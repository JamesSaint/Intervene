---
/**
 * A specimen of the three verdict states, presented as numbered rows.
 * The labels explain the states; restrained signals provide a second cue.
 */
import Agda from './Agda.astro';

const states = [
  { state: 'open',      name: 'Before impact', line: 'Intervention completes in time. The window stays open.' },
  { state: 'narrowing', name: 'At risk',       line: 'Completes within a margin ordinary pressure can erode.' },
  { state: 'closed',    name: 'After impact',  line: 'Intervention lands too late. The window has closed.' },
];
---

<figure
  class="verdict-block"
  aria-label="AGDA® Intervention Readiness verdict. A specimen of the verdict format, not a result. A full AGDA® Assessment returns one of three states: before impact, at risk, or after impact. The Intervention Readiness Review does not produce a verdict."
>
  <div class="vb-frame">
    <header class="vb-head">
      <span class="vb-title mono">Intervention Readiness · Verdict</span>
      <span class="vb-serial mono">Specimen</span>
    </header>

    <ol class="vb-states" role="list">
      {states.map((s, i) => (
        <li class="vb-state" data-state={s.state}>
          <span class="vb-index mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="vb-read">
            <span class="vb-name mono"><span class="vb-dot" aria-hidden="true"></span>{s.name}</span>
            <span class="vb-line">{s.line}</span>
          </span>
        </li>
      ))}
    </ol>

  </div>
  <figcaption class="vb-caption">
    A full <Agda /> Assessment returns one of these three states. The
    Intervention Readiness Review does not produce a verdict. A specimen
    of the verdict format, not a result.
  </figcaption>
</figure>

<style>
  .verdict-block { margin: 0; width: 100%; }
  .vb-frame {
    position: relative;
    border-block: 1px solid var(--hair-strong);
    background: transparent;
    padding: 0;
  }
  .vb-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--hair-strong);
  }
  .vb-title { font-size: var(--type-caption); letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); }
  .vb-serial { font-size: var(--type-caption); letter-spacing: 0.08em; color: var(--muted); }

  .vb-states { list-style: none; margin: 0; padding: 0; }
  .vb-state {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    padding: 28px 0;
    border-bottom: 1px solid var(--hair);
  }
  .vb-index {
    color: var(--accent);
    font-size: var(--type-caption);
    letter-spacing: 0.18em;
    padding-top: 3px;
  }
  .vb-read { display: grid; gap: 8px; }
  .vb-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: var(--type-card);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
  }
  .vb-dot { width: 10px; height: 10px; flex: none; }
  .vb-state[data-state='open']      .vb-dot { background: var(--pass); }
  .vb-state[data-state='narrowing'] .vb-dot { background: var(--hold); }
  .vb-state[data-state='closed']    .vb-dot { background: var(--warn); }
  .vb-state:last-child { border-bottom: 0; }
  .vb-line { font-family: var(--font-sans); font-size: 16px; line-height: 1.65; color: var(--muted); }

  .vb-caption { margin: 20px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.65; color: var(--muted); }

  @media (max-width: 640px) {
    .vb-head { padding: 16px 0; flex-wrap: wrap; }
    .vb-state { grid-template-columns: 28px minmax(0, 1fr); gap: 14px; padding: 24px 0; }
  }
</style>
