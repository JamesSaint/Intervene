---
/**
 * The SEDI chain: four nodes on a rail. When motion is enabled the rail
 * draws once, left to right, and each stage's node and name follow in
 * order. The order is the chain's order, not a duration.
 */
const stages = ['Detect', 'Escalate', 'Decide', 'Intervene'];
---

<figure class="chain-flow" data-reveal="scene" aria-label="The intervention capability chain: Detect, Escalate, Decide, Intervene.">
  <div class="rail draw" aria-hidden="true"></div>
  <ol role="list">
    {stages.map((s, i) => (
      <li style={`--i: ${i}`}>
        <span class="node" aria-hidden="true"></span>
        <span class="stage">{s}</span>
      </li>
    ))}
  </ol>
  <figcaption>Each stage is necessary. None is sufficient. Intervention Readiness equals the weakest stage.</figcaption>
</figure>

<style>
  .chain-flow { margin: 0; padding: var(--gap-intro) 0 0; }
  .chain-flow > .rail { margin-bottom: -7px; z-index: 0; }
  .chain-flow ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    position: relative;
    z-index: 1;
  }
  .chain-flow li { display: grid; justify-items: center; gap: 20px; }
  .stage {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }
  figcaption {
    margin-top: var(--space-5);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--muted);
    text-align: center;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }

  /* Sequence: rail 0 to 700ms; stages from 160ms, 140ms apart. */
  html[data-motion] .chain-flow li {
    opacity: 0;
    transform: translateY(var(--move-reveal));
    transition:
      opacity var(--dur-reveal) var(--ease-out),
      transform var(--dur-reveal) var(--ease-out);
    transition-delay: calc(160ms + var(--i) * 140ms);
  }
  html[data-motion] .chain-flow figcaption {
    opacity: 0;
    transition: opacity var(--dur-reveal) var(--ease-out) 760ms;
  }
  html[data-motion] .chain-flow.in li { opacity: 1; transform: none; }
  html[data-motion] .chain-flow.in figcaption { opacity: 1; }

  @media (max-width: 720px) {
    .chain-flow > .rail { display: none; }
    .chain-flow ol { grid-template-columns: 1fr; gap: var(--space-4); }
    .chain-flow li {
      grid-template-columns: 14px 1fr;
      justify-items: start;
      align-items: center;
      gap: 16px;
    }
    figcaption { text-align: left; margin-left: 0; }
  }
</style>
