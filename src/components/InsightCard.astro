---
import { markAgda } from '../lib/marks';

/**
 * Insight row. Publication style: full-width, strong ink rules, large
 * title, mono meta. Board-grade title, one line of dek, no marketing.
 */
interface Props {
  title: string;
  dek: string;
  href: string;
  kicker?: string;
}
const { title, dek, href, kicker = 'Note' } = Astro.props;
---

<a class="insight-row" href={href}>
  <span class="insight-meta mono">{kicker}</span>
  <span class="insight-main">
    <h2 class="insight-title" set:html={markAgda(title)}></h2>
    <p class="insight-dek" set:html={markAgda(dek)}></p>
  </span>
  <span class="insight-cue" aria-hidden="true">→</span>
</a>

<style>
  .insight-row {
    display: grid;
    grid-template-columns: 140px 1fr 40px;
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--hair-strong);
    color: var(--ink);
  }
  .insight-meta {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--type-caption);
    padding-top: 8px;
  }
  .insight-main { display: grid; gap: 14px; }
  .insight-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--type-h3);
    letter-spacing: var(--tracking-heading); text-transform: none;
    line-height: 1.3;
    margin: 0;
    transition: color var(--dur-fast) var(--ease);
  }
  .insight-dek {
    font-family: var(--font-sans);
    font-size: var(--type-body);
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
  }
  .insight-cue {
    font-size: 22px;
    line-height: 1;
    padding-top: 10px;
    justify-self: end;
    transition: transform var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .insight-row:hover .insight-title,
  .insight-row:focus-visible .insight-title { color: var(--accent); }
  .insight-row:hover .insight-cue,
  .insight-row:focus-visible .insight-cue { color: var(--accent); }
  .insight-row:active :is(.insight-title, .insight-cue) { color: var(--accent-hover); }
  .insight-row:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  @media (max-width: 720px) {
    .insight-row {
      grid-template-columns: 1fr 32px;
      gap: 16px 24px;
      padding: 32px 0;
    }
    .insight-meta { grid-column: 1 / -1; padding-top: 0; }
  }
</style>
