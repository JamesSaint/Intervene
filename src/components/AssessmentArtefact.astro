---
/**
 * What a full assessment produces, as an explorable artefact: the existing
 * constructed retail-credit sample, split into the parts a reader of the
 * real output would move between.
 *
 * Every fact is the sample's own (src/lib/sample-report.ts and
 * FindingChain); nothing is added. The status line above the parts is
 * always visible, so the qualification never sits behind an interaction.
 * Without JavaScript every part is shown in order.
 */
import FindingChain from './FindingChain.astro';
import Agda from './Agda.astro';
import { markAgda } from '../lib/marks';
import { systemSpecs, evidence, priorities, DECISION_QUESTION, PRIORITIES_NOTE, SAMPLE_LIMITS } from '../lib/sample-report';

const parts = [
  { key: 'scope', label: 'Scope' },
  { key: 'evidence', label: 'Evidence register' },
  { key: 'findings', label: 'SEDI findings' },
  { key: 'conclusion', label: 'Conclusion' },
  { key: 'verification', label: 'Verification' },
];
const DEFAULT = 'findings';

const establishes = [
  'That the input and output records match the signed commitments for the stated engine version.',
  'That neither record has changed since signing.',
];
const notEstablished = [
  'That the underlying evidence is true or complete.',
  'That the assessment method is empirically valid. AGDA® is not validated against real-world outcomes.',
  'That a regulator accepts the conclusion, or that any obligation is met.',
  'That intervention will work in a future event.',
];
---
<div class="artefact" data-artefact>
  <header class="af-head">
    <div class="af-strip">
      <span class="af-ref mono">Intervention Readiness verdict · CRED-MOD-04</span>
      <span class="af-stamp">
        <span class="af-status mono">Constructed illustration</span>
        <span class="mono af-flags" aria-label="Not issued. Not signed.">Not issued · Not signed</span>
      </span>
    </div>
    <div class="af-title">
      <h3 class="h3">Detection works. <em>Authority does not.</em></h3>
      <p class="body muted">Can the auto-decline pathway stop within an assumed six-hour window? No client data; not an issued assessment or a verified outcome.</p>
    </div>
  </header>

  <div class="af-body">
  <div class="af-tabs" role="tablist" aria-label="Parts of the assessment output" aria-orientation="vertical" hidden>
    {parts.map((part) => (
      <button
        type="button"
        role="tab"
        id={`af-tab-${part.key}`}
        aria-controls={`af-${part.key}`}
        aria-selected={part.key === DEFAULT ? 'true' : 'false'}
        tabindex={part.key === DEFAULT ? 0 : -1}
        data-af-tab={part.key}
      >{part.label}</button>
    ))}
  </div>

  <section class="af-panel" id="af-scope" data-af-panel="scope" aria-labelledby="af-h-scope">
    <h4 class="af-h" id="af-h-scope">Scope</h4>
    <p class="af-lede">One named system, one defined pathway, one intervention scenario. The scope is fixed before any evidence is examined.</p>
    <dl class="af-specs">
      {systemSpecs.map((s) => (
        <div><dt>{s.k}</dt><dd><span class="af-val">{s.v}</span><span class="af-unit">{s.u}</span></dd></div>
      ))}
    </dl>
    <p class="af-note">{SAMPLE_LIMITS}</p>
  </section>

  <section class="af-panel" id="af-evidence" data-af-panel="evidence" aria-labelledby="af-h-evidence">
    <h4 class="af-h" id="af-h-evidence">Evidence register</h4>
    <p class="af-lede">What each described record supports, and what remains open. Descriptions within a fictional example, not records inspected in a client engagement.</p>
    <ol class="af-register" role="list">
      {evidence.map((e) => (
        <li>
          <span class="af-id mono">{e.id}</span>
          <span class="af-type mono">{e.type}</span>
          <span class="af-desc">{e.desc}</span>
          <span class="af-open">{e.open}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="af-panel" id="af-findings" data-af-panel="findings" aria-labelledby="finding-chain-heading">
    <FindingChain />
  </section>

  <section class="af-panel" id="af-conclusion" data-af-panel="conclusion" aria-labelledby="af-h-conclusion">
    <h4 class="af-h" id="af-h-conclusion">Conclusion</h4>
    <div class="af-conclusion">
      <div>
        <span class="af-k mono">Illustrative conclusion</span>
        <p class="af-verdict"><span class="af-dot" aria-hidden="true"></span>After impact</p>
        <p class="af-body">The required route to an authorised intervention cannot complete within the assumed six-hour window. Faster detection cannot by itself resolve that constraint.</p>
        <p class="af-note">Illustrative, not issued, not signed. A full <Agda /> Assessment returns one of three states: Before impact, At risk or After impact.</p>
      </div>
      <div>
        <span class="af-k mono">Decision the finding supports</span>
        <p class="af-question">{DECISION_QUESTION}</p>
        <ol class="af-priorities">
          {priorities.map((p) => <li><strong>{p.lead}</strong>{p.rest.startsWith(',') ? p.rest : ` ${p.rest}`}</li>)}
        </ol>
        <p class="af-note">{PRIORITIES_NOTE}</p>
      </div>
    </div>
  </section>

  <section class="af-panel" id="af-verification" data-af-panel="verification" aria-labelledby="af-h-verification">
    <h4 class="af-h" id="af-h-verification">Verification</h4>
    <p class="af-lede">This illustration is not signed. Where a signed SEDI result record is supplied, checking it establishes integrity and authenticity, and nothing beyond them.</p>
    <div class="af-proof">
      <div>
        <span class="af-k mono">A check establishes</span>
        <ul role="list">{establishes.map((x) => <li class="is-yes">{x}</li>)}</ul>
      </div>
      <div>
        <span class="af-k mono">A check does not establish</span>
        <ul role="list">{notEstablished.map((x) => <li class="is-no" set:html={markAgda(x)} />)}</ul>
      </div>
    </div>
    <p class="af-note">The full account of what the signature covers is on <a href="/verify/" class="link">the verification page</a>.</p>
  </section>
  </div>
</div>

<style>
  /* A report on a desk: one bounded sheet with a record strip, a contents
     rail and a reading pane. The strip carries the sample's status in every
     state, so no part can be read without it. */
  .artefact { background: var(--paper); border: 1px solid var(--hair-strong); }
  .af-strip { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-2) var(--space-5); padding: var(--space-3) var(--af-pad); border-bottom: 1px solid var(--hair-strong); }
  .artefact { --af-pad: clamp(20px, 3vw, 40px); --af-index: 232px; }
  .af-ref { font-size: var(--type-caption); line-height: 1.6; color: var(--ink); }
  .af-stamp { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  .af-status { margin: 0; padding: 4px 10px; border: 1px solid var(--accent-text); font-size: var(--type-caption); line-height: 1.6; color: var(--accent-text); }
  .af-flags { font-size: var(--type-caption); line-height: 1.6; color: var(--faint); }
  .af-title { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-4) var(--space-7); align-items: end; padding: var(--space-6) var(--af-pad) var(--space-5); border-bottom: 1px solid var(--hair-strong); }
  .af-title .h3 { font-size: var(--type-finding); line-height: 1.15; margin: 0; }
  .af-title .h3 em { color: var(--faint); }
  .af-title .body { margin: 0; font-size: var(--type-small); }

  .af-body { display: grid; grid-template-columns: var(--af-index) minmax(0, 1fr); align-items: start; }
  .af-tabs { display: grid; align-content: start; padding: var(--space-4) 0; border-right: 1px solid var(--hair); align-self: stretch; }
  .af-tabs[hidden] { display: none; }
  .af-tabs[hidden] ~ .af-panel { grid-column: 1 / -1; }
  .af-tabs button {
    position: relative; min-height: 48px; padding: 0 var(--space-4) 0 var(--af-pad); text-align: left; font-size: var(--type-small); font-weight: 600; line-height: 1.3; color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .af-tabs button::after { content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; background: var(--ink); transform: scaleY(0); transform-origin: center top; transition: transform var(--dur-expand) var(--ease-out); }
  .af-tabs button[aria-selected='true'] { color: var(--ink); }
  .af-tabs button[aria-selected='true']::after { transform: scaleY(1); }
  .af-tabs button:hover { color: var(--ink); }
  .af-tabs button:focus-visible { outline: 2px solid var(--focus); outline-offset: -4px; }

  .af-panel { grid-column: 2; min-width: 0; padding: var(--space-5) var(--af-pad) var(--space-6); }
  .af-panel[hidden] { display: none; }
  /* The finding diagram carries its own top rule and heading. */
  .af-panel :global(.finding-chain) { margin-top: 0; padding-top: 0; border-top: 0; }
  .af-h { margin: 0; font-size: var(--type-card); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.3; color: var(--ink); }
  .af-lede { margin: var(--space-2) 0 0; max-width: 68ch; font-size: var(--type-body); line-height: 1.7; color: var(--muted); }
  .af-note { margin: var(--space-4) 0 0; font-size: var(--type-small); line-height: 1.7; color: var(--faint); }
  .af-k { display: block; margin-bottom: var(--space-2); font-size: var(--type-caption); line-height: 1.6; color: var(--accent-text); }

  .af-specs { margin: var(--space-5) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--space-5); border-bottom: 1px solid var(--hair); }
  .af-specs > div { padding: var(--space-4) 0; border-top: 1px solid var(--hair); display: grid; gap: var(--space-1); align-content: start; }
  .af-specs dt { font-family: var(--font-mono); font-size: var(--type-caption); line-height: 1.6; color: var(--faint); }
  .af-specs dd { margin: 0; display: grid; gap: 4px; }
  .af-val { font-size: var(--type-card); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.3; color: var(--ink); }
  .af-unit { font-size: var(--type-action); line-height: 1.5; color: var(--muted); }

  .af-register { list-style: none; margin: var(--space-5) 0 0; padding: 0; border-bottom: 1px solid var(--hair); }
  .af-register li { display: grid; grid-template-columns: 56px 112px minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-2) var(--space-5); align-items: baseline; padding: var(--space-3) 0; border-top: 1px solid var(--hair); }
  .af-id { color: var(--ink); font-size: var(--type-caption); }
  .af-type { color: var(--faint); font-size: var(--type-caption); }
  .af-desc { color: var(--ink); font-size: var(--type-small); line-height: 1.6; }
  .af-open { color: var(--muted); font-size: var(--type-small); line-height: 1.6; }

  .af-conclusion { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--space-5) var(--space-7); margin-top: var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--hair); }
  .af-verdict { display: flex; align-items: center; gap: 14px; margin: 0 0 var(--space-3); font-size: var(--type-finding); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.15; color: var(--ink); }
  .af-dot { width: 14px; height: 14px; flex: none; background: var(--warn); }
  .af-body { margin: 0; font-size: var(--type-body); line-height: 1.7; color: var(--muted); }
  .af-question { margin: 0 0 var(--space-4); font-size: var(--type-card); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.3; color: var(--ink); }
  .af-priorities { margin: 0; padding: 0; list-style: none; counter-reset: priority; border-bottom: 1px solid var(--hair); }
  .af-priorities li { counter-increment: priority; position: relative; padding: var(--space-3) 0 var(--space-3) 40px; border-top: 1px solid var(--hair); font-size: var(--type-small); line-height: 1.6; color: var(--muted); }
  .af-priorities li::before { content: counter(priority); position: absolute; left: 0; top: var(--space-3); font-family: var(--font-mono); font-size: var(--type-caption); line-height: 2; color: var(--faint); }
  .af-priorities strong { color: var(--ink); font-weight: 600; }

  .af-proof { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-7); margin-top: var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--hair); }
  .af-proof ul { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--hair); }
  .af-proof li { position: relative; padding: var(--space-3) 0 var(--space-3) 32px; border-top: 1px solid var(--hair); font-size: var(--type-small); line-height: 1.6; color: var(--ink); }
  .af-proof li::before { content: ''; position: absolute; left: 0; top: calc(var(--space-3) + 6px); width: 13px; height: 13px; border: 1px solid var(--ink); border-radius: 50%; box-sizing: border-box; }
  .af-proof li.is-yes::before { background: var(--ink); }
  .af-proof li.is-no { color: var(--muted); }
  .af-proof li.is-no::before { border-style: dashed; border-color: var(--control-border); }

  @media (max-width: 960px) {
    .af-title { grid-template-columns: 1fr; padding-top: var(--space-5); }
    .af-body { grid-template-columns: minmax(0, 1fr); }
    .af-tabs { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); padding: 0 var(--af-pad); border-right: 0; border-bottom: 1px solid var(--hair-strong); }
    .af-tabs button { padding: 0; min-height: 52px; }
    .af-tabs button::after { left: 0; right: 0; top: auto; bottom: -1px; width: auto; height: 3px; transform: scaleX(0); transform-origin: left center; }
    .af-tabs button[aria-selected='true']::after { transform: scaleX(1); }
    .af-tabs button:focus-visible { outline-offset: 2px; }
    .af-panel { grid-column: 1; }
    .af-specs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .af-register li { grid-template-columns: 56px minmax(0, 1fr); }
    .af-type { grid-column: 2; grid-row: 1; }
    .af-desc, .af-open { grid-column: 2; }
    .af-conclusion, .af-proof { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .af-tabs { gap: 0 var(--space-3); }
    .af-tabs button { min-height: 48px; font-size: 14px; }
    .af-specs { grid-template-columns: 1fr; }
  }
  @media print { .af-tabs { display: none !important; } .af-panel[hidden] { display: block !important; } }
</style>

<script>
  // Tabs are an enhancement: until this runs, every part is on the page.
  document.querySelectorAll<HTMLElement>('[data-artefact]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-af-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-af-panel]'));
    if (!list || !tabs.length) return;

    const select = (key: string, focus = false) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.afTab === key;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.afPanel !== key; });
    };

    panels.forEach((panel) => { panel.setAttribute('role', 'tabpanel'); panel.tabIndex = 0; });
    list.hidden = false;
    select(tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')?.dataset.afTab ?? tabs[0].dataset.afTab!);

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.afTab!));
      tab.addEventListener('keydown', (event) => {
        const move: Record<string, number> = { ArrowRight: index + 1, ArrowDown: index + 1, ArrowLeft: index - 1, ArrowUp: index - 1, Home: 0, End: tabs.length - 1 };
        if (!(event.key in move)) return;
        event.preventDefault();
        const next = tabs[(move[event.key] + tabs.length) % tabs.length];
        select(next.dataset.afTab!, true);
      });
    });
    // Printing shows the whole artefact.
    window.addEventListener('beforeprint', () => panels.forEach((panel) => { panel.hidden = false; }));
    window.addEventListener('afterprint', () => select(tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')!.dataset.afTab!));
  });
</script>
