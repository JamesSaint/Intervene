---
/**
 * A fixed reading of the dial: the finished chain for one set of timings.
 * Used in pairs to set what is documented beside what happens under
 * pressure. Same face, same model, same rule for the outcome as the
 * instrument in the hero; nothing here is measured.
 */
import { evaluate, OUTCOME_LABEL, describe } from '../lib/window-model';
import { progress, percent } from '../lib/dial-geometry';
import DialFace from './DialFace.astro';

interface Props { uid: string; title: string; durations: readonly number[]; window: number }
const { uid, title, durations, window } = Astro.props;
const result = evaluate(durations, window);
const meter = progress(durations, window);
---
<figure class="dial-reading" data-outcome={result.outcome}>
  <div class="dr-face" role="img" aria-label={`${title}: ${OUTCOME_LABEL[result.outcome]}. ${describe(result)}`}>
    <DialFace durations={durations} window={window} uid={uid} />
    <div class="dr-centre" aria-hidden="true">
      <span class="dr-title">{title}</span>
      <strong class="dr-word">{OUTCOME_LABEL[result.outcome]}</strong>
    </div>
  </div>
  <figcaption>
    <span class="dr-cap-title">{title}</span>
    <span class="dr-cap-figure">{percent(meter.consumed)} of the window used{meter.beyond > 0 ? `, ${percent(meter.beyond)} beyond it` : ''}</span>
  </figcaption>
</figure>

<style>
  .dial-reading { margin: 0; display: grid; gap: var(--space-3); }
  .dr-face { position: relative; width: 100%; aspect-ratio: 1; }
  .dr-centre { position: absolute; inset: 31%; display: grid; align-content: center; justify-items: center; gap: 6px; text-align: center; color: #f0f0f0; }
  .dr-title { font-family: var(--font-mono); font-size: clamp(10px, 1.1vw, 12px); line-height: 1.4; color: #8e8b87; }
  .dr-word { font-size: clamp(22px, 3.3vw, 44px); font-weight: 600; letter-spacing: -0.03em; line-height: 1; white-space: nowrap; }
  .dial-reading[data-outcome='too-late'] .dr-word { color: #e0766a; }
  figcaption { display: grid; gap: 2px; padding-top: var(--space-3); border-top: 1px solid var(--hair-strong); }
  .dr-cap-title { font-size: var(--type-card); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.25; color: var(--ink); }
  .dr-cap-figure { font-family: var(--font-mono); font-size: var(--type-caption); line-height: 1.6; color: var(--faint); }
  .dial-reading[data-outcome='too-late'] .dr-cap-figure { color: var(--warn); }
</style>
