---
import Logo from './Logo.astro';
import Hallmark from './Hallmark.astro';
import LinkedInButton from './LinkedInButton.astro';
import { socialLinks, contactEmail } from '../lib/social';
import Agda from './Agda.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap foot-inner">
    <div class="brand-col">
      <Logo size="md" href="/" />
      <span class="brand-line">Intervention Readiness, assessed.</span>
      <a class="brand-email" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      <div class="brand-social">
        <LinkedInButton href={socialLinks.interveneLinkedIn} label="Intervene Limited on LinkedIn" />
      </div>
      <div class="brand-hallmark"><Hallmark /></div>
    </div>

    <nav class="primary-nav" aria-label="Footer">
      <ul role="list">
        <li><a href="/intervention-readiness/">Intervention Readiness</a></li>
        <li><a href="/about/">Why it matters</a></li>
        <li><a href="/agda/"><Agda /></a></li>
        <li><a href="/methodology/">How it works</a></li>
        <li><a href="/sample-report/">Sample verdict</a></li>
        <li><a href="/services/">Assessment options</a></li>
      </ul>
    </nav>

  </div>

  <div class="wrap foot-sub">
    <nav class="supporting-nav" aria-label="Supporting">
      <ul role="list">
        <li><a href="/sectors/">Where it matters</a></li>
        <li><a href="/insights/">Insights</a></li>
        <li><a href="/verify/">Verify</a></li>
        <li><a href="/network/">Intervention Readiness Network</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/legal/terms/">Terms</a></li>
        <li><a href="/legal/privacy/">Privacy</a></li>
        <li><a href="/legal/gdpr/">UK GDPR</a></li>
        <li><button type="button" data-consent-reopen>Cookies</button></li>
      </ul>
    </nav>

    <p class="meta">
      <span class="meta-name">Intervene Limited</span>
      <span aria-hidden="true" class="meta-sep">·</span>
      <span>Owner and developer of <Agda /></span>
      <span aria-hidden="true" class="meta-sep">·</span>
      <span>Registered in England and Wales, <span class="keep-together">company number 17317647</span></span>
      <span aria-hidden="true" class="meta-sep">·</span>
      <span>© {year} Intervene Limited</span>
    </p>
    <p class="trade-mark-notice">AGDA is a registered trade mark of Intervene Limited in the United Kingdom (UK00004416503).</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hair);
    padding: 72px 0 44px;
    background: var(--paper-deep);
  }
  .foot-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: start;
    gap: var(--space-7);
  }
  .brand-col { display: grid; gap: 12px; align-content: start; }
  .brand-social {
    display: flex;
    align-items: center;
  }
  .brand-line {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--muted);
    max-width: calc(34 * var(--ch));
    line-height: 1.5;
  }
  .brand-email {
    justify-self: start;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--muted);
    line-height: 1.5;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-hover) var(--ease),
      color var(--dur-hover) var(--ease);
  }
  .brand-email:hover { border-color: var(--accent); color: var(--ink); }
  .brand-hallmark { margin-top: 8px; }
  .primary-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 32px;
  }
  .primary-nav a {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--muted-soft);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    line-height: 1.5;
    padding: 8px 0;
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-hover) var(--ease),
      color var(--dur-hover) var(--ease);
  }
  .primary-nav a:hover { border-color: var(--accent); color: var(--ink); }
  /* Company facts remain in a full-width row below the navigation. */
  .meta {
    margin: 20px 0 0;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--faint);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 10px;
    line-height: 1.7;
  }
  .meta-name { color: var(--ink); font-weight: 600; }
  .meta-sep { color: var(--faint); }

  .foot-sub {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--hair);
  }
  .supporting-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }
  .supporting-nav a,
  .supporting-nav button {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    line-height: 1.5;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-hover) var(--ease);
  }
  .supporting-nav button {
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0;
    cursor: pointer;
  }
  .supporting-nav a:hover,
  .supporting-nav button:hover { color: var(--ink); }

  .trade-mark-notice {
    margin: 12px 0 0;
    color: var(--faint);
    font-size: var(--type-caption);
    line-height: 1.7;
  }

  @media (max-width: 1000px) {
    .primary-nav ul { grid-template-columns: 1fr; gap: 0; }
  }
  @media (max-width: 720px) {
    .foot-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: left;
    }
    .primary-nav ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 24px; }
    .meta { display: grid; gap: 8px; }
    .meta-sep { display: none; }
    .supporting-nav ul { gap: 4px 20px; }
    .foot-sub { margin-top: var(--space-5); padding-top: var(--space-4); }
  }
</style>
