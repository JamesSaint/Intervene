---
const bars = [
  { stage: 'Detect',     actual: 2.0, claimed: null },
  { stage: 'Escalate',   actual: 3.0, claimed: 4.0 },
  { stage: 'Decide',     actual: 3.5, claimed: 4.5 },
  { stage: 'Intervene',  actual: 4.0, claimed: 4.8 },
];
const MAX = 5;
const ticks = [5, 4, 3, 2, 1, 0];
---

<figure class="ceiling" data-reveal="scene" aria-label="Chain ceiling propagation. Claimed scores in light ghost tracks. Actual capped scores in dark bars.">
  <div class="chart">
    <ol class="axis-y" aria-hidden="true">
      {ticks.map((t) => <li>{t}</li>)}
    </ol>

    <div class="plot">
      <div class="gridlines" aria-hidden="true">
        {[1, 2, 3, 4, 5].map((n) => (
          <span class="gline" style={`bottom: ${(n / MAX) * 100}%`}></span>
        ))}
      </div>

      <div class="bars">
        {bars.map((b, i) => (
          <div
            class="col"
            style={`--actual: ${(b.actual / MAX) * 100}%; --claim: ${b.claimed !== null ? (b.claimed / MAX) * 100 : 0}%; --delay: ${i * 110}ms`}
          >
            {b.claimed !== null && (
              <span class="ghost" aria-label={`Claimed ${b.claimed.toFixed(1)}`}>
                <span class="ghost-label">claimed {b.claimed.toFixed(1)}</span>
              </span>
            )}
            <span class="bar" aria-label={`Capped at ${b.actual.toFixed(1)}`}>
              <span class="score">{b.actual.toFixed(1)}</span>
            </span>
            <span class="stage">{b.stage}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <figcaption>
    Detect measures 2.0 because signal is limited to nightly batch review.
    The chain ceiling propagates forward. Intervene is capped at 4.0, not
    the claimed 4.8.
  </figcaption>
</figure>

<style>
  .ceiling { margin: var(--gap-intro) 0 0; padding: 0; }

  .chart {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 24px;
    height: 420px;
  }

  .axis-y {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-align: right;
    padding-bottom: 40px;
  }

  .plot {
    position: relative;
    border-left: 1px solid var(--hair-strong);
    border-bottom: 1px solid var(--hair-strong);
    padding-bottom: 40px;
  }

  .gridlines {
    position: absolute;
    inset: 0 0 40px 0;
    pointer-events: none;
  }
  .gline {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--hair-soft);
  }

  .bars {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: end;
  }

  .col {
    position: relative;
    height: calc(100% - 40px);
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }
  .col::before {
    /* Stage label appears below baseline. Use the col itself as anchor. */
    content: '';
  }
  .stage {
    position: absolute;
    bottom: -32px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }

  .ghost,
  .bar {
    position: absolute;
    bottom: 0;
    left: 22%;
    right: 22%;
    display: block;
  }

  .ghost {
    height: var(--claim);
    background: var(--paper-soft);
    border: 1px solid var(--hair);
    border-bottom: 0;
    z-index: 1;
  }
  .ghost-label {
    position: absolute;
    top: -22px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-transform: lowercase;
  }

  .bar {
    height: var(--actual);
    background: var(--accent);
    z-index: 2;
  }
  .score {
    position: absolute;
    top: -22px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  /* Draw once when motion is on: the claimed track rises first, then
     the capped bar, then the labels. Stage by stage, left to right. */
  html[data-motion] .ghost {
    height: 0; opacity: 0;
    transition: height 520ms var(--ease-draw), opacity var(--dur-reveal) var(--ease-out);
    transition-delay: var(--delay);
  }
  html[data-motion] .bar {
    height: 0;
    transition: height var(--dur-draw) var(--ease-draw);
    transition-delay: calc(var(--delay) + 160ms);
  }
  html[data-motion] .ghost-label,
  html[data-motion] .score {
    opacity: 0;
    transition: opacity var(--dur-reveal) var(--ease-out);
    transition-delay: calc(var(--delay) + 700ms);
  }
  html[data-motion] .ceiling.in .ghost { height: var(--claim); opacity: 1; }
  html[data-motion] .ceiling.in .bar { height: var(--actual); }
  html[data-motion] .ceiling.in .ghost-label,
  html[data-motion] .ceiling.in .score { opacity: 1; }

  figcaption {
    margin-top: var(--space-6);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--muted);
    max-width: 64ch;
  }

  @media (max-width: 720px) {
    .chart { height: 320px; gap: 16px; grid-template-columns: 24px 1fr; }
    .axis-y { font-size: 10px; }
    .ghost, .bar { left: 14%; right: 14%; }
    .stage { font-size: 12px; bottom: -28px; }
    .ghost-label { font-size: 9px; top: -18px; }
    .score { font-size: 11px; top: -18px; }
  }
</style>
