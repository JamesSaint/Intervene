---
/**
 * The three engagements, compared at a glance on the homepage: the buyer's
 * question, the principal output, the indicative fee and a link to the
 * engagement's details on /services/. Nothing else: scope, exclusions and
 * timing stay on /services/.
 *
 * Everything reads from src/lib/offers.ts. Fees are printed exactly as held
 * there, with "fixed", "from", "initial" and "+ VAT" intact, and nothing
 * here restates or rounds a commercial term.
 *
 * Wide screens set the three side by side with their rows level. Narrow
 * screens stack them, so one engagement's question, output, fee and link
 * are read together before the next begins.
 */
import { offers } from '../lib/offers';
import { markAgda } from '../lib/marks';
import Agda from './Agda.astro';

interface Props {
  /** The heading element. /services/ uses the comparison as its opening, so its heading is the page's h1. */
  as?: 'h1' | 'h2';
  /** The heading's two halves; the second is set in the lighter tone on its own line. */
  lead?: string;
  tail?: string;
}
const { as: H = 'h2', lead = 'Three questions.', tail = 'One named system.' } = Astro.props;

const shorts = ['Authority Check', 'Review', 'Assessment'];
/* The engagement names sit one level beneath the comparison's own heading. */
const Name = H === 'h1' ? 'h2' : 'h3';
---
<div class="offer-compare">
  <div class:list={['cmp-caption', { 'is-page': H === 'h1' }]} data-offer-view="offer_choice">
    <H class:list={[H, 'cmp-heading']} id="offer-compare-heading">{lead}{tail && <Fragment> <em>{tail}</em></Fragment>}</H>
    <p class="cmp-intro">You can commission any of the three engagements directly.</p>
  </div>

  <ol class="cmp-list" role="list">
    {offers.map((o, i) => (
      <li class="cmp-item">
        <p class="cmp-q">{o.question}</p>
        <Name class="cmp-name" set:html={markAgda(o.name)} />
        <div class="cmp-row">
          <span class="mono cmp-k">Principal output</span>
          <p class="cmp-output" set:html={markAgda(o.output)} />
        </div>
        <div class="cmp-row">
          <span class="mono cmp-k">{o.priceNote}</span>
          <p class="cmp-price">{o.price}</p>
        </div>
        <a href={`/services/#${o.slug}`} class="link cmp-link" data-offer-select={o.slug}>{shorts[i]} details <span aria-hidden="true">→</span></a>
      </li>
    ))}
  </ol>

  <p class="cmp-note">
    Only the full Assessment produces an <Agda /> verdict. A Review may
    recommend a full Assessment but does not commit you to one or determine
    its verdict.
  </p>
</div>

<style>
  .cmp-caption { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-4) var(--space-7); align-items: end; }
  .cmp-heading { margin: 0; font-size: clamp(32px, 4.4vw, 64px); line-height: 1.04; }
  .cmp-heading em { display: block; color: var(--faint); }
  /* As a page heading it runs on one line, with its sentence directly beneath. */
  .cmp-caption.is-page { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  .cmp-caption.is-page .cmp-heading { font-size: clamp(34px, 4.6vw, 68px); line-height: 1.02; }
  .cmp-caption.is-page .cmp-intro { padding-bottom: 0; color: var(--muted); }
  .cmp-intro { margin: 0; padding-bottom: 6px; font-size: var(--type-support); line-height: 1.5; color: var(--ink); }

  /* Five rows shared by the three columns, so questions, outputs, fees and
     links sit level whatever the length of the text above them. */
  .cmp-list { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); column-gap: clamp(24px, 3vw, 48px); }
  .cmp-item { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; min-width: 0; padding-top: var(--space-4); border-top: 1px solid var(--ink); }
  .cmp-q { margin: 0; font-size: clamp(22px, 2.1vw, 30px); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.15; color: var(--ink); }
  .cmp-name { margin: var(--space-3) 0 0; font-size: var(--type-body); font-weight: 600; letter-spacing: 0; line-height: 1.4; color: var(--muted); }
  .cmp-row { display: grid; gap: 4px; align-content: start; margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid var(--hair-strong); }
  .cmp-k { font-size: var(--type-caption); line-height: 1.6; color: var(--faint); }
  .cmp-output { margin: 0; font-size: var(--type-small); line-height: 1.6; color: var(--ink); }
  .cmp-price { margin: 0; font-family: var(--font-mono); font-size: clamp(20px, 2vw, 26px); line-height: 1.3; color: var(--ink); }
  .cmp-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-top: var(--space-3); justify-self: start; font-size: var(--type-small); font-weight: 600; }
  .cmp-note { margin: var(--space-5) 0 0; font-size: var(--type-small); line-height: 1.7; color: var(--muted); }

  @media (max-width: 1080px) { .cmp-caption { grid-template-columns: minmax(0, 1fr); } }
  /* Narrow: one engagement at a time, each complete before the next. */
  @media (max-width: 860px) {
    .cmp-list { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; margin-top: var(--space-5); row-gap: var(--space-6); }
    .cmp-item { grid-row: auto; grid-template-rows: none; }
    .cmp-q { font-size: 24px; }
  }
</style>
