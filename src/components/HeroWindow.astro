---
/**
 * The proposition as one picture: the same four-stage chain, as documented
 * and under pressure, against one closing window.
 *
 * Conceptual only. Positions encode order, never a measured duration, and
 * the figure describes no organisation. Everything is present at first
 * paint; only the two traces draw.
 */
const stages = ['Detect', 'Escalate', 'Decide', 'Intervene'];
const rows = [
  { key: 'paper', label: 'On paper', at: [0, 15, 30, 45] },
  { key: 'pressure', label: 'Under pressure', at: [0, 31, 60, 88] },
];
const BOUNDARY = 70;
---
<figure
  class="hero-window"
  style={`--hw-b:${BOUNDARY}%`}
  aria-label="Conceptual illustration. On paper, detect, escalate, decide and intervene complete before the intervention window closes. Under pressure, the same chain reaches intervention after the window has closed."
>
  <div class="hw-head" aria-hidden="true">
    <span class="hw-label"></span>
    <span class="hw-track"><span class="hw-close">Window closes</span></span>
  </div>
  {rows.map((row) => (
    <div class={`hw-row hw-${row.key}`} aria-hidden="true">
      <span class="hw-label">{row.label}</span>
      <span class="hw-track">
        <span class="hw-trace" style={`--hw-end:${row.at[3]}%;--hw-cut:${((BOUNDARY / row.at[3]) * 100).toFixed(2)}%`}></span>
        {row.at.map((x, i) => (
          <span class="hw-stage" style={`--hw-x:${x}%`}>
            <span class="hw-node"></span>
            <span class="hw-name">{stages[i]}</span>
          </span>
        ))}
      </span>
    </div>
  ))}
  <figcaption>
    <span class="hw-legend" aria-hidden="true">Detect → Escalate → Decide → Intervene</span>
    <span>Conceptual illustration. Positions show order, not measured durations.</span>
  </figcaption>
</figure>

<style>
  .hero-window { --hw-label: 152px; margin: var(--gap-intro) 0 0; padding-top: var(--space-4); border-top: 1px solid var(--hair-strong); }
  .hw-head, .hw-row { display: grid; grid-template-columns: var(--hw-label) minmax(0, 1fr); gap: var(--space-4); align-items: center; }
  .hw-label { font-size: var(--type-action); font-weight: 600; line-height: 1.3; color: var(--ink); }
  .hw-track { position: relative; display: block; height: 76px; margin-right: 7px; }
  .hw-head .hw-track { height: 24px; }
  .hw-close { position: absolute; right: calc(100% - var(--hw-b) + 10px); bottom: 4px; font-family: var(--font-mono); font-size: 12px; line-height: 1.4; color: var(--ink); white-space: nowrap; }
  /* The rail, then the closed region drawn over it from the boundary on. */
  .hw-row .hw-track::before { content: ''; position: absolute; left: 0; right: 0; top: 26px; height: 1px; background: var(--hair-strong); }
  .hw-row .hw-track::after {
    content: ''; position: absolute; top: 0; bottom: 0; left: var(--hw-b); right: -7px;
    border-left: 1px dashed var(--control-border);
    background: repeating-linear-gradient(135deg, var(--hair) 0 1px, transparent 1px 11px);
  }
  .hw-trace { position: absolute; z-index: 1; left: 0; top: 25px; height: 3px; width: var(--hw-end); background: var(--ink); transform-origin: left center; }
  .hw-pressure .hw-trace { background: linear-gradient(to right, var(--ink) 0 var(--hw-cut), var(--warn) var(--hw-cut) 100%); }
  .hw-stage { position: absolute; z-index: 2; left: var(--hw-x); top: 20px; display: grid; justify-items: start; gap: 10px; }
  .hw-node { width: 13px; height: 13px; border: 1px solid var(--ink); border-radius: 50%; background: var(--paper-deep); }
  .hw-stage:last-child .hw-node { background: var(--ink); }
  .hw-pressure .hw-stage:last-child .hw-node { border-radius: 0; border-color: var(--warn); background: var(--warn); }
  .hw-name { font-family: var(--font-mono); font-size: 12px; line-height: 1.4; color: var(--muted); white-space: nowrap; }
  .hw-pressure .hw-stage:last-child { justify-items: end; transform: translateX(calc(-100% + 13px)); }
  .hw-pressure .hw-stage:last-child .hw-name { color: var(--ink); }
  figcaption { display: flex; flex-wrap: wrap; gap: 4px var(--space-4); margin-top: var(--space-2); padding-left: calc(var(--hw-label) + var(--space-4)); font-size: var(--type-caption); line-height: 1.65; color: var(--faint); }
  .hw-legend { display: none; font-family: var(--font-mono); color: var(--muted); }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-motion]) .hw-trace { animation: hw-draw var(--dur-trace) var(--ease-reveal) both; }
    :global(html[data-motion]) .hw-pressure .hw-trace { animation-duration: calc(var(--dur-trace) * 1.9); }
  }
  @keyframes hw-draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  @media (max-width: 880px) {
    .hero-window { --hw-label: 0px; }
    .hw-head, .hw-row { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .hw-head .hw-label { display: none; }
    .hw-row .hw-label { padding-top: var(--space-3); }
    .hw-track { height: 48px; }
    .hw-row .hw-track::before { top: 22px; }
    .hw-trace { top: 21px; }
    .hw-stage { top: 16px; }
    .hw-name { display: none; }
    .hw-legend { display: block; flex-basis: 100%; }
    figcaption { padding-left: 0; margin-top: var(--space-3); }
  }
  @media print { .hw-trace { animation: none; } }
</style>
