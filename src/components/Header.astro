---
import Logo from './Logo.astro';
import MenuIcon from './MenuIcon.astro';
interface Props { current?: string }
const { current } = Astro.props;
---

<header class="site-header" data-site-header>
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="wrap header-inner">
    <Logo size="md" href="/" />
    <!-- Three buyer destinations, desktop only. The takeover menu remains
         the full site structure and the only navigation on small screens. -->
    <nav class="quick-nav" aria-label="Primary">
      <a href="/services/" aria-current={current === 'services' ? 'page' : undefined}>Assessment options</a>
      <a href="/sample-report/" aria-current={current === 'sample-report' ? 'page' : undefined}>Sample verdict</a>
      <a href="/contact/" class="quick-cta" aria-current={current === 'contact' ? 'page' : undefined}>Discuss your system</a>
    </nav>
    <button
      type="button"
      class="menu-trigger"
      aria-expanded="false"
      aria-controls="takeover-menu"
      aria-label="Open menu"
      data-menu-trigger
    >
      <MenuIcon />
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1100;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--hair);
    transition:
      background 200ms ease,
      border-color 200ms ease;
  }
  .site-header[data-takeover-open] {
    border-bottom-color: var(--hair);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    padding-top: 18px;
    padding-bottom: 18px;
  }
  .quick-nav {
    display: none;
    align-items: center;
    gap: 28px;
    margin-left: auto;
    margin-right: 28px;
  }
  .quick-nav a {
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 0.01em;
    color: var(--muted);
    padding: 6px 0;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-hover) var(--ease), border-color var(--dur-hover) var(--ease);
  }
  .quick-nav a:hover,
  .quick-nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
  .quick-nav a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .quick-nav .quick-cta { color: var(--ink); }
  @media (min-width: 900px) {
    .quick-nav { display: flex; }
  }
  .menu-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    color: var(--ink);
    transition: color var(--dur-hover) var(--ease);
  }
  .menu-trigger:hover { color: var(--accent); }
  .menu-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
