---
type Pattern = 'focused' | 'recurring' | 'continuous';
interface Props {
  pattern: Pattern;
  duration?: string;
}

const { pattern, duration } = Astro.props;
---

<div class={`scope scope-${pattern}`} aria-hidden="true">
  <span class="track"></span>
  <span class="fill"></span>
</div>
{duration && <span class="scope-meta">{duration}</span>}

<style>
  .scope {
    position: relative;
    width: 160px;
    height: 2px;
    overflow: hidden;
  }
  .track {
    position: absolute;
    inset: 0;
    background: var(--hair);
  }
  .fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
  }

  /* Focused: a single short block at the start. The fill itself is 25% wide;
     the bar appears as a single thick dot at left. */
  .scope-focused .fill {
    width: 25%;
    background: var(--accent);
  }

  /* Recurring: dashes spanning the full bar. */
  .scope-recurring .fill {
    width: 100%;
    border-top: 2px dashed var(--accent);
  }

  /* Continuous: solid line. */
  .scope-continuous .fill {
    width: 100%;
    background: var(--accent);
  }

  .scope-meta {
    display: block;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    letter-spacing: 0.04em;
    color: var(--muted);
    text-transform: uppercase;
  }

</style>
