---
/**
 * The dial's drawing, shared by the interactive instrument and the static
 * readings elsewhere on the page. Everything on it is geometry from
 * src/lib/dial-geometry.ts: one revolution of the outer ring is the window,
 * and time past it runs on the inner ring.
 *
 * `live` adds the hooks the instrument's script drives. Without it the face
 * is a fixed picture of the finished chain.
 */
import { STAGES } from '../lib/window-model';
import { dialArcs, dash, labelPlacements, fitsLabel, RADIUS } from '../lib/dial-geometry';

interface Props { durations: readonly number[]; window: number; uid: string; live?: boolean }
const { durations, window, uid, live = false } = Astro.props;

const GAP = 0.006;
const arcs = dialArcs(durations, window);
const arc = (stage: number, ring: 'window' | 'beyond') => dash(arcs.find((a) => a.stage === stage && a.ring === ring), GAP);
const ticks = Array.from({ length: window * 4 }, (_, i) => ({ angle: (i / (window * 4)) * 360, major: i % 4 === 0 }));
const labels = labelPlacements(durations, window);
const total = durations.reduce((a, b) => a + b, 0);
const late = total > window;
// Names read left to right: clockwise round the top half, anticlockwise round the bottom.
const circle = (r: number, sweep: 0 | 1) => `M300,${300 - r} A${r},${r} 0 1,${sweep} ${sweep ? 299.99 : 300.01},${300 - r}`;
const along = (at: number) => (at > 0.25 && at < 0.75 ? { dir: 'ccw', offset: (1 - at) * 100 } : { dir: 'cw', offset: at * 100 });
---
<svg class="dial-face" viewBox="0 0 600 600" aria-hidden="true" focusable="false" data-late={late ? '' : undefined}>
  <defs>
    <path id={`${uid}-window-cw`} d={circle(RADIUS.window, 1)} />
    <path id={`${uid}-window-ccw`} d={circle(RADIUS.window, 0)} />
    <path id={`${uid}-beyond-cw`} d={circle(RADIUS.beyond, 1)} />
    <path id={`${uid}-beyond-ccw`} d={circle(RADIUS.beyond, 0)} />
  </defs>
  <circle class="df-disc" cx="300" cy="300" r="298" />
  <g class="df-ticks" data-df-ticks={live ? '' : undefined}>
    {ticks.map((t) => <line class:list={[{ 'is-major': t.major }]} x1="300" x2="300" y1={t.major ? 14 : 22} y2="32" transform={`rotate(${t.angle} 300 300)`} />)}
  </g>
  <g transform="rotate(-90 300 300)">
    <circle class="df-track" cx="300" cy="300" r={RADIUS.window} />
    <circle class="df-track df-track-beyond" cx="300" cy="300" r={RADIUS.beyond} />
    {STAGES.map((_, i) => (
      <Fragment>
        <circle class="df-arc" data-df-arc={live ? i : undefined} cx="300" cy="300" r={RADIUS.window} pathLength="1" stroke-dasharray={arc(i, 'window').array} stroke-dashoffset={arc(i, 'window').offset} />
        <circle class="df-arc df-arc-beyond" data-df-beyond={live ? i : undefined} cx="300" cy="300" r={RADIUS.beyond} pathLength="1" stroke-dasharray={arc(i, 'beyond').array} stroke-dashoffset={arc(i, 'beyond').offset} />
      </Fragment>
    ))}
  </g>
  <g class="df-names">
    {STAGES.map((name, i) => {
      const p = labels[i];
      const a = along(p.at);
      return (
        <text class:list={['df-name', `on-${p.ring}`, 'is-lit', { 'is-hidden': !fitsLabel(name, p) }]} data-df-name={live ? i : undefined} dy="0.36em">
          <textPath href={`#${uid}-${p.ring}-${a.dir}`} startOffset={`${a.offset}%`} text-anchor="middle">{name}</textPath>
        </text>
      );
    })}
  </g>
  <line class="df-boundary" x1="300" x2="300" y1="40" y2={300 - RADIUS.beyond + 12} />
  {live && <circle class="df-hand" data-df-hand cx="300" cy={300 - RADIUS.window} r="7" />}
</svg>

<style is:global>
  /* Global, because the instrument's script redraws ticks and the readings reuse the face. */
  .dial-face { display: block; width: 100%; height: 100%; --df-disc: #0a0a0a; --df-ink: #f0f0f0; --df-warn: #e0766a; --df-signal: #c9b694; }
  :root[data-theme='dark'] .dial-face { --df-disc: #181818; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme]) .dial-face { --df-disc: #181818; } }
  .df-disc { fill: var(--df-disc); stroke: rgba(201, 182, 148, 0.22); stroke-width: 1; }
  .df-ticks line { stroke: rgba(240, 240, 240, 0.32); stroke-width: 1; }
  .df-ticks line.is-major { stroke: rgba(240, 240, 240, 0.8); stroke-width: 1.5; }
  .df-track { fill: none; stroke: rgba(240, 240, 240, 0.13); stroke-width: 38; }
  .df-track-beyond { stroke: rgba(224, 118, 106, 0.13); stroke-width: 24; }
  .df-arc { fill: none; stroke: var(--df-ink); stroke-width: 38; transition: opacity 160ms ease; }
  .df-arc-beyond { stroke: var(--df-warn); stroke-width: 24; }
  .df-name { font-family: var(--font-sans); font-size: 16px; font-weight: 600; letter-spacing: 0.01em; fill: rgba(240, 240, 240, 0.62); transition: fill 160ms ease, opacity 160ms ease; }
  .df-name.on-beyond { font-size: 13px; }
  .df-name.is-lit { fill: #0a0a0a; }
  .df-name.is-hidden { display: none; }
  .df-boundary { stroke: var(--df-ink); stroke-width: 2; transition: stroke 360ms ease; }
  .dial-face[data-late] .df-boundary { stroke: var(--df-warn); }
  .df-hand { fill: var(--df-signal); opacity: 0; }
  @media (max-width: 720px) { .df-name { display: none; } }
  @media (prefers-reduced-motion: reduce) { .df-arc, .df-name, .df-boundary { transition: none; } }
</style>
