---
import InterventionWindow from './InterventionWindow.astro';

/**
 * The SEDI chain as four connected stages on one rail. Each stage opens in
 * place to show what is examined, what it depends on, how it fails and what
 * that costs the intervention.
 *
 * Public explanation only. The protected rubric is not reproduced here.
 * `window` adds the conceptual two-outcome comparison above the chain; the
 * homepage omits it because the scenario model there covers the same ground.
 */
interface Props { window?: boolean }
const { window: showWindow = true } = Astro.props;
// One stage open at a time, natively: the open stage's detail runs the full
// width of the chain, and the stages after it are drawn as waiting on it.
// Detect is open from the start, so the dependency is visible before any
// interaction; every stage remains one click or key press away.
const group = 'sedi-chain';

const stages = [
  { name: 'Detect', needs: 'Starts the chain', depends: 'Starts the chain. Every later stage begins after it.', question: 'Can the organisation recognise when intervention is required?', evidence: 'Signals, monitoring records and evidence of how the need to act is recognised.', failure: 'A warning exists but does not become an actionable signal.', consequence: 'The available intervention window is spent before the response begins.' },
  { name: 'Escalate', needs: 'Needs an actionable signal', depends: 'An actionable signal from Detect.', question: 'Can the right people be informed in time?', evidence: 'Escalation routes, contact arrangements and records of reaching decision authority.', failure: 'The signal reaches someone who cannot authorise action.', consequence: 'Reaching the person with authority may consume the remaining time.' },
  { name: 'Decide', needs: 'Needs the signal to reach someone with authority', depends: 'The signal reaching a person with authority to act.', question: 'Can accountable decision-makers determine what action is necessary?', evidence: 'Decision records, halt authority and arrangements for decisions under pressure.', failure: 'A decision depends on a quorum or approval route that cannot operate in time.', consequence: 'Detection and escalation cannot compensate for unavailable decision authority.' },
  { name: 'Intervene', needs: 'Needs an authorised decision and a working mechanism', depends: 'An authorised decision, and a mechanism that takes effect.', question: 'Can the organisation execute an effective intervention?', evidence: 'Intervention procedures and records of exercises or action taking effect.', failure: 'An authorised action does not take effect under the relevant operating conditions.', consequence: 'The response must take effect before the consequence becomes irreversible.' },
];
---
<div class="sedi-explorer">
  {showWindow && <InterventionWindow />}
  <p class="sedi-instruction">Select a stage to see what it depends on and what waits on it.</p>
  <ol role="list" aria-label="The SEDI intervention chain" data-reveal="stagger">
    {stages.map((stage, i) => (
      <li>
        <details data-disclosure name={group} open={i === 0}>
          <summary>
            <span class="sedi-node" aria-hidden="true"></span>
            <span class="sedi-name">{stage.name}</span>
            <span class="sedi-needs">{stage.needs}</span>
            <span class="sedi-question">{stage.question}</span>
            {i > 0 && <span class="sedi-wait mono">Waits on {stages[i - 1].name}</span>}
            <span class="sedi-toggle" aria-hidden="true"></span>
          </summary>
          <div data-disclosure-body>
            <dl>
              <div><dt>Evidence examined</dt><dd>{stage.evidence}</dd></div>
              <div><dt>Depends on</dt><dd>{stage.depends}</dd></div>
              <div><dt>Possible failure</dt><dd>{stage.failure}</dd></div>
              <div><dt>Consequence for intervention</dt><dd>{stage.consequence}</dd></div>
            </dl>
          </div>
        </details>
      </li>
    ))}
  </ol>
  <p class="sedi-caption">The weakest stage constrains the chain. Public explanations only, not assessment criteria or findings.</p>
</div>
<style>
  .sedi-explorer { margin-top: var(--gap-intro); }
  .sedi-instruction, .sedi-caption { color: var(--muted); font-size: var(--type-small); line-height: 1.6; margin: 0; }
  /* One continuous rail: the columns share no gap, so each stage's top
     rule meets the next, and the node sits on it. */
  ol { list-style: none; margin: var(--space-5) 0 var(--space-4); padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  li { min-width: 0; position: relative; border-top: 1px solid var(--hair-strong); }
  summary { list-style: none; cursor: pointer; padding: var(--space-5) var(--space-7) var(--space-4) 0; position: relative; display: grid; gap: var(--space-3); align-content: start; }
  summary::-webkit-details-marker { display: none; }
  .sedi-node { position: absolute; left: 0; top: -8px; width: 15px; height: 15px; border: 1px solid var(--ink); border-radius: 50%; background: var(--paper); transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease); }
  li:last-child .sedi-node { background: var(--ink); }
  details[open]:not([data-disclosure-state='closed']) .sedi-node { background: var(--sedi-signal); border-color: var(--sedi-signal); }
  /* The rail records the state of the chain. Up to the open stage it is
     drawn solid; the open stage takes the signal colour; every stage after
     it is dashed, because it cannot begin until the open one completes. */
  li::before { content: ''; position: absolute; left: 0; right: 0; top: -2px; height: 3px; background: var(--ink); transform: scaleX(0); transform-origin: left center; transition: transform var(--dur-expand) var(--ease-out), background-color var(--dur-fast) var(--ease); }
  li:has(~ li details[open])::before { transform: scaleX(1); }
  li:has(details[open]:not([data-disclosure-state='closed']))::before { transform: scaleX(1); background: var(--sedi-signal); }
  li:has(details[open]) ~ li { border-top-style: dashed; }
  li:has(details[open]) ~ li .sedi-node { border-style: dashed; background: var(--paper); }
  li:has(details[open]) ~ li :is(.sedi-name, .sedi-question, .sedi-needs) { color: var(--faint); }
  /* The rail has a direction: each stage hands on to the next. */
  li:not(:last-child)::after { content: ''; position: absolute; right: 10px; top: -5px; width: 8px; height: 8px; border-top: 1px solid var(--ink); border-right: 1px solid var(--ink); transform: rotate(45deg); }
  .sedi-wait { display: none; font-size: var(--type-caption); line-height: 1.6; color: var(--accent-text); }
  li:has(details[open]) ~ li .sedi-wait { display: block; }
  .sedi-name { transition: color var(--dur-fast) var(--ease); font-size: clamp(28px, 3.2vw, 46px); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.05; color: var(--ink); }
  /* What each stage needs from the one before it, stated on the chain itself. */
  .sedi-needs { font-size: var(--type-body); font-weight: 600; line-height: 1.4; color: var(--ink); }
  /* The arrow is a visual cue; the alternative text keeps it out of what is read aloud. */
  li + li .sedi-needs::before { content: '← '; content: '← ' / ''; color: var(--accent-text); }
  .sedi-question { transition: color var(--dur-fast) var(--ease); color: var(--muted); font-size: var(--type-small); line-height: 1.6; }
  .sedi-toggle { position: absolute; right: var(--space-5); top: calc(var(--space-5) + 8px); width: 18px; height: 18px; }
  li:last-child .sedi-toggle { right: 0; }
  .sedi-toggle::before, .sedi-toggle::after { content: ''; position: absolute; background: var(--ink); }
  .sedi-toggle::before { height: 1px; width: 18px; top: 8px; }
  .sedi-toggle::after { width: 1px; height: 18px; left: 8px; }
  .sedi-toggle::after { transition: transform var(--dur-expand) var(--ease-out); transform-origin: center; }
  details[open]:not([data-disclosure-state='closed']) .sedi-toggle::after { transform: scaleY(0); }
  summary:is(:hover, :focus-visible) .sedi-name, details[open] .sedi-name { color: var(--accent-text); }
  summary:active .sedi-name { color: var(--accent-text-hover); }
  summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 6px; }
  dl { margin: 0; padding-bottom: var(--space-4); display: grid; gap: 24px; }
  dt { color: var(--accent-text); font-family: var(--font-mono); font-size: var(--type-caption); line-height: 1.6; margin-bottom: 8px; }
  dd { margin: 0; color: var(--muted); font-size: var(--type-small); line-height: 1.7; }
  /* Wide screens: the open stage's detail leaves its column and runs the
     width of the chain, four facets across. Summaries share one height so
     the detail always starts below every stage. */
  @media (min-width: 1101px) {
    summary { min-height: 288px; }
    [data-disclosure-body] { width: 400%; }
    li:nth-child(2) [data-disclosure-body] { margin-left: -100%; }
    li:nth-child(3) [data-disclosure-body] { margin-left: -200%; }
    li:nth-child(4) [data-disclosure-body] { margin-left: -300%; }
    dl { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; padding: var(--space-5) 0 var(--space-5); border-top: 1px solid var(--hair-strong); border-bottom: 1px solid var(--hair-strong); background: var(--paper); position: relative; }
    dl > div { padding-right: var(--space-7); }
    dd { font-size: var(--type-body); color: var(--ink); }
  }
  @media (max-width: 1100px) {
    ol { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-4); }
    li:nth-child(2n) .sedi-toggle { right: 0; }
  }
  @media (max-width: 560px) {
    ol { grid-template-columns: 1fr; row-gap: 0; }
    li { border-top: 0; border-left: 1px solid var(--hair-strong); padding-left: var(--space-4); }
    li:has(details[open]) ~ li { border-left-style: dashed; }
    .sedi-toggle { right: 0; }
    li::before { left: -2px; right: auto; top: 0; bottom: 0; width: 3px; height: auto; transform: scaleY(0); transform-origin: center top; }
    li:not(:last-child)::after { right: auto; left: -5px; top: auto; bottom: 6px; transform: rotate(135deg); }
    .sedi-question { display: none; }
    details[open] .sedi-question { display: block; }
    li + li .sedi-needs::before { content: '↑ '; content: '↑ ' / ''; }
    li:has(details[open]:not([data-disclosure-state='closed']))::before { transform: scaleY(1); }
    .sedi-node { left: calc(-1 * var(--space-4) - 7px); top: calc(var(--space-4) + 6px); }
    summary { padding: var(--space-4) 32px var(--space-3) 0; gap: var(--space-1); }
    .sedi-toggle { top: calc(var(--space-4) + 6px); }
    dl { padding-bottom: var(--space-4); }
  }
</style>
