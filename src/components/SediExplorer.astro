---
import InterventionWindow from './InterventionWindow.astro';
import { PRESETS, DEFAULT_PRESET, WINDOWS, evaluate, describe } from '../lib/window-model';
import { scenarioChain, chainTotals, totalsText } from '../lib/scenario-chain';

/**
 * The SEDI chain as four connected stages on one rail. Each stage opens in
 * place to show what is examined, what it depends on, how it fails and what
 * that costs the intervention.
 *
 * Public explanation only. The protected rubric is not reproduced here.
 * `window` adds the conceptual two-outcome comparison above the chain; the
 * homepage omits it because the scenario model there covers the same ground.
 *
 * `scenario` carries the dial's illustrative scenario into the chain: each
 * stage shows its share of the window and where the window closes, and the
 * line above the chain names the scenario. It follows the dial when the
 * visitor changes it (the `intervene:scenario` event). The first paint is
 * the default scenario, rendered here, so it reads without script. These
 * are interface states of the illustrative model, not assessment states.
 */
interface Props { window?: boolean; scenario?: boolean }
const { window: showWindow = true, scenario = false } = Astro.props;
const preset = PRESETS.find((p) => p.key === DEFAULT_PRESET)!;
const result = evaluate(preset.durations, WINDOWS.set);
const chain = scenarioChain(preset.durations, WINDOWS.set);
const totals = chainTotals(preset.durations, WINDOWS.set);
const totalText = totalsText(totals);
const markAt = chain.findIndex((c) => c.state === 'closes');
const vars = (i: number) => `--start: ${chain[i].start}; --end: ${chain[i].end}; --scale: ${totals.scale}; --cut: ${chain[i].boundary ?? (chain[i].state === 'after' ? 0 : 1)}`;
// One stage open at a time, natively: the open stage's detail runs the full
// width of the chain, and the stages after it are drawn as waiting on it.
// Detect is open from the start, so the dependency is visible before any
// interaction; every stage remains one click or key press away.
const group = 'sedi-chain';

const stages = [
  { name: 'Detect', needs: 'Starts the chain', depends: 'Starts the chain. Every later stage begins after it.', question: 'Can the organisation recognise when intervention is required?', evidence: 'Signals, monitoring records and evidence of how the need to act is recognised.', failure: 'A warning exists but does not become an actionable signal.', consequence: 'The available intervention window is spent before the response begins.' },
  { name: 'Escalate', needs: 'Needs an actionable signal', depends: 'An actionable signal from Detect.', question: 'Can the right people be informed in time?', evidence: 'Escalation routes, contact arrangements and records of reaching decision authority.', failure: 'The signal reaches someone who cannot authorise action.', consequence: 'Reaching the person with authority may consume the remaining time.' },
  { name: 'Decide', needs: 'Needs the signal to reach someone with authority', depends: 'The signal reaching a person with authority to act.', question: 'Can accountable decision-makers determine what action is necessary?', evidence: 'Decision records, halt authority and arrangements for decisions under pressure.', failure: 'A decision depends on a quorum or approval route that cannot operate in time.', consequence: 'Detection and escalation cannot compensate for unavailable decision authority.' },
  { name: 'Intervene', needs: 'Needs an authorised decision and a working mechanism', depends: 'An authorised decision, and a mechanism that takes effect.', question: 'Can the organisation execute an effective intervention?', evidence: 'Intervention procedures and records of exercises or action taking effect.', failure: 'An authorised action does not take effect under the relevant operating conditions.', consequence: 'The response must take effect before the consequence becomes irreversible.' },
];
---
<div class="sedi-explorer">
  {showWindow && <InterventionWindow />}
  {scenario && (
    <div class="sedi-carry" data-sedi-carry>
      <div class="sedi-carry-head">
        <span class="sedi-carry-k mono">Carried from the dial · illustrative</span>
        <label class="sedi-pick">
          <span>Scenario</span>
          <select data-sedi-preset>
            {PRESETS.map((p) => <option value={p.key} selected={p.key === preset.key}>{p.label}</option>)}
            <option value="custom" hidden>Your own timings</option>
          </select>
        </label>
        <a class="sedi-back" href="#window-dial">Shown on the dial <span aria-hidden="true">↑</span></a>
      </div>
      <div class="sedi-carry-body">
        <p class="sedi-carry-line"><strong data-sedi-label>{preset.label}.</strong> <span data-sedi-text>{preset.text}</span> <span data-sedi-out>{describe(result)}</span></p>
        <div class="sedi-figures">
          <dl class="sedi-totals sedi-principal">
            <div><dt>Whole chain</dt><dd><span data-sedi-total>{totalText.total}</span> of the window</dd></div>
          </dl>
          <!-- Secondary figures and the key. Present and shown in the markup,
               so nothing depends on script. On a narrow screen the script
               folds them behind the button; wide screens show them with no
               control. A button and a region, not a details element, so the
               chain's own stage disclosures stay the only ones here. -->
          <button type="button" class="sedi-more-toggle" data-sedi-more-toggle aria-expanded="true" aria-controls="sedi-more" hidden><span>More measurements and how to read the bars</span></button>
          <div class="sedi-more" id="sedi-more" data-sedi-more>
            <dl class="sedi-totals">
              <div><dt>Window remaining</dt><dd data-sedi-remaining>{totalText.remaining}</dd></div>
              <div class="sedi-total-beyond"><dt>Beyond the window</dt><dd data-sedi-beyond>{totalText.beyond}</dd></div>
            </dl>
            <p class="sedi-key">Each bar is one stage on the same scale. Its length is how long the stage takes; its right end is the time elapsed when the stage completes. The line is where the window closes.</p>
          </div>
        </div>
      </div>
    </div>
    <noscript><style is:inline>.sedi-pick { display: none !important; }</style></noscript>
  )}
  <p class="sedi-instruction">Select a stage to see what it depends on and what waits on it.</p>
  <ol role="list" aria-label="The SEDI intervention chain" data-reveal="stagger" data-sedi-chain={scenario ? '' : undefined}>
    {stages.map((stage, i) => (
      <li data-sedi-stage={scenario ? chain[i].state : undefined} data-sedi-longest={scenario && chain[i].longest ? '' : undefined} data-sedi-mark={scenario && i === (markAt === -1 ? 3 : markAt) ? '' : undefined} style={scenario ? vars(i) : undefined}>
        <details data-disclosure name={group} open={i === 0}>
          <summary>
            <span class="sedi-node" aria-hidden="true"></span>
            {scenario && (
              <span class="sedi-scn">
                <span class="sedi-share" aria-hidden="true"><span class="sedi-before"></span><span class="sedi-fill"></span><span class="sedi-boundary"><span class="mono">Window closes</span></span></span>
                <span class="sedi-share-text mono">Takes <span data-sedi-pct>{chain[i].percent}</span> of the window</span>
                <span class="sedi-end-text mono">Complete at <span data-sedi-end>{chain[i].endPercent}</span> elapsed</span>
                <span class="sedi-state mono" data-sedi-state>{chain[i].text}</span>
              </span>
            )}
            <span class="sedi-name">{stage.name}</span>
            <span class="sedi-needs">{stage.needs}</span>
            <span class="sedi-question">{stage.question}</span>
            {i > 0 && <span class="sedi-wait mono">Waits on {stages[i - 1].name}</span>}
            <span class="sedi-toggle" aria-hidden="true"></span>
          </summary>
          <div data-disclosure-body>
            <dl>
              <div><dt>Evidence examined</dt><dd>{stage.evidence}</dd></div>
              <div><dt>Depends on</dt><dd>{stage.depends}</dd></div>
              <div><dt>Possible failure</dt><dd>{stage.failure}</dd></div>
              <div><dt>Consequence for intervention</dt><dd>{stage.consequence}</dd></div>
            </dl>
          </div>
        </details>
      </li>
    ))}
  </ol>
  <p class="sedi-caption">The weakest stage constrains the chain. Public explanations only, not assessment criteria or findings.</p>
</div>
<style>
  .sedi-explorer { margin-top: var(--gap-intro); }
  .sedi-instruction, .sedi-caption { color: var(--muted); font-size: var(--type-small); line-height: 1.6; margin: 0; }
  /* One continuous rail: the columns share no gap, so each stage's top
     rule meets the next, and the node sits on it. */
  ol { list-style: none; margin: var(--space-5) 0 var(--space-4); padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  li { min-width: 0; position: relative; border-top: 1px solid var(--hair-strong); }
  summary { list-style: none; cursor: pointer; padding: var(--space-5) var(--space-7) var(--space-4) 0; position: relative; display: grid; gap: var(--space-3); align-content: start; }
  summary::-webkit-details-marker { display: none; }
  .sedi-node { position: absolute; left: 0; top: -8px; width: 15px; height: 15px; border: 1px solid var(--ink); border-radius: 50%; background: var(--paper); transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease); }
  li:last-child .sedi-node { background: var(--ink); }
  details[open]:not([data-disclosure-state='closed']) .sedi-node { background: var(--sedi-signal); border-color: var(--sedi-signal); }
  /* The rail records the state of the chain. Up to the open stage it is
     drawn solid; the open stage takes the signal colour; every stage after
     it is dashed, because it cannot begin until the open one completes. */
  li::before { content: ''; position: absolute; left: 0; right: 0; top: -2px; height: 3px; background: var(--ink); transform: scaleX(0); transform-origin: left center; transition: transform var(--dur-expand) var(--ease-out), background-color var(--dur-fast) var(--ease); }
  li:has(~ li details[open])::before { transform: scaleX(1); }
  li:has(details[open]:not([data-disclosure-state='closed']))::before { transform: scaleX(1); background: var(--sedi-signal); }
  li:has(details[open]) ~ li { border-top-style: dashed; }
  li:has(details[open]) ~ li .sedi-node { border-style: dashed; background: var(--paper); }
  li:has(details[open]) ~ li :is(.sedi-name, .sedi-question, .sedi-needs) { color: var(--faint); }
  /* The rail has a direction: each stage hands on to the next. */
  li:not(:last-child)::after { content: ''; position: absolute; right: 10px; top: -5px; width: 8px; height: 8px; border-top: 1px solid var(--ink); border-right: 1px solid var(--ink); transform: rotate(45deg); }
  .sedi-wait { display: none; font-size: var(--type-caption); line-height: 1.6; color: var(--accent-text); }
  li:has(details[open]) ~ li .sedi-wait { display: block; }
  .sedi-name { transition: color var(--dur-fast) var(--ease); font-size: clamp(28px, 3.2vw, 46px); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.05; color: var(--ink); }
  /* What each stage needs from the one before it, stated on the chain itself. */
  .sedi-needs { font-size: var(--type-body); font-weight: 600; line-height: 1.4; color: var(--ink); }
  /* The arrow is a visual cue; the alternative text keeps it out of what is read aloud. */
  li + li .sedi-needs::before { content: '← '; content: '← ' / ''; color: var(--accent-text); }
  .sedi-question { transition: color var(--dur-fast) var(--ease); color: var(--muted); font-size: var(--type-small); line-height: 1.6; }
  .sedi-toggle { position: absolute; right: var(--space-5); top: calc(var(--space-5) + 8px); width: 18px; height: 18px; }
  li:last-child .sedi-toggle { right: 0; }
  .sedi-toggle::before, .sedi-toggle::after { content: ''; position: absolute; background: var(--ink); }
  .sedi-toggle::before { height: 1px; width: 18px; top: 8px; }
  .sedi-toggle::after { width: 1px; height: 18px; left: 8px; }
  .sedi-toggle::after { transition: transform var(--dur-expand) var(--ease-out); transform-origin: center; }
  details[open]:not([data-disclosure-state='closed']) .sedi-toggle::after { transform: scaleY(0); }
  summary:is(:hover, :focus-visible) .sedi-name, details[open] .sedi-name { color: var(--accent-text); }
  summary:active .sedi-name { color: var(--accent-text-hover); }
  summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 6px; }
  dl { margin: 0; padding-bottom: var(--space-4); display: grid; gap: 24px; }
  dt { color: var(--accent-text); font-family: var(--font-mono); font-size: var(--type-caption); line-height: 1.6; margin-bottom: 8px; }
  dd { margin: 0; color: var(--muted); font-size: var(--type-small); line-height: 1.7; }
  /* Wide screens: the open stage's detail leaves its column and runs the
     width of the chain, four facets across. Summaries share one height so
     the detail always starts below every stage. */
  /* The dial's scenario, carried into the chain. */
  .sedi-carry { display: grid; gap: var(--space-4); padding: var(--space-4) 0; margin-bottom: var(--space-4); border-block: 1px solid var(--hair-strong); }
  .sedi-carry-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .sedi-carry-k { font-size: var(--type-caption); line-height: 1.6; color: var(--accent-text); margin-right: auto; }
  .sedi-pick { position: relative; display: inline-grid; min-width: 248px; border: 1px solid var(--control-border); background: var(--paper); }
  .sedi-pick > span { position: absolute; left: 12px; top: 6px; font-family: var(--font-mono); font-size: 11px; line-height: 1.3; color: var(--faint); pointer-events: none; }
  .sedi-pick select { appearance: none; width: 100%; min-height: 48px; padding: 22px 36px 6px 12px; border: 0; background: transparent; font: inherit; font-size: var(--type-action); font-weight: 600; color: var(--ink); cursor: pointer; }
  .sedi-pick::after { content: ''; position: absolute; right: 14px; top: 20px; width: 7px; height: 7px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); transform: rotate(45deg); pointer-events: none; }
  .sedi-pick select:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .sedi-back { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: var(--type-action); font-weight: 600; color: var(--ink); text-decoration: underline; text-decoration-color: var(--hair-strong); text-underline-offset: 4px; }
  .sedi-back:is(:hover, :focus-visible) { color: var(--accent-text); }
  .sedi-carry-body { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-4) var(--space-7); align-items: start; }
  .sedi-figures { display: grid; gap: var(--space-3); align-content: start; }
  .sedi-principal dd { font-size: clamp(22px, 2.2vw, 30px); line-height: 1.2; }
  .sedi-more { display: grid; gap: var(--space-3); }
  .sedi-more[hidden] { display: none; }
  .sedi-more-toggle { appearance: none; display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px; padding: 0; border: 0; border-top: 1px solid var(--hair); background: transparent; font: inherit; font-size: var(--type-action); font-weight: 600; text-align: left; color: var(--ink); cursor: pointer; }
  .sedi-more-toggle[hidden] { display: none; }
  .sedi-more-toggle::before { content: ''; flex: none; width: 8px; height: 8px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); transform: translateY(-2px) rotate(45deg); transition: transform var(--dur-fast) var(--ease-out); }
  .sedi-more-toggle[aria-expanded='true']::before { transform: translateY(2px) rotate(-135deg); }
  .sedi-more-toggle span { text-decoration: underline; text-decoration-color: var(--hair-strong); text-underline-offset: 4px; }
  .sedi-more-toggle:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .sedi-more > .sedi-totals { margin-bottom: var(--space-3); }
  .sedi-carry-line { margin: 0; min-height: 3lh; font-size: var(--type-support); line-height: 1.5; color: var(--muted); }
  .sedi-carry-line strong { color: var(--ink); font-weight: 600; }
  .sedi-totals { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); padding: 0; }
  .sedi-totals :is(dt, dd) { white-space: nowrap; }
  .sedi-totals dt { margin: 0 0 4px; font-family: var(--font-mono); font-size: var(--type-caption); line-height: 1.5; color: var(--muted); }
  .sedi-totals dd { margin: 0; font-family: var(--font-mono); font-size: var(--type-body); line-height: 1.4; color: var(--ink); }
  .sedi-total-beyond dd { color: var(--warn); }
  .sedi-key { margin: 0; font-size: var(--type-action); line-height: 1.55; color: var(--muted); }
  .sedi-scn { display: grid; gap: 4px; }
  /* One track per stage, all on one scale: the window, or the whole chain
     when it runs longer. The pale part is time already elapsed before the
     stage starts; the solid part is the stage; the line is where the window
     closes, at the same place on every track. A stage is drawn in the
     warning colour only for the part of it that falls after that line. */
  .sedi-share { position: relative; display: block; height: 12px; margin-bottom: 4px; background: var(--hair); }
  .sedi-before, .sedi-fill { position: absolute; top: 0; bottom: 0; transition: left var(--dur-signal) var(--ease-out), width var(--dur-signal) var(--ease-out); }
  .sedi-before { left: 0; width: calc(var(--start) / var(--scale) * 100%); background: var(--hair-strong); opacity: 0.55; }
  .sedi-fill { left: calc(var(--start) / var(--scale) * 100%); width: calc((var(--end) - var(--start)) / var(--scale) * 100%); background: linear-gradient(to right, var(--ink) calc(var(--cut) * 100%), var(--warn) calc(var(--cut) * 100%)); }
  .sedi-share-text, .sedi-end-text { font-size: var(--type-caption); line-height: 1.6; color: var(--muted); }
  .sedi-state { font-size: var(--type-caption); line-height: 1.6; color: var(--muted); min-height: 1lh; }
  li[data-sedi-stage='closes'] .sedi-state, li[data-sedi-stage='after'] .sedi-state { color: var(--warn); }
  li[data-sedi-stage='closes'] .sedi-end-text, li[data-sedi-stage='after'] .sedi-end-text { color: var(--warn); }
  li[data-sedi-longest] .sedi-share-text { color: var(--ink); font-weight: 600; }
  .sedi-boundary { position: absolute; left: calc(1 / var(--scale) * 100%); top: -5px; bottom: -5px; border-left: 2px solid var(--warn); transition: left var(--dur-signal) var(--ease-out); pointer-events: none; }
  .sedi-boundary > span { display: none; position: absolute; right: 8px; top: -30px; white-space: nowrap; font-size: var(--type-caption); line-height: 1.6; color: var(--warn); }
  li[data-sedi-mark] .sedi-boundary { top: -32px; }
  li[data-sedi-mark] .sedi-boundary > span { display: block; top: -4px; }
  ol[data-sedi-chain] { margin-top: var(--space-7); }
  ol[data-sedi-chain] summary { padding-top: var(--space-5); }
  @media (min-width: 1101px) {
    summary { min-height: 288px; }
    ol[data-sedi-chain] summary { min-height: 408px; }
    [data-disclosure-body] { width: 400%; }
    li:nth-child(2) [data-disclosure-body] { margin-left: -100%; }
    li:nth-child(3) [data-disclosure-body] { margin-left: -200%; }
    li:nth-child(4) [data-disclosure-body] { margin-left: -300%; }
    dl { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; padding: var(--space-5) 0 var(--space-5); border-top: 1px solid var(--hair-strong); border-bottom: 1px solid var(--hair-strong); background: var(--paper); position: relative; }
    dl > div { padding-right: var(--space-7); }
    dd { font-size: var(--type-body); color: var(--ink); }
  }
  @media (max-width: 1100px) {
    ol { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-4); }
    li:nth-child(2n) .sedi-toggle { right: 0; }
  }
  @media (max-width: 1100px) {
    .sedi-carry-body { grid-template-columns: 1fr; }
    .sedi-carry-line { min-height: 4lh; }

  }
  @media (max-width: 560px) {
  }
  /* Below the wide layout the stage's own line says where the window closes; the mark stays on the bar. */
  @media (max-width: 1100px) {
    li[data-sedi-mark] .sedi-boundary { top: -5px; }
    li[data-sedi-mark] .sedi-boundary > span { display: none; }
    .sedi-pick { min-width: 0; flex: 1 1 220px; }
    .sedi-carry-k { flex: 1 1 100%; }
  }
  @media (max-width: 560px) {
    ol[data-sedi-chain] { margin-top: var(--space-5); }
    ol { grid-template-columns: 1fr; row-gap: 0; }
    li { border-top: 0; border-left: 1px solid var(--hair-strong); padding-left: var(--space-4); }
    li:has(details[open]) ~ li { border-left-style: dashed; }
    .sedi-toggle { right: 0; }
    li::before { left: -2px; right: auto; top: 0; bottom: 0; width: 3px; height: auto; transform: scaleY(0); transform-origin: center top; }
    li:not(:last-child)::after { right: auto; left: -5px; top: auto; bottom: 6px; transform: rotate(135deg); }
    .sedi-question { display: none; }
    details[open] .sedi-question { display: block; }
    li + li .sedi-needs::before { content: '↑ '; content: '↑ ' / ''; }
    li:has(details[open]:not([data-disclosure-state='closed']))::before { transform: scaleY(1); }
    .sedi-node { left: calc(-1 * var(--space-4) - 7px); top: calc(var(--space-4) + 6px); }
    summary { padding: var(--space-4) 32px var(--space-3) 0; gap: var(--space-1); }
    .sedi-toggle { top: calc(var(--space-4) + 6px); }
    dl { padding-bottom: var(--space-4); }
  }
</style>

<script>
  import { PRESETS, CUSTOM_TEXT, evaluate, describe } from '../lib/window-model';
  import { scenarioChain, chainTotals, totalsText } from '../lib/scenario-chain';

  // The chain follows the dial, and can set it. The dial announces each
  // settled scenario; this redraws durations, elapsed time, states and the
  // boundary from the same model. Choosing a scenario here asks the dial to
  // take it, so there is one scenario on the page and the dial owns it. The
  // dial's own live sentence carries the outcome to a screen reader, so
  // nothing here is announced a second time.
  interface Scenario { key: string; label: string; durations: number[]; window: number }
  const set = (el: Element | null, value: string) => { if (el && el.textContent !== value) el.textContent = value; };

  // On a narrow screen the secondary figures and the key wait behind their
  // button; on a wide one they are simply shown and the button is absent.
  // Decided on load and again if the width class changes, never while the
  // reader is using it.
  const narrow = matchMedia('(max-width: 1100px)');
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-sedi-more-toggle]')];
  const show = (toggle: HTMLButtonElement, open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    document.getElementById(toggle.getAttribute('aria-controls')!)!.hidden = !open;
  };
  const fold = () => toggles.forEach((toggle) => { toggle.hidden = !narrow.matches; show(toggle, !narrow.matches); });
  toggles.forEach((toggle) => toggle.addEventListener('click', () => show(toggle, toggle.getAttribute('aria-expanded') !== 'true')));
  fold();
  narrow.addEventListener('change', fold);

  document.querySelectorAll<HTMLSelectElement>('[data-sedi-preset]').forEach((select) => {
    select.addEventListener('change', () => document.dispatchEvent(new CustomEvent('intervene:scenario-set', { detail: { key: select.value } })));
  });

  document.addEventListener('intervene:scenario', (event) => {
    const { key, label, durations, window } = (event as CustomEvent<Scenario>).detail;
    const chain = scenarioChain(durations, window);
    const totals = chainTotals(durations, window);
    const text = totalsText(totals);
    const result = evaluate(durations, window);
    const closes = chain.findIndex((c) => c.state === 'closes');
    document.querySelectorAll<HTMLElement>('[data-sedi-chain]').forEach((list) => {
      const root = list.closest('.sedi-explorer')!;
      set(root.querySelector('[data-sedi-label]'), `${label}.`);
      set(root.querySelector('[data-sedi-text]'), PRESETS.find((p) => p.key === key)?.text ?? CUSTOM_TEXT);
      set(root.querySelector('[data-sedi-out]'), describe(result));
      set(root.querySelector('[data-sedi-total]'), text.total);
      set(root.querySelector('[data-sedi-remaining]'), text.remaining);
      set(root.querySelector('[data-sedi-beyond]'), text.beyond);
      const select = root.querySelector<HTMLSelectElement>('[data-sedi-preset]');
      if (select) {
        select.querySelector<HTMLOptionElement>('option[value="custom"]')!.hidden = key !== 'custom';
        if (select.value !== key) select.value = key;
      }
      list.querySelectorAll<HTMLElement>(':scope > li').forEach((item, i) => {
        const stage = chain[i];
        item.dataset.sediStage = stage.state;
        item.toggleAttribute('data-sedi-longest', stage.longest);
        item.toggleAttribute('data-sedi-mark', i === (closes === -1 ? chain.length - 1 : closes));
        item.style.setProperty('--start', String(stage.start));
        item.style.setProperty('--end', String(stage.end));
        item.style.setProperty('--scale', String(totals.scale));
        item.style.setProperty('--cut', String(stage.boundary ?? (stage.state === 'after' ? 0 : 1)));
        set(item.querySelector('[data-sedi-pct]'), stage.percent);
        set(item.querySelector('[data-sedi-end]'), stage.endPercent);
        set(item.querySelector('[data-sedi-state]'), stage.text);
      });
    });
  });
</script>
