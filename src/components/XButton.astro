---
interface Props {
  href: string;
  label: string;
  size?: 'sm' | 'md';
}

const { href, label, size = 'sm' } = Astro.props;
const ariaLabel = `${label} (opens in new tab)`;
---

<a
  class:list={['x-button', 'btn-ghost', size]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  title={label}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.64 7.584H.47l8.6-9.835L0 1.154h7.594l5.243 6.932 6.064-6.933Zm-1.29 19.49h2.039L6.487 3.24H4.3l13.31 17.403Z" />
  </svg>
</a>

<style>
  .x-button { padding: 0; color: var(--accent-text); }

  .x-button.sm {
    width: 44px;
    height: 44px;
  }

  .x-button.md {
    width: 48px;
    height: 48px;
  }

  .x-button svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

</style>
