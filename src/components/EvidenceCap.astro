---
const grades = [
  { label: 'Assumed',       weight: 1 },
  { label: 'Policy',        weight: 2 },
  { label: 'Drill',         weight: 3 },
  { label: 'Production',    weight: 4 },
  { label: 'Stress-tested', weight: 5 },
];
const MAX = 5;
---

<figure class="ev-cap" data-reveal="scene" aria-label="Evidence-confidence ladder. Policy evidence carries less confidence than operational or stress evidence.">
  <div class="chart">
    <div class="scale" aria-hidden="true">
      {[1, 2, 3, 4, 5].map((n) => (
        <span class="tick" style={`left: ${(n / MAX) * 100}%`}>{n}</span>
      ))}
    </div>

    <div class="rows">
      <div class="gridlines" aria-hidden="true">
        {[1, 2, 3, 4, 5].map((n) => (
          <span class="gridline" style={`left: ${(n / MAX) * 100}%`}></span>
        ))}
      </div>

      {grades.map((g, i) => (
        <div class="row" style={`--w: ${(g.weight / MAX) * 100}%; --delay: ${i * 90}ms`}>
          <span class="grade-label">{g.label}</span>
          <span class="track">
            <span class="bar"></span>
          </span>
          <span class="cap-text">confidence {g.weight} / {MAX}</span>
        </div>
      ))}
    </div>
  </div>
  <figcaption>Policy alone cannot carry a high-confidence intervention verdict. Green requires evidence the control has worked under real pressure.</figcaption>
</figure>

<style>
  .ev-cap { margin: var(--gap-intro) 0 0; padding: 0; }

  .chart {
    --left-col: 180px;
    --right-col: 120px;
    --gutter: 24px;
  }

  /* Scale row */
  .scale {
    position: relative;
    height: 28px;
    margin-left: calc(var(--left-col) + var(--gutter));
    margin-right: calc(var(--right-col) + var(--gutter));
    border-bottom: 1px solid var(--hair-strong);
  }
  .tick {
    position: absolute;
    bottom: 6px;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  /* Bar rows */
  .rows {
    position: relative;
    padding-top: 8px;
  }

  /* Vertical gridlines, anchored to the track column. */
  .gridlines {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--left-col) + var(--gutter));
    right: calc(var(--right-col) + var(--gutter));
    pointer-events: none;
    z-index: 0;
  }
  .gridline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--hair-soft);
    transform: translateX(-1px);
  }

  .row {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: var(--left-col) 1fr var(--right-col);
    gap: var(--gutter);
    align-items: center;
    padding: 16px 0;
  }
  .grade-label {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }
  .track {
    position: relative;
    display: block;
    height: 22px;
    background: transparent;
  }
  .bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    background: var(--accent);
  }
  /* Draw once when motion is on: bars grow to their weight in order. */
  html[data-motion] .bar {
    width: 0;
    transition: width var(--dur-draw) var(--ease-draw);
    transition-delay: var(--delay);
  }
  html[data-motion] .ev-cap.in .bar { width: var(--w); }

  .cap-text {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    text-align: right;
    letter-spacing: 0.04em;
  }
  html[data-motion] .cap-text {
    opacity: 0;
    transition: opacity var(--dur-reveal) var(--ease-out);
    transition-delay: calc(var(--delay) + 400ms);
  }
  html[data-motion] .ev-cap.in .cap-text { opacity: 1; }

  figcaption {
    margin-top: var(--space-5);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--muted);
    max-width: 60ch;
  }

  @media (max-width: 720px) {
    .chart { --left-col: 120px; --right-col: 0px; --gutter: 16px; }
    .scale { margin-right: 0; height: 22px; }
    .row {
      grid-template-columns: var(--left-col) 1fr;
      gap: var(--gutter);
      padding: 12px 0;
    }
    .gridlines { right: 0; }
    .cap-text { display: none; }
    .grade-label { font-size: 14px; }
    .track { height: 18px; }
  }
</style>
