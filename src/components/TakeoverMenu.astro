---
import { markAgda } from '../lib/marks';
import Logo from './Logo.astro';
import MenuIcon from './MenuIcon.astro';

const base = import.meta.env.BASE_URL;
const items = [
  { label: 'Intervention Readiness', href: `${base}intervention-readiness/` },
  { label: 'Why it matters',         href: `${base}about/` },
  { label: 'AGDA®',                  href: `${base}agda/` },
  { label: 'How AGDA® works',        href: `${base}methodology/` },
  { label: 'View sample verdict',    href: `${base}sample-report/` },
  { label: 'Assessment options',     href: `${base}services/` },
  { label: 'Discuss your system',    href: `${base}contact/` },
];

const norm = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const here = norm(Astro.url.pathname);
const home = norm(base);
const isCurrent = (href: string) => {
  const h = norm(href);
  if (h === home) return here === home;
  return here === h || here.startsWith(h);
};
---

<div
  class="takeover"
  id="takeover-menu"
  role="dialog"
  aria-modal="true"
  aria-labelledby="takeover-heading"
  aria-hidden="true"
  hidden
  data-takeover
>
  <div class="takeover-header">
    <div class="wrap takeover-top">
      <Logo size="md" href="/" />
      <button type="button" class="takeover-close" aria-label="Close menu" aria-expanded="true" aria-controls="takeover-menu" data-menu-close>
        <MenuIcon />
      </button>
    </div>
  </div>
  <nav class="takeover-body wrap" aria-labelledby="takeover-heading">
    <h2 id="takeover-heading" class="sr-only">Primary navigation</h2>
    <ul role="list">
      {items.map((item, i) => (
        <li style={`--i: ${i}`}>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} set:html={markAgda(item.label)}></a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  const FOCUSABLE = 'a[href],button:not([disabled]),[tabindex]:not([tabindex="-1"])';

  class Takeover {
    private el: HTMLElement;
    private trigger: HTMLButtonElement | null = null;
    private lastFocused: HTMLElement | null = null;
    private isOpen = false;
    private inerted: HTMLElement[] = [];
    private previousOverflow = '';
    private closeTimer: number | undefined;

    constructor(el: HTMLElement) {
      this.el = el;
      document.querySelectorAll<HTMLButtonElement>('[data-menu-trigger]').forEach((t) => {
        t.addEventListener('click', () => this.open(t));
      });
      el.querySelector<HTMLButtonElement>('[data-menu-close]')?.addEventListener('click', () => this.close());
      el.addEventListener('keydown', (e) => this.onKey(e));
      el.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        a.addEventListener('click', () => this.close());
      });
    }

    private open(trigger: HTMLButtonElement) {
      if (this.isOpen) return;
      window.clearTimeout(this.closeTimer);
      this.isOpen = true;
      this.trigger = trigger;
      this.lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : trigger;
      this.previousOverflow = document.body.style.overflow;
      this.el.hidden = false;
      this.el.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      document.querySelector('[data-site-header]')?.setAttribute('data-takeover-open', '');

      // Restore only the elements this dialog made inert. Existing inert
      // states belong to their own controls and must survive closing.
      this.inerted = Array.from(document.body.children).filter(
        (c): c is HTMLElement => c instanceof HTMLElement && c !== this.el && !c.inert,
      );
      this.inerted.forEach((c) => { c.inert = true; });
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        if (!this.isOpen) return;
        this.el.classList.add('open');
        this.el.querySelector<HTMLAnchorElement>('.takeover-body a[href]')?.focus();
      });
    }

    private close() {
      if (!this.isOpen) return;
      this.isOpen = false;
      this.el.classList.remove('open');
      this.trigger?.setAttribute('aria-expanded', 'false');
      document.querySelector('[data-site-header]')?.removeAttribute('data-takeover-open');
      this.inerted.forEach((c) => { c.inert = false; });
      this.inerted = [];
      document.body.style.overflow = this.previousOverflow;
      this.lastFocused?.focus({ preventScroll: true });
      this.el.setAttribute('aria-hidden', 'true');

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.closeTimer = window.setTimeout(() => {
        if (!this.isOpen) this.el.hidden = true;
      }, reduce ? 80 : 320);
    }

    private onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        e.preventDefault();
        this.close();
        return;
      }
      if (e.key !== 'Tab') return;
      const items = Array.from(this.el.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (n) => n.offsetParent !== null,
      );
      if (!items.length) return;
      // Cycle every step inside the dialog. Safari's default Tab mode
      // skips buttons and links, so guarding only the endpoints can
      // strand focus on the inert document behind the menu.
      e.preventDefault();
      const index = items.indexOf(document.activeElement as HTMLElement);
      const next = index < 0 ? 0 : (index + (e.shiftKey ? -1 : 1) + items.length) % items.length;
      items[next].focus();
    }
  }

  const el = document.querySelector<HTMLElement>('[data-takeover]');
  if (el) new Takeover(el);
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  .takeover {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1300;
    background: var(--paper);
    color: var(--ink);
    opacity: 0;
    transition: opacity 320ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }
  .takeover.open {
    opacity: 1;
    pointer-events: auto;
  }
  .takeover[hidden] { display: none; }

  .takeover-header {
    flex: none;
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--paper);
    border-bottom: 1px solid var(--hair);
  }
  .takeover-top {
    width: 100%;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    padding-top: 18px;
    padding-bottom: 18px;
  }
  .takeover-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    color: var(--ink);
  }
  .takeover-close:hover { color: var(--accent); }
  .takeover-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .takeover-body {
    width: 100%;
    flex: 1;
    display: flex;
    align-items: safe center;
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .takeover-body ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .takeover-body a {
    position: relative;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(28px, 4vw, 56px);
    letter-spacing: var(--tracking-heading); text-transform: none;
    line-height: 1.15;
    color: var(--ink);
    display: block;
    white-space: normal;
    padding: 8px 0;
    min-height: 48px;
    transition:
      color 200ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 360ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 360ms cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    transform: translateY(12px);
    transition-delay: calc(80ms + var(--i) * 50ms);
  }
  .takeover.open .takeover-body a {
    opacity: 1;
    transform: none;
  }
  .takeover-body a:hover,
  .takeover-body a:focus-visible { color: var(--accent); }
  /* Focus is the ring as well as the colour, never the colour alone. */
  .takeover-body a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  /* Active route: a bronze rule without shifting the link text. */
  .takeover-body a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -32px;
    top: 50%;
    width: 16px;
    height: 2px;
    background: var(--accent);
  }
  @media (max-width: 720px) {
    .takeover-body { padding-top: var(--space-4); padding-bottom: var(--space-5); }
    .takeover-body a {
      font-size: clamp(23px, 5.7vw, 30px);
    }
    .takeover-body a[aria-current='page']::before {
      left: -16px;
      width: 8px;
    }
  }

  @media (max-height: 760px) and (min-width: 721px) {
    .takeover-body { padding-top: var(--space-4); padding-bottom: var(--space-4); }
    .takeover-body a { font-size: clamp(28px, 3vw, 40px); }
  }
  @media (max-height: 620px) and (min-width: 721px) {
    .takeover-body { padding-top: var(--space-3); padding-bottom: var(--space-3); }
    .takeover-body a { font-size: 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .takeover-body a { transition-delay: 0ms; transform: none; }
  }
</style>
