---
/** Approved artwork only. Use Agda.astro for mentions in copy. */
interface Props { variant?: 'logo' | 'lockup' | 'small'; }
const { variant = 'logo' } = Astro.props;
const assets = {
  logo: { light: 'agda-primary.svg', file: 'agda-reverse.svg', width: 224, height: 50, alt: 'AGDA®' },
  lockup: { light: 'agda-by-intervene-stacked-ink.svg', file: 'agda-by-intervene-stacked-white.svg', width: 280, height: 92, alt: 'AGDA® by Intervene' },
  small: { light: 'agda-small-black.svg', file: 'agda-small-white.svg', width: 80, height: 20, alt: 'AGDA®' },
};
const asset = assets[variant];
---
{(['light', 'dark'] as const).map((theme) => (
  <picture class={`brand-${theme}`}>
    {variant === 'lockup' && <source media="(max-width: 360px)" srcset={`/assets/brand/${theme === 'light' ? 'agda-primary.svg' : 'agda-reverse.svg'}`} width="224" height="50" />}
    <img class:list={['agda-logo', variant]} src={`/assets/brand/${theme === 'light' ? asset.light : asset.file}`} width={asset.width} height={asset.height} alt={asset.alt} />
  </picture>
))}
<style>
  .agda-logo { display: block; height: auto; flex: none; }
  .logo { width: 224px; }
  .lockup { width: 280px; }
  .small { width: 80px; }

  /* Use the approved full wordmark where the 280px lockup cannot fit. */
  @media (max-width: 360px) { .lockup { width: 224px; } }
</style>
