---
/**
 * "Where should we begin?" Three questions about one named system, drawn in
 * the methodology page's SEDI language: a rail, numbered nodes, bold labels.
 * Each route includes the one before it and none is a prerequisite for a
 * later one; choosing one confirms
 * nothing about availability or acceptance. Content reads from
 * src/lib/offers.ts so the diagram cannot drift from the offer sheets.
 *
 * `editorial` presents the same routes as aligned homepage columns.
 *
 * `compact` keeps only the distinguishing question, "appropriate when"
 * and a link to each sheet (used above the full sheets on /services/,
 * which carry scope, outputs, boundaries and prices).
 */
import { check, review, assessment } from '../lib/offers';
import { markAgda } from '../lib/marks';
import Agda from './Agda.astro';

interface Props { compact?: boolean; headingLevel?: 'h2' | 'h3'; editorial?: boolean }
const { compact = false, headingLevel = 'h3', editorial = false } = Astro.props;

const routes = [
  {
    o: check,
    n: 'A',
    kicker: 'Entry point',
    whenShort: 'You need a bounded answer on whether anyone can stop one named system.',
    when: 'You need a bounded answer on whether anyone can stop one named system, before examining the evidence behind each step of its intervention chain.',
    output: 'A one-page finding on authority, reachability and the halt mechanism, with the gaps found.',
    receive: ['One-page finding', 'The gaps found', 'The live call-out, stated as one test at one time'],
    boundary: 'Not an AGDA® verdict, SEDI result or score, and no attestation. Prepared without independent review. A finding about this system only.',
    href: '/services/#check',
  },
  {
    o: review,
    n: 'B',
    kicker: 'Preliminary',
    whenShort: 'You need to know what you could evidence for one system, and whether a full assessment is warranted.',
    when: 'You need to know what you could evidence for this one system, step by step, and the evidence position needs clarifying before a full assessment is scoped.',
    output: 'The Authority Check finding, a gap register across the four steps and a recommendation on whether a full assessment is warranted.',
    receive: ['The Authority Check finding', 'Gap register: evidence graded for each step', 'Recommendation on a full assessment'],
    boundary: 'The Review does not include the AGDA® verdict, the window set from your records or signed SEDI result records.',
    href: '/services/#review',
  },
  {
    o: assessment,
    n: 'C',
    kicker: 'Full assessment',
    whenShort: 'The system, pathway and scenario are defined, and relevant evidence access is available.',
    when: 'The named system, pathway and scenario are defined and relevant evidence access is available.',
    output: 'The full assessment package: an Intervention Readiness verdict with its basis and limitations, and what has to change before the organisation relies on the pathway.',
    receive: ['Window set from your records; evidence register', 'Best and worst-case timings and a 25% sensitivity test', 'Verdict, confidence basis, limitations, weak link', 'Remediation priorities and a board report'],
    boundary: 'One system, one pathway, one scenario. Connected systems are scoped separately.',
    href: '/services/#assessment',
  },
];
const H = headingLevel;
const RouteHeading = editorial ? 'h3' : 'span';
---

<figure class:list={["offer-choice", { "offer-choice--editorial": editorial, "offer-choice--compact": compact }]} data-reveal="scene" aria-labelledby="offer-choice-heading">
  <figcaption class="oc-caption" data-offer-view="offer_choice">
    <span class="label section-kicker">Where should we begin?</span>
    <H class="h2" id="offer-choice-heading">Three questions.{!editorial && <em> One named system. Neither is a prerequisite for the other.</em>}</H>
    {editorial && <p class="oc-principle">One named system. Each engagement includes the one before it, and none is a prerequisite.</p>}
    <p class="body muted oc-lede">Choose by the intervention question and available evidence.</p>
  </figcaption>

  <div class="oc-root" aria-hidden="true">
    <span class="node oc-node"></span>
    <span class="oc-stem"></span>
  </div>

  <ol class="oc-routes" role="list">
    {routes.map(({ o, n, kicker, when, whenShort, output, receive, boundary, href }) => (
      <li class="oc-route">
        <span class="oc-branch" aria-hidden="true"></span>
        <div class="oc-head">
          <span class="node oc-node" aria-hidden="true"></span>
          <span class="mono oc-n">Route {n} · {kicker}</span>
          <RouteHeading class="oc-name" set:html={markAgda(o.name)} />
          <span class="oc-q">{o.question}</span>
        </div>
        <dl class="oc-fields">
          <div>
            <dt>Appropriate when</dt>
            <dd>{editorial ? whenShort : when}</dd>
          </div>
          {editorial && !compact && <div><dt>Question and decision</dt><dd set:html={markAgda(o.decision)} /></div>}
          {editorial && !compact && <div><dt>Evidence examined</dt><dd>{o.examined}</dd></div>}
          {!compact && (
            <div>
              <dt>What you receive</dt>
              <dd>
                {!editorial && <span set:html={markAgda(output)} />}
                <ul class="oc-list" role="list">
                  {receive.map((r) => <li set:html={markAgda(r)} />)}
                </ul>
              </dd>
            </div>
          )}
          {!compact && (
            <div>
              <dt>Boundary</dt>
              <dd set:html={markAgda(boundary)} />
            </div>
          )}
          {!compact && (
            <div>
              <dt>{o.priceNote}</dt>
              <dd class="oc-price">{o.price}</dd>
            </div>
          )}
        </dl>
        <a href={href} class="link oc-link" data-offer-select={o.slug}>
          {editorial ? `Explore the ${o.slug === 'check' ? 'Authority Check' : o.slug === 'review' ? 'Review' : 'Assessment'}` : `${o.slug === 'check' ? 'Authority Check' : o.slug === 'review' ? 'Review' : 'Assessment'} sheet: scope, outputs, boundary and indicative fee`} <span aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>

  <p class="body muted oc-foot">
    The Authority Check is not an <Agda /> verdict. A Review may recommend a
    full Assessment but does not commit you to one or determine its verdict.
    {compact
      ? 'Scope, availability and delivery arrangements are confirmed before an engagement is accepted.'
      : ''}
  </p>
</figure>

<style>
  .offer-choice { margin: 0; }
  .oc-caption .h2 { margin-top: 12px; }
  .oc-lede { margin: var(--gap-head) 0 0; }

  /* Root node and stem, then two branches: the rail language from the
     methodology page, turned into a fork. */
  .oc-root { position: relative; height: 56px; margin-top: var(--gap-intro); display: grid; justify-items: center; }
  .oc-root .oc-node { position: relative; z-index: 1; }
  .oc-stem { position: absolute; top: 13px; bottom: 0; left: 50%; width: 1px; background: var(--hair-strong); }
  .oc-routes {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(32px, 5vw, 72px);
    position: relative;
  }
  /* Horizontal bar joining the two branch tops. */
  .oc-routes::before {
    content: ''; position: absolute; top: 0; left: 16.67%; right: 16.67%; height: 1px; background: var(--hair-strong);
  }
  .oc-route { position: relative; padding-top: 40px; display: grid; gap: 20px; align-content: start; min-width: 0; }
  .oc-branch { position: absolute; top: 0; left: 50%; width: 1px; height: 40px; background: var(--hair-strong); }
  .oc-head { display: grid; justify-items: center; gap: 12px; text-align: center; }
  .oc-head .oc-node { margin-top: -7px; }
  .oc-n { font-size: var(--type-caption); letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-text); }
  .oc-name { margin: 0; font-family: var(--font-sans); font-size: var(--type-h3); font-weight: 600; color: var(--ink); letter-spacing: var(--tracking-heading); text-transform: none; }

  .oc-q { font-family: var(--font-sans); font-size: var(--type-small); line-height: 1.5; color: var(--muted); }
  .oc-fields { margin: 8px 0 0; display: grid; gap: 0; border-top: 1px solid var(--hair-strong); }
  .oc-fields > div { display: grid; gap: 6px; padding: var(--space-3) 0; border-bottom: 1px solid var(--hair); }
  .oc-fields dt { font-family: var(--font-mono); font-size: var(--type-caption); letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  .oc-fields dd { margin: 0; font-family: var(--font-sans); font-size: var(--type-small); line-height: 1.6; color: var(--ink); }
  .oc-fields dd.oc-price { font-family: var(--font-mono); font-size: 20px; font-weight: 400; letter-spacing: 0; }
  .oc-list { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 6px; }
  .oc-list > li { position: relative; padding-left: 18px; color: var(--muted); font-size: var(--type-small); }
  .oc-list > li::before { content: ''; position: absolute; left: 0; top: 11px; width: 8px; height: 1px; background: var(--accent); }
  .oc-link { display: inline-block; font-size: var(--type-small); }
  .oc-foot { margin: var(--gap-intro) 0 0; }

  /* Homepage: two parallel editorial columns. The full offer sheets
     retain their existing diagram and share the same commercial data. */
  .offer-choice--editorial .oc-caption { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-4) var(--space-6); }
  .offer-choice--editorial .oc-caption .label { grid-row: 1 / span 3; margin-top: 10px; align-self: start; }
  .offer-choice--editorial .oc-caption .h2 { font-size: var(--type-h2); line-height: 1.2; letter-spacing: var(--tracking-heading); text-transform: none; max-width: none; margin: 0; }
  .oc-principle { font-size: 20px; line-height: 1.5; color: var(--ink); margin: 0; }
  .offer-choice--editorial .oc-lede { font-size: var(--type-body); line-height: 1.7; margin: 0; }
  .offer-choice--editorial .oc-root, .offer-choice--editorial .oc-branch,
  .offer-choice--editorial .oc-node, .offer-choice--editorial .oc-routes::before { display: none; }
  .offer-choice--editorial .oc-q { font-size: var(--type-body); color: var(--ink); }
  .offer-choice--editorial .oc-routes { margin-top: var(--space-6); gap: 0 var(--space-5); grid-template-rows: repeat(8, auto); }
  .offer-choice--editorial .oc-route { border-top: 1px solid var(--hair-strong); padding-top: 24px; grid-row: span 8; grid-template-rows: subgrid; gap: 0; }
  .offer-choice--editorial .oc-head { justify-items: start; text-align: left; gap: 16px; padding-bottom: 28px; align-content: start; }
  .offer-choice--editorial .oc-n { font-size: var(--type-caption); letter-spacing: 0; text-transform: none; }
  .offer-choice--editorial .oc-name { font-size: var(--type-h3); line-height: 1.3; letter-spacing: var(--tracking-heading); text-transform: none; }
  .offer-choice--editorial .oc-fields { display: grid; grid-row: span 6; grid-template-rows: subgrid; margin: 0; border-top: 0; }
  .offer-choice--editorial .oc-fields > div { gap: 12px; padding: var(--space-4) 0; align-content: start; }
  .offer-choice--editorial .oc-fields dt { font-size: var(--type-caption); letter-spacing: 0; text-transform: none; color: var(--faint); }
  .offer-choice--editorial .oc-fields dd { font-size: var(--type-body); line-height: 1.7; }
  .offer-choice--editorial .oc-fields > div:nth-child(3) dd { font-size: 16px; color: var(--muted); }
  .offer-choice--editorial .oc-fields dd.oc-price { font-size: clamp(18px, 1.8vw, 24px); line-height: 1.5; }
  .offer-choice--editorial .oc-list { margin: 0; gap: 10px; }
  .offer-choice--editorial .oc-list > li { font-size: var(--type-body); line-height: 1.65; }
  .offer-choice--editorial .oc-link { font-size: 16px; padding: 12px 0; justify-self: start; margin-top: 16px; }
  .offer-choice--editorial .oc-foot { margin-top: 32px; font-size: 16px; line-height: 1.7; }
  .offer-choice--compact .oc-routes { grid-template-rows: repeat(3, auto); }
  .offer-choice--compact .oc-route { grid-row: span 3; }
  .offer-choice--compact .oc-fields { grid-row: span 1; }
  @media (max-width: 880px) {
    .offer-choice--editorial .oc-caption { grid-template-columns: 1fr; gap: 20px; }
    .offer-choice--editorial .oc-caption .label { grid-row: auto; margin-top: 0; }
    .offer-choice--editorial .oc-routes { gap: 0 32px; }
  }
  @media (max-width: 1080px) {
    .offer-choice--editorial .oc-routes, .offer-choice--compact .oc-routes { grid-template-rows: none; gap: 40px; margin-top: 32px; }
    .offer-choice--editorial .oc-route, .offer-choice--compact .oc-route { grid-row: auto; grid-template-rows: none; }
    .offer-choice--editorial .oc-head { grid-template-columns: 1fr; padding-bottom: 8px; }
    .offer-choice--editorial .oc-head .oc-n, .offer-choice--editorial .oc-head .oc-name { grid-column: 1; }
    .offer-choice--editorial .oc-fields, .offer-choice--compact .oc-fields { grid-row: auto; grid-template-rows: none; }
    .offer-choice--editorial .oc-fields > div { padding: 20px 0; }
    .offer-choice--editorial .oc-fields dd, .offer-choice--editorial .oc-list > li { font-size: 16px; }
  }

  @media (max-width: 1080px) {
    .oc-root { display: none; }
    .oc-routes { grid-template-columns: 1fr; gap: var(--space-6); }
    .oc-routes::before { display: none; }
    .oc-route { padding-top: 0; }
    .oc-branch { display: none; }
    .oc-head { justify-items: start; text-align: left; grid-template-columns: 13px 1fr; column-gap: 14px; align-items: center; }
    .oc-head .oc-node { margin-top: 0; grid-row: 1 / span 2; }
    .oc-head .oc-n { grid-column: 2; }
    .oc-head .oc-name { grid-column: 2; }
  }
</style>
