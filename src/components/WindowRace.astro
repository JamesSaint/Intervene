---
/**
 * The intervention scene: a response racing a closing window.
 *
 * Two bars share one time axis. The window is lit while it is open and goes
 * dark behind the present moment. The response is four stages, each drawn
 * as it runs. Where the window closes, the region beyond is irreversible and
 * the response simply carries on into it. The time model is stated in
 * src/lib/race-geometry.ts and the outcome is decided only by
 * src/lib/window-model.ts; this component draws what they return.
 *
 * Illustrative: relative units, not the AGDA® engine, and its outcome words
 * are not the verdict states. The note saying so is always visible.
 *
 * The telling (stage, bars, outcome) is kept apart from the diagnostics
 * (stage timings, window test), which sit in a drawer beneath it. The first
 * paint is the finished default scenario, rendered here, so the scene reads
 * without JavaScript and with motion off.
 */
import {
  STAGES, STAGE_MIN, STAGE_MAX, WINDOWS, PRESETS, DEFAULT_PRESET,
  OUTCOME_LABEL, evaluate, describe,
} from '../lib/window-model';
import { segments, boundary, now, endsBeyond, progress, percent } from '../lib/race-geometry';

interface Props { id?: string }
const { id = 'window-race' } = Astro.props;

const preset = PRESETS.find((p) => p.key === DEFAULT_PRESET)!;
const window = WINDOWS.set;
const result = evaluate(preset.durations, window);
const segs = segments(preset.durations, window);
const late = endsBeyond(preset.durations, window);
const meter = progress(preset.durations, window);
const windows = [
  { key: 'shorter', label: '25% shorter' },
  { key: 'set', label: 'As set' },
  { key: 'longer', label: '25% longer' },
];
/** Below this share of the axis a stage is too narrow to hold its own name. */
const THIN = 0.1;
---
<div
  class="window-race"
  id={id}
  data-window-race
  data-outcome={result.outcome}
  data-window="set"
  data-closed={result.outcome === 'too-late' ? '' : undefined}
  style={`--wr-p:${now(preset.durations, window)};--wr-w:${boundary(preset.durations, window)}`}
>
  <div class="wrap wr-wrap">
    <div class="wr-top">
      <label class="wr-select">
        <span>Illustrative scenario</span>
        <select data-wr-preset aria-describedby={`${id}-note`}>
          {PRESETS.map((p) => <option value={p.key} selected={p.key === preset.key}>{p.label}</option>)}
          <option value="custom" hidden>Your own timings</option>
        </select>
      </label>
      <div class="wr-playback">
        <button class="wr-btn" type="button" data-wr-toggle hidden>Pause</button>
        <button class="wr-btn wr-btn-primary" type="button" data-wr-replay hidden><span class="wr-play" aria-hidden="true"></span>Replay</button>
      </div>
    </div>

    <p class="wr-premise">A response has four stages. It has to finish before the window closes.</p>

    <div class="wr-telling" aria-hidden="true">
      <p class="wr-word"><span class="wr-dot"></span><span data-wr-word>{OUTCOME_LABEL[result.outcome]}</span></p>
      <p class="wr-caption" data-wr-caption>{describe(result)}</p>
    </div>

    <figure class="wr-figure" role="img" aria-labelledby={`${id}-result`} aria-describedby={`${id}-note`}>
      <div class="wr-bars" aria-hidden="true">
        <div class="wr-row">
          <span class="wr-row-label">Time available</span>
          <div class="wr-track" data-wr-track="window">
            <span class="wr-mark wr-mark-start">Signal</span>
            <span class="wr-mark wr-mark-close">Window closes</span>
            <div class="wr-window"><span class="wr-window-label" data-wr-window-label>{meter.remaining > 0 ? 'Window open' : 'Window used up'}</span></div>
            <div class="wr-after"><span>Too late to prevent harm</span></div>
          </div>
        </div>
        <div class="wr-row">
          <span class="wr-row-label">Time taken</span>
          <div class="wr-track" data-wr-track="response">
            <div class="wr-after"></div>
            {STAGES.map((stage, i) => (
              <div
                class:list={['wr-seg', { 'is-thin': segs[i].length < THIN }]}
                data-wr-seg={i}
                data-state="completed"
                data-late={late[i] ? '' : undefined}
                style={`--wr-s:${segs[i].start};--wr-d:${segs[i].length};--wr-in:${segs[i].inside}`}
              >
                <span class="wr-ghost">{stage}</span>
                <span class="wr-fill"><span>{stage}</span></span>
              </div>
            ))}
          </div>
        </div>
        <div class="wr-now"><span>Now</span></div>
      </div>
    </figure>

    <div class="wr-foot">
      <dl class="wr-meter">
        <div><dt>Window consumed</dt><dd data-wr-consumed>{percent(meter.consumed)}</dd></div>
        <div><dt>Remaining</dt><dd data-wr-remaining>{percent(meter.remaining)}</dd></div>
        <div class="wr-beyond"><dt>Beyond the window</dt><dd data-wr-beyond>{percent(meter.beyond)}</dd></div>
      </dl>
      <p class="wr-note" id={`${id}-note`}>
        Illustrative model. Relative units, not measured durations, and not an
        assessment result. An assessment sets the window from your own records.
      </p>
    </div>
    <p class="wr-result" id={`${id}-result`} aria-live="polite">Illustrative scenario, <span data-wr-sr-scn>{preset.label}</span>: <span data-wr-label>{OUTCOME_LABEL[result.outcome]}</span>. <span data-wr-text>{describe(result)}</span></p>
  </div>

  <details class="wr-diag" data-wr-diag>
    <summary><span class="wrap wr-diag-summary"><span class="wr-diag-title">Open the diagnostic model</span><span class="wr-diag-hint">Stage timings and the window test</span></span></summary>
    <div class="wrap wr-diag-body">
      <div class="wr-sliders">
        {STAGES.map((stage, i) => (
          <label>
            <span>{stage}</span>
            <input type="range" min={STAGE_MIN} max={STAGE_MAX} step="1" value={preset.durations[i]} data-wr-range={i} aria-label={`${stage}: time taken`} aria-valuetext={`${preset.durations[i]} of ${STAGE_MAX}`} />
          </label>
        ))}
      </div>
      <fieldset class="wr-window-test">
        <legend>Test the window</legend>
        {windows.map((w) => (
          <label><input type="radio" name={`${id}-window`} value={w.key} checked={w.key === 'set'} /><span>{w.label}</span></label>
        ))}
      </fieldset>
    </div>
  </details>
</div>

<noscript><style is:inline>.wr-top, .wr-diag { display: none !important; } .wr-premise { margin: 0 !important; }</style></noscript>

<style>
  /* The scene sits on the page's own surface, in the page's own tokens.
     Ink carries the response; the warning colour marks only the part of it
     that falls after the window. */
  .window-race {
    --signal: var(--sedi-signal);
    --wr-label: 128px; --wr-gap: var(--space-4); --wr-bar: 56px;
    border-top: 1px solid var(--hair-strong); overflow: hidden;
  }
  .wr-wrap { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); padding-top: var(--space-3); padding-bottom: var(--space-4); }

  .wr-top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); visibility: hidden; }
  .window-race[data-ready] .wr-top { visibility: visible; }
  .wr-select { position: relative; display: block; }
  .wr-select > span { position: absolute; left: 0; top: 0; font-family: var(--font-mono); font-size: 12px; line-height: 1.4; color: var(--faint); pointer-events: none; }
  .wr-select select { appearance: none; -webkit-appearance: none; height: 48px; padding: 20px 28px 2px 0; border: 0; border-bottom: 1px solid var(--hair-strong); border-radius: 0; font: inherit; font-size: 16px; font-weight: 600; color: var(--ink); cursor: pointer;
    background: transparent linear-gradient(45deg, transparent 50%, var(--ink) 50%) no-repeat right 8px bottom 14px / 6px 6px; }
  .wr-select select:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .wr-playback { display: flex; gap: var(--space-2); }
  .wr-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 44px; min-width: 96px; padding: 0 var(--space-3); border: 1px solid var(--hair-strong); font-size: var(--type-action); font-weight: 600; letter-spacing: 0.02em; color: var(--ink); transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease); }
  /* Hidden when there is nothing to pause or motion is off, but still holding its place. */
  .wr-btn[hidden] { display: inline-flex; visibility: hidden; }
  .wr-btn:is(:hover, :focus-visible) { border-color: var(--ink); }
  .wr-btn-primary { border-color: var(--ink); }
  .wr-btn-primary:is(:hover, :focus-visible) { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .wr-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .wr-play { width: 0; height: 0; border-style: solid; border-width: 5px 0 5px 8px; border-color: transparent transparent transparent currentColor; }

  .wr-premise { margin: 0; font-size: var(--type-support); line-height: 1.4; color: var(--ink); }
  /* Wide: the premise sits on the scenario's own line, between it and the playback controls. */
  @media (min-width: 1001px) {
    .wr-premise { display: flex; align-items: center; min-height: 48px; margin: calc(-48px - var(--space-4)) 232px 0 300px; }
  }
  /* The telling: the stage that is running, then the outcome, in a sentence. */
  .wr-telling { display: grid; grid-template-columns: var(--wr-label) minmax(0, auto) minmax(0, 1fr); gap: var(--space-2) var(--wr-gap); align-items: center; padding-top: var(--space-2); border-top: 1px solid var(--hair); }
  .wr-word { grid-column: 2; display: inline-flex; align-items: center; gap: 14px; min-width: 6.4em; margin: 0; font-size: clamp(30px, 3.2vw, 46px); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.1; white-space: nowrap; color: var(--ink); }
  .wr-dot { width: 14px; height: 14px; flex: none; border-radius: 50%; background: var(--pass); }
  .window-race[data-outcome='narrow'] .wr-dot { background: var(--hold); }
  .window-race[data-outcome='too-late'] .wr-dot { background: var(--warn); border-radius: 0; }
  .window-race[data-playing] .wr-dot { background: var(--signal); border-radius: 50%; }
  /* Room for the longest sentence the model can return, so the scene keeps one height. */
  .wr-caption { grid-column: 3; margin: 0; min-height: 3lh; display: flex; align-items: center; max-width: 62ch; font-size: var(--type-body); line-height: 1.5; color: var(--muted); }

  /* The bars. Both tracks are the same axis, so the boundary is one line. */
  .wr-figure { margin: 0; }
  .wr-bars { position: relative; display: grid; gap: 28px; padding-top: 24px; }
  .wr-row { display: grid; grid-template-columns: var(--wr-label) minmax(0, 1fr); gap: var(--wr-gap); align-items: center; }
  .wr-row-label { font-size: var(--type-action); font-weight: 600; line-height: 1.3; color: var(--ink); }
  .wr-mark { position: absolute; top: -24px; font-family: var(--font-mono); font-size: 12px; line-height: 1.4; color: var(--faint); white-space: nowrap; }
  .wr-mark-start { left: 0; }
  .wr-mark-close { right: calc(100% - var(--wr-w) * 100% + 8px); color: var(--ink); }
  .wr-track { position: relative; height: var(--wr-bar); }
  .wr-after {
    position: absolute; top: 0; bottom: 0; left: calc(var(--wr-w) * 100%); right: calc(-1 * var(--gutter));
    border-left: 1px dashed var(--control-border);
    background: repeating-linear-gradient(135deg, var(--hair) 0 1px, transparent 1px 11px);
    display: flex; align-items: center; padding-left: var(--space-3);
    font-family: var(--font-mono); font-size: 12px; color: var(--faint);
    transition: background-color var(--dur-signal) var(--ease), color var(--dur-signal) var(--ease);
  }
  .window-race[data-closed] .wr-after { background-color: color-mix(in srgb, var(--warn) 7%, transparent); border-left: 1px solid var(--warn); color: var(--warn); }
  /* Time available: clear while it is still open, hatched once it is spent. */
  .wr-window {
    position: absolute; inset: 0 auto 0 0; width: calc(var(--wr-w) * 100%); border: 1px solid var(--ink);
    --wr-spent: calc(min(var(--wr-p), var(--wr-w)) / var(--wr-w) * 100%);
    background: repeating-linear-gradient(135deg, var(--hair-strong) 0 1px, transparent 1px 9px) left / var(--wr-spent) 100% no-repeat, var(--paper);
  }
  /* The label sits at the open end, which is the last part to be spent. */
  .wr-window-label { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); padding: 2px 8px; background: var(--paper); font-size: var(--type-action); font-weight: 600; color: var(--ink); white-space: nowrap; }
  .wr-window-label:empty { display: none; }
  /* A stage: an outline until it runs, then filled as far as time has reached. */
  .wr-seg { position: absolute; top: 0; bottom: 0; left: calc(var(--wr-s) * 100%); width: calc(var(--wr-d) * 100%); }
  .wr-seg::before { content: ''; position: absolute; inset: 0 2px 0 0; border: 1px solid var(--hair-strong); }
  .wr-seg[data-state='pending']::before { border-style: dashed; }
  .wr-ghost, .wr-fill > span { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-size: 16px; font-weight: 600; white-space: nowrap; }
  .wr-ghost { color: var(--muted); }
  .wr-fill {
    position: absolute; inset: 0 2px 0 0; overflow: hidden; color: var(--paper);
    background: linear-gradient(to right, var(--ink) 0 calc(var(--wr-in) * 100%), var(--warn) calc(var(--wr-in) * 100%) 100%);
    clip-path: inset(0 calc((1 - clamp(0, calc((var(--wr-p) - var(--wr-s)) / var(--wr-d)), 1)) * 100%) 0 0);
  }
  /* A stage too narrow for its name carries it above the bar instead. */
  .wr-seg.is-thin .wr-fill > span { display: none; }
  .wr-seg.is-thin .wr-ghost { left: 0; top: -22px; transform: none; font-family: var(--font-mono); font-size: 12px; font-weight: 400; color: var(--faint); }
  .wr-now { position: absolute; top: 20px; bottom: -6px; width: 2px; margin-left: -1px; background: var(--signal); opacity: 0;
    left: calc(var(--wr-label) + var(--wr-gap) + (100% - var(--wr-label) - var(--wr-gap)) * var(--wr-p)); }
  .window-race[data-playing] .wr-now { opacity: 1; }
  .wr-now span { position: absolute; bottom: -16px; left: -13px; font-family: var(--font-mono); font-size: 12px; line-height: 1; color: var(--accent-text); }

  .wr-foot { display: grid; grid-template-columns: var(--wr-label) minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-3) var(--wr-gap); align-items: end; padding-top: var(--space-3); }
  .wr-meter { grid-column: 2; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); margin: 0; }
  .wr-meter dt { font-family: var(--font-mono); font-size: 12px; line-height: 1.4; color: var(--faint); }
  .wr-meter dd { margin: 2px 0 0; font-family: var(--font-mono); font-size: 22px; line-height: 1.2; color: var(--ink); }
  .window-race[data-closed] .wr-beyond dd { color: var(--warn); }
  .wr-note { margin: 0; font-size: var(--type-caption); line-height: 1.6; color: var(--faint); }
  .wr-result { position: absolute; width: 1px; height: 1px; margin: 0; overflow: hidden; clip-path: inset(50%); }

  /* Diagnostics: apart from the telling, one step away. */
  .wr-diag { border-top: 1px solid var(--hair-strong); visibility: hidden; }
  .window-race[data-ready] .wr-diag { visibility: visible; }
  .wr-diag summary { list-style: none; cursor: pointer; }
  .wr-diag summary::-webkit-details-marker { display: none; }
  .wr-diag-summary { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); min-height: 64px; }
  .wr-diag-title { display: inline-flex; align-items: center; gap: 14px; font-size: 17px; font-weight: 600; color: var(--ink); }
  .wr-diag-title::before { content: ''; width: 9px; height: 9px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); transform: translateY(-3px) rotate(45deg); transition: transform var(--dur-fast) var(--ease-out); }
  .wr-diag[open] .wr-diag-title::before { transform: translateY(2px) rotate(-135deg); }
  .wr-diag-hint { font-family: var(--font-mono); font-size: 13px; color: var(--faint); }
  .wr-diag summary:focus-visible { outline: 2px solid var(--focus); outline-offset: -4px; }
  .wr-diag-body { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr); gap: var(--space-4) var(--space-7); padding-top: var(--space-2); padding-bottom: var(--space-6); }
  .wr-sliders { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3) var(--space-5); }
  .wr-sliders label { display: grid; padding-top: var(--space-2); border-top: 1px solid var(--hair-strong); font-size: 20px; font-weight: 600; letter-spacing: var(--tracking-heading); color: var(--ink); }
  .wr-sliders input { appearance: none; -webkit-appearance: none; width: 100%; height: 44px; margin: 0; background: transparent; cursor: ew-resize; }
  .wr-sliders input::-webkit-slider-runnable-track { height: 1px; background: var(--control-border); }
  .wr-sliders input::-moz-range-track { height: 1px; background: var(--control-border); }
  .wr-sliders input::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 20px; height: 20px; margin-top: -10px; border-radius: 50%; border: 1px solid var(--ink); background: var(--paper); }
  .wr-sliders input::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; border: 1px solid var(--ink); background: var(--paper); }
  .wr-sliders input:is(:hover, :active)::-webkit-slider-thumb { background: var(--ink); }
  .wr-sliders input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .wr-window-test { border: 0; margin: 0; padding: var(--space-2) 0 0; min-width: 0; display: flex; flex-wrap: wrap; border-top: 1px solid var(--hair-strong); }
  .wr-window-test legend { float: left; width: 100%; padding: 0; margin-bottom: 10px; font-size: 20px; font-weight: 600; letter-spacing: var(--tracking-heading); color: var(--ink); }
  .wr-window-test label { position: relative; flex: 1 1 0; cursor: pointer; }
  .wr-window-test input { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .wr-window-test label > span { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 4px; border: 1px solid var(--hair-strong); font-size: 13px; line-height: 1.3; color: var(--muted); white-space: nowrap; }
  .wr-window-test label + label > span { border-left: 0; }
  .wr-window-test input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .wr-diag { background: var(--paper); }
  .wr-window-test input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 3px; }

  @media (max-width: 1000px) {
    .wr-telling { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
    .wr-word, .wr-caption { grid-column: 1; }
    .wr-caption { min-height: 3lh; align-items: flex-start; max-width: none; }
    .wr-foot { grid-template-columns: minmax(0, 1fr); }
    .wr-meter { grid-column: 1; }
    .wr-diag-body { grid-template-columns: minmax(0, 1fr); }
  }
  /* Phone: time runs downwards. The window and the response stand side by
     side as two columns, so every stage has room for its own name and the
     boundary is one line across both. */
  @media (max-width: 720px) {
    .window-race { --wr-label: 0px; }
    .wr-wrap { gap: var(--space-3); padding-top: var(--space-3); }
    /* The scenario stays above the telling; playback moves below the bars,
       so the outcome and the bars come sooner. */
    .wr-top { display: contents; }
    .wr-select { order: 0; } .wr-telling { order: 1; } .wr-figure { order: 2; } .wr-playback { order: 3; } .wr-foot { order: 4; }
    .wr-select select { width: 100%; }
    .wr-playback { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wr-btn { min-width: 0; }
    .wr-premise { font-size: 17px; }
    .wr-word { font-size: 30px; }
    .wr-caption { font-size: 16px; min-height: 5lh; }
    .wr-bars { grid-template-columns: 76px minmax(0, 1fr); gap: var(--space-2); height: 360px; padding-top: 0; }
    .wr-row-label { font-size: 13px; }
    .wr-mark { display: none; }
    .wr-row { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); gap: 6px; align-items: stretch; }
    .wr-track { height: auto; }
    .wr-after { top: calc(var(--wr-w) * 100%); bottom: 0; left: 0; right: calc(-1 * var(--gutter-tight)); border-left: 0; border-top: 1px dashed var(--control-border); align-items: flex-end; justify-content: flex-end; padding: 0 var(--gutter-tight) 8px 0; }
    .window-race[data-closed] .wr-after { border-left: 0; border-top: 1px solid var(--warn); }
    .wr-row:first-child .wr-after { right: calc(-1 * var(--space-2)); }
    .wr-row:first-child .wr-after span { display: none; }
    .wr-window { inset: 0 0 auto 0; width: auto; height: calc(var(--wr-w) * 100%); background: repeating-linear-gradient(135deg, var(--hair-strong) 0 1px, transparent 1px 7px) top / 100% var(--wr-spent) no-repeat, var(--paper); }
    .wr-window-label { left: 4px; top: 6px; transform: none; padding: 1px 4px; font-size: 11px; white-space: normal; max-width: calc(100% - 8px); }
    .wr-seg { left: 0; right: 0; width: auto; top: calc(var(--wr-s) * 100%); bottom: auto; height: calc(var(--wr-d) * 100%); }
    .wr-seg::before { inset: 0 0 2px 0; }
    .wr-ghost, .wr-fill > span { left: 12px; top: 8px; transform: none; font-size: 16px; }
    .wr-fill { inset: 0 0 2px 0; background: linear-gradient(to bottom, var(--ink) 0 calc(var(--wr-in) * 100%), var(--warn) calc(var(--wr-in) * 100%) 100%);
      clip-path: inset(0 0 calc((1 - clamp(0, calc((var(--wr-p) - var(--wr-s)) / var(--wr-d)), 1)) * 100%) 0); }
    /* Vertically every stage is wide enough for its name; a short one sets it smaller. */
    .wr-seg.is-thin .wr-fill > span { display: block; }
    .wr-seg.is-thin :is(.wr-ghost, .wr-fill > span) { left: 12px; top: 2px; font-family: var(--font-sans); font-size: 13px; font-weight: 600; }
    .wr-seg.is-thin .wr-ghost { color: var(--muted); }
    .wr-now { left: 0; right: 0; width: auto; height: 2px; margin: -1px 0 0; bottom: auto; top: calc(23px + (100% - 23px) * var(--wr-p)); }
    .wr-now span { bottom: auto; top: -15px; left: auto; right: 0; }
    .wr-meter dd { font-size: 20px; }
    .wr-diag-summary { min-height: 56px; }
    .wr-diag-hint { display: none; }
    .wr-sliders { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .wr-after, .wr-btn { transition: none; } }
  @media print { .wr-top, .wr-diag { display: none; } }
</style>

<script>
  import { STAGES, STAGE_ACTIONS, WINDOWS, PRESETS, OUTCOME_LABEL, evaluate, describe, type WindowKey } from '../lib/window-model';
  import { segments, boundary, now, stageStates, endsBeyond, progress, percent } from '../lib/race-geometry';

  /** Milliseconds of playback for one unit of the model. */
  const UNIT_MS = 380;
  const THIN = 0.1;

  const motionEnabled = () => document.documentElement.hasAttribute('data-motion')
    && !matchMedia('(prefers-reduced-motion: reduce)').matches && !document.hidden;

  document.querySelectorAll<HTMLElement>('[data-window-race]').forEach((race) => {
    const $ = <T extends Element>(sel: string) => race.querySelector<T>(sel)!;
    const $$ = <T extends Element>(sel: string) => Array.from(race.querySelectorAll<T>(sel));
    const segs = $$<HTMLElement>('[data-wr-seg]');
    const ranges = $$<HTMLInputElement>('[data-wr-range]');
    const windows = $$<HTMLInputElement>('.wr-window-test input');
    const select = $<HTMLSelectElement>('[data-wr-preset]');
    const toggle = $<HTMLButtonElement>('[data-wr-toggle]');
    const replay = $<HTMLButtonElement>('[data-wr-replay]');
    const word = $<HTMLElement>('[data-wr-word]');
    const caption = $<HTMLElement>('[data-wr-caption]');
    const set = (el: Element, value: string) => { if (el.textContent !== value) el.textContent = value; };

    let frame = 0;
    let elapsed = Infinity;
    let last = 0;
    let played = false;

    const durations = () => ranges.map((r) => Number(r.value));
    const windowKey = () => (windows.find((w) => w.checked)?.value ?? 'set') as WindowKey;
    const win = () => WINDOWS[windowKey()];
    const label = () => (select.value === 'custom' ? 'Your own timings' : PRESETS.find((p) => p.key === select.value)?.label ?? '');

    /** Draws the state of the model at `elapsed`. Infinity is the finished chain. */
    function draw() {
      const d = durations();
      const w = win();
      const result = evaluate(d, w);
      const playing = Number.isFinite(elapsed);
      const geometry = segments(d, w);
      const states = stageStates(d, elapsed);
      const late = endsBeyond(d, w);
      segs.forEach((el, i) => {
        el.style.setProperty('--wr-s', String(geometry[i].start));
        el.style.setProperty('--wr-d', String(geometry[i].length));
        el.style.setProperty('--wr-in', String(geometry[i].inside));
        el.classList.toggle('is-thin', geometry[i].length < THIN);
        el.dataset.state = states[i];
        el.toggleAttribute('data-late', late[i]);
      });
      race.style.setProperty('--wr-w', String(boundary(d, w)));
      race.style.setProperty('--wr-p', now(d, w, elapsed).toFixed(5));
      const meter = progress(d, w, elapsed);
      set($('[data-wr-consumed]'), percent(meter.consumed));
      set($('[data-wr-remaining]'), percent(meter.remaining));
      set($('[data-wr-beyond]'), percent(meter.beyond));
      // The window is shown closed only once time has actually reached the boundary.
      const closed = result.outcome === 'too-late' && (!playing || elapsed >= w);
      race.toggleAttribute('data-closed', closed);
      set($('[data-wr-window-label]'), meter.remaining > 0 ? 'Window open' : 'Window used up');
      const active = states.indexOf('active');
      if (playing && active > -1) { set(word, STAGES[active]); set(caption, STAGE_ACTIONS[active]); }
      else if (!playing) { set(word, OUTCOME_LABEL[result.outcome]); set(caption, describe(result)); }
      // While time runs the outcome is withheld; the model's answer shows once it has.
      race.dataset.outcome = playing ? 'in-time' : result.outcome;
    }

    /** The text equivalent, written once per settled state so it is announced once. */
    function announce() {
      const result = evaluate(durations(), win());
      set($('[data-wr-sr-scn]'), label());
      set($('[data-wr-label]'), OUTCOME_LABEL[result.outcome]);
      set($('[data-wr-text]'), describe(result));
    }

    function sync() {
      const can = motionEnabled();
      const running = frame !== 0;
      const paused = !running && Number.isFinite(elapsed);
      replay.hidden = !can;
      toggle.hidden = !can || !(running || paused);
      set(toggle, running ? 'Pause' : 'Resume');
      race.toggleAttribute('data-playing', running || paused);
    }

    function settle() {
      cancelAnimationFrame(frame); frame = 0; elapsed = Infinity;
      draw(); announce(); sync();
    }
    function run() {
      const end = durations().reduce((a, b) => a + b, 0) + 0.4;
      last = performance.now();
      const tick = (time: number) => {
        elapsed = Math.min(end, elapsed + (time - last) / UNIT_MS); last = time;
        if (elapsed >= end) { settle(); return; }
        draw();
        frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
      sync();
    }
    function play() {
      cancelAnimationFrame(frame); frame = 0; played = true;
      if (!motionEnabled()) { settle(); return; }
      announce();
      elapsed = 0; draw(); run();
    }

    select.addEventListener('change', () => {
      const preset = PRESETS.find((p) => p.key === select.value);
      if (!preset) return;
      preset.durations.forEach((value, i) => { ranges[i].value = String(value); ranges[i].setAttribute('aria-valuetext', `${value} of ${ranges[i].max}`); });
      play();
    });
    ranges.forEach((range) => range.addEventListener('input', () => {
      range.setAttribute('aria-valuetext', `${range.value} of ${range.max}`);
      const match = PRESETS.find((p) => p.durations.every((value, i) => value === Number(ranges[i].value)));
      select.querySelector<HTMLOptionElement>('option[value="custom"]')!.hidden = !!match;
      select.value = match ? match.key : 'custom';
      settle();
    }));
    windows.forEach((radio) => radio.addEventListener('change', () => { race.dataset.window = windowKey(); settle(); }));
    replay.addEventListener('click', play);
    toggle.addEventListener('click', () => {
      if (frame) { cancelAnimationFrame(frame); frame = 0; sync(); } else if (Number.isFinite(elapsed)) run();
    });

    race.setAttribute('data-ready', '');
    settle();
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', settle);
    document.addEventListener('visibilitychange', () => { if (document.hidden && frame) { cancelAnimationFrame(frame); frame = 0; sync(); } });
    window.addEventListener('pageshow', sync);
    window.addEventListener('beforeprint', settle);

    // One unprompted run, as the page settles, if the scene is on screen;
    // otherwise the first time it is. It never repeats by itself.
    // The stage name is what tells the visitor it is running, so that is what must be in view.
    const figure = race.querySelector('.wr-telling');
    if (figure && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (played || !entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.9)) return;
        observer.disconnect();
        const fonts = 'fonts' in document ? document.fonts.ready : Promise.resolve();
        Promise.race([fonts, new Promise((resolve) => window.setTimeout(resolve, 900))])
          .then(() => window.setTimeout(() => { if (!played) play(); }, 400));
      }, { threshold: 0.9 });
      observer.observe(figure);
    }
  });
</script>
