---
/** Conceptual sequence only: positions encode order, never measured duration. */
interface Props { id?: string }
const { id = 'sedi-window' } = Astro.props;
const views = [
  { key: 'in-time', label: 'In time', explanation: 'Detection, escalation and a decision with authority lead to effective intervention before the window closes.' },
  { key: 'too-late', label: 'Too late', explanation: 'The chain reaches intervention after the window closes. Detection alone does not establish the ability to act in time.' },
];
const stages = ['Detect', 'Escalate', 'Decide', 'Intervene'];
---
<section class="intervention-window" id={id} aria-labelledby={`${id}-title`}>
  <div class="window-head">
    <h3 class="window-title" id={`${id}-title`}>The intervention window.</h3>
    <fieldset class="window-controls" aria-describedby={`${id}-note`}>
      <legend>Compare the timing of intervention</legend>
      {views.map((view, index) => (
        <label>
          <input type="radio" name={`${id}-view`} value={view.key} checked={index === 0} />
          <span>{view.label}</span>
        </label>
      ))}
    </fieldset>
  </div>
  <div class="window-meta">
  <button class="window-replay link" type="button" data-window-replay hidden>Replay sequence <span aria-hidden="true">↻</span></button>
  <p class="window-note" id={`${id}-note`}>Conceptual illustration. No assessment result, measured durations or scale.</p>
  </div>
  {views.map((view) => (
    <figure class="window-view" data-window-view={view.key}>
      <div class="window-sequence" aria-label={`Detect, escalate, decide, intervene: ${view.label.toLowerCase()}`}>
        <div class="window-trace" aria-hidden="true"></div>
        <div class="window-boundary"><span>Window closes</span></div>
        <ol role="list">
          {stages.map((stage, index) => (
            <li class={`window-stage window-stage-${index + 1}`}>
              <span class="window-node" aria-hidden="true"></span>
              <span class="window-index mono" aria-hidden="true">0{index + 1}</span>
              <span class="window-name">{stage}</span>
            </li>
          ))}
        </ol>
      </div>
      <figcaption><span class="window-outcome mono">{view.label}</span><p>{view.explanation}</p></figcaption>
    </figure>
  ))}
</section>
<style>
  .intervention-window { padding: var(--space-5) 0; border-block: 1px solid var(--hair-strong); margin-bottom: var(--space-6); }
  .window-head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); }
  .window-title { margin: 0; font-size: var(--type-card); font-weight: 600; line-height: 1.3; letter-spacing: var(--tracking-heading); color: var(--ink); }
  .window-controls { display: flex; gap: 0; border: 0; margin: 0; padding: 0; flex: none; }
  legend { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); }
  label { position: relative; cursor: pointer; }
  input { position: absolute; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  label > span { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 20px; border: 1px solid var(--control-border); font-size: var(--type-action); color: var(--muted); transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease); }
  label + label > span { border-left: 0; }
  input:checked + span { color: var(--black); background: var(--sedi-signal); }
  label:hover input:not(:checked) + span { color: var(--accent-text); }
  input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 4px; }
  .window-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 var(--space-4); margin-top: var(--space-2); }
  .window-meta .window-note { order: -1; margin: 0; }
  .window-replay { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin: 0; font-size: var(--type-action); }
  .window-replay[hidden] { display: inline-flex; visibility: hidden; }
  .window-note { margin: var(--space-3) 0 0; font-size: var(--type-caption); line-height: 1.65; color: var(--faint); }
  .window-view { margin: 0; }
  /* Both diagrams remain readable in browsers without :has(). Native
     radio controls also work without JavaScript. No scrolling gates content. */
  @supports selector(:has(*)) {
    .intervention-window:has(input[value='in-time']:checked) [data-window-view='too-late'],
    .intervention-window:has(input[value='too-late']:checked) [data-window-view='in-time'] { display: none; }
  }
  .window-sequence { position: relative; margin-top: var(--space-6); padding: var(--space-6) 0 var(--space-5); }
  .window-sequence::before { content: ''; position: absolute; left: 0; right: 0; top: var(--space-6); height: 1px; background: var(--hair-strong); }
  .window-sequence::after { content: ''; position: absolute; left: 0; right: 22%; top: var(--space-6); height: 1px; background: var(--accent-soft); }
  .window-trace { position: absolute; left: 6px; top: var(--space-6); width: 60%; height: 2px; background: var(--sedi-signal); transform-origin: left center; }
  .window-trace::after { content: ''; position: absolute; right: -3px; top: -2px; width: 6px; height: 6px; background: var(--sedi-signal); }
  [data-window-view='too-late'] .window-trace { width: calc(100% - 12px); background: var(--muted); }
  .window-view.is-playing .window-trace { animation: window-trace-x calc(var(--dur-trace) * 0.6) linear both; }
  .window-view.is-playing[data-window-view='too-late'] .window-trace { animation-duration: var(--dur-trace); }
  .window-view.is-playing .window-node::after { animation: window-stage var(--dur-signal) var(--ease-enter) both; animation-delay: calc(var(--dur-trace) * var(--stage-time)); }
  .window-stage-1 { --stage-time: 0; }
  .window-stage-2 { --stage-time: 0.2; }
  .window-stage-3 { --stage-time: 0.4; }
  .window-stage-4 { --stage-time: 0.6; }
  [data-window-view='too-late'] .window-stage-4 { --stage-time: 1; }
  .window-view.is-playing[data-window-view='too-late'] .window-boundary { animation: window-deadline var(--dur-reveal) var(--ease-enter) both; animation-delay: calc(var(--dur-trace) * 0.78); }
  @keyframes window-trace-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes window-trace-y { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes window-stage { 0% { transform: scale(1); opacity: 0; } 45% { transform: scale(1.9); opacity: 1; } 100% { transform: scale(2.5); opacity: 0; } }
  @keyframes window-deadline { 0%, 100% { border-color: var(--control-border); } 40% { border-color: var(--ink); } }
  .window-boundary { position: absolute; left: 78%; top: 0; bottom: 0; width: 1px; border-left: 1px dashed var(--control-border); }
  .window-boundary > span { position: absolute; top: 0; right: 12px; width: max-content; color: var(--muted); font-family: var(--font-mono); font-size: var(--type-caption); }
  ol { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); list-style: none; margin: -6px 0 0; padding: 0; }
  .window-stage { min-width: 0; display: grid; justify-items: start; align-content: start; gap: var(--space-2); grid-column: span 2; }
  /* Animate a separate halo so the node and trace stay fixed. Scaling
     and fading avoids repainting a growing shadow on every frame. */
  .window-node::after { content: ''; position: absolute; inset: -1px; border: 1px solid var(--accent-soft); border-radius: inherit; opacity: 0; pointer-events: none; }
  .window-node { position: relative; width: 13px; height: 13px; border: 1px solid var(--sedi-signal); border-radius: 50%; background: var(--paper); }
  .window-stage-4 .window-node { background: var(--sedi-signal); }
  .window-index { margin: 0; font-size: var(--type-caption); color: var(--faint); }
  .window-name { font-size: var(--type-small); font-weight: 600; color: var(--ink); }
  [data-window-view='too-late'] .window-stage-4 { grid-column: 10; justify-items: end; }
  [data-window-view='too-late'] .window-stage-4 .window-node { background: var(--paper); border-radius: 0; border-color: var(--muted); }
  figcaption { display: grid; grid-template-columns: minmax(0, 0.3fr) minmax(0, 1fr); gap: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--hair); align-items: baseline; }
  .window-outcome { color: var(--accent-text); font-size: var(--type-caption); }
  figcaption p { margin: 0; max-width: var(--measure-body); color: var(--muted); font-size: var(--type-small); line-height: 1.65; }
  @media (max-width: 720px) {
    .window-head { align-items: start; flex-direction: column; }
    .window-sequence { margin-top: var(--space-5); padding-left: 48px; padding-top: 0; padding-bottom: 0; }
    .window-sequence::before { left: 6px; top: 26px; bottom: 26px; width: 1px; height: auto; right: auto; }
    .window-sequence::after { left: 6px; top: 26px; bottom: 21%; width: 1px; height: auto; right: auto; }
    .window-trace { left: 6px; top: 26px; width: 2px; height: 156px; transform-origin: center top; }
    [data-window-view='too-late'] .window-trace { width: 2px; height: 208px; }
    .window-view.is-playing .window-trace { animation-name: window-trace-y; }
    /* Vertical stage spacing gives the late trace four equal intervals. */
    .window-view.is-playing .window-stage-2 { --stage-time: 0.25; }
    .window-view.is-playing .window-stage-3 { --stage-time: 0.5; }
    .window-view.is-playing .window-stage-4 { --stage-time: 0.75; }
    .window-view.is-playing[data-window-view='too-late'] .window-stage-4 { --stage-time: 1; }
    .window-view.is-playing .window-trace { animation-duration: calc(var(--dur-trace) * 0.75); }
    .window-view.is-playing[data-window-view='too-late'] .window-trace { animation-duration: var(--dur-trace); }
    .window-view.is-playing[data-window-view='too-late'] .window-boundary { animation-delay: calc(var(--dur-trace) * 0.86); }
    ol { display: grid; grid-template-columns: 1fr; grid-template-rows: repeat(5, 52px); margin: 0; }
    .window-stage { display: flex; align-items: center; gap: var(--space-3); grid-column: 1; position: relative; }
    .window-node { position: absolute; left: -48px; top: 19.5px; }
    .window-index { margin-top: 0; }
    .window-stage-4 { grid-row: 4; }
    [data-window-view='too-late'] .window-stage-4 { grid-column: 1; grid-row: 5; }
    .window-boundary { left: 0; right: 0; top: 79%; bottom: auto; width: auto; height: 1px; border-left: 0; border-top: 1px dashed var(--control-border); }
    .window-boundary > span { right: 0; top: -26px; }
    figcaption { grid-template-columns: 1fr; gap: var(--space-2); }
  }
  @media (prefers-reduced-motion: reduce) { label > span { transition: none; transition-duration: 0s !important; } }
  @media print { .window-replay, .window-replay[hidden] { display: none; }
 .window-controls { display: none; } .intervention-window .window-view { display: block !important; break-inside: avoid; } }
</style>
