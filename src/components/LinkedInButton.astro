---
interface Props {
  href: string;
  label: string;
  size?: 'sm' | 'md';
}

const { href, label, size = 'sm' } = Astro.props;
const ariaLabel = `${label} (opens in new tab)`;
---

<a
  class:list={['linkedin-button', 'btn-ghost', size]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  title={label}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M6.94 21H3.02V9h3.92v12ZM4.98 7.36a2.28 2.28 0 1 1 0-4.56 2.28 2.28 0 0 1 0 4.56ZM21 21h-3.9v-5.84c0-1.4-.03-3.19-1.94-3.19-1.95 0-2.25 1.52-2.25 3.09V21H9.02V9h3.73v1.64h.05c.52-.98 1.78-2.02 3.67-2.02 3.93 0 4.53 2.59 4.53 5.95V21Z" />
  </svg>
</a>

<style>
  .linkedin-button { padding: 0; color: var(--accent); }

  .linkedin-button.sm {
    width: 44px;
    height: 44px;
  }

  .linkedin-button.md {
    width: 48px;
    height: 48px;
  }

  .linkedin-button svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

</style>
