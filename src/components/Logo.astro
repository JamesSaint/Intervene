---
// Intervene wordmark. Artwork from the brand kit (assets/intervene/svg/intervene-wordmark-*.svg),
// inlined so it takes the text colour of its theme. Never typeset INTERVENE; never gold (BRAND.md v3.0).
// Heights: header 18 px mobile / 22 px desktop (sm). Minimum width 120 px.
interface Props {
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  inverted?: boolean;
  href?: string | null;
  label?: string;
}

const {
  size = 'sm',
  inverted = false,
  href = '/',
  label = 'Intervene · home',
} = Astro.props;

// cap height in px; width follows the 8.948 : 1 artwork proportion
const heights = { xs: 14, sm: 18, md: 22, lg: 40, xl: 72 };
const h = heights[size];
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['intervene-logo', `size-${size}`, { inverted }]}
  href={href ?? undefined}
  aria-label={href ? label : undefined}
  style={`--logo-h: ${h}px;`}
>
