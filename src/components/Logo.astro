<style>
  .intervene-logo {
    display: inline-flex;
    align-items: center;
    color: var(--ink-soft);
    line-height: 1;
  }
  .intervene-logo.inverted { color: var(--inverse-ink); }
  .intervene-wordmark { display: block; height: var(--logo-h); width: auto; aspect-ratio: 9196 / 1027.7; }
  /* header size steps down on small screens (inline --logo-h cannot be overridden, so set height directly) */
  @media (max-width: 767px) { .intervene-logo.size-md .intervene-wordmark { height: 18px; } }
</style>
