---
/**
 * The three engagements, introduced: the question each answers, its scope
 * and its fee. Each includes the one before it, which the nested frames
 * show; none is a prerequisite, which the caption says. Boundaries are on
 * the page at all times. The full comparison opens beneath.
 *
 * Everything reads from src/lib/offers.ts: question, name, the one-sentence
 * scope (`short`), the "everything in" line (`scope[0]`), fee and the short
 * exclusion. Nothing here restates or rounds a commercial term.
 */
import { offers } from '../lib/offers';
import { markAgda } from '../lib/marks';
import Agda from './Agda.astro';
import OfferLadder from './OfferLadder.astro';

interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel: H = 'h2' } = Astro.props;

const kickers = ['Entry point', 'Preliminary', 'Full assessment'];
const shorts = ['Authority Check', 'Review', 'Assessment'];
---
<figure class="offer-choice offer-intro" aria-labelledby="offer-choice-heading">
  <figcaption class="oi-caption" data-offer-view="offer_choice">
    <H class="h2" id="offer-choice-heading">Three questions. <em>One named system.</em></H>
    <p class="oi-principle">Each engagement includes the one before it, and none is a prerequisite.</p>
  </figcaption>

  <ol class="oi-routes" role="list">
    {offers.map((o, i) => (
      <li class="oi-route">
        <span class="mono oi-kicker">{kickers[i]}</span>
        <p class="oi-q">{o.question}</p>
        <h3 class="oi-name" set:html={markAgda(o.name)} />
        <p class="oi-scope" set:html={markAgda(o.short)} />
        {i > 0 && <p class="oi-includes"><span aria-hidden="true">+</span> {o.scope[0]}</p>}
        <p class="oi-fee">
          <span class="mono oi-fee-note">{o.priceNote}</span>
          <span class="oi-price">{o.price}</span>
        </p>
        <p class="oi-boundary" set:html={markAgda(o.exclusionShort)} />
        <a href={`/services/#${o.slug}`} class="link oi-link" data-offer-select={o.slug}>Explore the {shorts[i]} <span aria-hidden="true">→</span></a>
      </li>
    ))}
  </ol>

  <p class="body muted oi-note">
    The Authority Check is not an <Agda /> verdict. A Review may recommend a
    full Assessment but does not commit you to one or determine its verdict.
  </p>

  <details class="oi-compare" data-disclosure>
    <summary><span>Compare the three engagements in full</span><span class="oi-compare-hint mono">What each establishes, examines and excludes</span></summary>
    <div data-disclosure-body>
      <OfferLadder bare />
    </div>
  </details>
</figure>

<style>
  .offer-intro { margin: 0; }
  .oi-caption { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-4) var(--space-7); align-items: end; }
  .oi-caption .h2 { margin: 0; font-size: clamp(32px, 4.4vw, 64px); line-height: 1.04; }
  .oi-caption .h2 em { display: block; color: var(--faint); }
  .oi-principle { margin: 0; padding-bottom: 6px; font-size: var(--type-support); line-height: 1.5; color: var(--muted); }

  /* Nested frames: the Review's frame holds the Authority Check, and the
     Assessment's holds both. Inclusion is drawn, not listed. */
  .oi-routes { --oi-step: 16px; --oi-pad: clamp(20px, 2.2vw, 32px); list-style: none; margin: var(--space-7) 0 0; padding: calc(var(--oi-step) * 2) 0 calc(var(--oi-step) * 2) calc(var(--oi-step) * 2); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(8, auto); isolation: isolate; }
  .oi-route { position: relative; display: grid; grid-row: span 8; grid-template-rows: subgrid; row-gap: 0; min-width: 0; padding: var(--oi-pad); }
  .oi-route::before { content: ''; position: absolute; border: 1px solid var(--hair-strong); pointer-events: none; }
  .oi-route:nth-child(1)::before { inset: 0; z-index: -1; background: var(--paper); border-color: var(--ink); }
  .oi-route:nth-child(2)::before { inset: calc(-1 * var(--oi-step)) 0 calc(-1 * var(--oi-step)) calc(-100% - var(--oi-step)); z-index: -2; background: var(--paper-soft); }
  .oi-route:nth-child(3)::before { inset: calc(-2 * var(--oi-step)) 0 calc(-2 * var(--oi-step)) calc(-200% - 2 * var(--oi-step)); z-index: -3; background: var(--paper); }

  .oi-kicker { font-size: var(--type-caption); line-height: 1.6; color: var(--accent-text); }
  .oi-q { margin: var(--space-3) 0 0; font-size: clamp(28px, 3vw, 46px); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.05; color: var(--ink); }
  .oi-name { margin: var(--space-3) 0 0; font-size: var(--type-body); font-weight: 600; letter-spacing: 0; line-height: 1.4; color: var(--ink); }
  .oi-scope { margin: var(--space-2) 0 0; font-size: var(--type-small); line-height: 1.6; color: var(--muted); }
  .oi-includes { margin: var(--space-3) 0 0; font-size: var(--type-action); font-weight: 600; line-height: 1.5; color: var(--ink); }
  .oi-includes span { color: var(--accent-text); }
  .oi-fee { display: grid; gap: 2px; margin: var(--space-5) 0 0; padding-top: var(--space-3); border-top: 1px solid var(--hair-strong); }
  .oi-fee-note { font-size: var(--type-caption); line-height: 1.6; color: var(--faint); }
  .oi-price { font-family: var(--font-mono); font-size: clamp(20px, 2vw, 28px); line-height: 1.3; color: var(--ink); }
  .oi-boundary { margin: var(--space-3) 0 0; font-size: var(--type-action); line-height: 1.55; color: var(--muted); }
  .oi-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-top: var(--space-3); justify-self: start; font-size: var(--type-small); font-weight: 600; }
  .oi-note { margin: var(--space-6) 0 0; font-size: var(--type-small); line-height: 1.7; }

  .oi-compare { margin-top: var(--space-5); border-block: 1px solid var(--hair-strong); }
  .oi-compare summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); min-height: 72px; }
  .oi-compare summary::-webkit-details-marker { display: none; }
  .oi-compare summary > span:first-child { display: inline-flex; align-items: center; gap: 14px; font-size: clamp(18px, 1.8vw, 24px); font-weight: 600; letter-spacing: var(--tracking-heading); color: var(--ink); }
  .oi-compare summary > span:first-child::before { content: ''; width: 10px; height: 10px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); transform: translateY(-3px) rotate(45deg); transition: transform var(--dur-fast) var(--ease-out); }
  .oi-compare[open]:not([data-disclosure-state='closed']) summary > span:first-child::before { transform: translateY(3px) rotate(-135deg); }
  .oi-compare-hint { font-size: var(--type-caption); color: var(--faint); }
  .oi-compare summary:is(:hover, :focus-visible) > span:first-child { color: var(--accent-text); }
  .oi-compare summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .oi-compare [data-disclosure-body] { padding-bottom: var(--space-5); }

  @media (max-width: 1080px) { .oi-caption { grid-template-columns: minmax(0, 1fr); } }
  /* Narrow: one engagement at a time, each a sheet a little wider than the
     one it includes, so the nesting still reads going down the page. */
  @media (max-width: 960px) {
    .oi-routes { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; padding: 0; margin-top: var(--space-5); gap: var(--space-3); }
    .oi-route { grid-row: auto; grid-template-rows: none; border: 1px solid var(--hair-strong); background: var(--paper); }
    .oi-route::before { display: none; }
    .oi-route:nth-child(1) { margin-right: calc(var(--oi-step) * 2); border-color: var(--ink); }
    .oi-route:nth-child(2) { margin-right: var(--oi-step); background: var(--paper-soft); }
    .oi-q { font-size: 28px; }
    .oi-scope { display: none; }
    .oi-compare-hint { display: none; }
  }
</style>
