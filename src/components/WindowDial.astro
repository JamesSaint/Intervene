---
/**
 * The intervention dial: the homepage's opening instrument.
 *
 * One revolution of the outer ring is the intervention window. The four
 * stages run clockwise from twelve o'clock; anything after the window is
 * drawn on the inner ring and never wraps back onto the outer one. The time
 * model is stated in src/lib/dial-geometry.ts and the outcome is decided
 * only by src/lib/window-model.ts. This component draws what they return.
 *
 * Illustrative: relative units, not the AGDA® engine, and its outcome words
 * are not the verdict states. The note saying so is always visible.
 *
 * Slots place the page's own opening copy inside the instrument's layout so
 * the order can differ by screen: `head`, `support` and `cta`. The dial is
 * named once as a figure and its reading is one live sentence in the page
 * flow, so a screen reader meets the outcome once, not twice. The first
 * paint is the finished default scenario, rendered here, so the dial reads
 * without JavaScript and with motion off.
 */
import {
  STAGES, STAGE_ACTIONS, STAGE_MIN, STAGE_MAX, WINDOWS, PRESETS, DEFAULT_PRESET,
  OUTCOME_LABEL, evaluate, describe,
} from '../lib/window-model';
import { endsBeyond, progress, percent } from '../lib/dial-geometry';
import DialFace from './DialFace.astro';

interface Props { id?: string; /** Where on the page this scenario is read next, if anywhere. */ follow?: string }
const { id = 'window-dial', follow } = Astro.props;

const preset = PRESETS.find((p) => p.key === DEFAULT_PRESET)!;
const window = WINDOWS.set;
const result = evaluate(preset.durations, window);
const late = endsBeyond(preset.durations, window);
const meter = progress(preset.durations, window);
const windows = [
  { key: 'shorter', label: '25% shorter' },
  { key: 'set', label: 'As set' },
  { key: 'longer', label: '25% longer' },
];
const stateText = (i: number) => (late[i] ? (result.starts[i] >= window ? 'After the window' : 'Window closes here') : 'Completed');
const closedLine = result.outcome === 'too-late' ? `Window closed during ${STAGES[result.closesDuring ?? 3]}` : result.outcome === 'narrow' ? 'Inside the window, narrowly' : 'Inside the window';
---
<div class="window-dial" id={id} data-window-dial data-outcome={result.outcome} data-window="set" data-closed={result.outcome === 'too-late' ? '' : undefined}>
  <div class="wd-head"><slot name="head" /></div>
  <div class="wd-support"><slot name="support" /></div>
  <div class="wd-cta"><slot name="cta" /></div>

  <div class="wd-face">
    <div class="wd-figure" role="img" aria-label="Intervention dial. Its reading is given in the sentence that follows the stage list." aria-describedby={`${id}-note`}>
      <DialFace durations={preset.durations} window={window} uid={id} live />
      <span class="wd-top" data-wd-top>{result.outcome === 'too-late' ? 'Window closed' : 'Window closes'}</span>
      <div class="wd-centre">
        <span class="wd-scn" data-wd-scn>{preset.label}</span>
        <strong class="wd-word" data-wd-word>{OUTCOME_LABEL[result.outcome]}</strong>
        <span class="wd-caption" data-wd-caption>{closedLine}</span>
      </div>
    </div>
    <button class="wd-face-replay" type="button" data-wd-replay hidden><span class="wd-play" aria-hidden="true"></span>Replay</button>
  </div>

  <div class="wd-readout">
    <ol class="wd-stages" role="list" aria-label="The four stages, in the order they run round the dial">
      {STAGES.map((stage, i) => (
        <li>
          <button type="button" class="wd-stage" data-wd-stage={i} data-state="completed" data-late={late[i] ? '' : undefined} aria-pressed="false">
            <span class="wd-glyph" aria-hidden="true"></span>
            <span class="wd-name">{stage}</span>
            <span class="wd-action">{STAGE_ACTIONS[i]}</span>
            <span class="wd-state" data-wd-state>{stateText(i)}</span>
          </button>
        </li>
      ))}
    </ol>
    <dl class="wd-meter">
      <div><dt>Window consumed</dt><dd data-wd-consumed>{percent(meter.consumed)}</dd></div>
      <div><dt>Remaining</dt><dd data-wd-remaining>{percent(meter.remaining)}</dd></div>
      <div class="wd-beyond"><dt>Beyond the window</dt><dd data-wd-beyond-value>{percent(meter.beyond)}</dd></div>
    </dl>
    <p class="wd-result" id={`${id}-result`} aria-live="polite"><span class="wd-sr">Illustrative scenario, <span data-wd-sr-scn>{preset.label}</span>: <span data-wd-label>{OUTCOME_LABEL[result.outcome]}</span>. </span><span data-wd-text>{describe(result)}</span></p>
  </div>

  <div class="wd-bar">
    <label class="wd-select">
      <span>Illustrative scenario</span>
      <select data-wd-preset aria-describedby={`${id}-note`}>
        {PRESETS.map((p) => <option value={p.key} selected={p.key === preset.key}>{p.label}</option>)}
        <option value="custom" hidden>Your own timings</option>
      </select>
    </label>
    <button class="wd-btn" type="button" data-wd-toggle hidden>Pause</button>
    <button class="wd-btn wd-btn-primary" type="button" data-wd-replay hidden><span class="wd-play" aria-hidden="true"></span>Replay the scenario</button>
    <details class="wd-diag" data-wd-diag>
      <summary>Adjust the model</summary>
      <div class="wd-diag-body">
        <div class="wd-sliders">
          {STAGES.map((stage, i) => (
            <label>
              <span>{stage}</span>
              <input type="range" min={STAGE_MIN} max={STAGE_MAX} step="1" value={preset.durations[i]} data-wd-range={i} aria-label={`${stage}: time taken`} aria-valuetext={`${preset.durations[i]} of ${STAGE_MAX}`} />
            </label>
          ))}
        </div>
        <fieldset class="wd-window">
          <legend>Test the window</legend>
          {windows.map((w) => (
            <label><input type="radio" name={`${id}-window`} value={w.key} checked={w.key === 'set'} /><span>{w.label}</span></label>
          ))}
        </fieldset>
      </div>
    </details>
    {follow && <a class="wd-follow" href={follow}>This scenario is carried into the chain below <span aria-hidden="true">↓</span></a>}
  </div>

  <p class="wd-note" id={`${id}-note`}>
    Illustrative model. One turn of the dial is the intervention window; time
    past it runs on the inner ring. Relative units, not measured durations,
    and not an assessment result. An assessment sets the window from your own
    records.
  </p>
</div>

<noscript><style is:inline>.wd-bar { display: none !important; }</style></noscript>

<style>
  .window-dial {
    --wd-ink: #f0f0f0; --wd-muted: #c8c6c4; --wd-faint: #8e8b87; --wd-warn: #e0766a;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4);
    grid-template-areas: 'head' 'cta' 'face' 'readout' 'support' 'bar' 'note';
  }
  .wd-head { grid-area: head; } .wd-support { grid-area: support; } .wd-cta { grid-area: cta; }
  .wd-face { grid-area: face; } .wd-readout { grid-area: readout; } .wd-bar { grid-area: bar; } .wd-note { grid-area: note; }

  /* The face: the largest thing in the opening view. */
  .wd-face { position: relative; width: 100%; max-width: 640px; aspect-ratio: 1; margin: 28px auto 0; }
  .wd-face :global(.df-hand) { transition: opacity var(--dur-fast) var(--ease); }
  .window-dial[data-playing] .wd-face :global(.df-hand) { opacity: 1; }
  .window-dial[data-focus] .wd-face :global(.df-arc) { opacity: 0.24; }
  .window-dial[data-focus] .wd-face :global(.df-arc.is-focus) { opacity: 1; }
  .window-dial[data-focus] .wd-face :global(.df-name:not(.is-focus)) { opacity: 0.3; }
  .wd-figure { position: absolute; inset: 0; }
  /* A replay control on the instrument itself, so it is in view with the dial. */
  .wd-face-replay { position: absolute; left: 50%; top: 66%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 var(--space-3); border: 1px solid rgba(240, 240, 240, 0.34); font-size: 13px; font-weight: 600; letter-spacing: 0.02em; color: var(--wd-ink); transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease); }
  .wd-face-replay[hidden] { display: none; }
  .wd-face-replay:is(:hover, :focus-visible) { background: var(--wd-ink); color: #0a0a0a; }
  .wd-face-replay:focus-visible { outline: 2px solid #c9b694; outline-offset: 3px; }
  /* While time runs the centre names the stage; the control returns with the outcome. */
  .window-dial[data-playing] .wd-face-replay { opacity: 0; pointer-events: none; }
  .wd-top { position: absolute; left: 50%; top: -26px; transform: translateX(-50%); font-family: var(--font-mono); font-size: 12px; line-height: 1.4; color: var(--ink); white-space: nowrap; }
  .window-dial[data-closed] .wd-top { color: var(--warn); }
  .wd-centre { position: absolute; inset: 25% 26% 36%; display: grid; align-content: center; justify-items: center; gap: 8px; text-align: center; color: var(--wd-ink); }
  .wd-scn { font-family: var(--font-mono); font-size: clamp(10px, 1.9vw, 12px); line-height: 1.4; color: var(--wd-faint); min-height: 2.8em; display: flex; align-items: flex-end; }
  .wd-word { font-size: clamp(28px, 8vw, 68px); font-weight: 600; letter-spacing: -0.03em; line-height: 1; white-space: nowrap; }
  .window-dial[data-closed]:not([data-playing]):not([data-reading]) .wd-word { color: var(--wd-warn); }
  .wd-caption { font-size: clamp(12px, 2.6vw, 15px); line-height: 1.35; color: var(--wd-muted); min-height: 2.7em; max-width: 17ch; }

  /* The console under the opening: the four stages across, each with its
     state in words, then the three figures. It is the key to the dial. */
  .wd-readout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  .wd-stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-3); }
  .wd-stage { position: relative; display: grid; grid-template-columns: 15px minmax(0, 1fr); gap: 2px var(--space-2); align-content: start; align-items: center; width: 100%; min-height: 64px; padding: var(--space-2) 0; text-align: left; border-top: 1px solid var(--hair-strong); }
  .wd-glyph { width: 15px; height: 15px; border: 1px solid var(--ink); border-radius: 50%; box-sizing: border-box; }
  .wd-stage[data-state='completed'] .wd-glyph { background: var(--ink); }
  .wd-stage[data-state='active'] .wd-glyph { background: var(--sedi-signal); border-color: var(--sedi-signal); }
  .wd-stage[data-state='pending'] .wd-glyph { border-style: dashed; }
  .wd-stage[data-late][data-state='completed'] .wd-glyph { background: var(--warn); border-color: var(--warn); border-radius: 0; }
  .wd-name { font-size: 19px; font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.2; color: var(--ink); }
  .wd-action { grid-column: 2; font-size: var(--type-action); line-height: 1.4; color: var(--muted); }
  .wd-state { grid-column: 2; font-family: var(--font-mono); font-size: 12px; line-height: 1.5; color: var(--faint); white-space: nowrap; }
  .wd-stage[data-late][data-state='completed'] .wd-state { color: var(--warn); }
  .wd-stage[data-state='pending'] :is(.wd-name, .wd-action) { color: var(--faint); }
  /* The picked-out stage is marked by a rule, never by dimming the others' text. */
  .wd-stage.is-focus::before { content: ''; position: absolute; left: 0; right: 0; top: -2px; height: 3px; background: var(--ink); }
  .wd-stage:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }

  .wd-meter { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); margin: 0; padding-top: var(--space-2); border-top: 1px solid var(--hair-strong); }
  .wd-meter dt { font-family: var(--font-mono); font-size: 12px; line-height: 1.4; color: var(--faint); }
  .wd-meter dd { margin: 2px 0 0; font-family: var(--font-mono); font-size: 22px; line-height: 1.2; color: var(--ink); }
  .window-dial[data-closed] .wd-beyond dd { color: var(--warn); }
  .wd-result { margin: 0; min-height: 2lh; font-size: var(--type-small); line-height: 1.6; color: var(--muted); transition: opacity var(--dur-fast) var(--ease); }
  /* The sentence states the outcome, so it waits until time has run. */
  .window-dial[data-playing] .wd-result { opacity: 0; }
  .wd-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  /* Secondary interface: scenario, playback and the diagnostic model. */
  .wd-bar { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--space-2) var(--space-3); padding-top: var(--space-4); border-top: 1px solid var(--hair-strong); visibility: hidden; }
  .window-dial[data-ready] .wd-bar { visibility: visible; }
  .wd-select { display: block; position: relative; }
  .wd-select > span { position: absolute; left: 12px; top: 6px; font-family: var(--font-mono); font-size: 11px; line-height: 1.3; color: var(--faint); pointer-events: none; }
  .wd-select select { appearance: none; -webkit-appearance: none; height: 48px; min-width: 248px; padding: 20px 40px 4px 12px; border: 1px solid var(--control-border); border-radius: 0; font: inherit; font-size: var(--type-action); font-weight: 600; color: var(--ink); cursor: pointer;
    background: var(--paper) linear-gradient(45deg, transparent 50%, var(--ink) 50%) no-repeat right 14px center / 7px 7px; }
  .wd-select select:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .wd-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 48px; min-width: 104px; padding: 0 var(--space-3); border: 1px solid var(--control-border); font-size: var(--type-action); font-weight: 600; letter-spacing: 0.02em; color: var(--ink); transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease); }
  /* Hidden when there is nothing to pause or motion is off, but still holding its place. */
  .wd-btn[hidden] { display: inline-flex; visibility: hidden; }
  .wd-btn:is(:hover, :focus-visible) { border-color: var(--control-active); }
  .wd-btn-primary { border-color: var(--ink); background: var(--ink); color: var(--paper); }
  .wd-btn-primary:is(:hover, :focus-visible) { background: var(--muted); border-color: var(--muted); }
  .wd-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .wd-play { width: 0; height: 0; border-style: solid; border-width: 5px 0 5px 8px; border-color: transparent transparent transparent currentColor; }

  .wd-diag { flex: 1 1 100%; }
  .wd-diag summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 12px; min-height: 48px; font-size: var(--type-action); font-weight: 600; color: var(--ink); }
  .wd-diag summary::-webkit-details-marker { display: none; }
  .wd-diag summary::before { content: ''; width: 9px; height: 9px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); transform: translateY(-3px) rotate(45deg); transition: transform var(--dur-fast) var(--ease-out); }
  .wd-diag[open] summary::before { transform: translateY(2px) rotate(-135deg); }
  .wd-diag summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .wd-diag-body { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr); gap: var(--space-4) var(--space-7); padding: var(--space-2) 0 var(--space-3); }
  .wd-sliders { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3) var(--space-5); }
  .wd-sliders label { display: grid; padding-top: var(--space-2); border-top: 1px solid var(--hair-strong); font-size: 18px; font-weight: 600; letter-spacing: var(--tracking-heading); color: var(--ink); }
  .wd-sliders input { appearance: none; -webkit-appearance: none; width: 100%; height: 44px; margin: 0; background: transparent; cursor: ew-resize; }
  .wd-sliders input::-webkit-slider-runnable-track { height: 1px; background: var(--control-border); }
  .wd-sliders input::-moz-range-track { height: 1px; background: var(--control-border); }
  .wd-sliders input::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 20px; height: 20px; margin-top: -10px; border-radius: 50%; border: 1px solid var(--ink); background: var(--paper); }
  .wd-sliders input::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; border: 1px solid var(--ink); background: var(--paper); }
  .wd-sliders input:is(:hover, :active)::-webkit-slider-thumb { background: var(--ink); }
  .wd-sliders input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .wd-window { border: 0; margin: 0; padding: var(--space-2) 0 0; min-width: 0; display: flex; flex-wrap: wrap; border-top: 1px solid var(--hair-strong); }
  .wd-window legend { float: left; width: 100%; padding: 0; margin-bottom: 10px; font-size: 18px; font-weight: 600; letter-spacing: var(--tracking-heading); color: var(--ink); }
  .wd-window label { position: relative; flex: 1 1 0; cursor: pointer; }
  .wd-window input { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .wd-window label > span { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 4px; border: 1px solid var(--control-border); font-size: 13px; line-height: 1.3; color: var(--muted); white-space: nowrap; }
  .wd-window label + label > span { border-left: 0; }
  .wd-window input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .wd-window input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 3px; }
  .wd-follow { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; margin-left: auto; font-size: var(--type-action); font-weight: 600; color: var(--ink); text-decoration: underline; text-decoration-color: var(--hair-strong); text-underline-offset: 4px; }
  .wd-follow:is(:hover, :focus-visible) { color: var(--accent-text); }
  .wd-note { margin: 0; font-size: var(--type-caption); line-height: 1.65; color: var(--faint); max-width: 104ch; }

  /* Wide: the question on the left at full weight, the dial on the right,
     and the console across beneath both. */
  @media (min-width: 1100px) {
    .window-dial {
      grid-template-columns: minmax(0, 1fr) minmax(0, 620px); column-gap: var(--space-7); row-gap: var(--space-4); align-items: start;
      grid-template-areas: 'head face' 'support face' 'cta face' 'readout readout' 'bar bar' 'note note';
      grid-template-rows: auto auto 1fr auto auto auto;
    }
    .wd-face { align-self: center; margin-top: 30px; max-width: 620px; }
    .wd-readout { grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr); gap: var(--space-2) var(--space-6); align-items: start; margin-top: var(--space-2); }
    .wd-stages { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 var(--space-4); }
    .wd-result { grid-column: 1 / -1; min-height: 1lh; }
  }
  @media (max-width: 1099px) {
    .wd-readout, .wd-support { max-width: 640px; width: 100%; margin-inline: auto; }
  }
  /* Phone: the question, one action, then the dial at full width. Beneath
     it the four stages sit two by two with their states; what each stage
     does, and the supporting copy, wait further down. */
  @media (max-width: 720px) {
    .window-dial { gap: var(--space-3); }
    .wd-face { margin-top: 30px; }
    .wd-face-replay { display: none; }
    .wd-centre { inset: 27%; }
    .wd-stage { min-height: 56px; }
    .wd-action { display: none; }
    .wd-name { font-size: 17px; }
    /* The longest state wraps on the narrowest phones; two lines are held for it so nothing moves as states change. */
    .wd-state { white-space: normal; min-height: 2lh; }
    .wd-meter dd { font-size: 20px; }
    .wd-select { flex: 1 1 100%; }
    .wd-select select { width: 100%; }
    .wd-btn { flex: 1 1 0; min-width: 0; }
    .wd-diag-body { grid-template-columns: minmax(0, 1fr); }
    .wd-sliders { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .wd-stage, .wd-btn { transition: none; } }
  @media print { .wd-bar { display: none; } }
</style>

<script>
  import {
    STAGES, STAGE_ACTIONS, WINDOWS, PRESETS, OUTCOME_LABEL, evaluate, describe,
    type WindowKey,
  } from '../lib/window-model';
  import { dialArcs, dash, stageStates, endsBeyond, progress, handPosition, labelPlacements, fitsLabel, percent, RADIUS, STROKE } from '../lib/dial-geometry';

  const NS = 'http://www.w3.org/2000/svg';
  /** Milliseconds of playback for one unit of the model. */
  const UNIT_MS = 360;
  const GAP = 0.006;

  const motionEnabled = () => document.documentElement.hasAttribute('data-motion')
    && !matchMedia('(prefers-reduced-motion: reduce)').matches && !document.hidden;

  document.querySelectorAll<HTMLElement>('[data-window-dial]').forEach((dial) => {
    const $ = <T extends Element>(sel: string) => dial.querySelector<T>(sel)!;
    const $$ = <T extends Element>(sel: string) => Array.from(dial.querySelectorAll<T>(sel));
    const uid = dial.id;
    const face = $<SVGSVGElement>('.dial-face');
    const outer = $$<SVGCircleElement>('[data-df-arc]');
    const inner = $$<SVGCircleElement>('[data-df-beyond]');
    const names = $$<SVGTextElement>('[data-df-name]');
    const hand = $<SVGCircleElement>('[data-df-hand]');
    const ticks = $<SVGGElement>('[data-df-ticks]');
    const stages = $$<HTMLButtonElement>('[data-wd-stage]');
    const ranges = $$<HTMLInputElement>('[data-wd-range]');
    const windows = $$<HTMLInputElement>('.wd-window input');
    const select = $<HTMLSelectElement>('[data-wd-preset]');
    const toggle = $<HTMLButtonElement>('[data-wd-toggle]');
    const replays = $$<HTMLButtonElement>('[data-wd-replay]');
    const word = $<HTMLElement>('[data-wd-word]');
    const caption = $<HTMLElement>('[data-wd-caption]');
    const set = (el: Element, value: string) => { if (el.textContent !== value) el.textContent = value; };
    const attr = (el: Element, name: string, value: string) => { if (el.getAttribute(name) !== value) el.setAttribute(name, value); };

    let frame = 0;
    let elapsed = Infinity;
    let last = 0;
    let played = false;
    let focused: number | null = null;
    /** The stage currently picked out, by hover or by a press. */
    let shown: number | null = null;

    const durations = () => ranges.map((r) => Number(r.value));
    const windowKey = () => (windows.find((w) => w.checked)?.value ?? 'set') as WindowKey;
    const win = () => WINDOWS[windowKey()];
    const label = () => (select.value === 'custom' ? 'Your own timings' : PRESETS.find((p) => p.key === select.value)?.label ?? '');

    /** One major tick per unit of the model, so the scale follows the window being tested. */
    function drawTicks() {
      const count = win() * 4;
      if (ticks.childElementCount === count) return;
      ticks.replaceChildren(...Array.from({ length: count }, (_, i) => {
        const line = document.createElementNS(NS, 'line');
        const major = i % 4 === 0;
        line.setAttribute('x1', '300'); line.setAttribute('x2', '300');
        line.setAttribute('y1', major ? '12' : '18'); line.setAttribute('y2', '26');
        line.setAttribute('transform', `rotate(${(i / count) * 360} 300 300)`);
        if (major) line.setAttribute('class', 'is-major');
        return line;
      }));
    }

    /** Draws the state of the model at `elapsed`. Infinity is the finished chain. */
    function draw() {
      const d = durations();
      const w = win();
      const result = evaluate(d, w);
      const playing = Number.isFinite(elapsed);
      const arcs = dialArcs(d, w, elapsed);
      const find = (stage: number, ring: 'window' | 'beyond') => arcs.find((a) => a.stage === stage && a.ring === ring);
      outer.forEach((el, i) => { const v = dash(find(i, 'window'), GAP); attr(el, 'stroke-dasharray', v.array); attr(el, 'stroke-dashoffset', v.offset); });
      inner.forEach((el, i) => { const v = dash(find(i, 'beyond'), GAP); attr(el, 'stroke-dasharray', v.array); attr(el, 'stroke-dashoffset', v.offset); });

      // Each name is set along its own arc; it turns dark once the arc beneath it is drawn.
      const places = labelPlacements(d, w);
      names.forEach((el, i) => {
        const place = places[i];
        const bottom = place.at > 0.25 && place.at < 0.75;
        const path = el.querySelector('textPath')!;
        attr(path, 'href', `#${uid}-window-${bottom ? 'ccw' : 'cw'}`);
        attr(path, 'startOffset', `${(bottom ? 1 - place.at : place.at) * 100}%`);
        const drawn = find(i, place.ring);
        el.classList.toggle('on-beyond', place.ring === 'beyond');
        el.classList.toggle('on-window', place.ring === 'window');
        el.classList.toggle('is-lit', !!drawn && drawn.to >= place.at);
        el.classList.toggle('is-hidden', !fitsLabel(STAGES[i], place));
      });

      const states = stageStates(d, elapsed);
      const late = endsBeyond(d, w);
      const active = states.indexOf('active');
      stages.forEach((button, i) => {
        button.dataset.state = states[i];
        button.toggleAttribute('data-late', late[i]);
        set(button.querySelector('[data-wd-state]')!, states[i] === 'pending' ? 'Pending' : states[i] === 'active' ? 'Active'
          : late[i] ? (result.starts[i] >= w ? 'After the window' : 'Window closes here') : 'Completed');
      });
      const meter = progress(d, w, elapsed);
      set($('[data-wd-consumed]'), percent(meter.consumed));
      set($('[data-wd-remaining]'), percent(meter.remaining));
      set($('[data-wd-beyond-value]'), percent(meter.beyond));
      // The window is shown closed only once time has actually reached the boundary.
      const closed = result.outcome === 'too-late' && (!playing || elapsed >= w);
      dial.toggleAttribute('data-closed', closed);
      face.toggleAttribute('data-late', closed);
      set($('[data-wd-top]'), closed ? 'Window closed' : 'Window closes');
      set($('[data-wd-scn]'), label());
      if (playing && active > -1) { set(word, STAGES[active]); set(caption, STAGE_ACTIONS[active]); }
      else if (!playing) centre(shown);
      const at = handPosition(d, w, elapsed);
      const angle = at.turn * 2 * Math.PI;
      hand.setAttribute('cx', (300 + RADIUS[at.ring] * Math.sin(angle)).toFixed(2));
      hand.setAttribute('cy', (300 - RADIUS[at.ring] * Math.cos(angle)).toFixed(2));
      // While time runs the outcome is withheld; the model's answer shows once it has.
      dial.dataset.outcome = playing ? 'in-time' : result.outcome;
      if (playing) stages.forEach((button, i) => button.classList.toggle('is-focus', i === active));
      else highlight(focused);
    }

    /** The centre reads the outcome, or the share of the window one picked stage takes. */
    function centre(index: number | null) {
      const d = durations();
      const w = win();
      const result = evaluate(d, w);
      dial.toggleAttribute('data-reading', index !== null);
      if (index !== null) { set(word, STAGES[index]); set(caption, `Takes ${percent(d[index] / w)} of the window`); return; }
      set(word, OUTCOME_LABEL[result.outcome]);
      set(caption, result.outcome === 'too-late' ? `Window closed during ${STAGES[result.closesDuring ?? 3]}` : result.outcome === 'narrow' ? 'Inside the window, narrowly' : 'Inside the window');
    }

    function highlight(index: number | null) {
      shown = index;
      if (!Number.isFinite(elapsed)) centre(index);
      if (index === null) delete dial.dataset.focus; else dial.dataset.focus = String(index);
      [outer, inner, names, stages].forEach((group) => group.forEach((el, i) => el.classList.toggle('is-focus', i === index)));
      stages.forEach((button, i) => button.setAttribute('aria-pressed', String(focused === i)));
    }

    /** The text equivalent, written once per settled state so it is announced once. */
    function announce() {
      const result = evaluate(durations(), win());
      set($('[data-wd-sr-scn]'), label());
      set($('[data-wd-label]'), OUTCOME_LABEL[result.outcome]);
      set($('[data-wd-text]'), describe(result));
    }

    function sync() {
      const can = motionEnabled();
      const running = frame !== 0;
      const paused = !running && Number.isFinite(elapsed);
      replays.forEach((button) => { button.hidden = !can; });
      toggle.hidden = !can || !(running || paused);
      set(toggle, running ? 'Pause' : 'Resume');
      dial.toggleAttribute('data-playing', running || paused);
    }

    function settle() {
      cancelAnimationFrame(frame); frame = 0; elapsed = Infinity;
      drawTicks(); draw(); announce(); sync();
      // The settled scenario, for anything further down the page that reads the same model.
      document.dispatchEvent(new CustomEvent('intervene:scenario', { detail: { key: select.value, label: label(), durations: durations(), window: win() } }));
    }
    function run() {
      const end = durations().reduce((a, b) => a + b, 0) + 0.35;
      last = performance.now();
      const tick = (time: number) => {
        elapsed = Math.min(end, elapsed + (time - last) / UNIT_MS); last = time;
        if (elapsed >= end) { settle(); return; }
        draw();
        frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
      sync();
    }
    function play() {
      cancelAnimationFrame(frame); frame = 0; played = true; focused = null; shown = null;
      if (!motionEnabled()) { settle(); return; }
      drawTicks(); announce();
      elapsed = 0; draw(); run();
    }

    // Another instrument on the page may ask for a scenario by key. The dial
    // takes it without replaying, since it may be off screen, and announces
    // the settled result as usual.
    document.addEventListener('intervene:scenario-set', (event) => {
      const preset = PRESETS.find((p) => p.key === (event as CustomEvent<{ key: string }>).detail.key);
      if (!preset) return;
      select.value = preset.key;
      select.querySelector<HTMLOptionElement>('option[value="custom"]')!.hidden = true;
      preset.durations.forEach((value, i) => { ranges[i].value = String(value); ranges[i].setAttribute('aria-valuetext', `${value} of ${ranges[i].max}`); });
      focused = null; shown = null; played = true;
      settle();
    });

    select.addEventListener('change', () => {
      const preset = PRESETS.find((p) => p.key === select.value);
      if (!preset) return;
      preset.durations.forEach((value, i) => { ranges[i].value = String(value); ranges[i].setAttribute('aria-valuetext', `${value} of ${ranges[i].max}`); });
      play();
    });
    ranges.forEach((range) => range.addEventListener('input', () => {
      range.setAttribute('aria-valuetext', `${range.value} of ${range.max}`);
      const match = PRESETS.find((p) => p.durations.every((value, i) => value === Number(ranges[i].value)));
      select.querySelector<HTMLOptionElement>('option[value="custom"]')!.hidden = !!match;
      select.value = match ? match.key : 'custom';
      settle();
    }));
    windows.forEach((radio) => radio.addEventListener('change', () => { dial.dataset.window = windowKey(); settle(); }));
    replays.forEach((button) => button.addEventListener('click', play));
    toggle.addEventListener('click', () => {
      if (frame) { cancelAnimationFrame(frame); frame = 0; sync(); } else if (Number.isFinite(elapsed)) run();
    });
    // Picking a stage in the list picks out its arc. Hover previews it; a press holds it.
    stages.forEach((button, i) => {
      button.addEventListener('click', () => { if (Number.isFinite(elapsed)) return; focused = focused === i ? null : i; highlight(focused); });
      button.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse' && !Number.isFinite(elapsed) && focused === null) highlight(i); });
      button.addEventListener('pointerleave', (event) => { if (event.pointerType === 'mouse' && !Number.isFinite(elapsed) && focused === null) highlight(null); });
    });

    // The dial answers to the pointer as the list does: hover previews a
    // stage, a click holds it. The stage is found from the pointer's angle
    // and ring through the same geometry that draws the arcs, because a
    // browser's own hit test does not follow a dashed stroke.
    function stageAt(event: PointerEvent | MouseEvent): number | null {
      const box = face.getBoundingClientRect();
      const x = ((event.clientX - box.left) / box.width) * 600 - 300;
      const y = ((event.clientY - box.top) / box.height) * 600 - 300;
      const radius = Math.hypot(x, y);
      const ring = Math.abs(radius - RADIUS.window) <= STROKE.window / 2 ? 'window' : Math.abs(radius - RADIUS.beyond) <= STROKE.beyond / 2 + 4 ? 'beyond' : null;
      if (!ring) return null;
      const turn = (Math.atan2(x, -y) / (2 * Math.PI) + 1) % 1;
      const hit = dialArcs(durations(), win()).find((arc) => arc.ring === ring && turn >= arc.from && turn <= arc.to);
      return hit ? hit.stage : null;
    }
    face.addEventListener('click', (event) => {
      if (Number.isFinite(elapsed)) return;
      const i = stageAt(event);
      if (i === null) return;
      focused = focused === i ? null : i; highlight(focused);
    });
    face.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || Number.isFinite(elapsed)) return;
      const i = stageAt(event);
      face.style.cursor = i === null ? '' : 'pointer';
      if (focused === null && i !== shown) highlight(i);
    });
    face.addEventListener('pointerleave', () => { face.style.cursor = ''; if (focused === null && shown !== null && !Number.isFinite(elapsed)) highlight(null); });

    dial.setAttribute('data-ready', '');
    settle();
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', settle);
    document.addEventListener('visibilitychange', () => { if (document.hidden && frame) { cancelAnimationFrame(frame); frame = 0; sync(); } });
    window.addEventListener('pageshow', sync);
    window.addEventListener('beforeprint', settle);

    // One unprompted run, as the page settles, if the dial is on screen;
    // otherwise the first time it is. It never repeats by itself.
    const target = dial.querySelector('.wd-face');
    if (target && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (played || !entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.6)) return;
        observer.disconnect();
        const fonts = 'fonts' in document ? document.fonts.ready : Promise.resolve();
        Promise.race([fonts, new Promise((resolve) => window.setTimeout(resolve, 900))])
          .then(() => window.setTimeout(() => { if (!played) play(); }, 400));
      }, { threshold: 0.6 });
      observer.observe(target);
    }
  });
</script>
