---
/**
 * The three engagements as one comparison: what each establishes about a
 * named system, read across. Each includes the one before it, which the
 * filled marks show; none is a prerequisite, which the caption says.
 *
 * Names, questions, decisions, evidence, boundaries and prices read from
 * src/lib/offers.ts. The capability rows restate that file's scope,
 * deliverables and exclusions and must be re-checked against it on any
 * change there.
 *
 * Narrow screens and browsers without subgrid get three complete lists.
 * Wide screens align them as a table against one shared label column,
 * which is presentation only: each list still carries its own labels for
 * assistive technology.
 */
import { check, review, assessment } from '../lib/offers';
import { markAgda } from '../lib/marks';
import Agda from './Agda.astro';

interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel: H = 'h2' } = Astro.props;

/** `from` is the first engagement that includes the row: 0 Check, 1 Review, 2 Assessment. */
const capabilities = [
  { label: 'Finding on authority, reachability and the halt mechanism', from: 0 },
  { label: 'Live out-of-hours call-out, as one test at one time', from: 0 },
  { label: 'Evidence graded for all four steps, with a gap register', from: 1 },
  { label: 'Your own records reviewed for real timings', from: 1 },
  { label: 'Intervention window set from your records', from: 2 },
  { label: 'Best and worst-case timings, with a 25% sensitivity test', from: 2 },
  { label: 'Intervention Readiness verdict, with its basis and limitations', from: 2 },
  { label: 'Remediation priorities and a board report', from: 2 },
];

const routes = [
  { o: check, kicker: 'Entry point', short: 'Authority Check', boundary: 'Not an AGDA® verdict, SEDI result or score, and no attestation. Prepared without independent review. A finding about this system only.', href: '/services/#check' },
  { o: review, kicker: 'Preliminary', short: 'Review', boundary: 'The Review does not include the AGDA® verdict, the window set from your records or signed SEDI result records.', href: '/services/#review' },
  { o: assessment, kicker: 'Full assessment', short: 'Assessment', boundary: 'One system, one pathway, one scenario. Connected systems are scoped separately.', href: '/services/#assessment' },
];
const fields = ['Question and decision', 'Evidence examined', 'Boundary'];
---
<figure class="offer-choice offer-ladder" aria-labelledby="offer-choice-heading">
  <figcaption class="ol-caption" data-offer-view="offer_choice">
    <H class="h2" id="offer-choice-heading">Three questions.</H>
    <p class="ol-principle">One named system. Each engagement includes the one before it, and none is a prerequisite.</p>
  </figcaption>

  <div class="ol-grid">
    <div class="ol-labels" aria-hidden="true">
      <span class="ol-cell ol-corner"></span>
      {capabilities.map((c) => <span class="ol-cell ol-label">{c.label}</span>)}
      {fields.map((f) => <span class="ol-cell ol-label ol-field-label">{f}</span>)}
      <span class="ol-cell"></span>
    </div>

    <ol class="ol-routes" role="list">
      {routes.map(({ o, kicker, short, boundary, href }, level) => (
        <li class="ol-route oc-route">
          <div class="ol-cell ol-head oc-head">
            <span class="mono ol-kicker">{kicker}</span>
            <h3 class="ol-name oc-name" set:html={markAgda(o.name)} />
            <span class="ol-q oc-q">{o.question}</span>
          </div>
          <ul class="ol-caps" role="list" aria-label={`${o.name}: what it establishes`}>
            {capabilities.map((c) => (
              <li class:list={['ol-cell', 'ol-cap', c.from <= level ? 'is-on' : 'is-off']}>
                <span class="ol-mark" aria-hidden="true"></span>
                <span class="ol-cap-text">{c.label}<span class="ol-sr">{c.from <= level ? ': included' : ': not included'}</span></span>
              </li>
            ))}
          </ul>
          <dl class="ol-fields oc-fields">
            <div class="ol-cell"><dt>Question and decision</dt><dd set:html={markAgda(o.decision)} /></div>
            <div class="ol-cell"><dt>Evidence examined</dt><dd>{o.examined}</dd></div>
            <div class="ol-cell"><dt>Boundary</dt><dd set:html={markAgda(boundary)} /></div>
          </dl>
          <div class="ol-cell ol-foot">
            <span class="ol-price-note mono">{o.priceNote}</span>
            <span class="ol-price oc-price">{o.price}</span>
            <a href={href} class="link ol-link oc-link" data-offer-select={o.slug}>Explore the {short} <span aria-hidden="true">→</span></a>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <p class="body muted ol-note">
    The Authority Check is not an <Agda /> verdict. A Review may recommend a
    full Assessment but does not commit you to one or determine its verdict.
  </p>
</figure>

<style>
  .offer-ladder { margin: 0; }
  .ol-caption { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--space-4) var(--space-7); align-items: end; }
  .ol-caption .h2 { margin: 0; }
  .ol-principle { margin: 0; font-size: var(--type-support); line-height: 1.5; color: var(--muted); }

  .ol-grid { margin-top: var(--space-6); }
  .ol-labels { display: none; }
  .ol-routes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-7); }
  .ol-route { min-width: 0; border-top: 1px solid var(--hair-strong); }

  .ol-head { display: grid; gap: var(--space-2); align-content: start; padding: var(--space-4) 0 var(--space-5); }
  .ol-kicker { font-size: var(--type-caption); line-height: 1.6; color: var(--accent-text); }
  .ol-name { margin: 0; font-size: var(--type-h3); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.2; color: var(--ink); }
  .ol-q { font-size: var(--type-body); line-height: 1.5; color: var(--ink); }

  .ol-caps { list-style: none; margin: 0; padding: 0; }
  .ol-cap { display: grid; grid-template-columns: 13px minmax(0, 1fr); gap: var(--space-3); align-items: start; padding: var(--space-2) 0; border-top: 1px solid var(--hair); font-size: var(--type-small); line-height: 1.5; color: var(--ink); }
  .ol-mark { width: 13px; height: 13px; margin-top: 5px; border: 1px solid var(--ink); border-radius: 50%; background: var(--ink); box-sizing: border-box; }
  .ol-cap.is-off { color: var(--faint); }
  .ol-cap.is-off .ol-mark { width: 13px; height: 1px; margin-top: 12px; border: 0; border-radius: 0; background: var(--hair-strong); }
  .ol-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .ol-fields { margin: 0; }
  .ol-fields > div { display: grid; gap: 6px; align-content: start; padding: var(--space-3) 0; border-top: 1px solid var(--hair); }
  .ol-fields > div:first-child { border-top-color: var(--hair-strong); }
  .ol-fields dt { font-family: var(--font-mono); font-size: var(--type-caption); line-height: 1.6; color: var(--faint); }
  .ol-fields dd { margin: 0; font-size: var(--type-small); line-height: 1.6; color: var(--muted); }

  .ol-foot { display: grid; gap: 4px; justify-items: start; align-content: start; padding: var(--space-4) 0 0; border-top: 1px solid var(--hair-strong); }
  .ol-price-note { font-size: var(--type-caption); line-height: 1.6; color: var(--faint); }
  .ol-price { font-family: var(--font-mono); font-size: clamp(18px, 1.7vw, 22px); line-height: 1.4; color: var(--ink); }
  .ol-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-top: var(--space-2); font-size: var(--type-small); }
  .ol-note { margin: var(--space-6) 0 0; font-size: var(--type-small); line-height: 1.7; }

  @media (max-width: 880px) {
    .ol-caption { grid-template-columns: 1fr; }
  }

  /* Wide screens: one table. Fifteen shared rows (head, eight capabilities,
     three fields, foot) run through the label column and all three offers. */
  @media (min-width: 1081px) {
    @supports (grid-template-rows: subgrid) {
      .ol-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 3fr); grid-template-rows: auto repeat(11, auto) auto; }
      .ol-labels, .ol-routes { grid-row: 1 / -1; display: grid; grid-template-rows: subgrid; }
      .ol-routes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; }
      .ol-route { grid-row: 1 / -1; display: grid; grid-template-rows: subgrid; }
      .ol-caps { grid-row: span 8; display: grid; grid-template-rows: subgrid; }
      .ol-fields { grid-row: span 3; display: grid; grid-template-rows: subgrid; }
      .ol-labels { border-top: 1px solid var(--hair-strong); }
      .ol-grid .ol-cell { padding-right: var(--space-5); }
      .ol-grid .ol-route:last-child .ol-cell { padding-right: 0; }
      .ol-label { display: flex; align-items: center; padding-top: var(--space-2); padding-bottom: var(--space-2); border-top: 1px solid var(--hair); font-size: var(--type-small); line-height: 1.5; color: var(--ink); }
      .ol-field-label { align-items: flex-start; padding-top: var(--space-3); font-family: var(--font-mono); font-size: var(--type-caption); line-height: 1.9; color: var(--faint); }
      .ol-labels .ol-label:nth-child(10) { border-top-color: var(--hair-strong); }
      .ol-labels .ol-cell:last-child { border-top: 1px solid var(--hair-strong); }
      .ol-cap { grid-template-columns: 13px; align-items: center; min-height: 48px; }
      .ol-cap .ol-mark { margin-top: 0; }
      .ol-cap.is-off .ol-mark { margin-top: 0; }
      .ol-cap-text, .ol-fields dt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .ol-cap { position: relative; }
      .ol-fields > div { position: relative; }
    }
  }
</style>
