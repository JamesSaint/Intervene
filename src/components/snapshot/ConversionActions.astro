---
/**
 * The three conversion actions. Exactly three, no others.
 *
 * copy-2.0 rewrote the labels. The previous set was product-centric:
 * "Email me my Snapshot", "Learn how AGDA™ validates these findings",
 * "Contact Intervene". They described what Intervene would do, not what
 * the visitor had just realised.
 *
 * At this point on the page the visitor has established that they
 * cannot answer their own question. The primary action should be the
 * answer to that feeling, not an offer of literature. So the strongest
 * action is now "Find out whether it holds", and the supporting note
 * carries the commercial fact rather than the button.
 *
 * "Send me the board version" was considered and rejected. It implies a
 * second artefact that does not exist, which is an overpromise, and it
 * frames the page as a lead magnet at exactly the moment it should feel
 * like a finding. "Send me this" makes the same offer honestly.
 *
 * `learn_agda` remains navigational: no record, no contact details.
 */

import FollowUpForm from './FollowUpForm.astro';

interface Props {
  prototype?: boolean;
}

const { prototype = true } = Astro.props as Props;

const actions = [
  {
    id: 'contact_intervene',
    label: 'Find out whether it holds',
    note: 'A conversation about testing one of these assumptions properly. A person replies within one to two working days.',
    needsDetails: true,
  },
  {
    id: 'learn_agda',
    label: 'How AGDA™ tests this',
    note: 'No details required.',
    needsDetails: false,
    href: '/agda/',
  },
  {
    id: 'email_snapshot_and_sample',
    label: 'Send me this',
    note: 'Your result, and a tested verdict for comparison.',
    needsDetails: true,
  },
];

const markAgda = (value: string) =>
  value.replace(/AGDA(?:™)?/g, '<span class="agda-mark">AGDA<span class="agda-tm">™</span></span>');
---

<section class="block tight conversion" data-conversion hidden aria-labelledby="conversion-heading">
  <div class="wrap-narrow">
    <h2 class="h3" id="conversion-heading">How would you actually know?</h2>

    <ul class="action-list" data-action-list>
      {actions.map((action, index) => (
        <li class="action" data-action-id={action.id}>
          {action.href ? (
            <a
              class={index === 0 ? 'btn' : 'btn-ghost'}
              href={action.href}
              data-action-link={action.id}
              set:html={markAgda(action.label)}
            />
          ) : (
            <button
              type="button"
              class={index === 0 ? 'btn' : 'btn-ghost'}
              data-action-open={action.id}
              set:html={markAgda(action.label)}
            />
          )}
          <p class="action-note body-sm" set:html={markAgda(action.note)} />
        </li>
      ))}
    </ul>

    <FollowUpForm prototype={prototype} />
  </div>
</section>

<style>
  .conversion {
    border-top: 1px solid var(--hair);
    padding-top: 56px;
  }

  .action-list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    gap: 32px;
  }

  .action {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--hair);
  }
  .action:last-child { border-bottom: 0; padding-bottom: 0; }

  .action-note {
    margin: 0;
    color: var(--faint);
    max-width: 52ch;
  }

  @media (max-width: 720px) {
    .action .btn,
    .action .btn-ghost {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  @media print {
    .conversion { display: none; }
  }
</style>
