---
/**
 * Mechanism descriptors for signed SEDI result records. Used on /verify/
 * only, where the surrounding copy states the condition (signed records
 * are supplied where the agreed scope includes them and the delivery
 * configuration supports them). Not a universal claim about every
 * assessment, so not shown on the homepage verdict object.
 */
interface Props {
  align?: 'start' | 'center';
}
const { align = 'start' } = Astro.props;
const marks = ['Ed25519 signature', 'Append-only registry', 'Offline verifier'];
---

<ul class={`proof-marks ${align}`} role="list" aria-label="Signed SEDI result record mechanisms">
  {marks.map((m) => (
    <li class="mono"><span class="tick" aria-hidden="true"></span>{m}</li>
  ))}
</ul>

<style>
  .proof-marks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
  }
  .proof-marks.center { justify-content: center; }
  .proof-marks > li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-soft);
  }
  .tick {
    width: 5px;
    height: 5px;
    background: var(--accent);
    flex: none;
  }
  @media (max-width: 560px) {
    .proof-marks { gap: 10px 20px; }
  }
</style>
