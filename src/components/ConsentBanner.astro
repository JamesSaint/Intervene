---
// Minimal, non-blocking cookie consent for Google Analytics (Consent Mode v2).
// Consent defaults are set to `denied` in BaseLayout before gtag fires; this banner
// only ever upgrades to `granted` on explicit Accept. Choice is stored in localStorage
// (a preference, PECR-exempt), never a cookie. No modal, no content wall, no focus trap.
---

<div class="consent" role="region" aria-label="Cookie consent" hidden>
  <div class="wrap consent-inner">
    <p class="consent-copy">
      Google Analytics cookies tell us which pages get read. They are set only
      if you accept, and the data goes to Google. Decline and none are set.
      <a href="/legal/privacy/">What we collect</a>.
    </p>
    <div class="consent-actions">
      <button type="button" class="consent-btn" data-consent="denied">Decline</button>
      <button type="button" class="consent-btn consent-accept" data-consent="granted">Accept</button>
    </div>
  </div>
</div>

<script>
  const KEY = 'intv-consent';

  class Consent {
    private el: HTMLElement;
    private isOpen = false;
    private returnFocus: HTMLElement | null = null;
    private hideTimer: number | undefined;

    constructor(el: HTMLElement) {
      this.el = el;
      el.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) => {
        b.addEventListener('click', () => this.choose(b.getAttribute('data-consent')));
      });
      document.querySelectorAll<HTMLButtonElement>('[data-consent-reopen]').forEach((t) => {
        t.addEventListener('click', () => this.open(t));
      });
      // Reserve exactly the banner's height, including after a resize,
      // so the final footer links can always scroll clear of it.
      new ResizeObserver(() => this.reserveSpace()).observe(el);
      let stored = null;
      try { stored = localStorage.getItem(KEY); } catch {}
      if (stored !== 'granted' && stored !== 'denied') this.open();
    }

    private reserveSpace() {
      const height = this.isOpen ? this.el.offsetHeight : 0;
      document.body.style.setProperty('--consent-clearance', `${height}px`);
    }

    private open(trigger: HTMLElement | null = null) {
      window.clearTimeout(this.hideTimer);
      this.isOpen = true;
      this.returnFocus = trigger;
      this.el.hidden = false;
      this.reserveSpace();
      requestAnimationFrame(() => {
        if (!this.isOpen) return;
        this.el.classList.add('open');
        // Initial display is non-blocking. An explicit reopening brings
        // the keyboard to the controls and returns it after choosing.
        if (trigger) this.el.querySelector<HTMLButtonElement>('[data-consent]')?.focus({ preventScroll: true });
      });
    }

    private close() {
      this.isOpen = false;
      this.el.classList.remove('open');
      this.returnFocus?.focus({ preventScroll: true });
      this.returnFocus = null;
      const finish = () => {
        if (this.isOpen) return;
        this.el.hidden = true;
        this.reserveSpace();
      };
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) finish();
      else this.hideTimer = window.setTimeout(finish, 340);
    }

    private choose(value: string | null) {
      if (value !== 'granted' && value !== 'denied') return;
      try { localStorage.setItem(KEY, value); } catch {}
      const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
      gtag?.('consent', 'update', { analytics_storage: value });
      if (value === 'denied') {
        // Expire any GA cookies already set in a prior session.
        document.cookie.split(';').forEach((c) => {
          const name = c.split('=')[0].trim();
          if (name === '_ga' || name.indexOf('_ga_') === 0) {
            document.cookie = name + '=; Max-Age=0; path=/; domain=.' + location.hostname;
            document.cookie = name + '=; Max-Age=0; path=/';
          }
        });
      }
      this.close();
    }
  }

  const el = document.querySelector<HTMLElement>('.consent');
  if (el) new Consent(el);
</script>

<style>
  .consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1200;
    background: var(--paper-raise);
    border-top: 1px solid var(--hair-strong);
    transform: translateY(100%);
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .consent.open { transform: translateY(0); }

  /* The horizontal padding must be restated. This element carries
     `.wrap`, but a `padding: 16px 0` shorthand here zeroes the gutter
     `.wrap` provides, which left the banner running edge to edge on a
     phone and sitting 64px wider than every other content column on
     desktop. */
  .consent-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 16px var(--gutter);
    padding-bottom: calc(16px + env(safe-area-inset-bottom));
  }
  .consent-copy {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
    max-width: calc(78 * var(--ch));
  }
  .consent-copy a {
    color: var(--muted);
    border-bottom: 1px solid var(--hair-strong);
    transition: color var(--dur-hover) var(--ease);
  }
  .consent-copy a:hover { color: var(--ink); }

  .consent-actions {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }
  /* A 44px target for both choices, with a visible keyboard ring. */
  .consent-btn {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--hair-strong);
    padding: 12px 22px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      color var(--dur-hover) var(--ease),
      border-color var(--dur-hover) var(--ease),
      background var(--dur-hover) var(--ease);
  }
  .consent-btn:hover { color: var(--ink); border-color: var(--muted); }
  .consent-accept {
    color: var(--inverse-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .consent-accept:hover {
    color: var(--inverse-ink);
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @media (max-width: 720px) {
    .consent-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 16px var(--gutter-tight);
      padding-bottom: calc(16px + env(safe-area-inset-bottom));
    }
    .consent-actions { width: 100%; }
    .consent-btn { flex: 1; text-align: center; }
  }
  @media (max-width: 360px) {
    .consent-inner { padding: 12px var(--gutter-tight); padding-bottom: calc(12px + env(safe-area-inset-bottom)); gap: 10px; }
    .consent-copy { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent { transition: none; }
  }
</style>
