---
/**
 * The research programme and commercial assessments as two lanes. Filled
 * nodes are current work; the open node is a subsequent stage. The one link
 * between the lanes applies only where a client separately agrees to research
 * participation. Orientation only: nothing here is a result, a measurement or
 * a claim of validation.
 *
 * Content is drawn from first paint. Where motion is allowed, the rails and
 * the agreed link draw once when the figure enters view; text never moves.
 */
import Agda from './Agda.astro';
---
<figure class="research-programme" aria-labelledby="rp-caption" data-rp>
  <div class="rp-lane">
    <h3 class="rp-lane-name">Research</h3>
    <ol role="list">
      <li class="is-on"><span class="rp-node" aria-hidden="true"></span><span class="rp-step">Theoretical model</span><span class="rp-note">Intervention feasibility as a condition of deployment</span></li>
      <li class="is-on"><span class="rp-node" aria-hidden="true"></span><span class="rp-step">Retrospective analysis</span><span class="rp-note">Documented historical failures</span></li>
      <li class="is-next"><span class="rp-node" aria-hidden="true"></span><span class="rp-step">Prospective evaluation</span><span class="rp-note">A subsequent stage: assessments against observed performance</span></li>
      <li class="rp-rail" aria-hidden="true"></li>
    </ol>
  </div>

  <div class="rp-bridge">
    <div class="rp-bridge-body">
      <span class="rp-link" aria-hidden="true"></span>
      <p>Only where a client separately agrees, subject to consent, confidentiality and research integrity requirements.</p>
    </div>
  </div>

  <div class="rp-lane">
    <h3 class="rp-lane-name">Commercial assessments</h3>
    <ol role="list">
      <li class="is-on"><span class="rp-node" aria-hidden="true"></span><span class="rp-step">Defined scope</span><span class="rp-note">One system, pathway and scenario</span></li>
      <li class="is-on"><span class="rp-node" aria-hidden="true"></span><span class="rp-step"><Agda /> assessment</span><span class="rp-note">The evidence for intervention capability</span></li>
      <li class="is-on"><span class="rp-node" aria-hidden="true"></span><span class="rp-step">Client findings</span><span class="rp-note">Constraints on effective action</span></li>
      <li class="rp-rail" aria-hidden="true"></li>
    </ol>
  </div>

  <figcaption id="rp-caption">Filled: current work. Open: a subsequent stage. Research participation is not a condition of an assessment.</figcaption>
</figure>

<script>
  // One bounded draw per page view. Content is never hidden without script.
  const figure = document.querySelector<HTMLElement>('[data-rp]');
  const allowed = () => document.documentElement.hasAttribute('data-motion')
    && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (figure && allowed() && 'IntersectionObserver' in window) {
    const box = figure.getBoundingClientRect();
    // Already on screen at load: leave it drawn.
    if (box.top > innerHeight) {
      figure.classList.add('rp-pending');
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        figure.classList.remove('rp-pending');
        figure.classList.add('rp-draw');
      }, { threshold: 0.35 });
      observer.observe(figure);
    }
  }
</script>

<style>
  /* One grid for the figure: the lane-name column fits the longest name and
     both lanes and the link share it through subgrid, so the rails align. */
  .research-programme { margin: var(--gap-sub) 0 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); column-gap: var(--space-6); }
  .rp-lane { position: relative; grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; align-items: start; }
  .rp-lane-name { margin: 0; padding-top: var(--space-3); font-size: var(--type-card); line-height: 1.25; color: var(--ink); }
  .rp-lane ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--hair-strong); position: relative; }
  /* The drawn rail sits over the static hairline and is what animates. */
  .rp-lane li.rp-rail { position: absolute; top: -1px; left: 0; right: 0; height: 1px; padding: 0; background: var(--ink); transform-origin: left center; }
  .rp-lane li { position: relative; display: grid; align-content: start; gap: var(--space-1); padding: var(--space-3) var(--space-4) 0 0; min-width: 0; }
  .rp-node { position: absolute; left: 0; top: -8px; width: 15px; height: 15px; border-radius: 50%; box-sizing: border-box; border: 1px solid var(--ink); background: var(--ink); z-index: 1; }
  .is-next .rp-node { background: var(--paper); border-style: dashed; }
  .rp-step { font-size: clamp(17px, 1.6vw, 22px); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.25; color: var(--ink); }
  .is-next .rp-step { color: var(--muted); }
  .rp-note { font-size: var(--type-small); line-height: 1.6; color: var(--muted); }

  /* The agreed link: from the client findings up to prospective evaluation,
     in the third column of both lanes. Dashed because it is conditional. */
  .rp-bridge { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; }
  .rp-bridge-body { grid-column: 2; position: relative; min-height: 120px; display: flex; align-items: center; }
  .rp-link { position: absolute; top: var(--space-1); bottom: var(--space-1); left: calc(100% * 2 / 3 + 7px); border-left: 1px dashed var(--ink); transform-origin: bottom center; }
  .rp-bridge p { margin: 0; padding: var(--space-4) 0 var(--space-4) calc(100% * 2 / 3 + var(--space-4) + 7px); font-size: var(--type-small); line-height: 1.6; color: var(--muted); }

  figcaption { grid-column: 1 / -1; margin-top: var(--space-5); font-family: var(--font-mono); font-size: var(--type-caption); line-height: 1.65; color: var(--faint); }

  @media (prefers-reduced-motion: no-preference) {
    .rp-pending .rp-rail { transform: scaleX(0); }
    .rp-pending .rp-link { transform: scaleY(0); }
    .rp-draw .rp-rail { animation: rp-rail var(--dur-reveal) var(--ease-enter) both; }
    .rp-draw .rp-lane:last-of-type .rp-rail { animation-delay: 120ms; }
    .rp-draw .rp-link { animation: rp-link var(--dur-reveal) var(--ease-enter) 360ms both; }
  }
  @keyframes rp-rail { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes rp-link { from { transform: scaleY(0); } to { transform: scaleY(1); } }

  /* Narrow screens: each lane reads down a rail on the left, and the agreed
     link becomes a dashed note between the lanes. */
  @media (max-width: 880px) {
    .research-programme { grid-template-columns: minmax(0, 1fr); }
    .rp-lane, .rp-bridge { gap: var(--space-3); }
    .rp-lane ol { grid-template-columns: 1fr; border-top: 0; border-left: 1px solid var(--hair-strong); margin-left: 7px; gap: var(--space-4); }
    .rp-lane li { padding: 0 0 0 var(--space-4); }
    .rp-node { left: -8px; top: 4px; }
    .rp-lane li.rp-rail { display: none; }
    .rp-bridge-body { grid-column: 1; min-height: 0; margin: var(--space-4) 0 var(--space-4) 7px; border-left: 1px dashed var(--ink); }
    .rp-link { display: none; }
    .rp-bridge p { padding: var(--space-3) 0 var(--space-3) var(--space-4); }
  }
</style>
