---
/**
 * The intervention window as a working model: four sequential stages spend
 * time against one window, and the visitor can change any of them.
 *
 * Illustrative only. Units are relative, the model is not the AGDA® engine
 * and its outcome is not a verdict; the note under the plot says so and is
 * always visible. The first paint is rendered here from the same model the
 * script uses, so the figure reads correctly without JavaScript.
 */
import {
  AXIS, STAGES, STAGE_MIN, STAGE_MAX, WINDOWS, PRESETS, DEFAULT_PRESET,
  OUTCOME_LABEL, evaluate, describe,
} from '../lib/window-model';

interface Props { id?: string }
const { id = 'window-lab' } = Astro.props;

const what = [
  'Recognise the need to act',
  'Reach decision authority',
  'Make the decision',
  'Put it into effect',
];
const preset = PRESETS.find((p) => p.key === DEFAULT_PRESET)!;
const result = evaluate(preset.durations, WINDOWS.set);
const windows = [
  { key: 'shorter', label: '25% shorter' },
  { key: 'set', label: 'As set' },
  { key: 'longer', label: '25% longer' },
];
---
<div
  class="window-lab"
  id={id}
  data-window-lab
  data-outcome={result.outcome}
  style={`--wl-axis:${AXIS};--wl-w:${WINDOWS.set};--wl-p:${AXIS}`}
>
  <div class="wl-bar-top">
    <fieldset class="wl-presets">
      <legend>Scenario</legend>
      {PRESETS.map((p) => (
        <label>
          <input type="radio" name={`${id}-preset`} value={p.key} checked={p.key === preset.key} />
          <span>{p.label}</span>
        </label>
      ))}
    </fieldset>
    <button class="wl-replay" type="button" data-wl-replay hidden><span class="wl-play" aria-hidden="true"></span>Run the scenario</button>
  </div>
  <p class="wl-scenario" data-wl-scenario>{preset.text}</p>

  <figure class="wl-figure" aria-labelledby={`${id}-result`} aria-describedby={`${id}-note`}>
    <div class="wl-row wl-axis" aria-hidden="true">
      <span class="wl-ctl"></span>
      <span class="wl-track">
        <span class="wl-mark wl-mark-start">Signal</span>
        <span class="wl-mark wl-mark-close">Window closes</span>
        <span class="wl-mark wl-mark-after">Irreversible</span>
        <span class="wl-head"></span>
      </span>
    </div>
    <div class="wl-row wl-sum" aria-hidden="true">
      <span class="wl-ctl"><span class="wl-sum-label">The chain, end to end</span></span>
      <span class="wl-track">
        {STAGES.map((_, i) => (
          <span class="wl-seg" data-wl-seg style={`--wl-s:${result.starts[i]};--wl-d:${preset.durations[i]}`}></span>
        ))}
        <span class="wl-head"></span>
      </span>
    </div>
    <ol class="wl-rows" role="list">
      {STAGES.map((stage, i) => (
        <li class="wl-row" data-wl-row style={`--wl-s:${result.starts[i]};--wl-d:${preset.durations[i]}`}>
          <div class="wl-ctl">
            <label class="wl-name" for={`${id}-${i}`}>{stage}</label>
            <span class="wl-what">{what[i]}</span>
            <input
              class="wl-range"
              type="range"
              id={`${id}-${i}`}
              min={STAGE_MIN}
              max={STAGE_MAX}
              step="1"
              value={preset.durations[i]}
              aria-label={`${stage}: time taken`}
              aria-valuetext={`${preset.durations[i]} of ${STAGE_MAX}`}
              data-wl-stage={i}
            />
          </div>
          <div class="wl-track" aria-hidden="true">
            <span class="wl-bar"></span>
            <span class="wl-node"></span>
            <span class="wl-head"></span>
          </div>
        </li>
      ))}
    </ol>
    <figcaption class="wl-readout">
      <p class="wl-result" id={`${id}-result`} aria-live="polite">
        <strong class="wl-outcome" data-wl-outcome><span class="wl-dot" aria-hidden="true"></span><span data-wl-label>{OUTCOME_LABEL[result.outcome]}</span></strong>
        <span class="wl-text" data-wl-text>{describe(result)}</span>
      </p>
      <p class="wl-status" data-wl-status aria-hidden="true"></p>
      <fieldset class="wl-window">
        <legend>Test the window</legend>
        {windows.map((w) => (
          <label>
            <input type="radio" name={`${id}-window`} value={w.key} checked={w.key === 'set'} />
            <span>{w.label}</span>
          </label>
        ))}
      </fieldset>
    </figcaption>
  </figure>

  <p class="wl-note" id={`${id}-note`}>
    Illustrative model. Relative units, not measured durations, and not an
    assessment result. An assessment sets the window from your own records.
  </p>
</div>

<noscript><style is:inline>.wl-bar-top, .wl-range, .wl-window { display: none !important; }</style></noscript>

<style>
  @property --wl-w { syntax: '<number>'; inherits: true; initial-value: 12; }
  @property --wl-s { syntax: '<number>'; inherits: true; initial-value: 0; }
  @property --wl-d { syntax: '<number>'; inherits: true; initial-value: 1; }

  /* An instrument, not a chart on the page: one dark surface in both
     appearances, so the model reads as a single object. Its palette is the
     site's dark palette, scoped here; nothing outside the panel changes. */
  .window-lab {
    --paper: #0a0a0a;
    --ink: #f0f0f0;
    --muted: #c8c6c4;
    --faint: #8e8b87;
    --hair: rgba(240, 240, 240, 0.10);
    --hair-strong: rgba(240, 240, 240, 0.26);
    --control-border: rgba(240, 240, 240, 0.42);
    --control-active: #f0f0f0;
    --focus: #c9b694;
    --warn: #e0766a;
    --hold: #c9b694;
    --pass: #8aaa91;
    --signal: #c9b694;
    --wl-ctl: 232px;
    --wl-gap: var(--space-5);
    --wl-pad: clamp(20px, 3vw, 44px);
    color-scheme: dark;
    background: var(--paper);
    color: var(--ink);
    padding: var(--wl-pad);
    transition: --wl-w var(--dur-expand) var(--ease-out);
  }
  :global(:root[data-theme='dark']) .window-lab { --paper: #141414; border: 1px solid rgba(201, 182, 148, 0.18); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .window-lab { --paper: #141414; border: 1px solid rgba(201, 182, 148, 0.18); }
  }

  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  fieldset label { position: relative; cursor: pointer; }
  fieldset input { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  fieldset input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 3px; }

  .wl-bar-top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); border-bottom: 1px solid var(--hair-strong); }
  /* Equal cells, so the number of rows never depends on which font has loaded. */
  .wl-presets { flex: 1; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0 var(--space-4); }
  .wl-presets label > span {
    position: relative; display: flex; align-items: center; height: 56px; font-size: var(--type-action); font-weight: 600; line-height: 1.25; color: var(--faint);
    transition: color var(--dur-fast) var(--ease);
  }
  .wl-presets label > span::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--ink); transform: scaleX(0); transform-origin: left center; transition: transform var(--dur-expand) var(--ease-out); }
  .wl-presets input:checked + span { color: var(--ink); }
  .wl-presets input:checked + span::after { transform: scaleX(1); }
  .wl-presets label:hover span { color: var(--ink); }
  .wl-replay { flex: none; display: inline-flex; align-items: center; gap: 10px; height: 56px; padding: 0 0 0 var(--space-3); white-space: nowrap; font-size: var(--type-action); font-weight: 600; color: var(--ink); }
  /* Hidden when motion is off, but still holding its place. */
  .wl-replay[hidden] { display: inline-flex; visibility: hidden; }
  .wl-replay:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .wl-play { width: 0; height: 0; border-style: solid; border-width: 5px 0 5px 8px; border-color: transparent transparent transparent var(--signal); transition: transform var(--dur-fast) var(--ease-out); }
  .wl-replay:hover .wl-play { transform: translateX(2px); }

  .wl-scenario { margin: var(--space-5) 0 0; min-height: 3lh; max-width: 30ch; font-size: clamp(22px, 2.5vw, 34px); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.22; color: var(--ink); }

  .wl-figure { margin: var(--space-5) 0 0; }
  .wl-rows { list-style: none; margin: 0; padding: 0; }
  .wl-row { display: grid; grid-template-columns: var(--wl-ctl) minmax(0, 1fr); gap: 0 var(--wl-gap); align-items: stretch; }
  .wl-rows .wl-row, .wl-sum { border-top: 1px solid var(--hair); }
  .wl-rows .wl-row { transition: --wl-s var(--dur-expand) var(--ease-out), --wl-d var(--dur-expand) var(--ease-out); }
  .wl-rows .wl-row:last-child { border-bottom: 1px solid var(--hair-strong); }
  .wl-sum { border-top-color: var(--hair-strong); }

  .wl-ctl { display: grid; grid-template-columns: 1fr; gap: 2px; align-content: center; padding: var(--space-3) 0 var(--space-1); min-width: 0; }
  .wl-name { font-size: var(--type-card); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.25; color: var(--ink); }
  .wl-what { font-size: var(--type-action); line-height: 1.5; color: var(--muted); }
  .wl-sum .wl-ctl { padding: var(--space-3) 0; }
  .wl-sum-label { font-size: var(--type-action); line-height: 1.5; color: var(--muted); }

  /* The whole 44px band is the target; the drawn track is a hairline. */
  .wl-range { display: block; visibility: hidden; appearance: none; -webkit-appearance: none; width: 100%; max-width: 184px; height: 44px; margin: -4px 0 0; padding: 0; background: transparent; cursor: ew-resize; }
  .window-lab[data-ready] .wl-range { visibility: visible; }
  .wl-range::-webkit-slider-runnable-track { height: 1px; background: var(--control-border); }
  .wl-range::-moz-range-track { height: 1px; background: var(--control-border); }
  .wl-range::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 18px; height: 18px; margin-top: -9px; border-radius: 50%; border: 1px solid var(--ink); background: var(--paper); transition: background-color var(--dur-fast) var(--ease); }
  .wl-range::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; border: 1px solid var(--ink); background: var(--paper); }
  .wl-range:is(:hover, :active)::-webkit-slider-thumb { background: var(--ink); }
  .wl-range:is(:hover, :active)::-moz-range-thumb { background: var(--ink); }
  .wl-range:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

  /* Each track draws its own slice of the closed region, so the rows read
     as one continuous zone on wide screens and stand alone when stacked.
     The region takes the warning tint only once the chain has run into it. */
  .wl-track { position: relative; min-height: 28px; }
  .wl-track::after {
    content: ''; position: absolute; top: 0; bottom: 0; right: 0;
    left: calc(var(--wl-w) / var(--wl-axis) * 100%);
    border-left: 1px dashed var(--control-border);
    background: repeating-linear-gradient(135deg, var(--hair) 0 1px, transparent 1px 11px);
    pointer-events: none;
    transition: background-color var(--dur-signal) var(--ease);
  }
  .window-lab[data-outcome='too-late'] .wl-track::after { background-color: color-mix(in srgb, var(--warn) 13%, transparent); border-left-color: var(--warn); border-left-style: solid; }
  /* A stage starts where the one before it ended. */
  .wl-rows .wl-row + .wl-row .wl-track::before {
    content: ''; position: absolute; top: -1px; height: calc(50% + 1px); width: 1px;
    left: calc(var(--wl-s) / var(--wl-axis) * 100%);
    background: var(--hair-strong);
    opacity: clamp(0, calc((var(--wl-p) - var(--wl-s)) * 100 + 1), 1);
  }
  .wl-bar, .wl-seg {
    position: absolute; z-index: 1;
    left: calc(var(--wl-s) / var(--wl-axis) * 100%);
    width: calc(var(--wl-d) / var(--wl-axis) * 100%);
    --wl-cut: clamp(0%, calc((var(--wl-w) - var(--wl-s)) / var(--wl-d) * 100%), 100%);
    background: linear-gradient(to right, var(--ink) 0 var(--wl-cut), var(--warn) var(--wl-cut) 100%);
    clip-path: inset(0 calc((1 - clamp(0, calc((var(--wl-p) - var(--wl-s)) / var(--wl-d)), 1)) * 100%) 0 0);
  }
  .wl-bar { top: calc(50% - 6px); height: 12px; }
  /* End to end: the four stages on one line, a hairline apart. */
  .wl-seg { top: calc(50% - 10px); height: 20px; box-shadow: inset -2px 0 0 var(--paper); transition: --wl-s var(--dur-expand) var(--ease-out), --wl-d var(--dur-expand) var(--ease-out); }
  .wl-sum .wl-track { min-height: 56px; }
  .wl-node {
    position: absolute; z-index: 2; top: calc(50% - 7.5px); width: 15px; height: 15px; margin-left: -7.5px;
    left: calc((var(--wl-s) + var(--wl-d)) / var(--wl-axis) * 100%);
    border: 1px solid var(--ink); border-radius: 50%; background: var(--paper);
    opacity: clamp(0, calc((var(--wl-p) - var(--wl-s) - var(--wl-d)) * 100 + 1), 1);
  }
  /* The last node is the intervention itself: filled when it lands in
     time, a square when it lands after the window (the site's late mark). */
  .wl-row:last-child .wl-node { background: var(--ink); }
  .window-lab[data-outcome='too-late'] .wl-row:last-child .wl-node { border-radius: 0; border-color: var(--warn); background: var(--warn); }

  /* Time itself: one line crossing every row while the scenario runs. */
  .wl-head { position: absolute; z-index: 3; top: 0; bottom: 0; width: 1px; left: calc(var(--wl-p) / var(--wl-axis) * 100%); background: var(--signal); opacity: 0; pointer-events: none; }
  .window-lab[data-playing] .wl-head { opacity: 1; }
  .wl-axis .wl-head::before { content: ''; position: absolute; left: -4px; bottom: 0; border-style: solid; border-width: 7px 4.5px 0; border-color: var(--signal) transparent transparent; }

  .wl-axis .wl-track { min-height: 40px; background: repeating-linear-gradient(to right, var(--hair-strong) 0 1px, transparent 1px calc(100% / var(--wl-axis))) left bottom / 100% 6px no-repeat; }
  .wl-axis .wl-track::after { background: none; border-left: 0; }
  .wl-mark { position: absolute; bottom: 14px; font-family: var(--font-mono); font-size: 12px; line-height: 1.4; color: var(--faint); white-space: nowrap; }
  .wl-mark-start { left: 0; }
  .wl-mark-close { right: calc(100% - var(--wl-w) / var(--wl-axis) * 100% + 10px); color: var(--ink); }
  .wl-mark-after { left: calc(var(--wl-w) / var(--wl-axis) * 100% + 10px); }
  .window-lab[data-outcome='too-late'] .wl-mark-after { color: var(--warn); }
  /* "Signal" gives way when a short window brings the boundary label over it. */
  .window-lab[data-window='shorter'] .wl-mark-start { visibility: hidden; }

  /* Playback status takes the result's own cell, so nothing below moves. */
  .wl-readout { display: grid; grid-template-columns: var(--wl-ctl) minmax(0, 1fr) auto; gap: var(--space-3) var(--wl-gap); align-items: center; padding-top: var(--space-5); }
  .wl-outcome { grid-column: 1; grid-row: 1; }
  .wl-text { grid-column: 2; grid-row: 1; min-height: 3lh; display: flex; align-items: center; }
  .wl-result { display: contents; }
  .wl-outcome { display: inline-flex; align-items: center; gap: 14px; font-size: clamp(26px, 2.8vw, 40px); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.1; color: var(--ink); white-space: nowrap; }
  .wl-dot { width: 14px; height: 14px; flex: none; background: var(--pass); border-radius: 50%; }
  [data-outcome='narrow'] .wl-dot { background: var(--hold); }
  [data-outcome='too-late'] .wl-dot { background: var(--warn); border-radius: 0; }
  .wl-text { margin: 0; max-width: 56ch; font-size: var(--type-body); line-height: 1.6; color: var(--muted); }
  .wl-status { visibility: hidden; margin: 0; grid-column: 1 / 3; grid-row: 1; font-size: clamp(26px, 2.8vw, 40px); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.1; color: var(--faint); }
  .window-lab[data-playing] .wl-status { visibility: visible; }
  .window-lab[data-playing] .wl-result > * { visibility: hidden; }

  .wl-window { display: flex; flex-wrap: wrap; visibility: hidden; grid-column: 3; grid-row: 1; }
  .window-lab[data-ready] .wl-window { visibility: visible; }
  .wl-window legend { position: static; float: left; width: 100%; height: auto; margin-bottom: 8px; clip-path: none; font-family: var(--font-mono); font-size: 12px; line-height: 1.4; color: var(--faint); }
  .wl-window label + label > span { border-left: 0; }
  .wl-window label > span { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 14px; border: 1px solid var(--hair-strong); font-size: 13px; line-height: 1.3; color: var(--muted); white-space: nowrap; transition: color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease); }
  .wl-window input:checked + span { color: var(--paper); background: var(--ink); border-color: var(--ink); }
  .wl-window label:hover input:not(:checked) + span { color: var(--ink); }
  .wl-note { margin: var(--space-5) 0 0; padding-top: var(--space-3); border-top: 1px solid var(--hair); font-size: var(--type-caption); line-height: 1.65; color: var(--faint); }
  /* Controls hold their space from first paint and appear when the script
     is ready, so nothing below the instrument moves as the page loads.
     With scripting off, the noscript rules below remove them and the figure
     is a fixed illustration of one scenario. */
  .window-lab:not([data-ready]) .wl-presets { visibility: hidden; }

  @media (max-width: 1100px) {
    .window-lab { --wl-ctl: 184px; --wl-gap: var(--space-4); }
    .wl-presets { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .wl-readout { grid-template-columns: minmax(0, 1fr); align-items: start; }
    .wl-outcome, .wl-status { grid-column: 1; grid-row: 1; }
    .wl-text { grid-column: 1; grid-row: 2; align-items: flex-start; }
    .wl-window { grid-column: 1; grid-row: 3; justify-self: start; }
  }
  @media (max-width: 720px) {
    /* The panel runs edge to edge so the tracks keep their width. */
    .window-lab { margin-inline: calc(-1 * var(--gutter-tight)); padding: var(--space-4) var(--gutter-tight) var(--space-5); border-inline: 0 !important; }
    .wl-row { grid-template-columns: minmax(0, 1fr); }
    .wl-axis .wl-ctl { display: none; }
    .wl-ctl { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 var(--space-3); align-items: center; padding: var(--space-3) 0 0; }
    .wl-sum .wl-ctl { padding: var(--space-2) 0 0; }
    .wl-sum .wl-track { min-height: 40px; }
    .wl-name { font-size: 18px; }
    .wl-what { grid-column: 1; grid-row: 2; font-size: 13px; }
    .wl-range { grid-column: 2; grid-row: 1 / span 2; max-width: none; justify-self: end; }
    .wl-track { min-height: 36px; }
    .wl-rows .wl-row + .wl-row .wl-track::before { display: none; }
    .wl-bar-top { display: block; }
    .wl-presets { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-3); }
    .wl-presets label > span { height: 48px; font-size: 13px; }
    .wl-replay { height: 48px; padding: 0; }
    .wl-scenario { min-height: 4lh; margin-top: var(--space-3); }
    .wl-text { min-height: 5lh; }
    .wl-window label { flex: 1 1 0; }
    .wl-window { justify-self: stretch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .window-lab, .wl-rows .wl-row, .wl-seg { transition: none; }
  }
  @media print {
    .window-lab { background: none; color: inherit; --paper: #fff; --ink: #1a1a1a; --muted: #4a4a4a; --faint: #6b6b6b; --hair: #e0e0e0; --hair-strong: #8c8c8c; --control-border: #6b6b6b; --warn: #a33a2e; }
    .wl-presets, .wl-range, .wl-replay, .wl-window { display: none !important; }
  }
</style>

<script>
  import {
    AXIS, STAGES, WINDOWS, PRESETS, CUSTOM_TEXT, OUTCOME_LABEL, evaluate, describe,
    type WindowKey,
  } from '../lib/window-model';

  const PROGRESS = ['Detecting', 'Escalating', 'Deciding', 'Intervening'];
  /** Milliseconds of playback for one unit of the model. */
  const UNIT_MS = 230;

  function motionEnabled(): boolean {
    return document.documentElement.hasAttribute('data-motion')
      && !matchMedia('(prefers-reduced-motion: reduce)').matches && !document.hidden;
  }

  document.querySelectorAll<HTMLElement>('[data-window-lab]').forEach((lab) => {
    const rows = Array.from(lab.querySelectorAll<HTMLElement>('[data-wl-row]'));
    const segments = Array.from(lab.querySelectorAll<HTMLElement>('[data-wl-seg]'));
    const ranges = Array.from(lab.querySelectorAll<HTMLInputElement>('[data-wl-stage]'));
    const presets = Array.from(lab.querySelectorAll<HTMLInputElement>('.wl-presets input'));
    const windows = Array.from(lab.querySelectorAll<HTMLInputElement>('.wl-window input'));
    const scenario = lab.querySelector<HTMLElement>('[data-wl-scenario]')!;
    const label = lab.querySelector<HTMLElement>('[data-wl-label]')!;
    const text = lab.querySelector<HTMLElement>('[data-wl-text]')!;
    const status = lab.querySelector<HTMLElement>('[data-wl-status]')!;
    const replay = lab.querySelector<HTMLButtonElement>('[data-wl-replay]')!;
    let frame = 0;
    let played = false;

    const durations = () => ranges.map((r) => Number(r.value));
    const windowKey = () => (windows.find((w) => w.checked)?.value ?? 'set') as WindowKey;
    const current = () => evaluate(durations(), WINDOWS[windowKey()]);

    const stop = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      lab.removeAttribute('data-playing');
      lab.style.setProperty('--wl-p', String(AXIS));
    };

    const render = () => {
      const d = durations();
      const result = current();
      rows.forEach((row, i) => {
        for (const el of [row, segments[i]]) {
          el?.style.setProperty('--wl-s', String(result.starts[i]));
          el?.style.setProperty('--wl-d', String(d[i]));
        }
        ranges[i].setAttribute('aria-valuetext', `${d[i]} of ${ranges[i].max}`);
      });
      lab.style.setProperty('--wl-w', String(WINDOWS[windowKey()]));
      lab.dataset.window = windowKey();
      lab.dataset.outcome = result.outcome;
      const next = describe(result);
      // Write only on change, so the live region announces a new outcome once.
      if (label.textContent !== OUTCOME_LABEL[result.outcome]) label.textContent = OUTCOME_LABEL[result.outcome];
      if (text.textContent !== next) text.textContent = next;
      return result;
    };

    const play = () => {
      stop();
      const result = render();
      played = true;
      if (!motionEnabled()) return;
      const d = durations();
      const end = Math.min(AXIS, Math.max(result.total, WINDOWS[windowKey()]) + 1);
      const began = performance.now();
      lab.setAttribute('data-playing', '');
      // The outcome is withheld while time runs: the closed region stays
      // neutral until the playhead has actually crossed the boundary.
      lab.dataset.outcome = 'in-time';
      const tick = (now: number) => {
        const p = Math.min(end, (now - began) / UNIT_MS);
        lab.style.setProperty('--wl-p', p.toFixed(3));
        const stage = d.findIndex((x, i) => p < result.starts[i] + x);
        status.textContent = stage === -1 ? '' : `${PROGRESS[stage]}…`;
        if (p >= WINDOWS[windowKey()] && result.outcome === 'too-late') lab.dataset.outcome = 'too-late';
        if (p < end) { frame = requestAnimationFrame(tick); return; }
        stop();
        lab.dataset.outcome = result.outcome;
      };
      frame = requestAnimationFrame(tick);
    };

    presets.forEach((radio) => radio.addEventListener('change', () => {
      const preset = PRESETS.find((p) => p.key === radio.value);
      if (!preset) return;
      preset.durations.forEach((value, i) => { ranges[i].value = String(value); });
      scenario.textContent = preset.text;
      play();
    }));
    ranges.forEach((range) => range.addEventListener('input', () => {
      stop();
      presets.forEach((radio) => { radio.checked = false; });
      scenario.textContent = CUSTOM_TEXT;
      render();
    }));
    windows.forEach((radio) => radio.addEventListener('change', () => { stop(); render(); }));
    replay.addEventListener('click', play);

    const sync = () => { replay.hidden = !motionEnabled(); };
    lab.setAttribute('data-ready', '');
    render();
    sync();
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', () => { stop(); render(); sync(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden && frame) { stop(); render(); } });
    window.addEventListener('pageshow', sync);
    window.addEventListener('beforeprint', () => { stop(); render(); });

    // One unprompted run, the first time most of the figure is on screen.
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || entry.intersectionRatio < 0.6 || played) return;
          observer.disconnect();
          sync();
          play();
        });
      }, { threshold: 0.6 });
      const figure = lab.querySelector('.wl-figure');
      if (figure) observer.observe(figure);
    }
  });
</script>
