---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { markAgda } from '../../lib/marks';
import { offers, activities, offerFaqs, buyingGroup, PRICE_QUALIFIER, FEE_BASIS, AVAILABILITY, RECORDS_NOTE, SELF_APPROVAL } from '../../lib/offers';
import OfferChoice from '../../components/OfferChoice.astro';
import PageNav from '../../components/PageNav.astro';

/* Everything commercial on this page reads from src/lib/offers.ts so the
   homepage, this page, the shared FAQ and the Offer schema nodes cannot
   disagree. Copy here is limited to framing. */

const included = [
  'One named AI-enabled system, one defined consequential pathway and one specified intervention scenario.',
  'Relevant business, risk and technology stakeholders.',
  'Structured interviews and walkthroughs.',
  'Review of relevant evidence.',
  'Intervention-chain analysis and the AGDA™ assessment.',
  'Executive-level findings and the defined assessment artefacts.',
];

const excluded = [
  'Enterprise-wide AI inventory or organisation-wide governance redesign.',
  'Legal opinion or full regulatory compliance assessment.',
  'Model validation, penetration testing or cybersecurity testing.',
  'Software development, technology implementation or remediation programme delivery.',
  'Unlimited interviews, additional unrelated systems or ongoing programme management.',
  'Formal regulatory certification.',
];


const pageNav = [
  { href: '#begin', label: 'Where to begin' },
  { href: '#engagements', label: 'The two engagements' },
  { href: '#scope', label: 'Included and excluded' },
  { href: '#how-it-runs', label: 'How it runs' },
  { href: '#who', label: 'Who takes part' },
  { href: '#control', label: 'How it is controlled' },
  { href: '#faq', label: 'Questions' },
];

const useCases = [
  'Payments: routing, release or rejection, transaction prioritisation, real-time decisioning.',
  'Fraud and financial crime: detection, transaction monitoring, case prioritisation, customer restrictions.',
  'Credit and lending: credit assessment, affordability, credit-limit decisions, customer risk classification.',
  'Wealth and investment: recommendations, portfolio decisions, suitability, risk alerts.',
  'Treasury and markets: trading recommendations, automated execution, liquidity decisions, market-risk responses.',
];
---

<BaseLayout
  title="Assessment Options and Indicative Pricing · Intervene"
  description="Choose an Intervention Readiness Review or a full AGDA™ Assessment. Scope, evidence access, deliverables and indicative fees are agreed before work begins."
  current="services"
  ogImage="/assets/og/og-services.png"
  faqs={offerFaqs}
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <h1 class="h1">Two ways to begin. <em>One named system.</em></h1>
      <p class="lede muted">
        The starting point is the system, the decision or action it
        influences, and the intervention question. We agree the evidence and
        access required before selecting the engagement. An Intervention
        Readiness Review establishes whether a full assessment is warranted.
        A full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment examines the agreed system, pathway and
        scenario in depth.
      </p>
      <div class="hero-cta">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
    </div>
  </section>

  <PageNav items={pageNav} />

  <!-- WHERE TO BEGIN. Compact shared diagram; the sheets below carry the detail. -->
  <section class="block choose" id="begin">
    <div class="wrap">
      <OfferChoice compact headingLevel="h2" />
    </div>
  </section>

  <!-- THE TWO OFFERS. Spec sheets, from src/lib/offers.ts. Labels sit
       above their content, and each row of the two sheets shares a grid
       row, so equivalent information sits level across the pair. Three
       tiers: what it is and costs; what it decides and returns; the
       scope, boundary and timing behind that. -->
  <section class="block start-here" id="engagements">
    <div class="wrap">
      <span class="label section-kicker">Current engagements</span>
      <h2 class="h2">The two engagements <em>in full.</em></h2>
      <p class="lede muted">
        Fees are indicative ranges. {PRICE_QUALIFIER}
      </p>

      <div class="offers">
        {offers.map((o) => (
          <article class="offer" id={o.slug} aria-labelledby={`offer-${o.slug}-name`}>
            <header class="sheet-head">
              <span class="mono offer-kicker">{o.slug === 'review' ? 'Route A · Preliminary engagement' : 'Route B · Full assessment'}</span>
              <h3 class="h3 offer-name" id={`offer-${o.slug}-name`} set:html={markAgda(o.name)} />
              <p class="offer-purpose" set:html={markAgda(o.purpose)} />
            </header>

            <div class="sheet-summary">
              <div class="sheet-fee">
                <h4 class="sheet-label">{o.priceNote}</h4>
                <p class="price">{o.price}</p>
                <p class="price-flag">Indicative. Confirmed in the proposal.</p>
              </div>
              <div class="sheet-when">
                <h4 class="sheet-label">Start here when</h4>
                <p set:html={markAgda(o.suitable)} />
              </div>
            </div>

            <div class="sheet-row">
              <h4 class="sheet-label">What it decides</h4>
              <p set:html={markAgda(o.decision)} />
            </div>

            <div class="sheet-row">
              <h4 class="sheet-label">{o.slug === 'review' ? 'What you receive' : 'Full-assessment deliverables'}</h4>
              <ul class="dash-list" role="list">
                {o.receive.map((x) => <li set:html={markAgda(x)} />)}
              </ul>
              {o.slug === 'assessment' && <p class="records-note">{RECORDS_NOTE}</p>}
            </div>

            <div class="sheet-row">
              <h4 class="sheet-label">What you keep</h4>
              <p set:html={markAgda(o.retain)} />
            </div>

            <div class="sheet-row sheet-row-detail">
              <h4 class="sheet-label">Scope</h4>
              <ul class="dash-list" role="list">
                {o.scope.map((x) => <li set:html={markAgda(x)} />)}
              </ul>
            </div>

            <div class="sheet-row sheet-row-detail">
              <h4 class="sheet-label">{o.slug === 'review' ? 'Not included' : 'Separately scoped'}</h4>
              {o.slug === 'review' ? (
                <p set:html={markAgda(o.exclusion)} />
              ) : (
                <>
                  <p set:html={markAgda(o.exclusionShort)} />
                  <details class="disclosure sheet-disclosure">
                    <summary>Full list of separately scoped work</summary>
                    <div class="disclosure-body">
                      <p set:html={markAgda(o.exclusion)} />
                    </div>
                  </details>
                </>
              )}
            </div>

            <div class="sheet-row sheet-row-detail">
              <h4 class="sheet-label">Timing</h4>
              <p>{o.timing}</p>
            </div>
          </article>
        ))}
      </div>

      <p class="body muted footnote price-qualifier">{FEE_BASIS} {AVAILABILITY}</p>

      <div class="cta-row">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
    </div>
  </section>

  <!-- SCOPE BOUNDARY -->
  <section class="block" id="scope">
    <div class="wrap">
      <h2 class="h2">What the standard assessment <em>includes and excludes.</em></h2>
      <p class="lede muted">
        One named system does not mean unlimited pathways or scenarios. The
        conclusion applies to the agreed conditions and evidence. Additional
        systems, scenarios or implementation work require separate agreement.
      </p>
      <div class="scope-grid">
        <div>
          <span class="col-label">Included</span>
          <ul class="dash-list" role="list">
            {included.map((x) => <li set:html={markAgda(x)} />)}
          </ul>
        </div>
        <div>
          <span class="col-label">Excluded unless separately contracted</span>
          <ul class="dash-list" role="list">
            {excluded.map((x) => <li>{x}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW AN ASSESSMENT RUNS -->
  <section class="block" id="how-it-runs">
    <div class="wrap">
      <h2 class="h2">How a full assessment runs.</h2>
      <p class="lede muted">
        Four activities. Once an engagement begins, a standard full assessment
        is estimated to run over approximately four weeks, subject to scope,
        stakeholder access and evidence readiness. The proposal sets the
        detailed timetable.
      </p>

      <figure class="activity-seq" data-reveal="scene" aria-labelledby="activity-seq-heading">
        <figcaption class="mono seq-caption" id="activity-seq-heading">Four activities, in order. No fixed duration is assigned to any one of them.</figcaption>
        <div class="rail draw seq-rail" aria-hidden="true"></div>
        <ol class="seq" role="list">
          {activities.map((a, i) => (
            <li class="seq-step" style={`--i: ${i}`}>
              <span class="node seq-node" aria-hidden="true"></span>
              <span class="mono stage-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3 seq-name">{a.name}.</h3>
              <p class="body muted" set:html={markAgda(a.body)} />
            </li>
          ))}
        </ol>
      </figure>
      <p class="body muted footnote seq-foot">
        Preparation, approval and issue are distinct steps. Signed SEDI
        result records are not a standard deliverable.
      </p>
    </div>
  </section>

  <!-- WHO SHOULD BE IN THE CONVERSATION -->
  <section class="block" id="who">
    <div class="wrap">
      <h2 class="h2">Who should be <em>in the conversation.</em></h2>
      <p class="lede muted">
        An assessment is rarely bought by one person. The preferred
        configuration brings three owners together. Legal, compliance,
        enterprise risk, internal audit and procurement join as required.
      </p>
      <ul class="feature-grid buyer-grid" role="list" data-reveal="stagger">
        {buyingGroup.map((b) => (
          <li>
            <h3 class="h3">{b.role}</h3>
            <p class="body muted">{b.example}</p>
          </li>
        ))}
      </ul>

      <h3 class="h3 services-head">Where we are starting.</h3>
      <p class="body muted">
        Our initial commercial focus is large UK and European regulated
        financial institutions, on consequential pathways such as:
      </p>
      <ul class="dash-list usecases" role="list">
        {useCases.map((x) => <li>{x}</li>)}
      </ul>
      <p class="body muted footnote">
        Financial services is the proving ground, not the limit. Other sectors
        are discussed case by case.
      </p>
      <p class="body muted footnote">
        If your work puts you close to boards, risk leaders or accountable
        executives who should face this question, the
        <a href="/network/" class="link">Intervention Readiness Network</a>
        explains how the question can be put in front of them without becoming
        a sales role.
      </p>
    </div>
  </section>

  <!-- HOW THE ENGAGEMENT IS CONTROLLED -->
  <section class="block" id="control">
    <div class="wrap">
      <h2 class="h2">How the engagement <em>is controlled.</em></h2>
      <ul class="feature-grid control-grid" role="list" data-reveal="stagger">
        <li>
          <h3 class="h3">Authority.</h3>
          <p class="body muted">
            Intervene retains Assessment Authority: over who may perform an
            assessment, the methodology they apply, conflicts of interest, the
            evidence requirements, and whether a conclusion is issued.
            {SELF_APPROVAL}
          </p>
        </li>
        <li>
          <h3 class="h3">Independence.</h3>
          <p class="body muted">
            Facts can be corrected. Evidence can change the judgement. The
            judgement itself is not negotiated. Agreement with the conclusion
            or a favourable result is not a deliverable or an acceptance
            criterion.
          </p>
        </li>
        <li>
          <h3 class="h3">Signed records.</h3>
          <p class="body muted">
            Signed SEDI result records are not a standard deliverable (see
            the deliverables above). A signed record is not by itself an
            issued assessment; issue is a separate, controlled step. The
            signature covers specified records, not every item displayed in a
            report or included in an export.
            <a href="/verify/" class="link">What verification establishes</a>.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- BEYOND ONE SYSTEM. Later-stage, not standard packages. -->
  <section class="block" id="beyond">
    <div class="wrap-narrow">
      <h2 class="h2">Beyond one system.</h2>
      <p class="body muted">
        Neither of the following is a standard package today. Both are scoped
        separately, informed by what initial engagements establish.
      </p>
      <p class="body muted">
        <strong class="ink">Structured Multi-System Assessment.</strong> Connected systems or
        business areas assessed with a consistent method, recognising shared
        evidence, dependencies and stakeholders. There is no standard
        multiplier or published tariff.
      </p>
      <p class="body muted">
        <strong class="ink">Standing Intervention Readiness Capability.</strong> Scheduled or
        material-change reassessment for organisations that need repeated
        evidence. A later development; scope and terms will be defined after
        initial paid engagements.
      </p>
    </div>
  </section>

  <!-- FAQ. Shared with /agda/; emitted as FAQPage JSON-LD. -->
  <section class="block" id="faq">
    <div class="wrap">
      <h2 class="h2">Frequently asked questions.</h2>
      <dl class="faq-list">
        {offerFaqs.map((faq) => (
          <div>
            <dt set:html={markAgda(faq.question)} />
            <dd set:html={markAgda(faq.answer)} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="block tight">
    <div class="wrap">
      <div class="close-grid">
        <h2 class="h2">
          Bring a named system, <em>its decision, and the intervention question.</em>
        </h2>
        <div class="close-cta">
          <p class="body muted">
            We can then establish whether a Review or a full assessment is the
            appropriate next step, and confirm delivery arrangements and a
            start date in the proposal. Review the sample verdict first if you
            want to see the shape of a finding.
          </p>
          <div class="cta-row">
            <a href="/contact/" class="btn">Discuss your system</a>
            <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* /services/ is the dense-page reference: two spec sheets, a scope
     boundary, a four-step sequence, three grids and a FAQ. Everything
     here composes from the shared scale; the sheet is the one component
     that is particular to this page. */
  .hero .h1 { max-width: 22ch; }
  .ink { color: var(--ink); font-weight: 700; }

  /* ----- Offer sheets ----- */
  .start-here { background: var(--paper-soft); border-bottom: 1px solid var(--hair); }
  .start-here .h2 { max-width: 22ch; }
  .offers {
    margin: var(--gap-intro) 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(40px, 6vw, 80px);
  }
  /* Subgrid keeps the eight rows of the two sheets level. Browsers
     without it fall back to independent sheets. */
  .offer { display: grid; align-content: start; min-width: 0; }
  @supports (grid-template-rows: subgrid) {
    .offer { grid-template-rows: subgrid; grid-row: span 8; }
  }

  .sheet-head { display: grid; gap: var(--gap-item); align-content: start; padding-bottom: var(--space-4); }
  .offer-kicker { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
  .offer-name { margin: 0; font-size: clamp(24px, 2.2vw, 30px); }
  .offer-purpose { margin: 4px 0 0; max-width: 46ch; font-family: var(--font-sans); font-size: 17px; line-height: 1.6; color: var(--muted); }

  .sheet-label {
    margin: 0;
    font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent);
  }
  .sheet-summary {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-4) var(--space-5);
    padding: var(--space-4) 0;
    border-top: 2px solid var(--accent);
    border-bottom: 1px solid var(--hair-strong);
    align-content: start;
  }
  .sheet-summary > div { display: grid; gap: 8px; align-content: start; min-width: 0; }
  .sheet-summary p { margin: 0; font-family: var(--font-sans); font-size: 15px; line-height: 1.6; color: var(--ink); }
  .price { font-size: clamp(24px, 2.2vw, 30px); font-weight: 700; letter-spacing: -0.01em; line-height: 1.15; }
  .price-flag { font-size: 13px; color: var(--muted); }

  .sheet-row {
    display: grid; gap: 10px; align-content: start;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hair);
  }
  .sheet-row p { margin: 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--ink); max-width: 52ch; }
  .sheet-row .dash-list > li { font-size: 16px; max-width: 52ch; }
  .sheet-row-detail p,
  .sheet-row-detail .dash-list > li { font-size: 15px; color: var(--muted); }
  .sheet-row-detail .sheet-label { color: var(--muted); }
  .records-note { margin-top: var(--space-3); font-size: 14px; color: var(--muted); max-width: 52ch; }
  .sheet-disclosure { margin-top: 6px; border-top: 0; border-bottom: 0; }
  .sheet-disclosure > summary { min-height: 44px; padding: 10px 0; font-size: 14px; justify-content: flex-start; gap: 12px; }
  .sheet-disclosure .disclosure-body p { font-size: 15px; }
  .price-qualifier { margin-top: var(--space-5); }
  .start-here .cta-row { margin-top: var(--space-5); }

  /* ----- Scope grid ----- */
  .scope-grid {
    margin: var(--gap-intro) 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
  }
  .usecases { margin-top: var(--space-4); }

  /* ----- Buyer group and control grid: shared feature grid. ----- */
  .services-head { margin: var(--gap-sub) 0 var(--gap-item); }

  /* ----- Beyond one system ----- */
  .wrap-narrow .body { max-width: var(--measure); margin: var(--space-3) 0 0; }

  /* ----- Where to begin ----- */
  .choose { border-bottom: 1px solid var(--hair); }

  /* ----- Activity sequence: the SEDI rail, four steps ----- */
  .activity-seq { margin: var(--gap-intro) 0 0; }
  .seq-caption { display: block; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); margin-bottom: var(--space-5); }
  .seq-rail { margin-bottom: -7px; }
  .seq { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0 32px; position: relative; z-index: 1; }
  .seq-step { display: grid; gap: 10px; align-content: start; }
  .seq-step .stage-n { margin-top: 10px; color: var(--accent); letter-spacing: 0.06em; font-size: 11px; }
  .seq-name { margin: 0; font-size: 22px; }
  .seq-step p { margin: 0; max-width: 32ch; font-size: 15px; }
  .seq-foot { margin-top: var(--space-5); }
  html[data-motion] .seq-step {
    opacity: 0; transform: translateY(var(--move-reveal));
    transition: opacity var(--dur-reveal) var(--ease-out), transform var(--dur-reveal) var(--ease-out);
    transition-delay: calc(200ms + var(--i) * 140ms);
  }
  html[data-motion] .activity-seq.in .seq-step { opacity: 1; transform: none; }

  /* ----- Responsive ----- */
  @media (max-width: 880px) {
    .offers { grid-template-columns: 1fr; row-gap: var(--space-7); }
    @supports (grid-template-rows: subgrid) {
      .offer { grid-template-rows: auto; grid-row: auto; }
    }
    .scope-grid { grid-template-columns: 1fr; gap: var(--space-5); }
    .seq-rail { display: none; }
    .seq { grid-template-columns: 1fr; gap: 28px; }
    .seq-step { grid-template-columns: 13px 1fr; column-gap: 16px; }
    .seq-node { grid-row: 1 / span 3; margin-top: 6px; }
    .seq-step .stage-n { margin-top: 0; }
    .seq-step p { max-width: none; }
  }
  @media (max-width: 560px) {
    .sheet-summary { grid-template-columns: 1fr; }
  }
</style>
