---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { markAgda } from '../../lib/marks';
import { offers, activities, offerFaqs, buyingGroup, PRICE_QUALIFIER, AVAILABILITY, RECORDS_NOTE, SELF_APPROVAL } from '../../lib/offers';

/* Everything commercial on this page reads from src/lib/offers.ts so the
   homepage, this page, the shared FAQ and the Offer schema nodes cannot
   disagree. Copy here is limited to framing. */

const included = [
  'One named AI-enabled system, one defined consequential pathway and one specified intervention scenario.',
  'Relevant business, risk and technology stakeholders.',
  'Structured interviews and walkthroughs.',
  'Review of relevant evidence.',
  'Intervention-chain analysis and the AGDA™ assessment.',
  'Executive-level findings and the defined assessment artefacts.',
];

const excluded = [
  'Enterprise-wide AI inventory or organisation-wide governance redesign.',
  'Legal opinion or full regulatory compliance assessment.',
  'Model validation, penetration testing or cybersecurity testing.',
  'Software development, technology implementation or remediation programme delivery.',
  'Unlimited interviews, additional unrelated systems or ongoing programme management.',
  'Formal regulatory certification.',
];


const useCases = [
  'Payments: routing, release or rejection, transaction prioritisation, real-time decisioning.',
  'Fraud and financial crime: detection, transaction monitoring, case prioritisation, customer restrictions.',
  'Credit and lending: credit assessment, affordability, credit-limit decisions, customer risk classification.',
  'Wealth and investment: recommendations, portfolio decisions, suitability, risk alerts.',
  'Treasury and markets: trading recommendations, automated execution, liquidity decisions, market-risk responses.',
];
---

<BaseLayout
  title="Assessment Options and Indicative Pricing · Intervene"
  description="Choose an Intervention Readiness Review or a full AGDA™ Assessment. Scope, evidence access, deliverables and indicative fees are agreed before work begins."
  current="services"
  ogImage="/assets/og/og-services.png"
  faqs={offerFaqs}
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <h1 class="h1 reveal">Two ways to begin. <em>One named system.</em></h1>
      <p class="lede muted reveal">
        The starting point is the system, the decision or action it
        influences, and the intervention question. We agree the evidence and
        access required before selecting the engagement. An Intervention
        Readiness Review establishes whether a full assessment is warranted.
        A full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment examines the agreed system, pathway and
        scenario in depth.
      </p>
      <div class="hero-cta reveal">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
    </div>
  </section>

  <!-- THE TWO OFFERS. Spec sheets, from src/lib/offers.ts. -->
  <section class="block start-here">
    <div class="wrap">
      <span class="label section-kicker">Current engagements</span>
      <h2 class="h2">Choose the right <em>starting point.</em></h2>

      <div class="offers">
        {offers.map((o) => (
          <article class="offer" id={o.slug} aria-labelledby={`offer-${o.slug}-name`}>
            <span class="mono offer-kicker">{o.slug === 'review' ? 'Preliminary engagement' : 'Full assessment'}</span>
            <h3 class="h3 offer-name" id={`offer-${o.slug}-name`} set:html={markAgda(o.name)} />
            <p class="lede muted offer-purpose" set:html={markAgda(o.purpose)} />

            <dl class="start-list">
              <div>
                <dt>Scope</dt>
                <dd>
                  <ul class="plain" role="list">
                    {o.scope.map((x) => <li set:html={markAgda(x)} />)}
                  </ul>
                </dd>
              </div>
              <div>
                <dt>What it decides</dt>
                <dd set:html={markAgda(o.decision)} />
              </div>
              <div>
                <dt>{o.slug === 'review' ? 'What you receive' : 'Full-assessment deliverables'}</dt>
                <dd>
                  <ul class="plain" role="list">
                    {o.receive.map((x) => <li set:html={markAgda(x)} />)}
                  </ul>
                  {o.slug === 'assessment' && <p class="records-note">{RECORDS_NOTE}</p>}
                </dd>
              </div>
              <div>
                <dt>{o.slug === 'review' ? 'What you keep' : 'What you keep'}</dt>
                <dd set:html={markAgda(o.retain)} />
              </div>
              <div>
                <dt>Start here when</dt>
                <dd set:html={markAgda(o.suitable)} />
              </div>
              <div>
                <dt>{o.slug === 'review' ? 'Not included' : 'Separately scoped'}</dt>
                <dd set:html={markAgda(o.exclusion)} />
              </div>
              <div>
                <dt>Timing</dt>
                <dd>{o.timing}</dd>
              </div>
              <div>
                <dt>{o.priceNote}</dt>
                <dd class="price">{o.price}</dd>
              </div>
            </dl>
          </article>
        ))}
      </div>

      <p class="body muted footnote price-qualifier">{PRICE_QUALIFIER} {AVAILABILITY}</p>

      <div class="cta-row start-cta">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
    </div>
  </section>

  <!-- SCOPE BOUNDARY -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">What the standard assessment <em>includes and excludes.</em></h2>
      <p class="lede muted">
        One named system does not mean unlimited pathways or scenarios. The
        conclusion applies to the agreed conditions and evidence. Additional
        systems, scenarios or implementation work require separate agreement.
      </p>
      <div class="scope-grid">
        <div>
          <span class="mono col-label">Included</span>
          <ul class="scope-list" role="list">
            {included.map((x) => <li set:html={markAgda(x)} />)}
          </ul>
        </div>
        <div>
          <span class="mono col-label">Excluded unless separately contracted</span>
          <ul class="scope-list" role="list">
            {excluded.map((x) => <li>{x}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW AN ASSESSMENT RUNS -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">How a full assessment runs.</h2>
      <p class="lede muted">
        Four activities. Once an engagement begins, a standard full assessment
        is estimated to run over approximately four weeks, subject to scope,
        stakeholder access and evidence readiness. The proposal sets the
        detailed timetable.
      </p>

      <ol class="stages" role="list">
        {activities.map((a, i) => (
          <li class="stage reveal">
            <div class="stage-head">
              <span class="mono stage-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{a.name}.</h3>
            </div>
            <div class="stage-body">
              <p class="body muted" set:html={markAgda(a.body)} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WHO SHOULD BE IN THE CONVERSATION -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">Who should be <em>in the conversation.</em></h2>
      <p class="lede muted">
        An assessment is rarely bought by one person. The preferred
        configuration brings three owners together. Legal, compliance,
        enterprise risk, internal audit and procurement join as required.
      </p>
      <ul class="buyer-grid reveal" role="list">
        {buyingGroup.map((b) => (
          <li>
            <h3 class="h3">{b.role}</h3>
            <p class="body muted">{b.example}</p>
          </li>
        ))}
      </ul>

      <h3 class="h3 services-head">Where we are starting.</h3>
      <p class="body muted">
        Our initial commercial focus is large UK and European regulated
        financial institutions, on consequential pathways such as:
      </p>
      <ul class="scope-list usecases" role="list">
        {useCases.map((x) => <li>{x}</li>)}
      </ul>
      <p class="body muted footnote">
        Financial services is the proving ground, not the limit. Other sectors
        are discussed case by case.
      </p>
      <p class="body muted footnote">
        If your work puts you close to boards, risk leaders or accountable
        executives who should face this question, the
        <a href="/network/" class="link">Intervention Readiness Network</a>
        explains how the question can be put in front of them without becoming
        a sales role.
      </p>
    </div>
  </section>

  <!-- HOW THE ENGAGEMENT IS CONTROLLED -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">How the engagement <em>is controlled.</em></h2>
      <div class="control-grid">
        <div>
          <h3 class="h3">Authority.</h3>
          <p class="body muted">
            Intervene retains Assessment Authority: over who may perform an
            assessment, the methodology they apply, conflicts of interest, the
            evidence requirements, and whether a conclusion is issued.
            {SELF_APPROVAL}
          </p>
        </div>
        <div>
          <h3 class="h3">Independence.</h3>
          <p class="body muted">
            Facts can be corrected. Evidence can change the judgement. The
            judgement itself is not negotiated. Agreement with the conclusion
            or a favourable result is not a deliverable or an acceptance
            criterion.
          </p>
        </div>
        <div>
          <h3 class="h3">Signed records.</h3>
          <p class="body muted">
            Signed SEDI result records are not a standard deliverable (see
            the deliverables above). A signed record is not by itself an
            issued assessment; issue is a separate, controlled step. The
            signature covers specified records, not every item displayed in a
            report or included in an export.
            <a href="/verify/" class="link">What verification establishes</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- BEYOND ONE SYSTEM. Later-stage, not standard packages. -->
  <section class="block">
    <div class="wrap-narrow">
      <h2 class="h2">Beyond one system.</h2>
      <p class="body muted">
        Neither of the following is a standard package today. Both are scoped
        separately, informed by what initial engagements establish.
      </p>
      <p class="body muted">
        <strong class="ink">Structured Multi-System Assessment.</strong> Connected systems or
        business areas assessed with a consistent method, recognising shared
        evidence, dependencies and stakeholders. There is no standard
        multiplier or published tariff.
      </p>
      <p class="body muted">
        <strong class="ink">Standing Intervention Readiness Capability.</strong> Scheduled or
        material-change reassessment for organisations that need repeated
        evidence. A later development; scope and terms will be defined after
        initial paid engagements.
      </p>
    </div>
  </section>

  <!-- FAQ. Shared with /agda/; emitted as FAQPage JSON-LD. -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">Frequently asked questions.</h2>
      <dl class="faq-list">
        {offerFaqs.map((faq) => (
          <div>
            <dt set:html={markAgda(faq.question)} />
            <dd set:html={markAgda(faq.answer)} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="block tight">
    <div class="wrap">
      <div class="close-grid">
        <h2 class="h2 reveal">
          Bring a named system, <em>its decision, and the intervention question.</em>
        </h2>
        <div class="close-cta reveal">
          <p class="body muted">
            We can then establish whether a Review or a full assessment is the
            appropriate next step, and confirm delivery arrangements and a
            start date in the proposal. Review the sample verdict first if you
            want to see the shape of a finding.
          </p>
          <div class="cta-row">
            <a href="/contact/" class="btn">Discuss your system</a>
            <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 144px;
    padding-bottom: 144px;
    border-bottom: 1px solid var(--hair);
  }
  .hero .h1 { max-width: 22ch; }
  .hero .lede { margin-top: 32px; max-width: 62ch; }
  .hero-cta { margin-top: 48px; display: flex; gap: 16px; flex-wrap: wrap; }

  .block .h2 { max-width: 28ch; }
  .block .lede { margin-top: 16px; max-width: 60ch; }
  .ink { color: var(--ink); font-weight: 700; }

  /* ----- Offers. Two spec sheets side by side, stacked on narrow screens. ----- */
  .start-here { background: var(--paper-soft); border-bottom: 1px solid var(--hair); }
  .start-here .h2 { max-width: 22ch; }
  .offers {
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
  }
  .offer { display: grid; gap: 12px; align-content: start; min-width: 0; }
  .offer-kicker { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
  .offer-name { margin: 0; font-size: 28px; }
  .offer-purpose { margin: 4px 0 8px; max-width: 48ch; font-size: 17px; }
  .start-list {
    margin: 16px 0 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--hair-strong);
  }
  .start-list > div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--hair);
  }
  .start-list dt {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent); padding-top: 4px;
  }
  .start-list dd {
    margin: 0; font-family: var(--font-sans); font-size: 16px;
    line-height: 1.6; color: var(--ink); max-width: 52ch;
  }
  .start-list dd.price { font-size: 22px; font-weight: 700; }
  .plain { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .plain > li { position: relative; padding-left: 18px; }
  .plain > li::before {
    content: ''; position: absolute; left: 0; top: 11px;
    width: 8px; height: 1px; background: var(--accent);
  }
  .records-note { margin: 14px 0 0; font-size: 14px; line-height: 1.6; color: var(--muted); max-width: 52ch; }
  .price-qualifier { margin-top: 40px; }
  .start-cta { margin-top: 40px; }

  /* ----- Scope grid ----- */
  .scope-grid {
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  .col-label {
    display: block; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted); padding-bottom: 14px; border-bottom: 1px solid var(--hair-strong);
  }
  .scope-list { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 12px; }
  .scope-list > li {
    position: relative; padding-left: 20px;
    font-family: var(--font-sans); font-size: 15px; line-height: 1.6; color: var(--ink); max-width: 52ch;
  }
  .scope-list > li::before {
    content: ''; position: absolute; left: 0; top: 11px;
    width: 8px; height: 1px; background: var(--accent);
  }
  .usecases { margin-top: 20px; }

  /* ----- Buyer group ----- */
  .buyer-grid {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    border-top: 1px solid var(--hair-strong);
  }
  .buyer-grid > li { padding-top: 32px; display: grid; gap: 12px; align-content: start; }
  .buyer-grid .h3 { margin: 0; font-size: 20px; }
  .buyer-grid p { margin: 0; max-width: 34ch; }
  .services-head { margin: 64px 0 12px; font-size: 22px; }

  /* ----- Control grid ----- */
  .control-grid {
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  .control-grid > div { display: grid; gap: 12px; align-content: start; }
  .control-grid .h3 { margin: 0; }
  .control-grid p { margin: 0; max-width: 36ch; }

  .footnote {
    margin: 32px 0 0;
    max-width: 76ch;
    color: var(--muted);
    font-size: 14px;
  }

  /* ----- Beyond one system ----- */
  .wrap-narrow .body { max-width: 62ch; margin: 16px 0 0; }

  /* ----- FAQ ----- */
  .faq-list { margin: 56px 0 0; border-top: 1px solid var(--hair-strong); }
  .faq-list > div {
    display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 48px;
    padding: 28px 0; border-bottom: 1px solid var(--hair);
  }
  .faq-list dt { font-family: var(--font-sans); font-size: 18px; line-height: 1.35; color: var(--ink); }
  .faq-list dd { margin: 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.62; color: var(--muted); }

  /* ----- Close ----- */
  .close-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 96px;
    align-items: start;
  }
  .close-grid .h2 { max-width: 24ch; margin: 0; }
  .close-cta { display: grid; gap: 24px; align-content: start; padding-top: 12px; }
  .close-cta .body { margin: 0; max-width: 42ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }

  /* ----- Engagement stages ----- */
  .stages { list-style: none; margin: 72px 0 0; padding: 0; display: grid; gap: 40px; }
  .stage {
    padding-top: 32px;
    border-top: 1px solid var(--hair-strong);
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 40px;
    align-items: start;
  }
  .stage-head { display: grid; gap: 8px; align-content: start; }
  .stage-head .h3 { margin: 0; }
  .stage-n { color: var(--accent); letter-spacing: 0.06em; font-size: 11px; }
  .stage-body { display: grid; gap: 20px; min-width: 0; }
  .stage-body > p { margin: 0; max-width: 60ch; }

  /* ----- Responsive ----- */
  @media (max-width: 880px) {
    .hero { padding-top: 96px; padding-bottom: 96px; }
    .offers { grid-template-columns: 1fr; gap: 56px; }
    .scope-grid { grid-template-columns: 1fr; gap: 40px; }
    .buyer-grid { grid-template-columns: 1fr; gap: 40px; }
    .control-grid { grid-template-columns: 1fr; gap: 40px; }
    .stage { grid-template-columns: 1fr; gap: 20px; }
    .faq-list > div { grid-template-columns: 1fr; gap: 16px; }
    .close-grid { grid-template-columns: 1fr; gap: 48px; }
  }
  @media (max-width: 720px) {
    .start-list > div { grid-template-columns: 1fr; gap: 10px; }
    .start-list dt { padding-top: 0; }
  }
</style>
