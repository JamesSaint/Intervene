---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNav.astro';
import { markAgda } from '../../lib/marks';

const sectors = [
  {
    id: 'uk-finance',
    name: 'UK regulated finance',
    pressure: 'PRA · FCA · SS1/23 · SMCR',
    pressureText: 'SS1/23 sets the expectation that model risk is managed and owned. SMCR names a senior individual accountable for it.',
    failure: 'A named SMF can hold accountability for a model they cannot halt inside the harm window. The chart says control; the live event may say otherwise. AGDA® assesses whether intervention remains possible.',
  },
  {
    id: 'eu-ai',
    name: 'EU high-risk AI',
    pressure: 'EU AI Act · Article 14',
    pressureText: 'The AI Act requires human oversight of high-risk systems, capable of intervention and of overriding or halting the system.',
    failure: 'Oversight that is informed after the decision has landed is documentation, not control. AGDA® assesses whether oversight can alter the outcome before the consequence compounds.',
  },
  {
    id: 'cni',
    name: 'Critical national infrastructure',
    pressure: 'NIS Regulations · operational resilience',
    pressureText: 'Resilience regimes require that essential services withstand and recover from disruption inside defined tolerances.',
    failure: 'Automated systems act faster than the escalation chain meant to govern them. When the chain runs slower than the harm, the tolerance is breached before anyone is authorised to act.',
  },
  {
    id: 'public',
    name: 'Public services',
    pressure: 'Public law · accountability',
    pressureText: 'Automated decisions at population scale carry duties of fairness, transparency and an effective route to redress.',
    failure: 'A redress path slower than the harm it is meant to contain is redress in name only. AGDA® assesses whether intervention and correction land before the decision becomes irreversible for the person affected.',
  },
];
---

<BaseLayout
  title="Where Intervention Readiness Matters · Intervene"
  description="Regulated finance, high-risk AI, critical infrastructure and public services: where automated systems create consequences faster than authority can move."
  current="sectors"
  ogImage="/assets/og/og-sectors.png"
>
  <section class="hero">
    <div class="wrap">
      <h1 class="h1">Where Intervention Readiness <em>matters most.</em></h1>
      <p class="lede muted">
        Our initial commercial focus is large UK and European regulated financial institutions; other sectors are discussed case by case. Regulators increasingly require effective human oversight. The question is the same in every sector: can you stop it in time?
      </p>
    </div>
  </section>

  <PageNav items={sectors.map((sector) => ({ href: `#${sector.id}`, label: sector.name }))} />
  <!-- Each sector is drawn the same way: what the regime expects, on a
       solid line, and where that expectation can fail to become an
       intervention, on a broken one. The two sentences are the page's own;
       the drawing adds no claim about any sector. -->
  {sectors.map((s) => (
    <section class="block sector" id={s.id}>
      <div class="wrap">
        <div class="sector-grid">
          <div class="sector-lead">
            <h2 class="h2">{s.name}</h2>
            <ul class="sector-regimes mono" role="list" aria-label="Regimes and duties">
              {s.pressure.split(' · ').map((r) => <li>{r}</li>)}
            </ul>
          </div>
          <div class="sector-pair">
            <div class="sector-cell is-expected">
              <h3 class="sector-label mono">What is expected</h3>
              <p class="sector-text">{s.pressureText}</p>
            </div>
            <div class="sector-cell is-gap">
              <h3 class="sector-label mono">Where it can fail</h3>
              <p class="sector-text" set:html={markAgda(s.failure)}></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="block tight">
    <div class="wrap-narrow cta-band">
      <h2 class="h2">Is your situation <em>in scope?</em></h2>
      <p class="body muted">
        If your most consequential systems carry regulatory, financial,
        operational or reputational exposure, the question applies. Tell us
        the system and the decision it supports.
      </p>
      <div class="cta-row">
        <a data-primary-cta="discuss_system" href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Four sectors, each a label, a heading and two paragraphs. They read
     as one list, so they share one section's rhythm: a hairline between
     entries rather than a full section each. */

  .sector { padding-top: var(--gap-sub); padding-bottom: var(--gap-sub); }
  .sector + .sector > .wrap { border-top: 1px solid var(--hair); padding-top: var(--gap-sub); }
  .sector:first-of-type { padding-top: var(--section); }
  .sector:last-of-type { padding-bottom: var(--section); }
  .sector-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-7);
    align-items: start;
  }
  .sector-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
  .sector-lead { display: grid; gap: var(--space-4); align-content: start; }
  .sector-lead .h2 { margin: 0; font-size: clamp(30px, 3.4vw, 52px); }
  .sector-regimes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sector-regimes li { padding: 4px 10px; border: 1px solid var(--hair-strong); font-size: var(--type-caption); line-height: 1.6; color: var(--muted); }

  /* The pair. A solid line carries the expectation; the line over the gap
     is broken, the site's mark for something not established. */
  .sector-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 var(--space-6); }
  .sector-cell { display: grid; gap: var(--space-3); align-content: start; padding-top: var(--space-4); border-top: 2px solid var(--ink); }
  .sector-cell.is-gap { border-top-style: dashed; border-top-color: var(--accent); }
  .sector-label { margin: 0; font-size: var(--type-caption); font-weight: 400; letter-spacing: 0; line-height: 1.6; color: var(--muted); }
  .is-gap .sector-label { color: var(--accent-text); }
  .sector-text { margin: 0; font-size: var(--type-body); line-height: 1.65; color: var(--muted); }
  .is-expected .sector-text { color: var(--ink); }
  .is-gap .sector-text { color: var(--ink); }

  @media (max-width: 1080px) {
    .sector-grid { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  @media (max-width: 640px) {
    .sector-pair { grid-template-columns: 1fr; gap: var(--space-5) 0; }
  }
</style>
