---
import BaseLayout from '../layouts/BaseLayout.astro';
import VerdictBlock from '../components/VerdictBlock.astro';

/* Three situations in which the intervention question stops being
   theoretical. Drawn from the Pilot tier's "who it is for" and
   "decision supported" fields on /services/, so the homepage and the
   commercial page describe the same buyer. */
const situations = [
  {
    kicker: 'A consequential deployment',
    h: 'You are about to depend on something you cannot easily reverse.',
    p: 'Approval is close, the system will act without a human confirming each decision, and nobody has established how quickly it could be stopped.',
  },
  {
    kicker: 'Board or regulator scrutiny',
    h: 'Someone has asked for evidence, not assurance.',
    p: 'An audit committee, a supervisor or a risk committee wants to see that oversight works. Policies and control coverage do not answer the question they asked.',
  },
  {
    kicker: 'Untested arrangements',
    h: 'The arrangements exist. Nobody has run them under pressure.',
    p: 'Escalation routes, halt authority and named owners are documented. Whether they hold at 3am, during a change freeze, or when the primary contact is unavailable is a separate question.',
  },
];

/* Plain-language descriptions of the four stages, condensed from
   /intervention-readiness/intervention-chain/. Kept consistent with that
   page rather than rewritten, so the chain reads the same everywhere. */
const chain = [
  { n: '01', name: 'Detect', p: 'Whether a deviation is identified, and how long it takes a signal to reach anyone who can act.' },
  { n: '02', name: 'Escalate', p: 'Whether the signal reaches authority. Most escalation steps are staffed by people who can pass it on but cannot stop the system.' },
  { n: '03', name: 'Decide', p: 'Whether a stop decision can be made. Agreed thresholds are fast. Thresholds invented under pressure are not.' },
  { n: '04', name: 'Intervene', p: 'Whether the system can actually be altered or halted. This is the only stage that changes the outcome.' },
];

const provide = [
  'One consequential system, and the intervention question it has to answer.',
  'Access to the right people while scope is fixed.',
  'Control, escalation and drill evidence, plus subject-matter time.',
  'Board or executive time for the readout.',
];

const receive = [
  'A signed Intervention Readiness Verdict.',
  'A Failure Exposure Report at executive, operational and specialist layers.',
  'A board readout.',
  'A close-out memo recording agreed actions and ownership.',
];
---

<BaseLayout
  title="Intervention Readiness · Intervene"
  description="Intervention Readiness: detect, escalate, decide and intervene before harm becomes irreversible. AGDA™ measures it with a deterministic verdict."
  current="home"
>
  <!-- 1 · DOORWAY. Loud. Relevance, offer and next step, in that order. -->
  <section class="hero">
    <div class="wrap">
      <a class="label hero-label hero-link" href="/intervention-readiness/">Intervention Readiness</a>
      <h1 class="display-xl">Can you stop it <em>in time?</em></h1>
      <p class="hero-sub">
        Intervention Readiness is the ability of an organisation to detect,
        escalate, decide and intervene before harm becomes irreversible.
        <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> is the instrument that measures it.
      </p>
      <p class="hero-note">
        Short pilot: one system, four weeks, a signed verdict and a board readout.
      </p>
      <div class="hero-cta">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
      <ul class="hero-chain" role="list" aria-label="Intervention readiness chain">
        <li>Detect</li>
        <li>Escalate</li>
        <li>Decide</li>
        <li>Intervene</li>
      </ul>
    </div>
  </section>

  <!-- 2 · Relevance. Who is actually asking this question. -->
  <section class="block situations">
    <div class="wrap">
      <span class="label section-kicker">Where the question arrives</span>
      <h2 class="h2">Three situations that bring people here.</h2>
      <ul class="card-grid situation-grid" role="list">
        {situations.map((s) => (
          <li class="card">
            <span class="mono situation-kicker">{s.kicker}</span>
            <h3 class="h3 card-title">{s.h}</h3>
            <p class="body muted">{s.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 · Recognition and consequence, merged into one beat. -->
  <section class="block quiet">
    <div class="wrap">
      <div class="window-head">
        <h2 class="h2">You have probably watched <em>a version of this.</em></h2>
        <p class="lede muted">
          You have policies, controls, governance structures and escalation
          processes. All of it real, and all of it necessary. None of it proves
          the one thing that decides the outcome: at 3am, can the person who can
          halt the system be reached, authorised, and certain enough to act while
          acting still costs less than waiting?
        </p>
      </div>

      <ol class="window-grid reveal" role="list">
        <li class="stage">
          <div class="chip-row"><span class="time-chip">T+0</span><span class="stage-label">System event</span></div>
          <h3 class="h3">No signal yet.</h3>
          <p class="body muted">The system starts producing decisions outside its limits. Nothing has reached anyone with the authority to act.</p>
        </li>
        <li class="stage">
          <div class="chip-row"><span class="time-chip">T+6h</span><span class="stage-label">Operations</span></div>
          <h3 class="h3">Noticed, not stoppable.</h3>
          <p class="body muted">Someone sees the deviation. They cannot halt the system, and the route to who can is unclear.</p>
        </li>
        <li class="stage">
          <div class="chip-row"><span class="time-chip">T+18h</span><span class="stage-label">Management</span></div>
          <h3 class="h3">Still compounding.</h3>
          <p class="body muted">It reaches management. Authority to halt is still being established. The cost grows by the hour.</p>
        </li>
        <li class="stage critical">
          <div class="chip-row"><span class="time-chip warn">T+36h</span><span class="stage-label">Board</span></div>
          <h3 class="h3">The window has closed.</h3>
          <p class="body muted">The board is informed. The moment for low-cost intervention has already passed.</p>
        </li>
      </ol>

      <p class="window-foot">The chain was never tested before it had to hold.</p>
    </div>
  </section>

  <!-- 4 · THE GAP. The turn. -->
  <section class="gap">
    <div class="wrap-narrow">
      <span class="label section-kicker gap-label">The category</span>
      <h2 class="h2 gap-h">Intervention Readiness is the missing measurement.</h2>
      <p class="gap-body">
        Capital. Model performance. Control coverage. Incident counts. Audit
        findings. These matter, and none of them answer the board-level
        question: when a consequential system turns, can the organisation
        intervene before harm becomes irreversible? That capability is
        <a href="/intervention-readiness/" class="link">Intervention Readiness</a>.
      </p>
      <p class="gap-realisation">
        <span>Governance</span>
        <span>Controls</span>
        <span>Accountability</span>
        <strong>Most organisations cannot evidence whether intervention remains possible when it matters.</strong>
      </p>
      <div class="gap-status">
        <span class="status-rule" aria-hidden="true"></span>
        <span class="gauge-label mono">Unmeasured</span>
      </div>
    </div>
  </section>

  <!-- 5 · THE INSTRUMENT. What is assessed, and what a finding looks like. -->
  <section class="block verdict">
    <div class="wrap">
      <div class="verdict-flow">
        <div class="verdict-lead">
          <span class="label section-kicker">The instrument</span>
          <h2 class="h2"><span class="agda-mark">AGDA<span class="agda-tm">™</span></span> is a deterministic assessment of Intervention Readiness.</h2>
          <p class="body muted">
            It reduces reliance on assertion. The output is not a maturity
            score or a compliance claim. It is a deterministic verdict on
            whether intervention completes inside the harm window, with the
            limiting stage named.
          </p>
        </div>
        <div class="verdict-stage reveal">
          <VerdictBlock />
        </div>
      </div>

      <h3 class="h3 chain-head">What is assessed.</h3>
      <ol class="chain-list" role="list">
        {chain.map((c) => (
          <li>
            <span class="mono chain-n">{c.n} {c.name}</span>
            <p class="body muted">{c.p}</p>
          </li>
        ))}
      </ol>
      <p class="body muted chain-foot">
        Each stage is assessed against evidence and graded for quality, so weak
        evidence cannot inflate the result. The weakest stage constrains the
        chain, because the chain is only as fast as the step that holds it up.
      </p>

      <aside class="finding" aria-label="Illustrative finding">
        <span class="label finding-label">Illustrative example</span>
        <dl class="finding-list">
          <div>
            <dt>Finding</dt>
            <dd>Detection runs in about twelve minutes. Reaching a person with authority to halt takes between four and ninety-six hours.</dd>
          </div>
          <div>
            <dt>What it means</dt>
            <dd>The reversibility window is about six hours, so the chain cannot complete inside it. Detection is not the constraint. Authority is.</dd>
          </div>
          <div>
            <dt>Decision it supports</dt>
            <dd>Whether halt authority moves to the operations rota before the next material deployment, or the deployment waits.</dd>
          </div>
        </dl>
        <p class="finding-note">
          A constructed example, written to show the shape of a finding. It is
          not an assessment of any organisation and not evidence about one.
          <a href="/sample-report/" class="link">See the full sample verdict</a>.
        </p>
      </aside>
    </div>
  </section>

  <!-- 6 · THE ENGAGEMENT. What it requires, what it returns, what it costs. -->
  <section class="block engage">
    <div class="wrap">
      <span class="label section-kicker">The engagement</span>
      <h2 class="h2">What a pilot asks of you, <em>and what it returns.</em></h2>

      <div class="engage-grid">
        <div class="engage-col">
          <h3 class="h3">What you provide</h3>
          <ul class="engage-list" role="list">
            {provide.map((p) => <li>{p}</li>)}
          </ul>
          <p class="body muted engage-note">
            No system access and no integration. The assessment runs against
            evidence you already hold, not against your production environment.
          </p>
        </div>
        <div class="engage-col">
          <h3 class="h3">What you receive</h3>
          <ul class="engage-list" role="list">
            {receive.map((r) => <li>{r}</li>)}
          </ul>
          <p class="body muted engage-note">
            Every assessment ships with a signed regulator bundle. The
            signature lets an audit committee confirm the result came from a
            named engine version and specific inputs, without contacting us. It
            is not a certification and not regulatory approval.
          </p>
        </div>
      </div>

      <p class="engage-terms">
        <strong>Short pilot.</strong> One system, four weeks. Scope and price
        are fixed with you before work begins, and neither moves once the
        engagement starts.
        <a href="/services/" class="link">Formats and scope</a>.
      </p>

      <p class="engage-next">
        <strong>What happens next.</strong> Tell us the system and the decision
        it supports. The first conversation is twenty minutes at no charge, and
        you receive a direct response within one to two working days. We do not
        pre-qualify by email questionnaire.
      </p>
    </div>
  </section>

  <!-- 7 · CLOSE. Sparse. The refrain returns. -->
  <section class="block close">
    <div class="wrap close-wrap">
      <h2 class="close-q">Can you stop it <em>in time?</em></h2>
      <p class="close-line">The verdict names which stage limits timely intervention, so remediation can be prioritised.</p>
      <div class="close-actions">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  /* Dark advisory rhythm: doorway, quiet recognition, surface turn,
     evidence object, sparse close. */
  .hero,
  .gap {
    background: var(--paper);
    color: var(--ink);
    border-bottom: 1px solid var(--hair);
  }
  .hero .wrap,
  .block.quiet > .wrap,
  .block.quiet > .wrap-narrow,
  .gap > .wrap-narrow,
  .verdict > .wrap,
  .close > .wrap {
    max-width: 1120px;
  }

  /* 1 · Hero */
  .hero {
    min-height: calc(92vh - var(--header-h));
    display: flex;
    align-items: center;
    padding-top: clamp(80px, 13vh, 152px);
    padding-bottom: clamp(64px, 10vh, 120px);
    background: var(--paper-deep);
  }
  .hero-label { margin-bottom: 32px; }
  .hero-link { display: inline-block; border-bottom: 1px solid transparent; }
  .hero-link:hover { border-color: var(--accent); color: var(--ink); }
  .hero .display-xl { max-width: 820px; color: var(--ink); }

  .hero-sub {
    margin: 28px 0 0;
    font-family: var(--font-sans);
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    line-height: 1.62;
    max-width: 48ch;
  }
  .hero-note {
    margin: 18px 0 0;
    font-size: 15px;
    color: var(--faint);
    max-width: 48ch;
    line-height: 1.6;
  }
  .hero-cta { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-chain {
    list-style: none;
    margin: clamp(44px, 7vh, 72px) 0 0;
    padding: 28px 0 0;
    border-top: 1px solid var(--hair);
    display: flex;
    flex-wrap: wrap;
    gap: 18px 36px;
  }
  .hero-chain li {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* Quiet recognition sections: large statements, generous air, no rules. */
  .block.quiet {
    border-bottom: 1px solid var(--hair);
  }
  .block.quiet .h2 { max-width: 24ch; font-size: clamp(32px, 4.6vw, 58px); line-height: 1.08; }
  .wrap-narrow .body { margin: 32px 0 0; max-width: 56ch; }

  .window-head { margin-bottom: 64px; }
  .window-head .h2 { max-width: 24ch; }
  .window-head .lede { margin-top: 20px; max-width: 54ch; }
  .window-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); column-gap: 32px;
    border-top: 1px solid var(--hair-strong);
  }
  .window-grid > .stage {
    position: relative;
    padding: 32px 0 28px; display: grid; gap: 12px; align-content: start;
    opacity: 0; transform: translateY(12px);
    transition: opacity 480ms cubic-bezier(0.4,0,0.2,1), transform 480ms cubic-bezier(0.4,0,0.2,1);
  }
  .window-grid > .stage::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 32px;
    height: 1px;
    background: var(--hair-strong);
  }
  .window-grid > .stage.critical::before { background: var(--warn); }
  .window-grid.in > .stage { opacity: 1; transform: none; }
  .window-grid.in > .stage:nth-child(1) { transition-delay: 0ms; }
  .window-grid.in > .stage:nth-child(2) { transition-delay: 120ms; }
  .window-grid.in > .stage:nth-child(3) { transition-delay: 240ms; }
  .window-grid.in > .stage:nth-child(4) { transition-delay: 360ms; }
  .chip-row { display: flex; align-items: center; gap: 12px; }
  .time-chip {
    display: inline-block; background: var(--accent); color: var(--black);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 5px 9px; line-height: 1;
  }
  .time-chip.warn { background: var(--warn); }
  .stage-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--muted); text-transform: uppercase; }
  .window-grid .h3 { font-size: 21px; margin: 4px 0 0; }
  .window-grid p { max-width: 30ch; margin: 0; line-height: 1.58; }
  .window-foot {
    margin: 44px 0 0; padding-top: 24px; border-top: 1px solid var(--hair-strong);
    font-family: var(--font-sans); font-size: clamp(18px, 1.8vw, 24px);
    font-weight: 500; letter-spacing: -0.01em; color: var(--ink); max-width: 40ch;
  }
  @media (prefers-reduced-motion: reduce) {
    .window-grid > .stage { opacity: 1; transform: none; transition: none; }
  }

  /* 4 · The gap. Heavy. */
  .gap { padding: clamp(96px, 14vh, 168px) 0; background: var(--paper-soft); }
  .gap-label {
    color: var(--accent); letter-spacing: 0.22em; margin-bottom: 28px;
  }
  .gap-h { color: var(--ink); max-width: 22ch; font-size: clamp(36px, 5.4vw, 70px); line-height: 1.08; }
  .gap-body {
    margin: 32px 0 0; font-family: var(--font-sans); font-size: 18px;
    line-height: 1.66; color: var(--muted); max-width: 58ch;
  }
  .gap-realisation {
    margin: 72px 0 0;
    padding: 0 0 0 24px;
    border-left: 1px solid var(--hair-strong);
    display: grid; gap: 10px;
    font-family: var(--font-sans); font-size: clamp(20px, 2.4vw, 30px);
    font-weight: 500; letter-spacing: -0.02em; line-height: 1.25; max-width: 34ch;
  }
  .gap-realisation > span { color: var(--faint); }
  .gap-realisation > strong { color: var(--ink); font-weight: 700; max-width: 30ch; margin-top: 6px; }
  .gap-status { margin: 48px 0 0; display: flex; align-items: center; gap: 18px; }
  .status-rule { display: block; width: 72px; height: 1px; background: var(--accent); }
  .gauge-label { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--faint); }
  /* Sits under the refrain rather than beside it. The refrain poses the
     question; this answers it without taking the emphasis. */
  .gap-answer {
    margin: 20px 0 0; font-family: var(--font-sans); font-size: 15px;
    line-height: 1.6; color: var(--faint); max-width: 48ch;
  }

  /* 5 · The verdict. It stays on the same left rail; the verdict object
     becomes the object on the right, not a centred interruption. */
  .verdict { padding-top: clamp(112px, 16vh, 184px); padding-bottom: clamp(112px, 16vh, 184px); }
  .verdict-flow {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(520px, 1.14fr);
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
  }
  .verdict-lead { max-width: 52ch; margin: 0; text-align: left; }
  .verdict-lead .label { margin: 0 0 24px; letter-spacing: 0.12em; }
  .verdict-lead .h2 { max-width: 24ch; margin: 0; font-size: clamp(32px, 4vw, 54px); }
  .verdict-lead .body { margin: 24px 0 0; max-width: 48ch; }
  .verdict-stage { display: flex; justify-content: flex-start; min-width: 0; }

  /* 6 · Close. Sparse. */
  .close { padding-top: clamp(112px, 16vh, 200px); padding-bottom: clamp(112px, 16vh, 200px); }
  .close-wrap { display: grid; gap: 28px; justify-items: start; }
  .close-q {
    font-family: var(--font-sans); font-weight: 700;
    font-size: clamp(40px, 6vw, 88px); letter-spacing: -0.02em;
    line-height: 1.0; margin: 0; max-width: 18ch; color: var(--ink);
  }
  .close-line { font-family: var(--font-sans); font-size: 16px; line-height: 1.65; color: var(--muted); margin: 0; max-width: 56ch; }
  .close-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

  @media (max-width: 880px) {
    .window-grid { grid-template-columns: 1fr 1fr; column-gap: 24px; }
    .verdict-flow { grid-template-columns: 1fr; align-items: start; }
    .verdict-stage { max-width: 760px; }
  }
  @media (max-width: 560px) {
    .hero .wrap,
    .block.quiet > .wrap,
    .block.quiet > .wrap-narrow,
    .gap > .wrap-narrow,
    .verdict > .wrap,
    .close > .wrap {
      max-width: var(--max);
    }
    /* The consent banner is a fixed overlay on a first visit. A shorter
       hero lifts the primary action clear of it, so "Discuss your system"
       is fully visible and fully clickable before the banner is answered. */
    .hero {
      min-height: 0;
      padding-top: 64px;
      padding-bottom: 56px;
    }
    .hero-chain { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 20px; }
    .window-grid { grid-template-columns: 1fr; }
    .gap-realisation { padding-left: 18px; }
  }

  /* 2 · Situations. Relevance, using the shared card grid. */
  .situations { border-bottom: 1px solid var(--hair); }
  .situations .h2 { max-width: 20ch; margin: 0 0 56px; }
  .situation-grid { list-style: none; margin: 0; padding: 0; }
  .situation-kicker {
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--accent);
  }
  .situation-grid .h3 { font-size: 21px; margin: 0; }
  .situation-grid p { margin: 0; }

  /* 5 · What is assessed. Sits under the verdict object on the same rail. */
  .chain-head {
    margin: clamp(72px, 10vh, 120px) 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--hair-strong);
  }
  .chain-list {
    list-style: none; margin: 36px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px;
  }
  .chain-list > li { display: grid; gap: 10px; align-content: start; }
  .chain-n {
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--accent);
  }
  .chain-list p { margin: 0; max-width: 34ch; }
  .chain-foot { margin: 36px 0 0; max-width: 62ch; }

  /* Illustrative finding. Deliberately set apart from the verdict object
     above it, so a constructed example is never mistaken for assessment
     evidence. Bronze rail on the left, label above, caveat below. */
  .finding {
    margin: clamp(56px, 8vh, 88px) 0 0;
    padding: 32px 0 0 28px;
    border-left: 2px solid var(--accent);
    border-top: 1px solid var(--hair);
    max-width: 72ch;
  }
  .finding-label { display: block; margin: 0 0 24px; color: var(--accent); }
  .finding-list { margin: 0; display: grid; gap: 20px; }
  .finding-list > div { display: grid; gap: 6px; }
  .finding-list dt {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--faint);
  }
  .finding-list dd {
    margin: 0; font-family: var(--font-sans); font-size: 17px;
    line-height: 1.6; color: var(--ink); max-width: 60ch;
  }
  .finding-note {
    margin: 28px 0 0; font-size: 15px; line-height: 1.6;
    color: var(--faint); max-width: 60ch;
  }

  /* 6 · The engagement. Obligation on the left, return on the right. */
  .engage { border-top: 1px solid var(--hair); background: var(--paper-soft); }
  .engage .h2 { max-width: 22ch; margin: 0 0 56px; }
  .engage-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 88px);
  }
  .engage-col .h3 { margin: 0 0 24px; padding-bottom: 16px; border-bottom: 1px solid var(--hair-strong); }
  .engage-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .engage-list > li {
    position: relative; padding-left: 22px;
    font-family: var(--font-sans); font-size: 17px; line-height: 1.6;
    color: var(--ink); max-width: 46ch;
  }
  .engage-list > li::before {
    content: ''; position: absolute; left: 0; top: 11px;
    width: 10px; height: 1px; background: var(--accent);
  }
  .engage-note { margin: 28px 0 0; max-width: 48ch; }
  .engage-terms,
  .engage-next {
