---
import BaseLayout from '../layouts/BaseLayout.astro';
import { offers, PRICE_QUALIFIER, AVAILABILITY, RECORDS_NOTE, SELF_APPROVAL } from '../lib/offers';
import { markAgda } from '../lib/marks';
import FindingChain from '../components/FindingChain.astro';
import OfferChoice from '../components/OfferChoice.astro';

/* Section order, front to back: doorway, relevance (three situations),
   what the assessment shows (one constructed finding, the four stages,
   the three states), the two offers, how the conclusion is controlled,
   next step, close. The failure timeline and the "gap" section were
   removed: the situations establish relevance and the finding shows the
   mechanism, so the timeline repeated both. The attestation specimen
   moved to /verify/ and /agda/; signed records are not a standard
   deliverable and did not belong above the fold. */

const situations = [
  {
    kicker: 'A consequential deployment',
    h: 'You are about to depend on something you cannot easily reverse.',
    p: 'Approval is close, the system will act without a human confirming each decision, and nobody has established how quickly it could be stopped.',
  },
  {
    kicker: 'Board or regulator scrutiny',
    h: 'Someone has asked for evidence, not assurance.',
    p: 'An audit committee, a supervisor or a risk committee wants to see that oversight works. Policies and control coverage do not answer the question they asked.',
  },
  {
    kicker: 'Untested arrangements',
    h: 'The arrangements exist. Nobody has run them under pressure.',
    p: 'Escalation routes, halt authority and named owners are documented. Whether they hold at 3am, during a change freeze, or when the primary contact is unavailable is a separate question.',
  },
];

const states = [
  { name: 'Before impact', p: 'The chain completes in time under the assessed conditions.' },
  { name: 'At risk', p: 'The chain completes, but within a margin that ordinary operational pressure can erode.' },
  { name: 'After impact', p: 'The chain does not complete in time. Intervention lands after the consequence.' },
];

/* The constructed retail-credit example, as corrected on /sample-report/.
   Facts are the sample's own; nothing is added: no score, no money, no
   evidence grade, no regulatory conclusion. */
const finding = {
  system: 'CRED-MOD-04, a retail credit decisioning model. Automated approve, decline or refer decisions; the question concerns the auto-decline pathway.',
  scenario: 'A macro shock coincides with model drift and creates a need to stop or redirect the affected pathway.',
  decision: 'Whether the auto-decline pathway can keep operating under its present authority arrangements, and what has to change before the organisation relies on it: who may authorise a halt, how that person is reached out of hours, and how the route is exercised before it is needed.',
  limits: 'One pathway and one scenario. Nothing here is a conclusion about any institution, other systems or legal conformity.',
};
---

<BaseLayout
  title="Intervention Readiness · Intervene"
  description="AGDA™ assesses whether your organisation can detect, escalate, decide and intervene in a consequential AI-enabled system within the time available."
  current="home"
>
  <!-- 1 · DOORWAY -->
  <section class="hero">
    <div class="wrap">
      <a class="label hero-label hero-link" href="/intervention-readiness/">Intervention Readiness</a>
      <h1 class="display-xl">Can you stop it <em>in time?</em></h1>
      <p class="hero-sub">
        Intervention Readiness is the ability of an organisation to detect,
        escalate, decide and intervene before harm becomes irreversible.
        <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> is Intervene's proprietary assessment of it.
      </p>
      <div class="hero-cta">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="#offers" class="btn-ghost">Compare the two options</a>
      </div>
      <p class="hero-note">
        Two starting points: an Intervention Readiness Review, or a full
        <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment of one named system through a defined
        pathway and a specified intervention scenario.
      </p>
      <ul class="hero-chain" role="list" aria-label="Intervention readiness chain">
        <li>Detect</li>
        <li>Escalate</li>
        <li>Decide</li>
        <li>Intervene</li>
      </ul>
    </div>
  </section>

  <!-- 2 · RELEVANCE -->
  <section class="block situations">
    <div class="wrap">
      <span class="label section-kicker">Where the question arrives</span>
      <h2 class="h2">Three situations that bring people here.</h2>
      <ul class="card-grid situation-grid" role="list">
        {situations.map((s) => (
          <li class="card">
            <span class="mono situation-kicker">{s.kicker}</span>
            <h3 class="h3 card-title">{s.h}</h3>
            <p class="body muted">{s.p}</p>
          </li>
        ))}
      </ul>
      <p class="body muted situations-foot">
        Documented responsibilities alone do not establish whether the people
        named can intervene in time. The assessment examines whether they can.
      </p>
    </div>
  </section>

  <!-- 3 · WHAT THE ASSESSMENT SHOWS -->
  <section class="block finding-block">
    <div class="wrap">
      <span class="label section-kicker">What a finding looks like</span>
      <h2 class="h2">Detection works. <em>Authority does not.</em></h2>
      <p class="lede muted">
        A constructed illustration of a full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment finding.
        It describes no real organisation, uses no client data, and is not an
        issued assessment or a verified outcome.
      </p>

      <dl class="finding-scope">
        <div><dt>System</dt><dd>{finding.system}</dd></div>
        <div><dt>Scenario</dt><dd>{finding.scenario}</dd></div>
      </dl>

      <FindingChain />

      <dl class="finding-verdict">
        <div>
          <dt>Decision the finding supports</dt>
          <dd>{finding.decision}</dd>
        </div>
        <div>
          <dt>Assumptions and limits</dt>
          <dd>{finding.limits}</dd>
        </div>
      </dl>
      <p class="finding-note">
        <a href="/sample-report/" class="link">Read the full constructed sample</a>.
      </p>

      <h3 class="h3 chain-head">What a full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment returns.</h3>
      <p class="body muted chain-foot">
        Each stage is assessed against evidence. The weakest stage constrains
        the chain, and the assessment names it. A full Assessment returns one of
        three states; the Review does not produce a verdict.
      </p>
      <ul class="states" role="list">
        {states.map((st) => (
          <li>
            <span class="mono state-name">{st.name}</span>
            <p class="body muted">{st.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · THE TWO OFFERS. Shared diagram; the full sheets are on /services/. -->
  <section class="block engage" id="offers">
    <div class="wrap">
      <OfferChoice headingLevel="h2" />
      <p class="engage-terms">
        {PRICE_QUALIFIER} The proposal confirms the scope, outputs, fee, terms
        and timetable. {AVAILABILITY}
        <a href="/services/" class="link">Scope, fees and how an engagement runs</a>.
      </p>
    </div>
  </section>

  <!-- 5 · HOW THE CONCLUSION IS CONTROLLED, AND THE NEXT STEP -->
  <section class="block basis">
    <div class="wrap">
      <div class="basis-grid">
        <div>
          <h2 class="h2">A conclusion with a visible basis.</h2>
          <p class="body muted">
            The assessment identifies the limiting parts of the intervention
            chain and explains the evidence and assumptions behind the result.
            Intervene retains responsibility for the conclusion. Clients can
            correct facts, challenge interpretation and provide further
            evidence. {SELF_APPROVAL}
          </p>
          <p class="body muted">
            {RECORDS_NOTE} Where they are supplied, a check establishes the
            integrity of the covered records, not the truth of the evidence.
            <a href="/verify/" class="link">What verification establishes</a>.
          </p>
        </div>
        <div>
          <h2 class="h2">What happens next.</h2>
          <p class="body muted">
            Tell us the system and the decision it supports. The first
            conversation is twenty minutes at no charge, and you receive a
            direct response within one to two working days. We do not
            pre-qualify by email questionnaire. Scope, delivery arrangements
            and a start date are confirmed in the proposal.
          </p>
          <div class="hero-cta">
            <a href="/contact/" class="btn">Discuss your system</a>
            <a href="/services/" class="btn-ghost">Assessment options</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · CLOSE -->
  <section class="block close">
    <div class="wrap close-wrap">
      <h2 class="close-q">Can you stop it <em>in time?</em></h2>
      <p class="close-line">The assessment names the stage that limits timely intervention, so remediation can be prioritised.</p>
      <div class="close-actions">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--paper-deep);
    color: var(--ink);
    border-bottom: 1px solid var(--hair);
    /* Sized to its content, not the viewport, so the primary action and
       the chain sit inside the first screen with the consent banner open. */
    padding-top: clamp(48px, 8vh, 104px);
    padding-bottom: clamp(40px, 7vh, 88px);
  }
  /* Short viewports (a 720px laptop, a small phone) with the consent
     banner open: keep the primary action above the banner. */
  @media (max-height: 760px) {
    .hero { padding-top: 40px; }
    .hero .display-xl { font-size: clamp(40px, 6.2vw, 68px); }
    .hero-sub { margin-top: 20px; font-size: 18px; }
    .hero-cta { margin-top: 28px; }
  }
  .hero .wrap,
  .finding-block > .wrap,
  .close > .wrap { max-width: 1120px; }
  .hero-link { display: inline-block; border-bottom: 1px solid transparent; }
  .hero-link:hover { border-color: var(--accent); color: var(--ink); }
  .hero .display-xl { max-width: 820px; color: var(--ink); }
  .hero-sub {
    margin: 28px 0 0; font-family: var(--font-sans);
    font-size: clamp(18px, 1.8vw, 22px); font-weight: 400; letter-spacing: 0;
    color: var(--muted); line-height: 1.62; max-width: 48ch;
  }
  .hero-note { margin: 24px 0 0; font-size: 15px; color: var(--muted); max-width: 52ch; line-height: 1.6; }
  .hero-cta { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-chain {
    list-style: none; margin: clamp(36px, 6vh, 64px) 0 0; padding: 28px 0 0;
    border-top: 1px solid var(--hair); display: flex; flex-wrap: wrap; gap: 18px 36px;
  }
  .hero-chain li {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--faint);
  }

  /* 2 · Situations */
  .situations { border-bottom: 1px solid var(--hair); }
  .situations .h2 { max-width: 20ch; margin: 0 0 56px; }
  .situation-grid { list-style: none; margin: 0; padding: 0; }
  .situation-kicker { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
  .situation-grid .h3 { font-size: 21px; margin: 0; }
  .situation-grid p { margin: 0; }
  .situations-foot { margin: 48px 0 0; max-width: 62ch; }

  /* 3 · Finding */
  .finding-block { background: var(--paper-soft); border-bottom: 1px solid var(--hair); }
  .finding-block .h2 { max-width: 22ch; }
  .finding-block .lede { margin-top: 16px; max-width: 60ch; }
  .finding-scope {
    margin: 48px 0 0; padding-top: 28px; border-top: 1px solid var(--hair-strong);
    display: grid; grid-template-columns: 1fr 1fr; gap: 22px clamp(32px, 5vw, 72px); align-content: start;
  }
  .finding-scope div { display: grid; gap: 6px; }
  .finding-scope dt,
  .finding-verdict dt {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--faint);
  }
  .finding-scope dd,
  .finding-verdict dd { margin: 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--ink); max-width: 52ch; }
  .finding-verdict {
    margin: 40px 0 0; padding: 28px 0 0 28px; border-left: 2px solid var(--accent);
    display: grid; grid-template-columns: 1fr 1fr; gap: 32px;
  }
  .finding-verdict div { display: grid; gap: 8px; align-content: start; }
  .finding-note { margin: 24px 0 0; font-size: 15px; line-height: 1.6; color: var(--faint); max-width: 60ch; }

  .chain-head { margin: clamp(64px, 9vh, 104px) 0 0; padding-top: 32px; border-top: 1px solid var(--hair-strong); }
  .chain-foot { margin: 20px 0 0; max-width: 62ch; }
  .states { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px 32px; }
  .states > li { display: grid; gap: 8px; align-content: start; padding-top: 16px; border-top: 1px solid var(--hair); }
  .state-name { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); }
  .states p { margin: 0; max-width: 34ch; font-size: 15px; }

  /* 4 · Offers */
  .engage { border-bottom: 1px solid var(--hair); }
  .engage-terms {
    margin: 48px 0 0; padding-top: 28px; border-top: 1px solid var(--hair-strong);
    font-family: var(--font-sans); font-size: 16px; line-height: 1.65; color: var(--muted); max-width: 68ch;
  }

  /* 5 · Basis and next step */
  .basis { background: var(--paper-soft); border-bottom: 1px solid var(--hair); }
  .basis-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .basis .h2 { max-width: 20ch; font-size: clamp(26px, 3vw, 36px); }
  .basis .body { margin: 20px 0 0; max-width: 52ch; }
  .basis .hero-cta { margin-top: 28px; }

  /* 6 · Close */
  .close { padding-top: clamp(96px, 14vh, 176px); padding-bottom: clamp(96px, 14vh, 176px); }
  .close-wrap { display: grid; gap: 28px; justify-items: start; }
  .close-q { font-family: var(--font-sans); font-weight: 700; font-size: clamp(40px, 6vw, 88px); letter-spacing: -0.02em; line-height: 1.0; margin: 0; max-width: 18ch; color: var(--ink); }
  .close-line { font-family: var(--font-sans); font-size: 16px; line-height: 1.65; color: var(--muted); margin: 0; max-width: 56ch; }
  .close-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 880px) {
    .finding-scope { grid-template-columns: 1fr; }
    .finding-verdict { grid-template-columns: 1fr; }
    .states { grid-template-columns: 1fr; }
    .basis-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero .wrap, .finding-block > .wrap, .close > .wrap { max-width: var(--max); }
    .hero { padding-top: 40px; padding-bottom: 44px; }
    .hero .display-xl { font-size: clamp(36px, 11vw, 48px); }
    .hero-sub { margin-top: 16px; font-size: 17px; }
    .hero-cta { margin-top: 24px; }
    .hero-chain { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 20px; }
    .finding-verdict { padding-left: 18px; }
    .situations .h2, .engage .h2 { margin-bottom: 40px; }
  }
</style>
