---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRICE_QUALIFIER, AVAILABILITY, RECORDS_NOTE, SELF_APPROVAL } from '../lib/offers';
import FindingChain from '../components/FindingChain.astro';
import OfferChoice from '../components/OfferChoice.astro';
import AgdaLogo from '../components/AgdaLogo.astro';
import Agda from '../components/Agda.astro';
import SediExplorer from '../components/SediExplorer.astro';
import IntegrityNote from '../components/IntegrityNote.astro';

const questions = [
  { h: 'Who can actually stop it?', p: 'Not who owns the risk. Who has the authority to intervene?' },
  { h: 'Will they know in time?', p: 'Does actionable information reach the right people before the intervention window closes?' },
  { h: 'What happens when they act?', p: 'Does intervention work under actual operating conditions?' },
];
// The existing constructed sample. No client evidence or issued conclusion.
const finding = {
  system: 'CRED-MOD-04, a retail credit decisioning model. Automated approve, decline or refer decisions; the question concerns the auto-decline pathway.',
  scenario: 'A macro shock coincides with model drift and creates a need to stop or redirect the affected pathway.',
  decision: 'Whether the auto-decline pathway can keep operating under its present authority arrangements, and what has to change before the organisation relies on it: who may authorise a halt, how that person is reached out of hours, and how the route is exercised before it is needed.',
  limits: 'One pathway and one scenario. Nothing here is a conclusion about any institution, other systems or legal conformity.',
};
---
<BaseLayout
  title="Intervention Readiness · Intervene"
  description="AGDA® assesses whether your organisation can detect, escalate, decide and intervene in a consequential AI-enabled system within the time available."
  current="home"
>
  <section class="hero hero-home" aria-labelledby="home-question">
    <div class="wrap">
      <a class="label hero-link" href="/intervention-readiness/">Intervention Readiness</a>
      <h1 class="display-xl" id="home-question">Can you stop it <em>in time?</em></h1>
      <div class="hero-intro">
        <p class="hero-sub">Consequential systems need people who can act before harm becomes irreversible.</p>
        <div class="hero-actions">
          <div class="hero-cta">
            <a href="/contact/" class="btn">Discuss your system</a>
            <a href="/agda/" class="link hero-secondary">Explore <Agda /> <span aria-hidden="true">→</span></a>
          </div>
          <p class="hero-note">One named system. One defined pathway. One intervention scenario.</p>
        </div>
      </div>
      <p class="hero-principle">Governance is an input. <span>Intervention capability is the outcome.</span></p>
    </div>
  </section>

  <section class="block situations" aria-labelledby="home-problem">
    <div class="wrap">
      <div class="section-heading">
        <span class="label section-kicker">The problem</span>
        <h2 class="h2" id="home-problem">Responsibilities are documented. Can the people act?</h2>
      </div>
      <ol class="problem-questions" role="list" data-reveal="stagger">
        {questions.map((q, i) => (
          <li><span class="mono problem-index" aria-hidden="true">0{i + 1}</span><h3 class="h3">{q.h}</h3><p class="body muted">{q.p}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block method-block" aria-labelledby="home-method">
    <div class="wrap">
      <div class="assessment-intro">
        <div class="assessment-identity"><AgdaLogo /><span class="label">The method</span></div>
        <div>
          <h2 class="h2" id="home-method">Assess the ability to intervene.</h2>
          <p class="lede muted"><Agda /> assesses whether organisations can detect, escalate, decide and intervene when consequential systems require human intervention.</p>
        </div>
      </div>
      <SediExplorer />
      <nav class="related-links" aria-label="Explore the method"><a href="/methodology/" class="link">The methodology and its limits <span aria-hidden="true">→</span></a></nav>
    </div>
  </section>

  <section class="block finding-block" aria-labelledby="home-evidence">
    <div class="wrap">
      <div class="section-heading">
        <span class="label section-kicker">The evidence</span>
        <div>
          <h2 class="h2" id="home-evidence">A verdict. Supported by evidence.</h2>
          <p class="body muted">A full <Agda /> Assessment returns a verdict, evidence register, SEDI findings and executive interpretation. The Review does not produce a verdict.</p>
        </div>
      </div>
      <div class="example-heading">
        <span class="mono example-label">Constructed illustration</span>
        <h3 class="h3">Detection works. Authority does not.</h3>
        <p class="body muted">Can the auto-decline pathway stop within an assumed six-hour window? No client data; not an issued assessment or a verified outcome.</p>
      </div>
      <FindingChain />
      <details class="finding-example" data-disclosure>
        <summary><span class="example-title">Inspect the scope, decision and limitations</span><span class="example-toggle" aria-hidden="true"></span></summary>
        <div data-disclosure-body>
          <div class="example-body">
            <dl class="finding-scope">
              <div><dt>System</dt><dd>{finding.system}</dd></div>
              <div><dt>Scenario</dt><dd>{finding.scenario}</dd></div>
            </dl>
            <dl class="finding-verdict">
              <div><dt>Decision the finding supports</dt><dd>{finding.decision}</dd></div>
              <div><dt>Assumptions and limits</dt><dd>{finding.limits}</dd></div>
            </dl>
          </div>
        </div>
      </details>
      <nav class="related-links" aria-label="Inspect the assessment output"><a href="/sample-report/" class="btn-ghost">View sample verdict</a><a href="/agda/#verdict" class="link">The three verdict states <span aria-hidden="true">→</span></a></nav>
      <div class="evidence-notes">
        <p>{SELF_APPROVAL} {RECORDS_NOTE} <a href="/verify/" class="link">What verification establishes</a>.</p>
        <IntegrityNote />
      </div>
    </div>
  </section>

  <section class="block engage" id="offers">
    <div class="wrap">
      <OfferChoice headingLevel="h2" editorial />
      <p class="engage-terms">{PRICE_QUALIFIER} The proposal confirms scope, outputs, fee, terms and timetable. {AVAILABILITY} <a href="/services/" class="link">Scope, fees and how an engagement runs</a>.</p>
    </div>
  </section>

  <section class="block close" aria-labelledby="home-decision">
    <div class="wrap close-wrap">
      <h2 class="close-q" id="home-decision">Can you stop it <em>in time?</em></h2>
      <div class="close-action"><p class="close-line">Establish what your organisation can actually do before it matters.</p><a href="/contact/" class="btn">Discuss your system <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { background: var(--paper-deep); padding: clamp(48px, 7vh, 80px) 0 40px; }
  .hero-link { display: inline-flex; align-items: center; min-height: 44px; }
  .hero .display-xl { font-size: var(--type-display); line-height: 1.06; margin: 24px 0 0; }
  .hero-intro { display: grid; grid-template-columns: 1.35fr 1fr; gap: var(--space-7); margin-top: 40px; }
  .hero-sub { margin: 0; font-size: var(--type-support); line-height: 1.6; color: var(--muted); }
  .hero-actions { padding-top: 4px; }
  .hero-cta { margin: 0; align-items: flex-start; gap: 20px; flex-direction: column; }
  .hero-secondary { display: inline-flex; align-items: center; gap: 8px; font-size: var(--type-small); line-height: 1.5; min-height: 44px; }
  .hero-note { font-family: var(--font-mono); font-size: var(--type-caption); line-height: 1.65; color: var(--faint); margin: 20px 0 0; }
  .hero-principle { border-top: 1px solid var(--hair); padding-top: 24px; margin: 40px 0 0; color: var(--faint); font-size: var(--type-small); line-height: 1.6; }
  .hero-principle span { color: var(--ink); }
  .section-heading, .assessment-intro { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-6); align-items: start; margin-bottom: 48px; }
  .section-heading .label { margin-top: 10px; }
  .block .h2, .block .h3 { text-transform: none; letter-spacing: var(--tracking-heading); font-weight: 600; }
  .block .h2 { font-size: var(--type-h2); line-height: 1.2; }
  .block .h3 { font-size: var(--type-h3); line-height: 1.3; }
  .block .body { font-size: var(--type-body); line-height: 1.7; }
  .situations, .method-block, .finding-block, .engage { border-bottom: 1px solid var(--hair); }
  .problem-questions { list-style: none; margin: 0; padding: 0; }
  .problem-questions li { display: grid; grid-template-columns: 40px 1fr 1fr; gap: var(--space-6); align-items: baseline; padding: 32px 0; border-top: 1px solid var(--hair-strong); }
  .problem-index { color: var(--accent); font-size: var(--type-caption); }
  .problem-questions :is(h3, p) { margin: 0; }
  .assessment-identity { display: grid; gap: 32px; justify-items: start; padding-top: 8px; }
  .assessment-identity :global(.agda-logo.logo) { width: 256px; }
  .assessment-intro .lede { font-size: var(--type-support); line-height: 1.65; margin-top: 24px; }
  .finding-block { background: var(--paper-soft); }
  .example-heading { border-top: 1px solid var(--hair-strong); padding-top: 32px; }
  .example-label { font-size: var(--type-caption); line-height: 1.6; color: var(--accent); }
  .example-heading .h3 { margin: 16px 0; }
  .finding-example { border-block: 1px solid var(--hair-strong); margin-top: 32px; }
  .finding-example summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 24px 0; }
  .finding-example summary::-webkit-details-marker { display: none; }
  .finding-example summary:is(:hover, :focus-visible) .example-title { color: var(--accent); }
  .finding-example summary:active .example-title { color: var(--accent-hover); }
  .finding-example summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  .example-title { transition: color var(--dur-fast) var(--ease); font-size: var(--type-body); line-height: 1.5; color: var(--ink); }
  .example-toggle { width: 20px; height: 20px; position: relative; flex: none; }
  .example-toggle::before, .example-toggle::after { content: ''; position: absolute; background: var(--accent); }
  .example-toggle::before { width: 18px; height: 1px; top: 9px; left: 1px; }
  .example-toggle::after { height: 18px; width: 1px; top: 1px; left: 9px; }
  .example-toggle::after { transition: transform var(--dur-expand) var(--ease-out); transform-origin: center; }
  .finding-example[open]:not([data-disclosure-state='closed']) .example-toggle::after { transform: scaleY(0); }
  .example-body { padding: 8px 0 32px; }
  .finding-scope, .finding-verdict { margin: 0; padding: 24px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .finding-verdict { margin-top: 24px; border-top: 1px solid var(--hair); }
  .finding-scope dt, .finding-verdict dt { font-family: var(--font-mono); font-size: var(--type-caption); color: var(--accent); margin-bottom: 12px; }
  .finding-scope dd, .finding-verdict dd { margin: 0; font-size: var(--type-small); line-height: 1.7; color: var(--muted); }
  .evidence-notes { border-top: 1px solid var(--hair); margin-top: 32px; padding-top: 24px; }
  .evidence-notes > p { font-size: var(--type-small); line-height: 1.7; color: var(--muted); margin: 0; }
  .engage-terms { margin: 32px 0 0; padding-top: 24px; border-top: 1px solid var(--hair); font-size: var(--type-small); line-height: 1.7; color: var(--muted); }
  .close-wrap { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-7); align-items: end; }
  .close-q { color: var(--ink); font-size: clamp(36px, 4.2vw, 60px); line-height: 1.13; letter-spacing: var(--tracking-heading); text-transform: none; margin: 0; }
  .close-action { display: grid; justify-items: start; gap: 24px; }
  .close-line { font-size: var(--type-support); line-height: 1.65; color: var(--muted); margin: 0; }
  @media (max-height: 760px) and (min-width: 881px) { .hero { padding-top: 40px; } .hero .display-xl { font-size: clamp(44px, 6vw, 80px); } .hero-intro { margin-top: 28px; } }
  @media (max-width: 1100px) { .hero-intro { gap: 40px; } .section-heading, .assessment-intro { grid-template-columns: 1fr 1.8fr; gap: 32px; } .assessment-identity :global(.agda-logo.logo) { width: 224px; } .problem-questions li { gap: 24px; } }
  @media (max-width: 960px) {
    .hero-intro { grid-template-columns: 1fr; gap: 24px; }
    .hero-actions { grid-row: 1; }
    .hero-cta { flex-direction: row; align-items: center; gap: 16px 24px; }
    .hero-note { margin-top: 16px; }
    .section-heading, .assessment-intro, .close-wrap { grid-template-columns: 1fr; gap: 24px; }
    .section-heading .label { margin-top: 0; }
    .assessment-identity { padding-top: 0; }
    .problem-questions li { grid-template-columns: 32px 1fr; gap: 12px 24px; }
    .problem-index { grid-row: span 2; padding-top: 8px; }
    .problem-questions p { grid-column: 2; }
    .close-wrap { gap: 32px; }
  }
  @media (max-width: 560px) {
    .hero { padding-top: 32px; padding-bottom: 32px; }
    .hero .display-xl { font-size: clamp(34px, 8.6vw, 48px); margin-top: 24px; }
    .hero-intro { margin-top: 24px; gap: 24px; }
    .hero-cta { flex-direction: column; align-items: stretch; gap: 12px; }
    .hero-secondary { align-self: flex-start; }
    .hero-sub { font-size: 18px; }
    .hero-principle { margin-top: 32px; font-size: 15px; }
    .hero-principle span { display: block; }
    .section-heading { margin-bottom: 32px; }
    .problem-questions li { grid-template-columns: 24px 1fr; column-gap: 16px; }
    .problem-questions .h3 { font-size: var(--type-card); }
    .finding-scope, .finding-verdict { grid-template-columns: 1fr; gap: 24px; }
    .close-q { font-size: clamp(30px, 8vw, 44px); }
  }
</style>
