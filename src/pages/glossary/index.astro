---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { markAgda } from '../../lib/marks';
import { terms } from '../../lib/terms';

// Render the single source-of-truth vocabulary. Hub terms link to their
// dedicated page; the rest are canonically defined here at their anchor.
const hubLink = (path: string) => `/${path}`;

const faqs = [
  {
    question: 'What is Intervention Readiness?',
    answer: 'Intervention Readiness is the ability of an organisation to detect, escalate, decide and intervene before harm becomes irreversible.',
  },
  {
    question: 'What does AGDA™ assess?',
    answer: 'AGDA™ assesses Intervention Readiness: whether an organisation can detect, escalate, decide and intervene within the available reversibility window.',
  },
];
---

<BaseLayout
  title="Glossary · Intervene"
  description="The defined terms of Intervention Readiness: the intervention chain, the reversibility window, halt authority and effective human oversight."
  current="intervention-readiness"
  faqs={faqs}
>
  <section class="hero">
    <div class="wrap">
      <span class="label">Reference</span>
      <h1 class="h1">Glossary of Intervention Readiness.</h1>
      <p class="lede muted">
        The vocabulary of the category, defined once. Each term is used the
        same way across the site, the schema and the verdict.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <dl class="glossary">
        {terms.map((t) => (
          <div id={t.slug}>
            <dt set:html={markAgda(t.name)} />
            <dd>
              <p class="body" set:html={markAgda(t.definition)} />
              {t.hub && (
                <a href={hubLink(t.path)} class="link">Read the full page</a>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="block tight">
    <div class="wrap-narrow">
      <h2 class="h2">The category, the instrument, the owner.</h2>
      <p class="body muted">
        Intervention Readiness is the category. <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> is the proprietary
        assessment of it, created and owned by Intervene Limited.
      </p>
      <div class="cta-row">
        <a href="/intervention-readiness/" class="btn">What is Intervention Readiness?</a>
        <a href="/agda/" class="btn-ghost"><span class="agda-mark">AGDA<span class="agda-tm">™</span></span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Reference list: term left, definition right, one rule per entry.
     Each entry is an anchor, so it clears the sticky header. */
  .hero .h1 { max-width: 20ch; }
  .glossary { margin: 0; border-top: 1px solid var(--hair-strong); }
  .glossary > div {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hair);
  }
  .glossary dt {
    font-family: var(--font-sans);
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.25;
    color: var(--ink);
    max-width: 24ch;
  }
  .glossary dd { margin: 0; display: grid; gap: var(--gap-item); justify-items: start; }
  .glossary .body { max-width: 56ch; margin: 0; }
  @media (max-width: 880px) {
    .glossary > div { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
