---
import BaseLayout from '../../layouts/BaseLayout.astro';

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xvzwdyob';

const info = [
  { k: 'Confidentiality', v: 'All correspondence is private and off record unless explicitly agreed otherwise. NDA available before substantive discussion.' },
  { k: 'Response window', v: 'You receive a direct response within one to two working days. We do not auto-reply.' },
  { k: 'No obligation',   v: 'An initial conversation is brief and creates no engagement. We will say if we are not the right fit.' },
  { k: 'Office',          v: 'London, United Kingdom. Global mandates.' },
];
---

<BaseLayout
  title="Book a Conversation · Intervene"
  description="Book a confidential conversation about an AGDA™ Intervention Readiness assessment for a consequential system where intervention must remain possible."
  current="contact"
  ogImage="/assets/og/og-contact.png"
  pageType="ContactPage"
>
  <section class="hero">
    <div class="wrap">
      <h1 class="h1 reveal">Book a <em>conversation.</em></h1>
      <p class="lede muted reveal">
        Tell us the system, decision or exposure where you need to know whether
        intervention remains possible. A single line is enough to establish
        context.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="contact-grid">
        <aside class="info-col reveal">
          <h2 class="h2">What helps us understand the question.</h2>
          <p class="body muted">
            Include the system, decision, harm window or oversight concern. We
            will write back. We do not pre-qualify by email questionnaire.
          </p>

          <dl class="info-list">
            {info.map((row) => (
              <div>
                <dt>{row.k}</dt>
                <dd>{row.v}</dd>
              </div>
            ))}
          </dl>
        </aside>

        <div class="form-col reveal">
          <h2 class="h2">Tell us what may need to be stopped.</h2>

          <form class="form" data-contact action={FORMSPREE_ENDPOINT} method="POST" novalidate>
            <div class="field">
              <label for="f-name">Name</label>
              <input type="text" id="f-name" name="name" required autocomplete="name" />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="f-org">Organisation</label>
                <input type="text" id="f-org" name="organisation" required autocomplete="organization" />
              </div>
              <div class="field">
                <label for="f-email">Email</label>
                <input type="email" id="f-email" name="email" required autocomplete="email" />
              </div>
            </div>

            <div class="field">
              <label for="f-role">Role</label>
              <input
                type="text"
                id="f-role"
                name="role"
                placeholder="Board member · CRO · CISO · GC · Head of model risk"
                autocomplete="organization-title"
              />
            </div>

            <div class="field">
              <label for="f-msg">What must remain stoppable?</label>
              <textarea
                id="f-msg"
                name="message"
                rows="5"
                required
                placeholder="A single line is enough."></textarea>
            </div>

            <input
              type="text"
              name="_gotcha"
              class="honey"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <div class="submit-row">
              <p class="small muted">
                Held in strict confidence. Read the
                <a href="/legal/privacy/" class="link">privacy notice</a>.
              </p>
              <button type="submit" class="btn">Book a conversation</button>
            </div>

            <div class="form-status" hidden role="status"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initContactForm } from '../../lib/contact.ts';
    initContactForm();
  </script>
</BaseLayout>

<style>
  .hero {
    padding-top: 144px;
    padding-bottom: 144px;
    border-bottom: 1px solid var(--hair);
  }
  .hero .h1 { max-width: 16ch; }
  .hero .lede { margin-top: 32px; max-width: 52ch; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 96px;
    align-items: start;
  }

  /* Info column */
  .info-col .h2 { max-width: 24ch; }
  .info-col .body { margin: 16px 0 0; max-width: 36ch; }
  .info-list {
    margin: 40px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--hair);
    display: grid;
    gap: 20px;
  }
  .info-list > div {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 16px;
  }
  .info-list dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .info-list dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--ink);
    line-height: 1.55;
  }

  /* Form column. Field, choice, error, status and submit-row styles
     now live in src/styles/forms.css so the Snapshot does not
     duplicate them. Only the page layout remains here. */
  .form-col .h2 { max-width: 22ch; margin: 0 0 40px; }

  @media (max-width: 880px) {
    .hero { padding-top: 96px; padding-bottom: 96px; }
    .contact-grid { grid-template-columns: 1fr; gap: 64px; }
    .info-list > div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
