---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contactEmail, founderLine } from '../../lib/social';
import Agda from '../../components/Agda.astro';

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xaqrkrpo';

const info: { k: string; v: string; href?: string }[] = [
  { k: 'Confidentiality', v: 'We handle enquiries discreetly and use them only to respond to you. They are not used for marketing. An NDA is available before substantive discussion. The form is relayed by a third-party service.' },
  { k: 'Response',        v: 'You receive a direct response. We do not auto-reply.' },
  { k: 'Email',           v: contactEmail, href: `mailto:${contactEmail}` },
  { k: 'No obligation',   v: 'An initial conversation is brief and creates no engagement. We will say if we are not the right fit.' },
  { k: 'Office',          v: 'London, United Kingdom.' },
];
---

<BaseLayout
  title="Book a Conversation · Intervene"
  description="Discuss a consequential system, its intervention question and whether an Authority Check, an Intervention Readiness Review or a full AGDA® Assessment is the right next step."
  current="contact"
  ogImage="/assets/og/og-contact.png"
  pageType="ContactPage"
>
  <section class="hero contact-hero">
    <div class="wrap">
      <h1 class="h1">Discuss <em>your system.</em></h1>
    </div>
  </section>

  <section class="block contact-body">
    <div class="wrap">
      <div class="contact-grid">
        <div class="form-col">
          <p class="form-intro">
            The first conversation takes 20 minutes and is free of charge.
            We’ll discuss the system, the decision it supports and whether an
            assessment would answer your question. We reply within one to two
            working days.
          </p>

          <form class="form" data-contact action={FORMSPREE_ENDPOINT} method="POST">
            <input type="hidden" name="subject" value="Intervene | New enquiry" />
            <div class="field">
              <label for="f-name">Name</label>
              <input type="text" id="f-name" name="name" required autocomplete="name" />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="f-org">Organisation</label>
                <input type="text" id="f-org" name="organisation" required autocomplete="organization" />
              </div>
              <div class="field">
                <label for="f-email">Email</label>
                <input type="email" id="f-email" name="email" required autocomplete="email" />
              </div>
            </div>

            <div class="field">
              <label for="f-role">Role <span class="muted">(optional)</span></label>
              <input
                type="text"
                id="f-role"
                name="role"
                placeholder="Board member · CRO · CISO · GC · Head of model risk"
                autocomplete="organization-title"
              />
            </div>

            <div class="field">
              <label for="f-msg">What must remain stoppable?</label>
              <p class="small muted field-help" id="f-msg-help">
                The system, the decision or action it influences, and what
                might require intervention. One line is enough. Leave out
                sensitive details.
              </p>
              <textarea
                id="f-msg"
                name="message"
                rows="5"
                required
                aria-describedby="f-msg-help"></textarea>
            </div>
            <fieldset class="choice-set">
              <legend class="field-legend">Starting point</legend>
              <div class="choice-list">
                <label class="choice">
                  <input type="radio" name="starting_point" value="not-sure" checked />
                  <span class="choice-marker" aria-hidden="true"></span>
                  <span class="choice-label">Not sure yet</span>
                </label>
                <label class="choice">
                  <input type="radio" name="starting_point" value="check" />
                  <span class="choice-marker" aria-hidden="true"></span>
                  <span class="choice-label">Authority Check</span>
                </label>
                <label class="choice">
                  <input type="radio" name="starting_point" value="review" />
                  <span class="choice-marker" aria-hidden="true"></span>
                  <span class="choice-label">Intervention Readiness Review</span>
                </label>
                <label class="choice">
                  <input type="radio" name="starting_point" value="assessment" />
                  <span class="choice-marker" aria-hidden="true"></span>
                  <span class="choice-label">Full <Agda /> Assessment</span>
                </label>
              </div>
            </fieldset>

            <input
              type="text"
              name="_gotcha"
              class="honey"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <div class="submit-row">
              <p class="small muted">
                Handled discreetly. Relayed by Formspree (United States) to our
                email service. Read the
                <a href="/legal/privacy/" class="link">privacy notice</a>.
              </p>
              <button type="submit" class="btn">Send enquiry</button>
            </div>

            <div class="form-status" hidden role="status"></div>
          </form>
        </div>

        <aside class="info-col">
          <h2 class="info-heading">How we handle your enquiry</h2>
          <p class="body muted">
            We do not pre-qualify by email questionnaire, and nothing is
            committed until scope and fees are agreed in writing.
          </p>

          <p class="body muted">
            {founderLine} <a href="/about/" class="link">Why Intervene exists</a>.
          </p>

          <dl class="spec-list info-list">
            {info.map((row) => (
              <div>
                <dt>{row.k}</dt>
                <dd>{row.href ? <a href={row.href} class="link">{row.v}</a> : row.v}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <script>
    import { initContactForm } from '../../lib/contact.ts';
    initContactForm();
  </script>
</BaseLayout>

<style>
  /* The form leads in reading and keyboard order, with what the first
     conversation involves stated above its first field. Context sits beside
     it on desktop and follows it when the columns stack. */

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  /* The heading and the form read as one opening: no rule between them. */
  .contact-hero { padding-bottom: 0; border-bottom: 0; }
  /* The same heading size as the other pages' openings, now that it stands without a sentence beside it. */
  @media (min-width: 1100px) { .contact-hero .h1 { font-size: clamp(40px, 4.6vw, 68px); } }
  .contact-body { padding-top: var(--space-5); }

  /* The sidebar is reference, set a step below the form in weight. */
  .info-col { padding-top: 6px; }
  .info-heading { margin: 0; font-size: var(--type-card); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.25; color: var(--ink); }
  .info-col .body { margin: var(--gap-head) 0 0; font-size: var(--type-small); }
  .info-col .body + .body { margin-top: var(--space-2); }
  .info-col .body .link { display: inline-block; }
  .info-list { --spec-col: 130px; margin-top: var(--space-5); border-top-color: var(--hair); }
  .info-list > div { padding: 12px 0; gap: var(--space-3); border-bottom: 0; }
  .info-list dd { font-size: 16px; }

  /* Form column. Field, choice, error, status and submit-row styles
     live in src/styles/forms.css so the Snapshot does not duplicate
     them. Only the page layout remains here. */
  .form-intro { margin: 0 0 var(--space-5); font-size: var(--type-support); line-height: 1.6; color: var(--ink); }
  /* The help sits between the label and the field, so it is read before typing. */
  .field-help { margin: 0 0 10px; }
  .choice-set { border: 0; padding: 0; margin: 0; min-width: 0; }
  .choice-set legend { padding: 0; }
  .choice-set .choice-list { margin-top: 12px; }

  @media (max-width: 880px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
