---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contactEmail } from '../../lib/social';

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xvzwdyob';

const info: { k: string; v: string; href?: string }[] = [
  { k: 'Confidentiality', v: 'All correspondence is private and off record unless explicitly agreed otherwise. NDA available before substantive discussion.' },
  { k: 'Response window', v: 'You receive a direct response within one to two working days. We do not auto-reply.' },
  { k: 'Email',           v: contactEmail, href: `mailto:${contactEmail}` },
  { k: 'No obligation',   v: 'An initial conversation is brief and creates no engagement. We will say if we are not the right fit.' },
  { k: 'Office',          v: 'London, United Kingdom.' },
];
---

<BaseLayout
  title="Book a Conversation · Intervene"
  description="Book a confidential conversation about an Intervention Readiness Review or a full AGDA™ Assessment of a consequential system where intervention must remain possible."
  current="contact"
  ogImage="/assets/og/og-contact.png"
  pageType="ContactPage"
>
  <section class="hero">
    <div class="wrap">
      <h1 class="h1">Discuss <em>your system.</em></h1>
      <p class="lede muted">
        Name the system, decision or exposure where you need to know whether
        intervention remains possible. A single line is enough to establish
        context.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="contact-grid">
        <aside class="info-col">
          <h2 class="h2">What the first conversation covers.</h2>
          <p class="body muted">
            Twenty minutes, at no charge. We establish which system you mean,
            the decision it supports, the harm window it runs against, and
            whether an assessment would answer your question or whether
            something else would. If it would not, we say so.
          </p>
          <p class="body muted">
            Include the system, decision, harm window or oversight concern in
            your message. We do not pre-qualify by email questionnaire, and
            nothing is committed until scope and fees are agreed in writing.
          </p>

          <dl class="spec-list info-list">
            {info.map((row) => (
              <div>
                <dt>{row.k}</dt>
                <dd>{row.href ? <a href={row.href} class="link">{row.v}</a> : row.v}</dd>
              </div>
            ))}
          </dl>
        </aside>

        <div class="form-col">
          <h2 class="h2">Tell us what may need to be stopped.</h2>

          <form class="form" data-contact action={FORMSPREE_ENDPOINT} method="POST" novalidate>
            <div class="field">
              <label for="f-name">Name</label>
              <input type="text" id="f-name" name="name" required autocomplete="name" />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="f-org">Organisation</label>
                <input type="text" id="f-org" name="organisation" required autocomplete="organization" />
              </div>
              <div class="field">
                <label for="f-email">Email</label>
                <input type="email" id="f-email" name="email" required autocomplete="email" />
              </div>
            </div>

            <div class="field">
              <label for="f-role">Role</label>
              <input
                type="text"
                id="f-role"
                name="role"
                placeholder="Board member · CRO · CISO · GC · Head of model risk"
                autocomplete="organization-title"
              />
            </div>

            <div class="field">
              <label for="f-msg">What must remain stoppable?</label>
              <textarea
                id="f-msg"
                name="message"
                rows="5"
                required
                aria-describedby="f-msg-help"
                placeholder="A single line is enough."></textarea>
              <p class="small muted field-help" id="f-msg-help">
                The system, the decision or action it influences, and what
                might require intervention.
              </p>
            </div>
            <fieldset class="choice-set">
              <legend class="field-legend">Starting point</legend>
              <div class="choice-list">
                <label class="choice">
                  <input type="radio" name="starting_point" value="not-sure" checked />
                  <span class="choice-marker" aria-hidden="true"></span>
                  <span class="choice-label">Not sure yet</span>
                </label>
                <label class="choice">
                  <input type="radio" name="starting_point" value="review" />
                  <span class="choice-marker" aria-hidden="true"></span>
                  <span class="choice-label">Intervention Readiness Review</span>
                </label>
                <label class="choice">
                  <input type="radio" name="starting_point" value="assessment" />
                  <span class="choice-marker" aria-hidden="true"></span>
                  <span class="choice-label">Full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment</span>
                </label>
              </div>
            </fieldset>

            <input
              type="text"
              name="_gotcha"
              class="honey"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <div class="submit-row">
              <p class="small muted">
                Held in strict confidence. Read the
                <a href="/legal/privacy/" class="link">privacy notice</a>.
              </p>
              <button type="submit" class="btn">Send enquiry</button>
            </div>

            <div class="form-status" hidden role="status"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initContactForm } from '../../lib/contact.ts';
    initContactForm();
  </script>
</BaseLayout>

<style>
  /* Commercial page: what the conversation covers beside the form. */
  .hero .h1 { max-width: 16ch; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-8);
    align-items: start;
  }
  .info-col .h2 { max-width: 24ch; }
  .info-col .body { margin: var(--gap-head) 0 0; max-width: 40ch; }
  .info-col .body + .body { margin-top: var(--space-3); }
  .info-list { --spec-col: 130px; margin-top: var(--gap-intro); border-top-color: var(--hair); }
  .info-list > div { padding: 12px 0; gap: var(--space-3); border-bottom: 0; }
  .info-list dd { font-size: 14px; }

  /* Form column. Field, choice, error, status and submit-row styles
     live in src/styles/forms.css so the Snapshot does not duplicate
     them. Only the page layout remains here. */
  .form-col .h2 { max-width: 22ch; margin: 0 0 var(--space-5); }
  .field-help { margin: 8px 0 0; }
  .choice-set { border: 0; padding: 0; margin: 0; min-width: 0; }
  .choice-set legend { padding: 0; }
  .choice-set .choice-list { margin-top: 12px; }

  @media (max-width: 880px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
