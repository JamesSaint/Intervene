---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { markAgda } from '../../../lib/marks';

const rows = [
  { d: 'AI governance', does: 'Assigns responsibility and sets controls for AI systems', misses: 'Whether those controls can act in time', href: '/intervention-readiness/vs-ai-governance/' },
  { d: 'Compliance', does: 'Confirms obligations are met at a point in time', misses: 'Whether capability survives under pressure', href: '/intervention-readiness/vs-compliance/' },
  { d: 'Audit', does: 'Attests retrospectively that controls operated', misses: 'Whether intervention is possible going forward', href: '/intervention-readiness/vs-audit/' },
  { d: 'Risk management', does: 'Estimates likelihood and impact of events', misses: 'Whether the response beats the harm window', href: '/intervention-readiness/vs-risk-management/' },
  { d: 'Operational resilience', does: 'Keeps important services within tolerance', misses: 'The chain that prevents irreversible automated harm', href: '/intervention-readiness/vs-operational-resilience/' },
];

const faqs = [
  {
    question: 'What is the category boundary of Intervention Readiness?',
    answer: 'Intervention Readiness is the ability of an organisation to detect, escalate, decide and intervene before harm becomes irreversible. It is adjacent to governance, compliance, audit, risk management and operational resilience, and distinct from all of them: they describe structure, obligation, attestation, exposure and continuity, while Intervention Readiness asks whether intervention can occur in time.',
  },
  {
    question: 'Why is Intervention Readiness not just AI governance?',
    answer: 'Governance describes who is responsible and which controls exist. Intervention Readiness asks whether those controls can act before the reversibility window closes. Structure is not capability.',
  },
];
---

<BaseLayout
  title="The Category Map · Intervene"
  description="Intervention Readiness against each adjacent discipline: AI governance, compliance, audit, risk management, operational resilience, with boundaries named."
  current="intervention-readiness"
  ogImage="/assets/og/og-category-map.png"
  faqs={faqs}
>
  <section class="hero">
    <div class="wrap">
      <span class="label">Category boundaries</span>
      <h1 class="h1">The category map.</h1>
      <p class="lede muted">
        Intervention Readiness is adjacent to five established disciplines and
        is none of them. Each describes something real. None measures whether
        intervention can occur before harm becomes irreversible.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <table class="table-compare map">
        <thead>
          <tr>
            <th scope="col">Discipline</th>
            <th scope="col">What it does</th>
            <th scope="col">What it does not measure</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row"><a href={r.href} class="link">{r.d}</a></th>
              <td data-col="What it does">{r.does}</td>
              <td data-col="What it does not measure">{r.misses}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="body muted note">
        Owning the boundaries is what makes the category distinct. Intervention
        Readiness does not replace any of these disciplines. It measures the
        intervention capability each of them assumes.
      </p>
    </div>
  </section>

  <section class="block tight">
    <div class="wrap-narrow">
      <h2 class="h2">The category, measured.</h2>
      <p class="body muted">
        <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> is Intervene's proprietary assessment of Intervention
        Readiness. A full assessment examines detect, escalate, decide and
        intervene against the available time and returns an Intervention
        Readiness verdict with its evidence basis. Signed SEDI result records
        may be supplied only under an approved output-access arrangement, where the engagement terms provide for them and the delivery configuration supports them.
      </p>
      <div class="cta-row">
        <a href="/intervention-readiness/" class="btn">What is Intervention Readiness?</a>
        <a href="/glossary/" class="btn-ghost">Glossary</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero .h1 { max-width: 18ch; }
  .map { margin-top: 0; }
  .note { margin-top: var(--space-5); max-width: var(--measure); }
</style>
