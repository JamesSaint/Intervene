---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LinkedInButton from '../../components/LinkedInButton.astro';
import { markAgda } from '../../lib/marks';
import { socialLinks } from '../../lib/social';

const commitments = [
  { h: 'Independent judgement.',         p: 'No vendor affiliation, no co-marketing and no commercial relationship may reach an AGDA™ assessment. We do not implement what we recommend.' },
  { h: 'Documented methodology.',        p: 'Theses, catalogues, corpus governance and rater protocols are the documented basis of the method. They are not published here, and are provided under NDA during diligence. AGDA™ is not validated against real-world outcomes.' },
  { h: 'Verifiable records.',            p: 'Signed SEDI result records, where supplied, carry an Ed25519 attestation over specified records. Inputs and outputs are hashed. An audit committee can check them with the verifier and trust material supplied under the engagement terms.' },
  { h: 'Refusal of false control.',      p: 'If the evidence does not support the conclusion, the assessment does not reach it. Findings the client did not want, in writing, before the regulator does.' },
];

const sectorsPrimary = [
  { h: 'UK-regulated financial services.', p: 'Banks, asset managers, insurers under PRA / FCA jurisdiction with material automated decision systems.' },
  { h: 'EU high-risk AI operators.',       p: 'Annex III high-risk systems under the EU AI Act, where human oversight must be capable of intervention.' },
  { h: 'Critical national infrastructure.', p: 'Energy, water, telecoms, transport. Operators where intervention failure compounds across dependency chains.' },
];

const sectorsInvite = [
  { h: 'Healthcare systems.',  p: 'Clinical decision support and diagnostic AI. By invitation, where independence from device vendors can be guaranteed.' },
  { h: 'Defence & intelligence.', p: 'Autonomous decision systems and human-on-the-loop frameworks. With appropriate clearances and engagement letters.' },
];

/* Intervene's role, stated positively from the strategy: what the
   practice does, and the two boundaries that matter to a buyer. The
   former "not a Big-4 advisory" and "no leveraged teams, no slide decks"
   comparisons were removed; they compared rather than described. */
const role = [
  { h: 'Assesses one system at a time.',        p: 'A named consequential AI-enabled system, a defined decision or action pathway and a specified intervention scenario. The conclusion applies to those conditions and says so.' },
  { h: 'Works from evidence, not assertion.',   p: 'Records, interviews and walkthroughs across Detect, Escalate, Decide and Intervene. Documented arrangements are distinguished from exercised capability; a policy fallback is not a measurement.' },
  { h: 'Owns the judgement.',                   p: 'Facts can be corrected and evidence can change the conclusion. The conclusion is not negotiated, and issuance requires approval separate from the assessor\'s own judgement.' },
  { h: 'Stops at the finding.',                 p: 'Remediation, control build, integration and policy drafting are the client\'s or another provider\'s work. Keeping them separate is what lets the finding be trusted.' },
];
---

<BaseLayout
  title="Why Intervention Readiness Matters · Intervene"
  description="Systems are becoming more capable and organisations rely more on automation. Human oversight only matters if intervention remains possible."
  current="about"
  ogImage="/assets/og/og-about.png"
  pageType="AboutPage"
>
  <section class="hero">
    <div class="wrap">
      <span class="label">Why it matters</span>
      <h1 class="h1">Capability moved faster than intervention.</h1>
      <p class="lede muted">
        AI systems are becoming more capable. Organisations are becoming more
        dependent on automation. Human oversight only matters if intervention
        remains possible.
      </p>
    </div>
  </section>

  <!-- FOUNDER NARRATIVE -->
  <section class="block">
    <div class="wrap">
      <div class="founder">
        <figure class="portrait">
          <img
            src="/assets/images/james-saint.jpg"
            alt="James Saint, Founder and Principal Advisor, Intervene"
            width="640"
            height="800"
            loading="lazy"
            decoding="async"
          />
          <figcaption>James Saint · London · 2026</figcaption>
        </figure>

        <div class="bio">
          <div class="founder-meta">
            <p class="mono role">Founder</p>
            <LinkedInButton href={socialLinks.jamesSaintLinkedIn} label="James Saint on LinkedIn" />
          </div>

          <p class="body q">
            Organisations can evidence governance. Showing that they can
            intervene in time is a different test.
          </p>

          <p class="body">
            I founded Intervene because I have watched the same pattern repeat
            throughout my life, in institutions I had to trust, long before I
            encountered it in organisations governing technology.
          </p>

          <p class="body">
            Harm becomes visible. Concerns are raised. Responsibility disperses.
            The system continues.
          </p>

          <p class="body">
            Three decades across technology, systems architecture, digital
            products, payments and organisational risk, including co-founding
            Financial Innovation in Transactions and Security (FITS), brought
            me back to that pattern. Controls, reporting and governance
            structures existed, yet effective intervention repeatedly failed.
            Problems were detected too late, escalation stalled, decisions
            drifted and ownership became unclear.
          </p>

          <p class="body">
            It took time to stop treating these as isolated experiences. The
            question connecting them was whether anyone could still act once
            the evidence changed, while there was still time to prevent harm.
          </p>

          <p class="body">
            AI gives that question greater urgency. Systems act faster, affect
            more people and produce outcomes that are harder to reverse.
            Regulators press for effective human oversight, and boards need
            confidence that intervention remains possible before the window
            closes.
          </p>

          <p class="body">
            That is why we developed <span class="agda-mark">AGDA<span class="agda-tm">™</span></span>, our proprietary assessment
            of Intervention Readiness. It assesses whether an organisation can
            detect, escalate, decide and intervene within the time available,
            and issues an Intervention Readiness verdict with its evidence
            basis.
          </p>

          <p class="body">
            This work is personal, but its purpose is practical: to make the
            capacity to intervene something organisations can test rigorously,
            without reducing failure to individual blame. The same discipline
            matters beyond organisations, in how any of us reads a signal,
            takes responsibility and acts while there is still a choice.
          </p>

          <p class="body">
            For those accountable for consequential systems, <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> provides
            a defensible answer to a question governance papers alone cannot
            settle.
          </p>

          <p class="body aside keep-together">Can you stop it in time?</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMITMENTS -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">The operating commitments behind the assessment.</h2>
      <p class="lede muted">
        Operating constraints, codified into how we accept work and what we
        will and will not deliver.
      </p>

      <ul class="feature-grid commitments" role="list" style="--cols: 2" data-reveal="stagger">
        {commitments.map((c) => (
          <li>
            <h3 class="h3">{c.h}</h3>
            <p class="body muted" set:html={markAgda(c.p)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SECTORS -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">Where the category is most urgent.</h2>
      <p class="lede muted">
        Our initial commercial focus is large UK and European regulated
        financial institutions. The sectors below are where the question is
        most urgent; some we deliberately do not serve.
      </p>

      <div class="sector-group">
        <span class="col-label">Primary</span>
        <ul class="feature-grid sectors" role="list" style="--cols: 3">
          {sectorsPrimary.map((s) => (
            <li>
              <h3 class="h3">{s.h}</h3>
              <p class="body muted">{s.p}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="sector-group">
        <span class="col-label">By invitation</span>
        <ul class="feature-grid sectors" role="list" style="--cols: 2">
          {sectorsInvite.map((s) => (
            <li>
              <h3 class="h3">{s.h}</h3>
              <p class="body muted">{s.p}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="sector-group not-served">
        <span class="col-label">Not currently served</span>
        <p class="body muted not-text">
          Consumer internet, enterprise productivity, B2B SaaS, advertising
          tech. Not because the work is unimportant, but because Intervene's
          methodology, corpus governance and rater protocol are designed for
          regulated, board-accountable systems.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT INTERVENE DOES -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">What Intervene <em>does.</em></h2>
      <p class="lede muted">
        The practice in four statements. For the product's own boundaries, see
        <a href="/agda/" class="link">what <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> is not</a>.
      </p>

      <ul class="feature-grid not-list" role="list" style="--cols: 4" data-reveal="stagger">
        {role.map((n) => (
          <li>
            <h3 class="h3">{n.h}</h3>
            <p class="body muted" set:html={markAgda(n.p)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="block tight">
    <div class="wrap">
      <div class="close-grid">
        <h2 class="h2">The question returns to the same place.</h2>
        <div class="close-cta">
          <p class="body muted">
            <span class="keep-together">Can you stop it in time?</span> Name the system you are
            accountable for and we will tell you whether an assessment would
            answer it. Twenty minutes, at no charge. The sample verdict is
            there if you would rather see the evidence format first.
          </p>
          <div class="cta-row">
            <a href="/contact/" class="btn">Discuss your system</a>
            <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Founder narrative beside the portrait, then three grids. The
     grids are the shared feature grid; the narrative column is local. */
  .hero .h1 { max-width: 24ch; }
  .block .h2 { max-width: 24ch; }

  /* Founder */
  .founder {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-7);
    align-items: start;
  }
  .portrait { margin: 0; display: grid; gap: var(--space-3); }
  .portrait img {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(1);
  }
  .portrait figcaption {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .bio { display: grid; gap: var(--space-3); align-content: start; }
  .founder-meta { display: flex; align-items: center; gap: 14px; }
  .bio .role {
    color: var(--muted);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 11px;
  }
  .bio .body { margin: 0; max-width: 56ch; }
  .bio .q { font-style: italic; color: var(--ink); }

  /* Aside quote */
  .aside {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hair);
    font-style: italic;
    max-width: 60ch;
  }

  /* Sectors */
  .sector-group { margin-top: var(--gap-sub); }
  .sector-group:first-of-type { margin-top: var(--gap-intro); }
  .sectors { margin-top: var(--space-4); padding-top: 0; border-top: 0; }
  .not-served .col-label { margin-bottom: var(--space-3); }
  .not-text { max-width: 72ch; margin: 0; }

  /* What Intervene does */
  .not-list { gap: var(--space-5) var(--space-6); }

  .close-cta .btn { justify-self: start; }

  @media (max-width: 880px) {
    .founder { grid-template-columns: 1fr; gap: var(--space-6); }
    .portrait { max-width: 360px; }
  }
</style>
