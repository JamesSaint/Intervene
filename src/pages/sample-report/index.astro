---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { markAgda } from '../../lib/marks';

const cover = [
  { k: 'System',    v: 'CRED-MOD-04 · Retail Credit Decisioning' },
  { k: 'Scenario',  v: 'Macro shock · model drift' },
  { k: 'Sample',    v: 'Constructed example · not a client report' },
  { k: 'Issued',    v: 'No. Not an issued assessment' },
  { k: 'Signed',    v: 'No. Illustrative metadata only' },
];

const systemSpecs = [
  { k: 'System ID',            v: 'CRED-MOD-04',                       u: 'Retail Credit Decisioning' },
  { k: 'Materiality',          v: 'Tier 1',                            u: 'internal taxonomy' },
  { k: 'Decision authority',   v: 'Approve / decline / refer',         u: 'no human override on auto-decline' },
  { k: 'Volume',               v: '~18,000 / day',                     u: 'UK personal lending' },
  { k: 'Trigger scenario',     v: 'Macro shock + model drift',         u: 'simultaneous' },
  { k: 'Intervention window',  v: '~6 hours',                          u: 'illustrative scenario assumption; operational basis not substantiated' },
];

const controls = [
  { code: 'C-01', name: 'Real-time decision logging',         assessment: 'Production-grade. Timing telemetry from a 2024 outage post-mortem. Detection capability strong; surface latency under 90s.',                rag: 'green', terminal: 'GREEN' },
  { code: 'C-02', name: 'Drift monitoring (PSI / KS)',        assessment: 'Operational in production. Threshold tuning not re-validated since model retrain in 2025-Q3. Confidence constrained under evidence review.',  rag: 'amber', terminal: 'AMBER' },
  { code: 'C-03', name: 'Escalation to MRC',                  assessment: 'Documented in policy. One tabletop in 2024-Q4. Has not run live. Authority pathway terminates at a forum that meets monthly.',     rag: 'red',   terminal: 'RED'   },
  { code: 'C-04', name: 'Halt authority',                     assessment: 'Three named approvers. None authorised to halt unilaterally. Quorum required. No on-call rota. Weekend gap.',                       rag: 'red',   terminal: 'RED'   },
  { code: 'C-05', name: 'Manual override on auto-decline',    assessment: 'Designed-out. No human-in-the-loop on the high-volume decline path. Reversibility limited to next-day reprocessing.',                rag: 'red',   terminal: 'RED'   },
  { code: 'C-06', name: 'Audit trail',                        assessment: 'Immutable, hashed, retained 7 years. Decision rationale captured per inference. Auditable to regulator standard.',                   rag: 'amber', terminal: 'AMBER' },
];

const stages = [
  { stage: 'Detect',       value: '~12 min',       detail: 'to detect drift above threshold. A further ~38 min for the signal to reach a first responder is recorded separately.', status: 'pass', verdict: 'PRESENT' },
  { stage: 'Escalate',     value: '4 to 96 hours', detail: 'to reach an authority holder. Availability and routing can consume or exceed the window.', status: 'fail', verdict: 'CAN EXCEED WINDOW' },
  { stage: 'Decide',       value: '≥ 7 days',      detail: 'to obtain the required quorum. No out-of-cycle route. This alone exceeds the assumed window.', status: 'fail', verdict: 'EXCEEDS WINDOW' },
  { stage: 'Intervene',    value: '~6 min',        detail: 'to propagate a halt if instructed. No in-window reversal on the auto-decline path.', status: 'fail', verdict: 'NO TIMELY AUTHORITY' },
];

const gates = [
  { id: 'G-01', desc: 'Drift signal generation latency',          measured: '~12 min',           rag: 'green', verdict: 'PASS' },
  { id: 'G-02', desc: 'Signal surfaces to first responder',       measured: '~38 min',           rag: 'amber', verdict: 'MARGIN' },
  { id: 'G-03', desc: 'First responder reaches authority holder', measured: 'variable · 4 to 96h', rag: 'red',   verdict: 'FAIL' },
  { id: 'G-04', desc: 'Authority holder reaches quorum',          measured: '≥ 7 days',          rag: 'red',   verdict: 'FAIL' },
  { id: 'G-05', desc: 'Quorum decision recorded',                 measured: 'monthly cadence',   rag: 'red',   verdict: 'FAIL' },
  { id: 'G-06', desc: 'Halt instruction propagated to system',    measured: '~6 min (if instructed)', rag: 'green', verdict: 'PASS' },
];




const evidence = [
  { id: 'E-12', desc: '"On-call halt authority exists." Stated in interview, no document.', type: 'Verbal',      open: 'A claim requiring corroboration. It does not establish available authority.' },
  { id: 'E-08', desc: 'MRC charter naming halt authority.',                                  type: 'Document',    open: 'Documented allocation of authority. It does not establish that the required quorum can be reached in time.' },
  { id: 'E-04', desc: 'Tabletop exercise minutes, 2024-Q4.',                                 type: 'Exercise',    open: 'Evidence of the described exercise only. Not a live event.' },
  { id: 'E-02', desc: 'Production drift monitoring runtime logs (12 months).',               type: 'Operational', open: 'A source for detection timing, subject to coverage, provenance and scenario relevance.' },
  { id: 'E-01', desc: '2024 outage post-mortem with timing telemetry.',                      type: 'Incident',    open: 'A source for performance under those conditions. Transfer to the present scenario needs justification.' },
  { id: 'E-06', desc: 'Hashed audit log sample, regulator-format export.',                   type: 'Record',      open: 'Evidence of recorded activity. It does not establish regulatory acceptance or the integrity of every operational record.' },
];
---

<BaseLayout
  title="Sample AGDA™ Verdict · Intervene"
  description="A constructed, unsigned AGDA™ Intervention Readiness verdict showing how detect, escalate, decide and intervene are assessed against evidence and timing."
  current="sample-report"
  ogImage="/assets/og/og-sample-report.png"
>
  <!-- COVER -->
  <section class="cover">
    <div class="wrap">
      <span class="cover-kicker mono">Intervention Readiness Verdict · Constructed example</span>

      <div class="cover-grid">
        <div class="cover-left">
          <h1 class="h1 reveal">
            Retail credit. <em>Cannot stop in time.</em>
          </h1>
          <p class="lede muted reveal">
            <strong class="finding-lead">Detection works. Authority does not.</strong>
            A drift signal is generated in about twelve minutes, but reaching a
            person who can halt the model takes between four and ninety-six
            hours, and the required quorum takes at least seven days, against
            an assumed window of about six hours. The chain cannot complete in
            time, so the decision this finding supports is whether the affected
            pathway can continue operating under its present authority
            arrangements.
          </p>
          <p class="body muted reveal provenance-note">
            This is a constructed example, written to show the shape and
            structure of a finding from a full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment. It uses
            no client data and describes no real organisation. It has not been
            run as an assessment, is not issued and is not signed. The
            identifiers, timings and evidence descriptions are illustrative.
            Nothing on this page is evidence about anyone.
          </p>

          <dl class="cover-meta">
            {cover.map((c) => (
              <div>
                <dt>{c.k}</dt>
                <dd set:html={markAgda(c.v)}></dd>
              </div>
            ))}
          </dl>

          <p class="cover-proof reveal cover-proof-note">
            A full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment issues a verdict with its evidence basis.
            Signed SEDI result records are not a standard deliverable and may
            be supplied only under an approved output-access arrangement. This
            page carries neither a verdict nor a signed record.
            <a href="/verify/" class="link">How verification works</a>.
          </p>
        </div>

        <aside class="cover-right reveal" aria-label="Historical attestation summary">
          <span class="env-label mono">Illustrative · shape of an attestation envelope</span>
          <pre class="envelope" tabindex="0" aria-label="Illustrative attestation record"><code>{`sampleStatus       constructed example, not signed
engineVersion      not applicable
engineHash         not applicable
inputHash          not applicable
outputHash         not applicable
attestation        none. this page is not signed
signatureCovers    input, output and manifest commitments only. see /verify/`}</code></pre>
          <p class="env-verify mono">
            current verify path · agda-verify --bundle ./bundle.json
          </p>
          <p class="env-limits">
            On a real signed record, that command checks integrity and
            authenticity: it establishes that the input and output records
            match the signed commitments associated with the stated engine
            version, and that neither has changed since signing. It does not
            independently establish that the engine was executed or that its
            computation was correct, that the evidence is true, that the
            method is sound, that anyone independent has validated it, or that
            a regulator has approved anything. Repeatable computation
            is a separate property: the same inputs return the same computed
            result under the same engine and assessment versions, which follows
            from the engine's rules rather than from the signature.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 1. SYSTEM OVERVIEW -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">The assessed system. <em>The intervention question.</em></h2>
      <p class="lede muted">
        A retail credit decisioning model approving up to 18,000 unsecured
        applications per day. Identified as material under the operator's
        internal model risk taxonomy.
      </p>

      <dl class="specs">
        {systemSpecs.map((s) => (
          <div>
            <dt>{s.k}</dt>
            <dd><span class="val">{s.v}</span><span class="unit">{s.u}</span></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 2. CONTROL REALITY INDEX -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">Intervention Readiness evidence.</h2>
      <p class="lede muted">
        Six controls described in the example. How many controls and how
        many timing gates appear depends on the system being assessed, so
        those counts differ from one engagement to the next. Classification
        reflects what the control can do under pressure, not what the policy
        promises. This replacement specimen assigns no new numerical scores,
        evidence grades or technical failure identifiers.
      </p>

      <table class="tbl">
        <thead>
          <tr><th class="col-id">Code</th><th>Control</th><th>Assessment</th><th class="col-tag">Classification</th></tr>
        </thead>
        <tbody>
          {controls.map((c) => (
            <tr>
              <td class="mono">{c.code}</td>
              <td class="cell-name">{c.name}</td>
              <td class="cell-body">{c.assessment}</td>
              <td><span class={`pill pill-${c.rag}`}>{c.terminal}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 3. ESCALATION VIABILITY -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">The chain breaks <em>at authority.</em></h2>
      <p class="lede muted">
        Detection is present in the scenario. The break is between detection
        and authority: reaching an authority holder can take longer than the
        window, and the quorum that authority requires takes at least seven
        days.
      </p>

      <dl class="verdict-row">
        <div><dt>Finding</dt><dd>Structural constraint</dd></div>
        <div><dt>Route to an authorised decision</dt><dd>Cannot complete in window</dd></div>
        <div><dt>Timing</dt><dd>Authority lag above window</dd></div>
        <div><dt>Classification</dt><dd><span class="pill pill-red">RED · constrained</span></dd></div>
      </dl>

      <p class="body callout-note">
        <strong>Authority lag.</strong> The signal reaches the Model Risk
        Committee. The Committee meets monthly. The window assumed for the
        trigger scenario is approximately six hours. There is no out-of-cycle
        convening authority. There is no on-call halt authority below MRC
        level. The pathway from detection to halt cannot complete inside the
        window. Faster detection cannot by itself resolve that constraint.
      </p>
    </div>
  </section>

  <!-- 4. TEMPORAL GATING -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">Stage by stage. Against the clock.</h2>
      <p class="lede muted">
        These intervals are separate illustrative facts. They are not added
        as if they were all measured, sequential durations; their start and
        end points and any overlap have not been demonstrated. The quorum
        delay alone is sufficient to support the timing conclusion.
      </p>
      <ul class="stage-grid" role="list">
        {stages.map((s) => (
          <li>
            <span class="stage-name">{s.stage}</span>
            <span class="stage-value">{s.value}</span>
            <span class="stage-detail">{s.detail}</span>
            <span class={`mono stage-verdict v-${s.status}`}>{s.verdict}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. GATE REGISTER -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">Gate register.</h2>
      <p class="lede muted">
        Every timing gate the chain must clear, with the illustrative value
        and its position against the assumed window. Values are described in
        the source example, not measured in an engagement.
      </p>

      <table class="tbl">
        <thead>
          <tr><th class="col-id">Gate</th><th>Description</th><th class="col-num">Measured</th><th class="col-tag">Verdict</th></tr>
        </thead>
        <tbody>
          {gates.map((g) => (
            <tr>
              <td class="mono">{g.id}</td>
              <td class="cell-body">{g.desc}</td>
              <td class="mono">{g.measured}</td>
              <td><span class={`pill pill-${g.rag}`}>{g.verdict}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 6. BOARD CONCLUSION -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">The decision <em>the finding supports.</em></h2>
      <p class="lede muted">
        The system is well-instrumented at the technical layer. The authority
        structure surrounding it cannot exercise control inside the assumed
        window. This is an Intervention Readiness constraint, not a model
        defect.
      </p>

      <div class="callout">
        <span class="callout-label">Decision supported</span>
        <h3 class="h3">Can the affected pathway continue operating under its present authority arrangements?</h3>
        <p class="body">
          A proposed response is to establish an authorised route capable of
          acting within the required window, including when the normal
          decision-makers are unavailable, and to exercise that route before
          relying on it. Possible remediation priorities:
        </p>
        <ol class="actions">
          <li><strong>Define who may authorise an intervention</strong> and the circumstances in which that authority can be exercised.</li>
          <li><strong>Establish an available decision route</strong>, including out-of-hours cover and any required delegation.</li>
          <li><strong>Confirm how a halt, redirection or containment action takes effect</strong> and what happens to decisions already made.</li>
          <li><strong>Exercise the complete response</strong>, record timing and evidence, then reassess the identified constraint.</li>
        </ol>
        <p class="body muted callout-foot">
          These are proposed priorities for the scenario. They do not claim
          that remediation has been implemented or that it will produce a
          favourable reassessment.
        </p>
      </div>
    </div>
  </section>

  <!-- 11. EVIDENCE REGISTER -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">Evidence register.</h2>
      <p class="lede muted">
        What each described record supports, and what remains open. These are
        descriptions within a fictional example, not records inspected in a
        client engagement.
      </p>

      <table class="tbl">
        <thead>
          <tr><th class="col-id">ID</th><th>Record described</th><th class="col-num">Type</th><th>What it supports and what remains open</th></tr>
        </thead>
        <tbody>
          {evidence.map((e) => (
            <tr>
              <td class="mono">{e.id}</td>
              <td class="cell-body">{e.desc}</td>
              <td class="mono">{e.type}</td>
              <td class="cell-body">{e.open}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 12. EXPOSURE -->
  <section class="block">
    <div class="wrap-narrow">
      <h2 class="h2">Exposure and consequence.</h2>
      <p class="body">
        Exposure is not calculated in this example. The stated volume of
        approximately 18,000 applications per day is throughput, not a count
        of harmed people or wrong decisions. If applications arrived uniformly,
        18,000 per day would correspond to 4,500 over six hours; uniform arrival
        has not been established, and throughput would still not establish the
        number of incorrect decisions, affected customers or financial losses.
      </p>
    </div>
  </section>

  <!-- 13. VERDICT STATE -->
  <section class="block">
    <div class="wrap">
      <h2 class="h2">The illustrative <em>conclusion.</em></h2>
      <p class="lede muted">
        The state a full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment would report for this scenario.
        Illustrative, not issued, not signed.
      </p>

      <div class="viability">
        <div class="viability-left">
          <span class="mono viability-label">Illustrative conclusion · CRED-MOD-04</span>
          <span class="viability-big">After impact.</span>
          <p class="mono viability-sub">Detect, escalate, decide, intervene does not complete inside the assumed window.</p>
          <p class="body">
            The required route to an authorised intervention cannot complete
            within the assumed six-hour window. Obtaining the required quorum
            takes at least seven days. Faster detection cannot by itself
            resolve that constraint.
          </p>
        </div>
        <div class="viability-right">
          <span class="mono viability-label">Limits of this example</span>
          <p class="body muted">
            One pathway and one scenario. No conclusion about an institution's
            overall governance, other systems or legal conformity. The
            six-hour window is a scenario assumption; no operational harm
            threshold, regulatory breach, financial loss or empirical
            validation of <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> is established.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 14. AUTHORITY -->
  <section class="block">
    <div class="wrap-narrow">
      <h2 class="h2">Assessment authority <em>and limitations.</em></h2>
      <p class="body">
        In an actual engagement, the assessment conclusion is Intervene
        Limited's. The client may correct facts, challenge interpretation and
        provide further evidence. The judgement remains Intervene's.
      </p>
      <p class="body muted">
        Four things are distinct: this illustrative sample; a formally issued
        assessment; the authorised human sign-off that issues it; and the
        cryptographic attestation over specified records, where contracted.
        This page is only the first.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="block tight">
    <div class="wrap">
      <div class="close-grid">
        <h2 class="h2">Run this <em>against your own system.</em></h2>
        <div class="close-cta">
          <p class="body muted">
            This page shows the shape of a finding. A full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment
            applies the current methodology to one of your named systems, a
            defined pathway and a specified scenario. The conclusion is
            Intervene's. Signed SEDI result records are not a standard
            deliverable and may be supplied only under an approved
            output-access arrangement.
          </p>
          <div class="cta-row">
            <a href="/contact/" class="btn">Discuss your system</a>
            <a href="/methodology/" class="btn-ghost">How <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> works</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Consent-gated, via the same no-op-without-consent track() the
    // Snapshot uses. Carries no parameters and no identity.
    import { track } from '../../lib/snapshot/analytics.ts';
    track('sample_verdict_viewed');
  </script>
</BaseLayout>

<style>
  /* ----- COVER ----- */
  .cover {
    padding: 96px 0 96px;
    border-bottom: 1px solid var(--hair-strong);
  }
  .cover-kicker {
    display: block;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 11px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--hair);
    margin-bottom: 64px;
  }
  .cover-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .cover .h1 { max-width: 18ch; margin: 0; }
  .cover .lede { margin: 32px 0 0; max-width: 52ch; }
  .cover-proof { margin-top: 28px; }

  .cover-meta {
    margin: 56px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--hair);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 32px;
  }
  .cover-meta div { display: grid; gap: 6px; }
  .cover-meta dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .cover-meta dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }

  .cover-right {
    display: grid;
    gap: 16px;
    padding: 32px;
    background: var(--paper-soft);
    border: 1px solid var(--hair);
  }
  .env-label {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 11px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hair-strong);
  }
  .env-verify {
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--hair-strong);
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.04em;
    line-height: 1.5;
    word-break: break-all;
  }

  .envelope {
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
    color: var(--ink);
    overflow-x: auto;
    white-space: pre;
  }

  /* ----- COMMON ----- */
  .block .h2 { max-width: 28ch; }
  .block .lede { margin-top: 16px; max-width: 60ch; }

  /* ----- SPECS ----- */
  .specs {
    margin: 56px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--hair-strong);
  }
  .specs > div {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hair);
    align-items: baseline;
  }
  .specs dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .specs dd { margin: 0; display: flex; gap: 16px; align-items: baseline; }
  .specs .val { font-family: var(--font-sans); font-weight: 500; color: var(--ink); }
  .specs .unit { font-family: var(--font-mono); font-size: 11px; color: var(--muted); letter-spacing: 0.04em; }

  /* ----- TABLES ----- */
  .tbl {
    margin: 56px 0 0;
    width: 100%;
    border-collapse: collapse;
  }
  .tbl thead th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-transform: uppercase;
    padding: 0 16px 14px 0;
    border-bottom: 1px solid var(--hair-strong);
  }
  .tbl thead th:last-child { padding-right: 0; }
  .tbl tbody td {
    vertical-align: top;
    padding: 20px 16px 20px 0;
    border-bottom: 1px solid var(--hair);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.55;
  }
  .tbl tbody td:last-child { padding-right: 0; }
  .tbl .cell-name { font-weight: 500; }
  .tbl .cell-body { color: var(--muted); }
  .tbl .mono { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--ink); white-space: nowrap; }
  .tbl .col-id   { width: 110px; }
  .tbl .col-tag  { width: 140px; }
  .tbl .col-num  { width: 140px; }

  /* ----- PILLS ----- */
  .pill {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
    border: 1px solid currentColor;
    line-height: 1;
  }
  .pill-red   { color: var(--warn); }
  .pill-amber { color: var(--hold); }
  .pill-green { color: var(--pass); }

  /* ----- VERDICT ROW ----- */
  .verdict-row {
    margin: 48px 0 0;
    padding: 24px 0;
    border-top: 1px solid var(--hair-strong);
    border-bottom: 1px solid var(--hair);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .verdict-row > div { display: grid; gap: 6px; }
