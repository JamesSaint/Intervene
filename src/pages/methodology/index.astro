---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChainFlow from '../../components/ChainFlow.astro';
import EvidenceCap from '../../components/EvidenceCap.astro';
import ChainCeiling from '../../components/ChainCeiling.astro';
import { markAgda } from '../../lib/marks';

const dimensions = [
  { name: 'Detect',          q: 'Can the system surface the conditions that need attention, in time?' },
  { name: 'Escalate',        q: 'Does the signal reach an authority before the window to act has closed?' },
  { name: 'Decide',          q: 'Can the decision be made under pressure with incomplete information?' },
  { name: 'Intervene',       q: 'Can the action take effect before the consequence compounds?' },
  { name: 'Accountability',  q: 'Is responsibility real in practice, not only on paper?' },
  { name: 'Human oversight', q: 'Is oversight informed and capable of altering outcomes?' },
  { name: 'Auditability',    q: 'Is the decision trail complete, reliable, and defensible later?' },
  { name: 'Capacity',        q: 'Are the people and authority present when the moment arrives?' },
];

const stances = [
  { h: 'Coincidence is not a margin.',                       p: 'Absence of incidents is evidence of untested exposure, not effective controls.' },
  { h: 'Accountability cannot mask weak oversight.',         p: 'Naming an SMF4 without halt authority is governance theatre. The engine measures the pairing.' },
  { h: 'Evidence quality constrains confidence.',            p: 'Policy, drill, production and stress evidence carry different weight. High confidence needs evidence that has survived pressure.' },
  { h: 'Confidence must not exceed evidence.',               p: 'High confidence against weak evidence is demoted. Overconfidence is an assurance failure.' },
];

const docs = [
  { h: 'AGDA™ Thesis',             p: 'The intellectual position. Eight falsifiable claims.' },
  { h: 'Failure Mode Catalogue',   p: 'Forty canonical intervention failure modes, referenced by identifier in a verdict.' },
  { h: 'Corpus Governance',        p: 'The governance mechanism by which validation cases would be authored, challenged and locked. It exists as a mechanism; no populated corpus exists yet.' },
  { h: 'Rater Protocol',           p: 'The protocol external raters follow when governed corpus evidence is supplied.' },
];
---

<BaseLayout
  title="How AGDA™ Works · Intervene"
  description="How AGDA™ examines the SEDI intervention chain, supporting evidence, authority and timing to assess Intervention Readiness."
  current="methodology"
  ogImage="/assets/og/og-methodology.png"
>
  <section class="hero">
    <div class="wrap">
      <h1 class="h1 reveal">Follow the response from signal <em>to effective intervention.</em></h1>
      <p class="lede muted reveal">
        <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> examines four connected capabilities: Detect, Escalate, Decide
        and Intervene. Together they form the SEDI intervention chain.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap-narrow">
      <h2 class="h2">Scope first, <em>then evidence.</em></h2>
      <p class="body">
        We first define the system, the consequential pathway and the
        scenario. We then examine the evidence for recognising the need to
        act, reaching decision authority, making the decision and putting it
        into effect within the available time.
      </p>
      <p class="body muted">
        The assessment examines material dependencies and identifies the
        parts of the chain that constrain intervention. A policy fallback is
        not a measurement, and a walkthrough or a record of a previous drill is
        not a live operational test. Repeatable engine computation
        supports the assessment. Intervene remains responsible for evidence
        interpretation and the final conclusion. This page explains the basis
        and limits of the assessment; the underlying rubric and protected
        implementation remain Intervene IP.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">The intervention chain. <em>The chain is the control.</em></h2>
      <p class="lede muted">
        Detect, Escalate, Decide, Intervene. Four sequential stages running
        against the available time. The engine computes whether the
        cumulative chain completes before harm becomes irreversible. A full
        <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment returns one of three states.
      </p>
      <ChainFlow />

      <ul class="verdicts" role="list">
        <li>
          <span class="mono verdict-name">Before impact</span>
          <p class="body">The chain completes in time under the observed conditions.</p>
        </li>
        <li>
          <span class="mono verdict-name">At risk</span>
          <p class="body">The chain completes, but within a margin that operational noise can erode.</p>
        </li>
        <li>
          <span class="mono verdict-name warn">After impact</span>
          <p class="body">The chain does not complete in time. Harm is irreversible before intervention can land.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">Eight dimensions.</h2>
      <p class="lede muted">
        The four chain stages, plus the four conditions that determine whether
        each stage holds.
      </p>
      <ul class="dim-grid reveal" role="list">
        {dimensions.map((d) => (
          <li>
            <h3 class="h3">{d.name}</h3>
            <p class="body muted">{d.q}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">Evidence quality constrains confidence.</h2>
      <p class="lede muted">
        <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> does not let confidence outrun proof. Policy, drill,
        production and stress evidence are treated differently before the
        engine propagates the chain.
      </p>
      <EvidenceCap />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">A downstream stage cannot measure above upstream, plus one.</h2>
      <p class="lede muted">
        Operational topology, not heuristic. Claimed downstream strength on a
        weak upstream is structural fiction.
      </p>
      <ChainCeiling />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">Four positions the engine takes.</h2>
      <ul class="stances" role="list">
        {stances.map((s) => (
          <li>
            <h3 class="h3">{s.h}</h3>
            <p class="body muted">{s.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap-narrow">
      <h2 class="h2">Signed SEDI result records, <em>where contracted.</em></h2>
      <p class="lede muted">
        Signed SEDI result records are not a standard deliverable. Where one
        is supplied under an approved output-access arrangement, it can be
        checked against the signed commitments. The attestation envelope commits to the engine,
        methodology and rubric versions and to the input, output and manifest
        hashes. What the check does and does not establish, and what the
        signature does not cover, is on the
        <a href="/verify/" class="link">verify page</a>.
      </p>
      <span class="env-example mono">Example envelope · illustrative values</span>
      <pre class="envelope" tabindex="0" aria-label="Attestation envelope example"><code>{`attestationVersion 1.2
engineVersion      2.0.6
engineHash         17594a80…60355e50
transformVersion   N/A
catalogueVersion   1.0
methodologyVersion 1.3.0
rubricVersion      1.3.0
keyId              2026-05-02-d7e5468e
scoredAt           2026-05-14T09:47:12.334Z
inputHash          47a2e19c…103e4f8d
outputHash         91f4c02a…d4e7ad91
manifestHash       36b45cbe…3edc1c12
signature          M4Gb2ZqAfD…pLQX7w==`}</code></pre>
      <p class="body muted env-note">
        The values above are illustrative and show the shape of the envelope.
        A real signed record is produced by an assessment and commits to
        that assessment's engine version, input and output hashes. The published
        <a href="/sample-report/" class="link">sample verdict</a> is a
        constructed example and carries no signature.
      </p>
      <a href="/verify/" class="services-link">How the verify path works <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">The documented measurement basis.</h2>
      <p class="lede muted">
        Four documents anchor the practice. None is published on this site;
        each is provided under NDA during diligence. There is no populated
        corpus and no outcome-validation evidence. <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> is not
        validated against real-world outcomes.
      </p>
      <ul class="docs" role="list">
        {docs.map((d) => (
          <li>
            <h3 class="h3" set:html={markAgda(d.h)} />
            <p class="body muted">{d.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block tight">
    <div class="wrap-narrow cta-band">
      <h2 class="h2">A sample verdict is published.</h2>
      <p class="body muted">
        A constructed retail-credit example: reaching an authority holder
        may exceed the assumed six-hour window, and the required quorum takes
        at least seven days. It shows the shape of a finding, using no client
        data. It is not issued and not signed.
      </p>
      <div class="cta">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 144px;
    padding-bottom: 144px;
    border-bottom: 1px solid var(--hair);
  }
  .hero .h1 { max-width: 22ch; }
  .hero .lede { margin-top: 32px; max-width: 56ch; }

  .block .h2 { max-width: 28ch; }
  .block .lede { margin-top: 16px; max-width: 56ch; }
  .wrap-narrow .body { max-width: 62ch; margin: 16px 0 0; }

  /* Intervention-chain verdict states */
  .verdicts {
    list-style: none;
    margin: 64px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 32px 48px;
    padding-top: 24px;
    border-top: 1px solid var(--hair);
  }
  .verdicts > li { display: grid; gap: 8px; align-content: start; }
  .verdict-name {
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
  }
  .verdict-name.warn { color: var(--warn); }
  .verdicts p { max-width: 36ch; margin: 0; }


  /* Inline arrow link */
  .services-link {
    display: inline-block;
    margin-top: 32px;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--ink);
    border-bottom: 1px solid var(--hair-strong);
    padding-bottom: 2px;
    transition: border-color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .services-link:hover { border-color: var(--accent); }

  .dim-grid {
    list-style: none;
    margin: 80px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 48px;
    border-top: 1px solid var(--hair-strong);
    opacity: 1;
    transform: none;
  }
  .dim-grid > li {
    padding: 40px 0;
    border-bottom: 1px solid var(--hair);
    display: grid;
    gap: 12px;
    align-content: start;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 480ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 480ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .dim-grid .h3 { font-size: 22px; margin: 0; }
  .dim-grid p { max-width: 28ch; margin: 0; }

  .dim-grid.in > li { opacity: 1; transform: none; }
  .dim-grid.in > li:nth-child(1) { transition-delay: 0ms; }
  .dim-grid.in > li:nth-child(2) { transition-delay: 80ms; }
  .dim-grid.in > li:nth-child(3) { transition-delay: 160ms; }
  .dim-grid.in > li:nth-child(4) { transition-delay: 240ms; }
  .dim-grid.in > li:nth-child(5) { transition-delay: 320ms; }
  .dim-grid.in > li:nth-child(6) { transition-delay: 400ms; }
  .dim-grid.in > li:nth-child(7) { transition-delay: 480ms; }
  .dim-grid.in > li:nth-child(8) { transition-delay: 560ms; }

  @media (prefers-reduced-motion: reduce) {
    .dim-grid > li {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  .stances {
    list-style: none;
    margin: 64px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px 80px;
    max-width: 1080px;
  }
  .stances > li { display: grid; gap: 12px; }
  .stances p { max-width: 44ch; margin: 0; }

  .envelope {
    margin: 48px 0 0;
    padding: 32px;
    background: var(--paper-soft);
    border: 1px solid var(--hair);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.8;
    overflow-x: auto;
    white-space: pre;
  }
  .envelope code { font-family: inherit; }

  .docs {
    list-style: none;
    margin: 64px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 48px;
  }
  .docs > li { display: grid; gap: 12px; align-content: start; }
  .docs p { max-width: 32ch; margin: 0; }

  .cta-band { text-align: left; }
  .cta-band .body { margin: 16px 0 32px; max-width: 56ch; }
  .cta-band .cta { display: flex; flex-wrap: wrap; gap: 16px; }

  @media (max-width: 880px) {
    .hero { padding-top: 88px; padding-bottom: 88px; }
    .dim-grid { grid-template-columns: 1fr 1fr; column-gap: 32px; }
    .stances { grid-template-columns: 1fr; gap: 48px; }
    .docs { grid-template-columns: 1fr 1fr; gap: 32px; }
    .verdicts { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 560px) {
    .dim-grid { grid-template-columns: 1fr; column-gap: 0; }
    .docs { grid-template-columns: 1fr; gap: 32px; }
  }

  .env-example {
    display: block; font-size: 10px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--faint); margin-bottom: 12px;
  }
  .env-note { margin-top: 20px; max-width: 62ch; }
</style>
