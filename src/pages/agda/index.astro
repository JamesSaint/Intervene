---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerdictBlock from '../../components/VerdictBlock.astro';
import { markAgda } from '../../lib/marks';
import { assessment, offerFaqs, RECORDS_NOTE, SELF_APPROVAL } from '../../lib/offers';

const isnot = [
  { h: 'Not a maturity model', p: 'No five-point scale that always lands at three. A full AGDA™ Assessment answers one question: can the chain complete in time for this system, pathway and scenario.' },
  { h: 'Not a controls checklist', p: 'Existence of a control is not evidence it works under pressure. AGDA™ distinguishes documented arrangements from exercised capability. A policy fallback is not a measurement.' },
  { h: 'Not a negotiated result', p: 'The engine applies repeatable rules to recorded inputs under fixed versions. Defining the scenario, grading evidence and interpreting the result are Intervene\'s judgement. Facts can be corrected and evidence can change the conclusion; the conclusion is not negotiated.' },
];

const faqs = [
  {
    question: 'What does AGDA™ assess?',
    answer: 'AGDA™ assesses Intervention Readiness: whether an organisation can detect the need to intervene, escalate appropriately, decide with authority and intervene effectively in a consequential AI-enabled system before the opportunity to do so is lost.',
  },
  {
    question: 'Is AGDA™ an AI governance framework?',
    answer: 'No. AGDA™ is not an AI governance framework. It assesses whether governance can actually intervene when required.',
  },
  ...offerFaqs,
  {
    question: 'How is AGDA™ related to Intervention Readiness?',
    answer: 'Intervention Readiness is the category. AGDA™ is Intervene Limited\'s proprietary assessment of it.',
  },
];
---

<BaseLayout
  title="AGDA™ Assessment · Intervene"
  description="Intervene's proprietary assessment of Intervention Readiness: one named consequential AI-enabled system, one defined pathway and one intervention scenario."
  current="agda"
  ogImage="/assets/og/og-agda.png"
  faqs={faqs}
>
  <section class="hero">
    <div class="wrap">
      <span class="label">The assessment</span>
      <h1 class="h1"><span class="agda-mark">AGDA<span class="agda-tm">™</span></span> assesses Intervention Readiness.</h1>
      <p class="lede muted">
        Intervene's proprietary assessment of whether an organisation can
        detect the need to intervene, escalate appropriately, decide with
        authority and intervene effectively in a consequential AI-enabled
        system before the opportunity to do so is lost.
      </p>
      <div class="hero-cta">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap-narrow">
      <div class="subsection">
      <h2 class="h2">An assessment, <em>not a governance framework.</em></h2>
      <p class="body">
        Audit tells you whether a control existed. Model risk tells you whether
        a model behaves. Governance reviews tell you whether responsibilities
        have been assigned. None of those, by itself, tells you whether humans
        can still intervene inside the time available.
      </p>
      <p class="body muted">
        That is <a href="/intervention-readiness/" class="link">Intervention Readiness</a>: the ability to
        detect, escalate, decide and intervene before harm becomes irreversible.
      </p>
      </div>

      <div class="subsection">
      <h2 class="h2">One system, a defined pathway <em>and a specified scenario.</em></h2>
      <p class="body">
        We agree the system boundary, the consequential decision or action,
        the circumstances requiring intervention and the available time. The
        conclusion applies to those assessed conditions. It does not extend
        automatically to every pathway, future event or system in the
        organisation.
      </p>
      <p class="body muted">
        A finding about one pathway is not an assessment of the entire
        organisation or of every use of the system. Connected systems are
        scoped separately.
      </p>
      </div>

      <div class="subsection">
      <h2 class="h2">Evidence and <em>accountable judgement.</em></h2>
      <p class="body">
        <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> examines relevant records, interviews and walkthroughs across
        Detect, Escalate, Decide and Intervene. It distinguishes documented
        arrangements from exercised capability. A policy fallback is not a
        measurement, and a walkthrough or a record of a previous drill is not a
        live operational test.
      </p>
      <p class="body muted">
        The engine applies repeatable rules to recorded inputs under fixed
        assessment versions. The assessment also requires judgement about
        evidence, scope and interpretation. Intervene owns that judgement and
        the conclusion. {SELF_APPROVAL} A signed engine record is not by
        itself an issued assessment.
      </p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">One question. <em>Three verdict states.</em></h2>
      <p class="lede muted">
        A full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment examines the intervention chain, Detect to
        Escalate to Decide to Intervene, against the available time and
        returns one of three states. The Intervention Readiness Review does
        not produce a verdict.
      </p>
      <div class="verdict-stage">
        <VerdictBlock />
      </div>
      <a href="/methodology/" class="arrow-link">How <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> works <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">What a full <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment <em>delivers.</em></h2>
      <p class="lede muted">
        The engagement scope lists the outputs. The standard package
        comprises:
      </p>
      <ul class="dash-list deliver" role="list" data-reveal="stagger">
        {assessment.receive.map((d) => (
          <li set:html={markAgda(d)} />
        ))}
      </ul>
      <p class="body muted deliver-note">{RECORDS_NOTE}</p>
      <p class="body muted deliver-note">
        The assessment is not regulatory certification, a model-validation
        exercise or a guarantee of safety. <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> is not validated against
        real-world outcomes. Repeatable computation and signature verification
        are established technical properties with different purposes from
        empirical validation.
      </p>
      <a href="/sample-report/" class="arrow-link">See a constructed sample verdict <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">What <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> <em>is not.</em></h2>
      <ul class="card-grid isnot-grid" role="list" data-reveal="stagger">
        {isnot.map((d) => (
          <li class="card">
            <h3 class="h3 card-title">{d.h}</h3>
            <p class="body muted" set:html={markAgda(d.p)} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">Frequently asked questions.</h2>
      <dl class="faq-list">
        {faqs.map((faq) => (
          <div>
            <dt set:html={markAgda(faq.question)} />
            <dd set:html={markAgda(faq.answer)} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="block tight">
    <div class="wrap-narrow cta-band">
      <h2 class="h2">From assessment to engagement.</h2>
      <p class="body muted">
        Two starting points: an Intervention Readiness Review, or a full
        <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> Assessment. Before that, inspect the sample verdict and
        how verification works.
      </p>
      <div class="cta-row">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/services/" class="btn-ghost">Assessment options</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Commercial and explanation page for the instrument. Three short
     arguments share one section; the verdict specimen, deliverables,
     boundaries and FAQ each take their own. */
  .hero .h1 { max-width: 24ch; }
  .subsection + .subsection { margin-top: var(--gap-sub); padding-top: var(--gap-sub); border-top: 1px solid var(--hair); }
  .subsection .body { margin: 0; }
  .subsection .h2 + .body { margin-top: var(--gap-head); }
  .subsection .body + .body { margin-top: var(--space-3); }

  .verdict-stage { margin-top: var(--gap-intro); display: flex; justify-content: flex-start; max-width: 760px; }

  .deliver {
    margin: var(--gap-intro) 0 0;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-7);
    border-top: 1px solid var(--hair-strong);
    padding-top: var(--space-5);
  }
  .deliver > li { font-size: 17px; max-width: 46ch; padding-left: 22px; }
  .deliver > li::before { width: 10px; }
  .deliver-note { margin: var(--space-5) 0 0; max-width: var(--measure); }
  .deliver-note + .deliver-note { margin-top: var(--space-3); }

  .isnot-grid { margin-top: var(--gap-intro); list-style: none; padding: 0; }
  .isnot-grid .h3 { font-size: 21px; }

  @media (max-width: 880px) {
    .deliver { grid-template-columns: 1fr; gap: var(--space-3); }
  }
</style>
