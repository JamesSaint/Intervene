---
import BaseLayout from './BaseLayout.astro';
import { markAgda } from '../lib/marks';
import { terms } from '../lib/terms';

interface Faq {
  question: string;
  answer: string;
}
interface Related {
  label: string;
  href: string;
  ghost?: boolean;
}
interface Props {
  termSlug: string;     // pulls the canonical definition from lib/terms.ts
  title: string;        // ends "· Intervene"
  description: string;
  ogImage?: string;     // per-page social card; falls back to BaseLayout default
  label: string;        // hero kicker
  h1: string;
  lede: string;
  agda: string;         // how AGDA measures or evidences this component
  related: Related[];
  faqs: Faq[];
}

const { termSlug, title, description, ogImage, label, h1, lede, agda, related, faqs } =
  Astro.props as Props;

const term = terms.find((t) => t.slug === termSlug)!;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  current="intervention-readiness"
  faqs={faqs}
  breadcrumbs={[
    { name: 'Intervention Readiness', item: '/' },
    { name: 'What is Intervention Readiness?', item: '/intervention-readiness/' },
    { name: term.name, item: Astro.url.pathname },
  ]}
>
  <section class="hero">
    <div class="wrap">
      <span class="label">{label}</span>
      <h1 class="h1" set:html={markAgda(h1)} />
      <p class="lede muted" set:html={markAgda(lede)} />
    </div>
  </section>

  <section class="block definition">
    <div class="wrap">
      <aside class="definition-box" aria-label={`${term.name} definition`}>
        <span class="box-label">Defined term</span>
        <p>{term.definition}</p>
      </aside>
    </div>
  </section>

  <div class="hub-body">
    <slot />
  </div>

  <section class="block">
    <div class="wrap-narrow">
      <h2 class="h2">How <span class="agda-mark">AGDA<span class="agda-tm">™</span></span> evidences it.</h2>
      <p class="body muted" set:html={markAgda(agda)} />
      <div class="cta-row">
        {related.map((r) => (
          <a href={r.href} class={r.ghost ? 'btn-ghost' : 'btn'} set:html={markAgda(r.label)} />
        ))}
      </div>
    </div>
  </section>

  <section class="block tight">
    <div class="wrap">
      <h2 class="h2">Frequently asked questions.</h2>
      <dl class="faq-list">
        {faqs.map((faq) => (
          <div>
            <dt set:html={markAgda(faq.question)} />
            <dd set:html={markAgda(faq.answer)} />
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  /* Explanation page: hero, the defined term, the page's own sections,
     how AGDA evidences it, FAQ. Everything from the shared system;
     only the definition block's placement is set here. */
  .definition { padding-bottom: 0; }
  /* A hub page's own sections are short: one heading and a paragraph
     each. They read as one argument, so they share one section's air
     rather than each taking a full section. */
  .hub-body :global(.block) { padding-top: var(--gap-sub); padding-bottom: 0; }
  .hub-body :global(.block:first-child) { padding-top: var(--section); }
  .hub-body :global(.block:last-child) { padding-bottom: var(--section); }
</style>
