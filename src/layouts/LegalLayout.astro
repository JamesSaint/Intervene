---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string;
  current?: string;
}

const { title, description, heading, updated, current } = Astro.props;
---

<BaseLayout title={title} description={description} current={current} noindex={true}>
  <section class="legal-hero">
    <div class="wrap-reading">
      <p class="mono updated">Last updated · {updated}</p>
      <h1 class="h1">{heading}</h1>
    </div>
  </section>

  <section class="block legal-body">
    <div class="wrap-reading">
      <slot />
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Reference document: a reading column, dated, with numbered-feel
     headings. Nothing here changes the meaning of the text. */
  .legal-hero {
    padding-top: var(--hero-top);
    padding-bottom: var(--hero-bottom);
    border-bottom: 1px solid var(--hair);
  }
  .legal-hero .updated {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
    margin: 0 0 var(--space-4);
  }
  .legal-hero .h1 { max-width: 18ch; margin: 0; font-size: clamp(32px, 4.4vw, 52px); }

  .legal-body { padding: var(--section-tight) 0 var(--section); }
  .legal-body h2 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.01em;
    margin: var(--gap-sub) 0 var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hair);
    color: var(--ink);
  }
  .legal-body h2:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
  .legal-body p,
  .legal-body li {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink);
  }
  .legal-body p { margin: 0 0 18px; }
  .legal-body ul {
    margin: 0 0 18px;
    padding-left: 22px;
  }
  .legal-body li { margin-bottom: 8px; }
  .legal-body strong { font-weight: 600; }
  .legal-body a {
    color: var(--ink);
    border-bottom: 1px solid var(--hair-strong);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .legal-body a:hover { border-bottom-color: var(--accent); color: var(--accent); }
  .legal-body a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
