---
import BaseLayout from './BaseLayout.astro';
import { markAgda } from '../lib/marks';
import { terms } from '../lib/terms';
import Agda from '../components/Agda.astro';

interface Row {
  aspect: string;
  other: string;
  ir: string;
}
interface Faq {
  question: string;
  answer: string;
}
interface Props {
  title: string;        // passed to BaseLayout verbatim. Ends "· Intervene"
                        // except where the comparison term needs the room.
  description: string;
  ogImage?: string;     // per-page social card; falls back to BaseLayout default
  other: string;        // adjacent discipline, e.g. "AI Governance"
  verdict: string;      // one-line extractable distinction
  whatOther: string;    // what the adjacent discipline does
  rows: Row[];
  relate: string;       // how it relates to Intervention Readiness
  agda: string;         // how AGDA measures or evidences it
  faqs: Faq[];
}

const { title, description, ogImage, other, verdict, whatOther, rows, relate, agda, faqs } =
  Astro.props as Props;

const irDefinition = terms.find((t) => t.slug === 'intervention-readiness')!.definition;
// The row that states each discipline's question leads the page as a figure.
const core = rows.find((r) => r.aspect === 'Core question');
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  current="intervention-readiness"
  faqs={faqs}
  breadcrumbs={[
    { name: 'Intervention Readiness', item: '/' },
    { name: 'What is Intervention Readiness?', item: '/intervention-readiness/' },
    { name: `vs ${other}`, item: Astro.url.pathname },
  ]}
>
  <section class="hero">
    <div class="wrap">
      <span class="label">Comparison</span>
      <h1 class="h1" set:html={markAgda(`Intervention Readiness vs ${other}`)} />
      <p class="lede muted" set:html={markAgda(verdict)} />
    </div>
  </section>

  {core && (
    <section class="block tight two-questions" aria-label="The question each asks">
      <div class="wrap">
        <div class="tq-pair">
          <div class="tq-side">
            <span class="mono">{other} asks</span>
            <p set:html={markAgda(core.other)} />
          </div>
          <div class="tq-side tq-ir">
            <span class="mono">Intervention Readiness asks</span>
            <p set:html={markAgda(core.ir)} />
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="block definition">
    <div class="wrap">
      <div class="definition-grid">
        <div>
          <h2 class="h2" set:html={markAgda(`What ${other} does.`)} />
          <p class="body muted" set:html={markAgda(whatOther)} />
        </div>
        <aside class="definition-box" aria-label="Intervention Readiness definition">
          <span class="box-label">The category</span>
          <p>{irDefinition}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h2">What each answers.</h2>
      <!-- The same rows, drawn as two sides of one spine: the adjacent
           discipline on the left, Intervention Readiness on the right, and
           what is being compared on the line between them. Table roles are
           stated because the rows are laid out as a grid. -->
      <table class="table-compare split-ledger" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader"><span class="sl-sr">Question</span></th>
            <th scope="col" role="columnheader" set:html={markAgda(other)} />
            <th scope="col" role="columnheader">Intervention Readiness</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {rows.map((r) => (
            <tr role="row">
              <th scope="row" role="rowheader"><span set:html={markAgda(r.aspect)} /></th>
              <td role="cell" data-col={other} set:html={markAgda(r.other)} />
              <td role="cell" data-col="Intervention Readiness" set:html={markAgda(r.ir)} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <div class="wrap-narrow">
      <div class="section-intro"><h2 class="h2">How they relate.</h2><p class="body muted" set:html={markAgda(relate)} /></div>
    </div>
  </section>

  <section class="block tight">
    <div class="wrap">
      <h2 class="h2">Frequently asked questions.</h2>
      <dl class="faq-list">
        {faqs.map((faq) => (
          <div>
            <dt set:html={markAgda(faq.question)} />
            <dd set:html={markAgda(faq.answer)} />
          </div>
        ))}
      </dl>
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      <div class="section-intro">
        <h2 class="h2">How <Agda /> evidences it.</h2>
        <div><p class="body muted" set:html={markAgda(agda)} />
          <div class="cta-row"><a href="/agda/" class="btn">Explore the assessment</a><a href="/sample-report/" class="btn-ghost">View sample verdict</a></div>
          <nav class="related-links" aria-label="Related concepts"><a href="/intervention-readiness/" class="link">What is Intervention Readiness?</a><a href="/intervention-readiness/category-map/" class="link">The category map</a></nav>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Two questions at the same size: the adjacent discipline's in the quiet tone, this one's in ink. */
  .two-questions { border-bottom: 1px solid var(--hair); }
  .tq-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .tq-side { display: grid; gap: var(--space-3); align-content: start; padding: var(--space-4) var(--space-6) var(--space-4) 0; border-top: 1px solid var(--hair-strong); }
  .tq-side .mono { font-size: var(--type-caption); line-height: 1.6; color: var(--faint); }
  .tq-side p { margin: 0; font-size: clamp(24px, 3.2vw, 46px); font-weight: 600; letter-spacing: var(--tracking-heading); line-height: 1.08; color: var(--faint); }
  .tq-ir { padding-left: var(--space-6); padding-right: 0; border-top: 3px solid var(--ink); border-left: 1px solid var(--hair-strong); }
  .tq-ir .mono { color: var(--accent-text); }
  .tq-ir p { color: var(--ink); }
  @media (max-width: 720px) {
    .tq-pair { grid-template-columns: minmax(0, 1fr); }
    .tq-side { padding-right: 0; }
    .tq-ir { padding-left: 0; border-left: 0; }
  }

  /* The split ledger. Wide screens only; below 761px the shared stacked
     table takes over, with each cell labelled by its column. */
  .sl-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (min-width: 761px) {
    .split-ledger, .split-ledger :is(thead, tbody) { display: block; }
    .split-ledger tr { display: grid; grid-template-columns: minmax(0, 1fr) clamp(150px, 16vw, 220px) minmax(0, 1fr); align-items: stretch; }
    .split-ledger :is(th, td) { display: block; width: auto; border: 0; padding: var(--space-4) 0; }
    .split-ledger tr > :nth-child(1) { grid-column: 2; grid-row: 1; position: relative; display: grid; place-items: start center; padding-inline: var(--space-3); text-align: center; }
    /* The spine runs through every row; what is compared sits on it. */
    .split-ledger tr > :nth-child(1)::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; border-left: 1px solid var(--hair-strong); }
    .split-ledger tbody th span { position: relative; padding: 5px 10px; border: 1px solid var(--hair-strong); background: var(--paper); font-family: var(--font-mono); font-size: var(--type-caption); font-weight: 400; line-height: 1.5; color: var(--muted); }
    .split-ledger tr > :nth-child(2) { grid-column: 1; grid-row: 1; padding-right: var(--space-5); text-align: right; color: var(--muted); border-top: 1px solid var(--hair); }
    .split-ledger tr > :nth-child(3) { grid-column: 3; grid-row: 1; padding-left: var(--space-5); color: var(--ink); border-top: 1px solid var(--ink); }
    .split-ledger tbody td { font-size: clamp(17px, 1.5vw, 21px); line-height: 1.45; }
    .split-ledger tbody td:last-child { font-weight: 600; letter-spacing: var(--tracking-heading); }
    .split-ledger thead th { border: 0; padding-block: var(--space-3); }
    .split-ledger thead tr > :nth-child(2) { border-top: 1px solid var(--hair-strong); color: var(--faint); }
    .split-ledger thead tr > :nth-child(3) { border-top: 3px solid var(--ink); color: var(--accent-text); }
    .split-ledger thead tr > :nth-child(1)::before { top: 50%; }
    .split-ledger tbody tr:last-child > :nth-child(1)::before { bottom: 50%; }
  }

  /* Comparison page: hero, what the adjacent discipline does beside the
     category definition, a three-column table, two prose sections, FAQ. */

  .definition-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: var(--space-7);
    align-items: start;
  }
  .definition-grid .body { margin-top: var(--gap-head); }
  .definition-grid .definition-box p { font-size: clamp(19px, 2.2vw, 26px); }
  @media (max-width: 880px) {
    .definition-grid { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
