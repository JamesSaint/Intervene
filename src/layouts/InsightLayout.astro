---
import BaseLayout from './BaseLayout.astro';
import { markAgda } from '../lib/marks';

interface Props {
  title: string;
  /* Metadata title only, when the headline is too long for the <title>
     limit once the brand suffix is added. Omit it and the visible
     headline is used, which is the original behaviour. Never include
     the suffix here: it is appended once, below. */
  seoTitle?: string;
  description: string;
  dek: string;
  date: string;        // ISO, e.g. 2026-05-02
  kicker?: string;
}
const { title, seoTitle, description, dek, date, kicker = 'Note' } = Astro.props;
const dateLabel = new Date(date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${seoTitle ?? title} · Intervene`}
  headline={title}
  description={description}
  current="insights"
  pageType="Article"
  datePublished={date}
>
  <article class="insight">
    <header class="insight-header">
      <div class="wrap-reading">
        <a href="/insights/" class="back-link">Insights</a>
        <span class="label">{kicker}</span>
        <h1 class="h1" set:html={markAgda(title)}></h1>
        <p class="lede dek" set:html={markAgda(dek)}></p>
        <time class="meta mono" datetime={date}>{dateLabel}</time>
      </div>
    </header>

    <div class="wrap-reading prose">
      <slot />
    </div>

    <div class="wrap-reading insight-close">
      <p class="body muted">
        If this describes a system you are accountable for, look at the
        evidence format an assessment produces, and decide whether to open a
        conversation.
      </p>
      <div class="cta-row">
        <a href="/contact/" class="btn">Discuss your system</a>
        <a href="/sample-report/" class="btn-ghost">View sample verdict</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* Reading page: a narrow column, one kicker, a dek, and prose set at
     18px on a 680px measure. Closing actions sit under a rule. */
  .insight-header {
    padding-top: var(--hero-top);
    padding-bottom: var(--hero-bottom);
    border-bottom: 1px solid var(--hair);
  }
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .back-link:hover { color: var(--ink); border-color: var(--accent); }
  .insight-header .h1 { font-size: clamp(34px, 4.6vw, 56px); max-width: 22ch; }
  .dek { margin-top: var(--gap-h1); max-width: 48ch; color: var(--ink); }
  .insight-header .meta {
    display: block;
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .prose {
    padding-top: var(--section-tight);
    padding-bottom: var(--section-tight);
  }
  .prose :global(h2) {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(24px, 2.4vw, 30px);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: var(--gap-sub) 0 var(--space-3);
    color: var(--ink);
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .prose :global(p.muted) { color: var(--muted); }
  .prose :global(blockquote) {
    margin: var(--space-5) 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--accent);
    font-size: 22px;
    font-style: italic;
    line-height: 1.4;
    color: var(--muted);
    max-width: 40ch;
  }
  .prose :global(ul) {
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }
  .prose :global(ul > li) {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--hair);
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink);
  }
  .prose :global(strong) { font-weight: 600; }

  .insight-close {
    padding-top: var(--space-6);
    padding-bottom: var(--space-3);
    border-top: 1px solid var(--hair);
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .insight-close .body { max-width: 48ch; margin: 0; }
</style>
